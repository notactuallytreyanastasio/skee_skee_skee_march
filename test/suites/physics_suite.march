mod PhysicsSuite do

  -- Parity of the physics piece against the real Swift. Expected values come from
  -- test/golden/physics.march, generated by tools/golden. See docs/PORT.md.
  import Harness

  fn golden() : List(List(String)) do
    GoldenIo.rows(Golden.Physics.chunks())
  end

  fn f(token : String) : Float do
    GoldenIo.float_of_bits(token)
  end

  fn consts() : Skee.Consts.Consts do
    Skee.Consts.make()
  end

  fn curve_case(rows : List(List(String))) : Outcome do
    let lane = Skee.Types.standard_lane(consts())
    all(List.map(GoldenIo.of_kind(rows, "curve"), fn row ->
      match row do
      [p, want] -> GoldenIo.expect_float(Skee.Physics.release_speed(lane, f(p)), want, "release_speed " ++ p)
      _ -> Mismatch("bad curve row")
      end
    ))
  end

  fn inverse_case(rows : List(List(String))) : Outcome do
    let lane = Skee.Types.standard_lane(consts())
    all(List.map(GoldenIo.of_kind(rows, "inverse"), fn row ->
      match row do
      [v, want] -> GoldenIo.expect_float(Skee.Physics.power_for_speed(lane, f(v)), want, "power_for_speed " ++ v)
      _ -> Mismatch("bad inverse row")
      end
    ))
  end

  fn angle_case(rows : List(List(String))) : Outcome do
    let hinge = Skee.Types.standard_hinge(consts())
    all(List.map(GoldenIo.of_kind(rows, "angle"), fn row ->
      match row do
      [fold, want] -> GoldenIo.expect_float(Skee.Physics.launch_angle(hinge, f(fold)), want, "launch_angle " ++ fold)
      _ -> Mismatch("bad angle row")
      end
    ))
  end

  -- The tokens of `row` from `from`, as many as `n`.
  fn slice(row : List(String), from : Int, n : Int) : List(String) do
    List.take(List.drop(row, from), n)
  end

  fn token(row : List(String), i : Int) : String do
    match List.nth_opt(row, i) do
    Some(t) -> t
    None -> panic("golden row too short")
    end
  end

  -- A Float field of a row.
  fn at(row : List(String), i : Int) : Float do
    f(token(row, i))
  end

  fn expect_launch(l : Launch, want : List(String), what : String) : Outcome do
    let fields = [l.power, l.speed, l.from, l.aim, l.start, l.fold, l.spin, l.skid]
    all(List.map(List.zip(fields, want), fn pair ->
      match pair do
      (got, token) -> GoldenIo.expect_float(got, token, what)
      end
    ))
  end

  fn launch_power_row(k : Skee.Consts.Consts, row : List(String)) : Outcome do
    let l = Skee.Physics.launch_of_power(k, at(row, 0), at(row, 1), at(row, 2), at(row, 3), at(row, 4), at(row, 5))
    expect_launch(l, slice(row, 6, 8), "launch_of_power")
  end

  fn launch_speed_row(k : Skee.Consts.Consts, row : List(String)) : Outcome do
    let l = Skee.Physics.launch_of_speed(k, at(row, 0), at(row, 1), at(row, 2), at(row, 3), at(row, 4), at(row, 5), at(row, 6))
    all([expect_launch(l, slice(row, 7, 8), "launch_of_speed"), expect_launch(Skee.Physics.mirrored_launch(k, l), slice(row, 15, 8), "mirrored")])
  end

  fn launch_case(rows : List(List(String))) : Outcome do
    let k = consts()
    all(List.append(List.map(GoldenIo.of_kind(rows, "launchp"), fn row -> launch_power_row(k, row)), List.map(GoldenIo.of_kind(rows, "launchs"), fn row -> launch_speed_row(k, row))))
  end

  fn hole_of(name : String) : Hole do
    match name do
    "gutter" -> Gutter
    "ring10" -> Ring10
    "ring20" -> Ring20
    "ring30" -> Ring30
    "ring40" -> Ring40
    "ring50" -> Ring50
    "pocketLeft" -> PocketLeft
    "pocketRight" -> PocketRight
    _ -> panic("bad golden hole: " ++ name)
    end
  end

  fn expect_hole(got : Hole, want : String, what : String) : Outcome do
    expect(got == hole_of(want), what ++ ": got " ++ show(got) ++ ", want " ++ want)
  end

  fn hole_facts_row(row : List(String)) : Outcome do
    match row do
    [name, face, mirror, pocket] -> do
      let h = hole_of(name)
      all([expect_int(Skee.Physics.face_value(h), GoldenIo.int(face), "face " ++ name), expect_hole(Skee.Physics.mirrored(h), mirror, "mirrored " ++ name), expect(Skee.Physics.is_pocket(h) == (pocket == "1"), "is_pocket " ++ name)])
    end
    _ -> Mismatch("bad holefacts row")
    end
  end

  fn lane_of(r : List(String)) : LaneSpec do
    {
      length: at(r, 0),
      width: at(r, 1),
      incline: at(r, 2),
      rolling_friction: at(r, 3),
      rail_restitution: at(r, 4),
      min_speed: at(r, 5),
      scoring_speed: at(r, 6),
      max_speed: at(r, 7),
      knee: at(r, 8),
      max_aim_angle: at(r, 9),
      hook: at(r, 10),
      skid_loss: at(r, 11)
    }
  end

  fn vec(r : List(String), i : Int) : Skee.Maths.Vec2 do
    Skee.Maths.vec2(at(r, i), at(r, i + 1))
  end

  fn board_of(r : List(String)) : BoardSpec do
    {
      board_width: at(r, 0),
      board_height: at(r, 1),
      tilt: at(r, 2),
      ring_center: vec(r, 3),
      center_hole_offset: vec(r, 5),
      center_hole_radius: at(r, 7),
      capture_speed: at(r, 8),
      pockets_need_flight: token(r, 9) == "1",
      lip_min_fall: at(r, 10),
      ring_walls: { wall40: at(r, 11), wall30: at(r, 12), wall20: at(r, 13), wall10: at(r, 14) },
      pockets: {
        left: { pocket_hole: PocketLeft, center: vec(r, 15), radius: at(r, 17) },
        right: { pocket_hole: PocketRight, center: vec(r, 18), radius: at(r, 20) }
      },
      lip_height: at(r, 21),
      ball_radius: at(r, 22),
      lip_band: at(r, 23),
      bounce: at(r, 24),
      lip_bounce: at(r, 25),
      lip_kick: at(r, 26),
      wall_restitution: at(r, 27),
      backwall_restitution: at(r, 28),
      board_rolling_friction: at(r, 29),
      landing_grip: at(r, 30),
      wind: vec(r, 31),
      ring_hole_radius: at(r, 33)
    }
  end

  -- A table row: its id, then lane, hinge, board and the last three fields.
  fn table_of(row : List(String)) : Table do
    let r = List.drop(row, 1)
    {
      lane: lane_of(r),
      hinge: { base_angle: at(r, 12), fold_gain: at(r, 13), carry: at(r, 14) },
      board: board_of(List.drop(r, 15)),
      gravity: at(r, 49),
      dt: at(r, 50),
      max_duration: at(r, 51)
    }
  end

  -- Every golden table, by position: the rows are written in id order.
  fn tables_of(rows : List(List(String))) : List(Table) do
    List.map(GoldenIo.of_kind(rows, "table"), table_of)
  end

  fn table_at(tables : List(Table), id : String) : Table do
    match List.nth_opt(tables, GoldenIo.int(id)) do
    Some(t) -> t
    None -> panic("no golden table " ++ id)
    end
  end

  fn center_row(tables : List(Table), row : List(String)) : Outcome do
    let t = table_at(tables, token(row, 0))
    let c = Skee.Physics.hole_center(t.board, hole_of(token(row, 1)))
    all([GoldenIo.expect_float(c.x, token(row, 2), "center x"), GoldenIo.expect_float(c.y, token(row, 3), "center y")])
  end

  fn zone_row(tables : List(Table), row : List(String)) : Outcome do
    let t = table_at(tables, token(row, 0))
    expect_hole(Skee.Physics.zone(t.board, vec(row, 1)), token(row, 3), "zone")
  end

  fn board_case(rows : List(List(String))) : Outcome do
    let tables = tables_of(rows)
    all(List.append(List.map(GoldenIo.of_kind(rows, "center"), fn row -> center_row(tables, row)), List.map(GoldenIo.of_kind(rows, "zone"), fn row -> zone_row(tables, row))))
  end

  fn ball_of(name : String) : BallKind do
    match name do
    "marshmallow" -> Marshmallow
    "classic" -> ClassicBall
    "bean" -> JumpingBean
    "wobbler" -> Wobbler
    "comet" -> Comet
    _ -> panic("bad golden ball: " ++ name)
    end
  end

  fn hole_name(h : Hole) : String do
    match h do
    Gutter -> "gutter"
    Ring10 -> "ring10"
    Ring20 -> "ring20"
    Ring30 -> "ring30"
    Ring40 -> "ring40"
    Ring50 -> "ring50"
    PocketLeft -> "pocketLeft"
    PocketRight -> "pocketRight"
    end
  end

  fn event_name(e : ShotEvent) : String do
    match e do
    ShotDud -> "dud"
    ShotRail -> "rail"
    ShotLaunched -> "launched"
    ShotLanded -> "landed"
    ShotLip(ring) -> "lip" ++ int_to_string(ring)
    ShotBackwall -> "backwall"
    ShotHop -> "hop"
    ShotDropped(h) -> "dropped:" ++ hole_name(h)
    ShotSettled(h) -> "settled:" ++ hole_name(h)
    ShotGutter -> "gutter"
    end
  end

  fn phase_name(p : PathPhase) : String do
    match p do
    OnLane -> "lane"
    InAir -> "air"
    OnBoard -> "board"
    end
  end

  -- Bit equality, and the bits as text for messages. Every comparison of a
  -- Float here goes through this: == cannot tell 0.0 from -0.0.
  fn same_bits(x : Float, token : String) : Bool do
    Skee.U64.equal(GoldenIo.float_bits(x), GoldenIo.u64(token))
  end

  fn gap(x : Float, token : String) : Float do
    Math.abs(x -. f(token))
  end

  -- One golden shot, replayed. What Swift said against what March did.
  type ShotVerdict = {
    index : String,
    hole_ok : Bool,
    events_ok : Bool,
    floats_exact : Bool,
    count_ok : Bool,
    path_gap : Float,
    time_gap : Float,
    first_diff : String
  }

  fn shot_launch(k : Skee.Consts.Consts, row : List(String)) : Launch do
    match token(row, 4) do
    "p" -> Skee.Physics.launch_of_power(k, at(row, 5), at(row, 7), at(row, 8), at(row, 9), at(row, 10), at(row, 11))
    _ -> Skee.Physics.launch_of_speed(k, at(row, 5), at(row, 6), at(row, 7), at(row, 8), at(row, 9), at(row, 10), at(row, 11))
    end
  end

  fn sums_of(path : List(PathSample)) : (Float, Float, Float, Float) do
    List.fold_left(path, (0.0, 0.0, 0.0, 0.0), fn (acc, s) ->
      match acc do
      (t, x, along, height) -> (t +. s.t, x +. s.px, along +. s.along, height +. s.height)
      end
    )
  end

  -- Float tokens, in pairs with what they should equal.
  fn check_all(pairs : List((Float, String))) : (Bool, Float) do
    List.fold_left(pairs, (true, 0.0), fn (acc, pair) ->
      match (acc, pair) do
      ((ok, worst), (x, want)) -> (ok && same_bits(x, want), Skee.Maths.max_float(worst, gap(x, want)))
      end
    )
  end

  fn option_token(x : Option(Float), want : String) : (Bool, Float) do
    match x do
    Some(v) -> if want == "none" do (false, 0.0) else check_all([(v, want)]) end
    None -> (want == "none", 0.0)
    end
  end

  -- One sampled token against the path sample at its index.
  fn sample_check(path_at : Int -> Option(PathSample), text : String) : (Bool, Float) do
    match String.split(text, ":") do
    [index, phase, t, x, along, height] -> do
      match path_at(GoldenIo.int(index)) do
      Some(s) -> do
        let (exact, worst) = check_all([(s.t, t), (s.px, x), (s.along, along), (s.height, height)])
        (exact && phase_name(s.phase) == phase, worst)
      end
      None -> (false, 0.0)
      end
    end
    _ -> panic("bad golden sample")
    end
  end

  fn index_path(path : List(PathSample), i : Int, wanted : List(Int), acc : List((Int, PathSample))) : List((Int, PathSample)) do
    match (path, wanted) do
    (Nil, _) -> List.reverse(acc)
    (_, Nil) -> List.reverse(acc)
    (Cons(s, rest), Cons(w, more)) -> do
      if i == w do
        index_path(rest, i + 1, more, Cons((i, s), acc))
      else
        index_path(rest, i + 1, wanted, acc)
      end
    end
    end
  end

  fn sample_index(text : String) : Int do
    match String.split(text, ":") do
    Cons(i, _) -> GoldenIo.int(i)
    Nil -> panic("bad golden sample")
    end
  end

  -- The sampled path against March's. Walks the path once.
  fn samples_check(path : List(PathSample), token : String) : (Bool, Float) do
    let wanted = String.split(token, ",")
    let found = index_path(path, 0, List.map(wanted, sample_index), [])
    let lookup = fn i -> List.find(found, fn pair -> Tuple.first(pair) == i)
    List.fold_left(wanted, (true, 0.0), fn (acc, text) ->
      let (ok, worst) = acc
      let (one, w) = sample_check(fn i ->
        match lookup(i) do
        Some(pair) -> Some(Tuple.second(pair))
        None -> None
        end
      , text)
      (ok && one, Skee.Maths.max_float(worst, w))
    )
  end

  fn times_check(events : List(TimedEvent), token : String) : (Bool, Float) do
    let want = String.split(token, ",")
    if List.length(want) == List.length(events) do
      check_all(List.zip(List.map(events, fn e -> e.at), want))
    else
      (false, 0.0)
    end
  end

  fn landing_check(l : Option(Skee.Maths.Vec2), want_x : String, want_y : String) : (Bool, Float) do
    match l do
    Some(p) -> if want_x == "none" do (false, 0.0) else check_all([(p.x, want_x), (p.y, want_y)]) end
    None -> (want_x == "none", 0.0)
    end
  end

  fn judge(row : List(String), r : ShotResult) : ShotVerdict do
    let names = String.join(List.map(r.events, fn e -> event_name(e.event)), ",")
    let (hinge_ok, hinge_gap) = option_token(r.hinge_speed, token(row, 13))
    let (landing_ok, landing_gap) = landing_check(r.first_landing, token(row, 14), token(row, 15))
    let (single_ok, single_gap) = check_all([(r.peak_height, token(row, 16)), (r.duration, token(row, 17))])
    let (times_ok, times_gap) = times_check(r.events, token(row, 20))
    let (t, x, along, height) = sums_of(r.path)
    let (sums_ok, _) = check_all([(t, token(row, 22)), (x, token(row, 23)), (along, token(row, 24)), (height, token(row, 25))])
    let (samples_ok, sample_gap) = samples_check(r.path, token(row, 26))
    let count_ok = List.length(r.path) == GoldenIo.int(token(row, 21))
    let parts = [("hinge", hinge_ok), ("landing", landing_ok), ("peak/duration", single_ok), ("times", times_ok), ("sums", sums_ok), ("samples", samples_ok)]
    let bad = List.filter(parts, fn p -> !Tuple.second(p))
    {
      index: token(row, 0),
      hole_ok: hole_name(r.hole) == token(row, 12),
      events_ok: names == token(row, 19) && Skee.Physics.rattles(r) == GoldenIo.int(token(row, 18)),
      floats_exact: List.is_empty(bad),
      count_ok: count_ok,
      path_gap: sample_gap,
      time_gap: Skee.Maths.max_float(single_gap, Skee.Maths.max_float(times_gap, Skee.Maths.max_float(hinge_gap, landing_gap))),
      first_diff: String.join(List.map(bad, fn p -> Tuple.first(p)), "+")
    }
  end

  fn replay(k : Skee.Consts.Consts, tables : List(Table), row : List(String)) : ShotVerdict do
    let t = table_at(tables, token(row, 1))
    judge(row, Skee.Physics.simulate_shot(k, shot_launch(k, row), t, ball_of(token(row, 2)), GoldenIo.u64(token(row, 3))))
  end

  fn exact(v : ShotVerdict) : Bool do
    v.hole_ok && v.events_ok && v.floats_exact && v.count_ok
  end

  fn describe(v : ShotVerdict) : String do
    "shot " ++ v.index ++ ": hole " ++ show(v.hole_ok) ++ " events " ++ show(v.events_ok) ++ " count " ++ show(v.count_ok) ++ " differs in " ++ v.first_diff
  end

  fn outcome_of(v : ShotVerdict) : Outcome do
    if exact(v) do Passed(1) else Mismatch(describe(v)) end
  end

  fn shots_where(rows : List(List(String)), keep : List(String) -> Bool) : Outcome do
    let k = consts()
    let tables = tables_of(rows)
    all(List.map(List.filter(GoldenIo.of_kind(rows, "shot"), keep), fn row -> outcome_of(replay(k, tables, row))))
  end

  fn is_dud(row : List(String)) : Bool do
    token(row, 13) == "none"
  end

  fn cases() : List(Case) do
    let rows = golden()
    [
      case("speed curve", fn -> curve_case(rows)),
      case("inverse speed curve", fn -> inverse_case(rows)),
      case("hinge launch angle", fn -> angle_case(rows)),
      case("launch construction and mirroring", fn -> launch_case(rows)),
      case("hole facts", fn -> all(List.map(GoldenIo.of_kind(rows, "holefacts"), hole_facts_row))),
      case("board geometry", fn -> board_case(rows)),
      case("golden shots that never leave the lane", fn -> shots_where(rows, is_dud))
    ]
  end

end
