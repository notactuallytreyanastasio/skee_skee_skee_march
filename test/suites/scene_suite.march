mod SceneSuite do

  -- The scene piece: Skee.World, Skee.Camera and Skee.Scene. Golden rows come
  -- from the real SkeeScene (tools/golden_scene). SkeeScene computes in 32-bit
  -- Float and this port in 64-bit, so values are compared within a tolerance
  -- stated next to each reader, and the worst measured error is printed.
  import Harness
  import Skee.Maths
  import Skee.World

  fn rows(kind : String) : List(List(String)) do
    GoldenIo.of_kind(GoldenIo.rows(Golden.Scene.chunks()), kind)
  end

  fn k() : Skee.Consts.Consts do
    Skee.Consts.make()
  end

  fn fl(token : String) : Float do
    GoldenIo.float_of_bits(token)
  end

  -- Tolerances. Float32 carries 24 bits: a scene coordinate near 3 m is good
  -- to about 2.4e-7 m, and a few roundings stack. Pixels are fractions of a
  -- 1920-pixel screen through a 32-bit projection.
  fn metres_tol() : Float do
    0.000001
  end

  fn pixels_tol() : Float do
    0.001
  end

  -- A lane point is a 32-bit ray cast about a metre: measured worst 1.43e-6 m.
  fn ray_tol() : Float do
    0.000002
  end

  fn unit_tol() : Float do
    0.000001
  end

  fn near(actual : Float, token : String, tol : Float, what : String) : Outcome do
    let want = fl(token)
    let d = Math.abs(actual -. want)
    if d <= tol do
      Passed(1)
    else
      Mismatch(what ++ ": got " ++ float_to_string(actual) ++ ", want " ++ float_to_string(want) ++ " (off " ++ float_to_string(d) ++ ")")
    end
  end

  fn near3(p : Vec3, x : String, y : String, z : String, tol : Float, what : String) : Outcome do
    all([near(p.x, x, tol, what ++ ".x"), near(p.y, y, tol, what ++ ".y"), near(p.z, z, tol, what ++ ".z")])
  end

  fn near2(p : Vec2, x : String, y : String, tol : Float, what : String) : Outcome do
    all([near(p.x, x, tol, what ++ ".x"), near(p.y, y, tol, what ++ ".y")])
  end

  fn room_of(token : String) : Room do
    match List.find(Skee.Rooms.all_rooms(), fn r -> room_token(r) == token) do
    Some(r) -> r
    None -> panic("bad golden room: " ++ token)
    end
  end

  fn room_token(r : Room) : String do
    match r do
    Boardwalk -> "boardwalk"
    NeonLounge -> "neonLounge"
    HighRoller -> "highRoller"
    Penthouse -> "penthouse"
    end
  end

  fn world_of(token : String) : World do
    Skee.World.make(k(), Skee.Rooms.table(k(), room_of(token)))
  end

  fn phase_of(token : String) : PathPhase do
    if token == "lane" do
      OnLane
    else
      if token == "air" do InAir else OnBoard end
    end
  end

  fn hole_of(token : String) : Hole do
    match List.find(Skee.HoleMap.all_holes(), fn h -> hole_token(h) == token) do
    Some(h) -> h
    None -> panic("bad golden hole: " ++ token)
    end
  end

  fn hole_token(h : Hole) : String do
    match h do
    Gutter -> "gutter"
    Ring10 -> "ring10"
    Ring20 -> "ring20"
    Ring30 -> "ring30"
    Ring40 -> "ring40"
    Ring50 -> "ring50"
    PocketLeft -> "pocketLeft"
    PocketRight -> "pocketRight"
    end
  end

  -- ---- World ----
  fn world_row(row : List(String)) : Outcome do
    match row do
    Cons(r, Cons(length, Cons(br, Cons(nx, Cons(ny, Cons(nz, Cons(fx, Cons(fy, Cons(fz, Cons(ox, Cons(oy, Cons(oz, Cons(ux, Cons(uy, Cons(uz, Cons(nbx, Cons(nby, Cons(nbz, Nil)))))))))))))))))) -> do
      let w = world_of(r)
      all([near(lane_length(w), length, metres_tol(), r ++ " laneLength"), near(ball_radius(w), br, metres_tol(), r ++ " ballRadius"), near3(lane_normal(w), nx, ny, nz, unit_tol(), r ++ " laneNormal"), near3(lane_forward(w), fx, fy, fz, unit_tol(), r ++ " laneForward"), near3(board_origin(w), ox, oy, oz, metres_tol(), r ++ " boardOrigin"), near3(board_up(w), ux, uy, uz, unit_tol(), r ++ " boardUp"), near3(board_normal(w), nbx, nby, nbz, unit_tol(), r ++ " boardNormal")])
    end
    _ -> Mismatch("bad world row")
    end
  end

  fn lane_row(row : List(String)) : Outcome do
    match row do
    Cons(r, Cons(x, Cons(s, Cons(px, Cons(py, Cons(pz, Nil)))))) -> do
      near3(lane(world_of(r), fl(x), fl(s)), px, py, pz, metres_tol(), r ++ " lane " ++ x ++ " " ++ s)
    end
    _ -> Mismatch("bad lane row")
    end
  end

  fn board_row(row : List(String)) : Outcome do
    match row do
    Cons(r, Cons(x, Cons(y, Cons(z, Cons(px, Cons(py, Cons(pz, Nil))))))) -> do
      near3(board(world_of(r), vec2(fl(x), fl(y)), fl(z)), px, py, pz, metres_tol(), r ++ " board")
    end
    _ -> Mismatch("bad board row")
    end
  end

  fn sample_of(phase : String, x : String, along : String, height : String) : PathSample do
    {
      t: 0.0,
      phase: phase_of(phase),
      px: fl(x),
      along: fl(along),
      height: fl(height)
    }
  end

  fn ball_row(row : List(String)) : Outcome do
    match row do
    Cons(r, Cons(phase, Cons(x, Cons(along, Cons(height, Cons(scale, Cons(cx, Cons(cy, Cons(cz, Cons(nx, Cons(ny, Cons(nz, Nil)))))))))))) -> do
      let w = world_of(r)
      let s = sample_of(phase, x, along, height)
      all([near(ball_scale(w, s), scale, unit_tol(), r ++ " ballScale"), near3(ball_center(w, s), cx, cy, cz, metres_tol(), r ++ " ballCenter"), near3(surface_normal(w, s), nx, ny, nz, unit_tol(), r ++ " surfaceNormal")])
    end
    _ -> Mismatch("bad ball row")
    end
  end

  -- ---- Camera ----
  fn boardwalk() : World do
    world_of("boardwalk")
  end

  fn fitted() : Skee.Camera.Rig do
    Skee.Camera.fit_world(k(), boardwalk())
  end

  fn view_of(w : String, h : String) : Skee.Camera.Viewport do
    Skee.Camera.viewport(int_to_float(GoldenIo.int(w)), int_to_float(GoldenIo.int(h)))
  end

  fn framing_row(row : List(String)) : Outcome do
    match row do
    Cons(nx, Cons(ny, Cons(nz, Cons(hx, Cons(hy, Cons(hz, Cons(tx, Cons(ty, Cons(tz, Nil))))))))) -> do
      let f = Skee.Camera.framing(boardwalk())
      all([near3(f.near_point, nx, ny, nz, metres_tol(), "near"), near3(f.hump_point, hx, hy, hz, metres_tol(), "hump"), near3(f.top_point, tx, ty, tz, metres_tol(), "top")])
    end
    _ -> Mismatch("bad framing row")
    end
  end

  fn fit_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(ex, Cons(ey, Cons(ez, Cons(tx, Cons(ty, Cons(tz, Cons(fov, Nil))))))))) -> do
      let what = "fit " ++ w ++ "x" ++ h
      all([near3(rig.eye, ex, ey, ez, metres_tol(), what ++ " eye"), near3(rig.target, tx, ty, tz, metres_tol(), what ++ " target"), near(rig.fov, fov, unit_tol(), what ++ " fov")])
    end
    _ -> Mismatch("bad fit row")
    end
  end

  fn proj_point(w : World, name : String) : Vec3 do
    let span = w.table.lane.length
    let hw = w.table.lane.width /. 2.0
    let f = Skee.Camera.framing(w)
    if name == "laneNearLeft" do
      lane(w, -hw, 0.0)
    else
      if name == "laneNearRight" do
        lane(w, hw, 0.0)
      else
        if name == "laneFarLeft" do
          lane(w, -hw, span)
        else
          if name == "laneFarRight" do
            lane(w, hw, span)
          else
            if name == "hump" do
              f.hump_point
            else
              if name == "near" do
                f.near_point
              else
                if name == "top" do
                  f.top_point
                else
                  if String.starts_with(name, "sample") do
                    ball_center(w, sample_n(GoldenIo.int(String.replace_all(name, "sample", ""))))
                  else
                    board(w, Skee.Physics.hole_center(w.table.board, hole_of(name)), 0.0)
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  -- The samples golden-scene projects, in its order.
  fn samples() : List(PathSample) do
    [
      sample_of_floats(OnLane, 0.0, 0.0, 0.0),
      sample_of_floats(OnLane, -0.21, 0.7, 0.0),
      sample_of_floats(OnLane, 0.25, 2.4, 0.0),
      sample_of_floats(InAir, 0.05, 2.45, 0.04),
      sample_of_floats(InAir, -0.1, 2.52, 0.11),
      sample_of_floats(OnBoard, 0.12, 2.65, 0.002),
      sample_of_floats(OnBoard, 0.0, 2.9, 0.0),
      sample_of_floats(OnBoard, -0.2, 3.26, 0.0)
    ]
  end

  fn sample_of_floats(p : PathPhase, x : Float, along : Float, h : Float) : PathSample do
    { t: 0.0, phase: p, px: x, along: along, height: h }
  end

  fn sample_n(n : Int) : PathSample do
    match List.nth_opt(samples(), n) do
    Some(s) -> s
    None -> panic("no sample " ++ int_to_string(n))
    end
  end

  fn proj_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(name, Cons(px, Cons(py, Nil))))) -> do
      let world = boardwalk()
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      near2(Skee.Camera.pixel(k(), l, proj_point(world, name)), px, py, pixels_tol(), w ++ "x" ++ h ++ " " ++ name)
    end
    _ -> Mismatch("bad proj row")
    end
  end

  fn holes_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(name, Cons(px, Cons(py, Nil))))) -> do
      let spots = Skee.Camera.hole_on_screen(k(), boardwalk(), rig, view_of(w, h))
      if List.any(Skee.HoleMap.all_holes(), fn x -> hole_token(x) == name) do
        near2(Skee.HoleMap.at(spots, hole_of(name)), px, py, pixels_tol(), "holeOnScreen " ++ name)
      else
        Passed(0)
      end
    end
    _ -> Mismatch("bad proj row")
    end
  end

  fn flick_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(crease, Cons(cx, Cons(half, Cons(give, Nil)))))) -> do
      let g = Skee.Camera.flick_geometry(k(), boardwalk(), rig, view_of(w, h))
      let what = "flick " ++ w ++ "x" ++ h
      all([near(g.crease_y, crease, pixels_tol(), what ++ " creaseY"), near(g.lane_center_x, cx, pixels_tol(), what ++ " laneCenterX"), near(g.lane_half_width, half, pixels_tol(), what ++ " laneHalfWidth"), near(g.foul_give, give, 0.0, what ++ " foulGive")])
    end
    _ -> Mismatch("bad flick row")
    end
  end

  fn guide_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(line, coords))) -> do
      let pts = Skee.Camera.guide(k(), boardwalk(), rig, view_of(w, h), fl(line))
      let got = List.flat_map(pts, fn p -> [p.x, p.y])
      if List.length(got) == List.length(coords) do
        all(List.zip_with(got, coords, fn (g, c) -> near(g, c, pixels_tol(), "guide " ++ w ++ "x" ++ h ++ " line " ++ line)))
      else
        Mismatch("guide length")
      end
    end
    _ -> Mismatch("bad guide row")
    end
  end

  fn waiting_row(row : List(String)) : Outcome do
    match row do
    Cons(line, Cons(x, Cons(y, Cons(z, Nil)))) -> do
      near3(Skee.Camera.waiting_ball(boardwalk(), fl(line)), x, y, z, metres_tol(), "waitingBall " ++ line)
    end
    _ -> Mismatch("bad waiting row")
    end
  end

  fn lane_point_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(fx, Cons(fy, Cons(hit, Cons(x, Cons(y, Cons(z, Nil)))))))) -> do
      let got =
        Skee.Camera.lane_point(k(), boardwalk(), rig, view_of(w, h), vec2(fl(fx), fl(fy)))
      match got do
      Some(p) -> do
        if hit == "1" do
          near3(p, x, y, z, ray_tol(), "lanePoint")
        else
          Mismatch("lanePoint hit, Swift missed")
        end
      end
      None -> Mismatch("lanePoint missed, Swift hit")
      end
    end
    Cons(w, Cons(h, Cons(fx, Cons(fy, Cons(_, Nil))))) -> do
      match Skee.Camera.lane_point(k(), boardwalk(), rig, view_of(w, h), vec2(fl(fx), fl(fy))) do
      Some(_) -> Mismatch("lanePoint hit, Swift missed")
      None -> Passed(1)
      end
    end
    _ -> Mismatch("bad lanepoint row")
    end
  end

  fn lane_coords_row(row : List(String)) : Outcome do
    match row do
    Cons(px, Cons(py, Cons(pz, Cons(x, Cons(s, Nil))))) -> do
      let (gx, gs) = Skee.Camera.lane_coordinates(boardwalk(), v3(fl(px), fl(py), fl(pz)))
      all([near(gx, x, metres_tol(), "laneCoordinates x"), near(gs, s, metres_tol(), "laneCoordinates s")])
    end
    _ -> Mismatch("bad lanecoords row")
    end
  end

  fn ray_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(ox, Cons(oy, Cons(oz, Cons(dx, Cons(dy, Cons(dz, Nil)))))))) -> do
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      let (o, d) = Skee.Camera.ray(l, vec2(0.3, 0.6))
      all([near3(o, ox, oy, oz, metres_tol(), "ray origin"), near3(d, dx, dy, dz, unit_tol(), "ray direction")])
    end
    _ -> Mismatch("bad ray row")
    end
  end

  fn camera0_row(row : List(String)) : Outcome do
    match row do
    Cons(_, Cons(x, Cons(y, Cons(z, Cons(fov, Nil))))) -> do
      let r = Skee.Camera.initial()
      all([near3(r.eye, x, y, z, metres_tol(), "initial camera"), near(r.fov, fov, 0.0, "initial fov")])
    end
    _ -> Mismatch("bad camera0 row")
    end
  end

  fn tap_case() : Outcome do
    let w = boardwalk()
    let rig = fitted()
    let v = Skee.Camera.viewport(390.0, 844.0)
    let spots = Skee.Camera.hole_on_screen(k(), w, rig, v)
    let at50 = spots.ring50
    let near50 =
      Skee.Camera.tapped_hole(k(), w, rig, v, vec2(at50.x +. 3.0, at50.y -. 2.0))
    let far = Skee.Camera.tapped_hole(k(), w, rig, v, vec2(5.0, 840.0))
    let gutter = Skee.Camera.tapped_hole(k(), w, rig, v, spots.gutter)
    all([expect(near50 == Some(Ring50), "tap by the 50 picks the 50"), expect(far == None, "a tap far from every hole picks none"), expect(gutter != Some(Gutter), "the gutter is never a target")])
  end

  fn lean_case() : Outcome do
    let w = boardwalk()
    let rig = fitted()
    let still = Skee.Camera.framed(w, rig, 0.0, 0.0, 3.0)
    let up = Skee.Camera.lean_step(0.0, 1.0, 0.1)
    let down = Skee.Camera.lean_step(1.0, 0.0, 0.1)
    let big = Skee.Camera.lean_step(0.2, 1.0, 1.0)
    all([expect(Skee.World.length3(Skee.World.minus(still.eye, rig.eye)) == 0.0, "no lean, no shake: the fitted rig"), expect(Math.abs(up -. 0.5) < 0.0000001, "lean eases in at 5 per second"), expect(Math.abs(down -. 0.75) < 0.0000001, "lean eases out at 2.5 per second"), expect(big == 1.0, "a long frame lands on the target")])
  end

  fn world_cases() : List(Case) do
    [
      case("World constants, every room", fn () -> all(List.map(rows("world"), world_row))),
      case("World.lane", fn () -> all(List.map(rows("lane"), lane_row))),
      case("World.board", fn () -> all(List.map(rows("board"), board_row))),
      case("World.ballCenter, ballScale, surfaceNormal", fn () -> all(List.map(rows("ball"), ball_row)))
    ]
  end

  fn camera_cases(rig : Skee.Camera.Rig) : List(Case) do
    [
      case("Cabinet.framingPoints", fn () -> all(List.map(rows("framing"), framing_row))),
      case("Cabinet.fit, every viewport", fn () -> all(List.map(rows("fit"), fn r -> fit_row(rig, r)))),
      case("projected points, every viewport", fn () -> all(List.map(rows("proj"), fn r -> proj_row(rig, r)))),
      case("hole_on_screen, every viewport", fn () -> all(List.map(rows("proj"), fn r -> holes_row(rig, r)))),
      case("flickGeometry, every viewport", fn () -> all(List.map(rows("flick"), fn r -> flick_row(rig, r)))),
      case("guide, every viewport", fn () -> all(List.map(rows("guide"), fn r -> guide_row(rig, r)))),
      case("waitingBall", fn () -> all(List.map(rows("waiting"), waiting_row))),
      case("lanePoint", fn () -> all(List.map(rows("lanepoint"), fn r -> lane_point_row(rig, r)))),
      case("laneCoordinates", fn () -> all(List.map(rows("lanecoords"), lane_coords_row))),
      case("CameraRig.ray", fn () -> all(List.map(rows("ray"), fn r -> ray_row(rig, r)))),
      case("the camera before a fit", fn () -> all(List.map(rows("camera0"), camera0_row))),
      case("tapBoard picks the nearest reel hole within 44 px", fn () -> tap_case()),
      case("camera lean and shake", fn () -> lean_case())
    ]
  end

  -- ---- The cabinet model against the real node tree ----
  fn fresh_stage(r : Room) : Skee.Scene.Scenery do
    let w = Skee.World.make(k(), Skee.Rooms.table(k(), r))
    let rad = ball_radius(w)
    let place =
      {
        centre: plus(lane(w, 0.0, 0.15), times(lane_normal(w), rad)),
        scale: 1.0,
        normal: lane_normal(w),
        airborne: false,
        visible: true,
        sink: 0.0,
        over_board: false
      }
    let motion =
      {
        orientation: Skee.Scene.quat_identity(),
        last: None,
        spin: origin(),
        pop: 0.0
      }
    let shadow =
      {
        spot: origin(),
        facing: v3(0.0, 0.0, 1.0),
        size: 1.0,
        fade: 1.0,
        shown: true
      }
    let look = { symbol: Blank, turn: 0.0, glow: 0.0, slot_match: false, pulse: 1.0 }
    {
      world: w,
      palette: Skee.Rooms.palette(r),
      viewport: Skee.Camera.viewport(390.0, 844.0),
      camera: Skee.Camera.initial(),
      ball: { place: place, motion: motion, kind: ClassicBall, shadow: shadow },
      waiting: 12,
      reels: Skee.HoleMap.fill_reels(look),
      bulbs: { chase: 0, level: 0.0 },
      waves: []
    }
  end

  fn solid_tokens(s : Skee.Scene.Solid) : List(Float) do
    match s do
    Slab(a, b, c, d) -> [a, b, c, d]
    Drum(a, b) -> [a, b]
    Orb(a) -> [a]
    Hoop(a, b) -> [a, b]
    Card(a, b) -> [a, b]
    Band(a, b) -> [a, b]
    LipArc(_, _, _, _, _) -> []
    end
  end

  fn solid_kind(s : Skee.Scene.Solid) : String do
    match s do
    Slab(_, _, _, _) -> "box"
    Drum(_, _) -> "cylinder"
    Orb(_) -> "sphere"
    Hoop(_, _) -> "torus"
    Card(_, _) -> "plane"
    Band(_, _) -> "tube"
    LipArc(_, _, _, _, _) -> "mesh"
    end
  end

  fn colour_token(c : Option(Skee.Scene.Rgba)) : String do
    match c do
    Some(x) -> int_to_string(x.red * 65536 + x.green * 256 + x.blue)
    None -> "-"
    end
  end

  fn is_coin(p : Skee.Scene.Part) : Bool do
    match p.role do
    CoinPart(_) -> true
    _ -> false
    end
  end

  fn is_halo(p : Skee.Scene.Part) : Bool do
    match p.role do
    HaloPart(_) -> true
    _ -> false
    end
  end

  fn frame_floats(f : Skee.Scene.Frame) : List(Float) do
    [
      f.ax.x,
      f.ax.y,
      f.ax.z,
      f.ay.x,
      f.ay.y,
      f.ay.z,
      f.az.x,
      f.az.y,
      f.az.z,
      f.at.x,
      f.at.y,
      f.at.z
    ]
  end

  fn compare_floats(got : List(Float), want : List(String), tol : Float, what : String) : Outcome do
    if List.length(got) == List.length(want) do
      all(List.zip_with(got, want, fn (g, t) -> near(g, t, tol, what)))
    else
      Mismatch(what ++ ": " ++ int_to_string(List.length(got)) ++ " values, want " ++ int_to_string(List.length(want)))
    end
  end

  fn node_row(p : Skee.Scene.Part, row : List(String)) : Outcome do
    match row do
    Cons(_, Cons(i, Cons(kind, rest))) -> do
      let what = "node " ++ i ++ " " ++ kind
      let dims = List.length(solid_tokens(p.solid))
      let mesh = if kind == "mesh" do 1 else 0 end
      let dim_tokens = List.take(rest, dims + mesh)
      let after = List.drop(rest, dims + mesh)
      match after do
      Cons(colour, Cons(thick, Cons(hidden, Cons(opacity, frame)))) -> do
        let kind_ok = expect_string(solid_kind(p.solid), kind, what ++ " kind")
        let dims_ok =
          if mesh == 1 do
            Passed(1)
          else
            compare_floats(solid_tokens(p.solid), dim_tokens, metres_tol(), what ++ " size")
          end
        let colour_ok =
          if is_halo(p) do
            Passed(0)
          else
            expect_string(colour_token(p.colour), colour, what ++ " colour")
          end
        let thick_ok = near(p.outline, thick, unit_tol(), what ++ " outline")
        let hidden_ok =
          if is_coin(p) do
            Passed(0)
          else
            expect_string(if p.hidden do "1" else "0" end, hidden, what ++ " hidden")
          end
        let opacity_ok = near(p.opacity, opacity, unit_tol(), what ++ " opacity")
        let frame_ok =
          if is_coin(p) do
            Passed(0)
          else
            compare_floats(frame_floats(p.frame), frame, metres_tol(), what ++ " transform")
          end
        all([kind_ok, dims_ok, colour_ok, thick_ok, hidden_ok, opacity_ok, frame_ok])
      end
      _ -> Mismatch("bad node row")
      end
    end
    _ -> Mismatch("bad node row")
    end
  end

  fn room_model(r : Room) : Outcome do
    let parts = Skee.Scene.model(k(), fresh_stage(r))
    let want = List.filter(rows("node"), fn row -> List.take(row, 1) == [room_token(r)])
    let count =
      List.filter(rows("nodecount"), fn row -> List.take(row, 1) == [room_token(r)])
    let count_ok =
      match count do
      Cons(Cons(_, Cons(n, Nil)), Nil) -> do
        expect_int(List.length(parts), GoldenIo.int(n), room_token(r) ++ " node count")
      end
      _ -> Mismatch("no nodecount row")
      end
    if List.length(parts) == List.length(want) do
      all(Cons(count_ok, List.zip_with(parts, want, node_row)))
    else
      Mismatch(room_token(r) ++ ": " ++ int_to_string(List.length(parts)) ++ " parts, Swift has " ++ int_to_string(List.length(want)))
    end
  end

  fn model_cases() : List(Case) do
    List.map(Skee.Rooms.all_rooms(), fn r -> case("Cabinet node tree, " ++ room_token(r), fn () -> room_model(r)))
  end

  -- ---- Cabinet.setReel and lightBulbs ----
  fn look_of(turn : String, glow : String, slot : String, pulse : String) : Skee.Scene.ReelLook do
    {
      symbol: Bell,
      turn: fl(turn),
      glow: fl(glow),
      slot_match: slot == "1",
      pulse: fl(pulse)
    }
  end

  fn reel_parts_for(h : Hole, look : Skee.Scene.ReelLook) : List(Skee.Scene.Part) do
    let st = { fresh_stage(Boardwalk) with reels: Skee.HoleMap.fill_reels(look) }
    List.filter(Skee.Scene.model(k(), st), fn p -> p.role == Skee.Scene.CoinPart(h) || p.role == Skee.Scene.HaloPart(h))
  end

  fn decal_row(row : List(String)) : Outcome do
    match row do
    Cons(h, Cons(turn, Cons(glow, Cons(slot, Cons(pulse, Cons(i, Cons(hidden, Cons(scale, Cons(lx, Cons(ly, Cons(lz, Cons(wx, Cons(wy, Cons(wz, Nil)))))))))))))) -> do
      let hole = hole_of(h)
      let look = look_of(turn, glow, slot, pulse)
      let table = Skee.Rooms.table(k(), Boardwalk)
      let layout = Skee.Scene.reel_layout(k(), table.board, hole)
      let c = Skee.Scene.coin(k(), layout, look, GoldenIo.int(i))
      let what = "decal " ++ h ++ " " ++ i ++ " turn " ++ float_to_string(fl(turn))
      let coins =
        List.filter(reel_parts_for(hole, look), fn p -> p.role == Skee.Scene.CoinPart(hole))
      let world_ok =
        match List.nth_opt(coins, GoldenIo.int(i)) do
        Some(p) -> near3(p.frame.at, wx, wy, wz, metres_tol(), what ++ " world")
        None -> Mismatch(what ++ ": no such coin")
        end
      all([expect_string(if c.coin_hidden do "1" else "0" end, hidden, what ++ " hidden"), near(c.swell, scale, unit_tol(), what ++ " scale"), near3(c.local, lx, ly, lz, metres_tol(), what ++ " local"), world_ok])
    end
    _ -> Mismatch("bad decal row")
    end
  end

  fn halo_row(row : List(String)) : Outcome do
    match row do
    Cons(h, Cons(turn, Cons(glow, Cons(slot, Cons(pulse, Cons(opacity, Cons(colour, Cons(wx, Cons(wy, Cons(wz, Nil)))))))))) -> do
      let hole = hole_of(h)
      let look = look_of(turn, glow, slot, pulse)
      let (o, c) = Skee.Scene.halo(look)
      let halos =
        List.filter(reel_parts_for(hole, look), fn p -> p.role == Skee.Scene.HaloPart(hole))
      let what = "halo " ++ h
      let at_ok =
        match halos do
        Cons(p, Nil) -> do
          all([near3(p.frame.at, wx, wy, wz, metres_tol(), what ++ " world"), near(p.opacity, opacity, unit_tol(), what ++ " part opacity")])
        end
        _ -> Mismatch(what ++ ": want one halo")
        end
      all([near(o, opacity, unit_tol(), what ++ " opacity"), expect_string(colour_token(Some(c)), colour, what ++ " colour"), at_ok])
    end
    _ -> Mismatch("bad halo row")
    end
  end

  fn bulbs_row(row : List(String)) : Outcome do
    match row do
    Cons(phase, Cons(level, lit)) -> do
      let light = { chase: GoldenIo.int(phase), level: fl(level) }
      let st = { fresh_stage(Boardwalk) with bulbs: light }
      let bulbs = List.filter(Skee.Scene.model(k(), st), fn p -> p.role == BulbPart)
      let got = List.map(bulbs, fn p -> p.emission.glow_r)
      compare_floats(got, lit, unit_tol(), "bulbs phase " ++ phase)
    end
    _ -> Mismatch("bad bulbs row")
    end
  end

  fn reel_cases() : List(Case) do
    [
      case("Cabinet.setReel: coins", fn () -> all(List.map(rows("decal"), decal_row))),
      case("Cabinet.setReel: halos", fn () -> all(List.map(rows("halo"), halo_row))),
      case("Cabinet.lightBulbs", fn () -> all(List.map(rows("bulbs"), bulbs_row)))
    ]
  end

  -- ---- ScenePresenter.update replayed frame by frame ----
  fn spark_of(token : String) : List(Skee.Scene.Spark) do
    if token == "hump" do
      [SparkHump]
    else
      if token == "lip" do
        [SparkLip]
      else
        if token == "hop" do
          [SparkHop]
        else
          if token == "landed" do
            [SparkLanded]
          else
            if token == "backwall" do
              [SparkBackwall]
            else
              if token == "rail" do
                [SparkRail]
              else
                if String.starts_with(token, "drop-") do
                  [SparkDrop(hole_of(String.replace_all(token, "drop-", "")))]
                else
                  []
                end
              end
            end
          end
        end
      end
    end
  end

  fn sparks_of(token : String) : List(Skee.Scene.Spark) do
    if token == "-" do
      []
    else
      List.flat_map(String.split(token, ","), spark_of)
    end
  end

  fn sample_or_none(fields : List(String)) : Option(PathSample) do
    match fields do
    Cons(phase, Cons(x, Cons(along, Cons(h, Nil)))) -> if phase == "-" do None else Some(sample_of(phase, x, along, h)) end
    _ -> None
    end
  end

  fn resting_of(fields : List(String)) : Option((PathSample, Float)) do
    match fields do
    Cons(phase, Cons(x, Cons(along, Cons(h, Cons(until, Nil))))) -> do
      if phase == "-" do
        None
      else
        Some((sample_of(phase, x, along, h), fl(until)))
      end
    end
    _ -> None
    end
  end

  fn token_at(row : List(String), i : Int) : String do
    match List.nth_opt(row, i) do
    Some(t) -> t
    None -> "-"
    end
  end

  fn frame_cue(row : List(String)) : Skee.Scene.FrameCue do
    let bc =
      {
        sample: sample_or_none(List.take(List.drop(row, 5), 4)),
        busy: token_at(row, 3) == "1",
        beat_is_roll: token_at(row, 4) == "1",
        resting: resting_of(List.take(List.drop(row, 9), 5)),
        clock: fl(token_at(row, 2)),
        throwing: token_at(row, 14) == "1",
        held: None
      }
    let reel_cue =
      {
        setup: Skee.Types.standard_setup(),
        positions: Skee.HoleMap.fill_reels(0.0),
        have: [],
        slot: None
      }
    {
      ball_cue: bc,
      sparks: sparks_of(token_at(row, 19)),
      kind: ClassicBall,
      anticipation: fl(token_at(row, 16)),
      shake: fl(token_at(row, 17)),
      balls_left: GoldenIo.int(token_at(row, 15)),
      excited: false,
      reel_cue: reel_cue
    }
  end

  -- Tolerance for the roll: 32-bit quaternion products over hundreds of frames.
  fn spin_tol() : Float do
    0.0001
  end

  fn frame_check(s : Skee.Scene.Scenery, row : List(String)) : Outcome do
    let tail = List.drop(row, 20)
    let what = "frame " ++ String.join(List.take(row, 2), " ")
    let b = s.ball
    let q = b.motion.orientation
    let size = b.place.scale *. (1.0 +. 0.35 *. b.motion.pop)
    let sh = b.shadow
    let sq = Skee.Scene.quat_between(v3(0.0, 0.0, 1.0), sh.facing)
    let cam = s.camera.eye
    let got =
      [
        b.place.centre.x,
        b.place.centre.y,
        b.place.centre.z,
        q.qw,
        q.qx,
        q.qy,
        q.qz,
        size
      ]
    let got_shadow =
      [
        sh.spot.x,
        sh.spot.y,
        sh.spot.z,
        sq.qw,
        sq.qx,
        sq.qy,
        sq.qz,
        sh.size,
        sh.fade
      ]
    match tail do
    Cons(px, Cons(py, Cons(pz, Cons(qr, Cons(qx, Cons(qy, Cons(qz, Cons(scale, Cons(hidden, Cons(sx, Cons(sy, Cons(sz, Cons(sr, Cons(sqx, Cons(sqy, Cons(sqz, Cons(ss, Cons(so, Cons(shidden, Cons(waiting, Cons(cx, Cons(cy, Cons(cz, Nil))))))))))))))))))))))) -> do
      all([compare_floats(List.take(got, 3), [px, py, pz], metres_tol(), what ++ " ball"), compare_floats(List.drop(got, 3), [qr, qx, qy, qz, scale], spin_tol(), what ++ " roll"), expect_string(if b.place.visible do "0" else "1" end, hidden, what ++ " ball hidden"), compare_floats(got_shadow, [sx, sy, sz, sr, sqx, sqy, sqz, ss, so], metres_tol(), what ++ " shadow"), expect_string(if sh.shown do "0" else "1" end, shidden, what ++ " shadow hidden"), expect_int(s.waiting, GoldenIo.int(waiting), what ++ " waiting"), near3(cam, cx, cy, cz, metres_tol(), what ++ " camera")])
    end
    _ -> Mismatch("bad frame row")
    end
  end

  -- The roll is checked one frame at a time: each frame starts from Swift's
  -- orientation of the frame before. Where the ball sinks straight into a
  -- hole Swift's roll axis is rounding noise (Skee.Scene.rolls_straight_down,
  -- the port's own test), so those frames are not compared for orientation
  -- and are counted instead. A gutter sink moves along the board's normal,
  -- not the lane's, so it rolls in both and is compared.
  type SceneReplay = {
    rig : Skee.Camera.Rig,
    kept : Skee.Scene.Keep,
    outcomes : List(Outcome),
    worst_spin : Float,
    skipped : Int
  }

  fn swift_orientation(row : List(String)) : Option(Skee.Scene.Quat) do
    match List.drop(row, 23) do
    Cons(qr, Cons(qx, Cons(qy, Cons(qz, _)))) -> Some({ qw: fl(qr), qx: fl(qx), qy: fl(qy), qz: fl(qz) })
    _ -> None
    end
  end

  fn replay_step(acc : SceneReplay, row : List(String)) : SceneReplay do
    let w = boardwalk()
    let (scene, kept) =
      Skee.Scene.present(w, Skee.Rooms.palette(Boardwalk), acc.rig, Skee.Camera.viewport(390.0, 844.0), acc.kept, frame_cue(row), 1.0 /. 60.0)
    let q = scene.ball.motion.orientation
    let sinking =
      match acc.kept.motion.last do
      Some(last) -> do
        scene.ball.place.visible && Skee.Scene.rolls_straight_down(scene.ball.place, minus(scene.ball.place.centre, last))
      end
      None -> false
      end
    let want = swift_orientation(row)
    let off_q =
      match want do
      Some(sq) -> do
        if sinking do
          0.0
        else
          worst([Math.abs(q.qw -. sq.qw), Math.abs(q.qx -. sq.qx), Math.abs(q.qy -. sq.qy), Math.abs(q.qz -. sq.qz)])
        end
      end
      None -> 0.0
      end
    let next_motion =
      match want do
      Some(sq) -> { kept.motion with orientation: sq }
      None -> kept.motion
      end
    let outcome =
      if sinking do
        frame_check({ scene with ball: { scene.ball with motion: { scene.ball.motion with orientation: unwrap_quat(want, q) } } }, row)
      else
        frame_check(scene, row)
      end
    {
      rig: acc.rig,
      kept: { kept with motion: next_motion },
      outcomes: Cons(outcome, acc.outcomes),
      worst_spin: if off_q > acc.worst_spin do off_q else acc.worst_spin end,
      skipped: acc.skipped + count_if(sinking)
    }
  end

  fn count_if(b : Bool) : Int do
    if b do 1 else 0 end
  end

  fn unwrap_quat(q : Option(Skee.Scene.Quat), fallback : Skee.Scene.Quat) : Skee.Scene.Quat do
    match q do
    Some(x) -> x
    None -> fallback
    end
  end

  doc """Frames whose roll is Swift's rounding noise, not compared."""
  fn noise_frames() : Int do
    let r = replayed()
    r.skipped
  end

  -- Before the first recorded frame the pull finished and one idle frame put
  -- the waiting ball at the release spot: that is the last centre the roll
  -- starts from.
  fn replayed() : SceneReplay do
    let w = boardwalk()
    let fresh = Skee.Scene.keep_fresh()
    let spot = plus(lane(w, 0.0, 0.12), times(lane_normal(w), ball_radius(w)))
    let start = { fresh with motion: { fresh.motion with last: Some(spot) } }
    List.fold_left(rows("frame"), { rig: fitted(), kept: start, outcomes: [], worst_spin: 0.0, skipped: 0 }, replay_step)
  end

  doc """Worst quaternion component error over the replay."""
  fn worst_spin() : Float do
    let r = replayed()
    r.worst_spin
  end

  fn presenter_cases() : List(Case) do
    [
      case("ScenePresenter.update over three real throws", fn () -> replay_outcome()),
      case("ScenePresenter.update over a frame: reels, bulbs, rings, aim", fn () -> look_outcome())
    ]
  end

  fn replay_outcome() : Outcome do
    let r = replayed()
    all(List.reverse(r.outcomes))
  end

  -- ---- ScenePresenter.update over a whole frame: reels, bulbs, rings, aim ----
  -- Replay "b" feeds what update reads besides the ball (excited, the
  -- symbols shown so far, the top slot, the reels' positions) and compares
  -- what it set on the cabinet: each reel's shown symbol, halo opacity and
  -- colour, first coin's swell, hiding and emission; every bulb; every ring
  -- of light's scale and opacity; the camera's position and where it looks.
  fn kind_of(token : String) : BallKind do
    match List.find([Marshmallow, ClassicBall, JumpingBean, Wobbler, Comet], fn b -> kind_token(b) == token) do
    Some(b) -> b
    None -> panic("bad golden ball: " ++ token)
    end
  end

  fn kind_token(b : BallKind) : String do
    match b do
    Marshmallow -> "marshmallow"
    ClassicBall -> "classic"
    JumpingBean -> "bean"
    Wobbler -> "wobbler"
    Comet -> "comet"
    end
  end

  fn symbol_token(x : Symbol) : String do
    match x do
    Blank -> "blank"
    Cherry -> "cherry"
    Lemon -> "lemon"
    Bell -> "bell"
    BarSym -> "bar"
    Seven -> "seven"
    Diamond -> "diamond"
    Clover -> "clover"
    end
  end

  fn symbol_of(token : String) : Symbol do
    match List.find([Blank, Cherry, Lemon, Bell, BarSym, Seven, Diamond, Clover], fn x -> symbol_token(x) == token) do
    Some(x) -> x
    None -> panic("bad golden symbol: " ++ token)
    end
  end

  fn symbols_of(token : String) : List(Symbol) do
    if token == "-" do [] else List.map(String.split(token, ","), symbol_of) end
  end

  fn slot_of(token : String) : Option(TopSlot) do
    match symbols_of(token) do
    Cons(a, Cons(b, Cons(c, Nil))) -> Some({ targets: Three(a, b, c) })
    _ -> None
    end
  end

  fn reel_field(row : List(String), hole_index : Int, field : Int) : String do
    token_at(row, 24 + 9 * hole_index + field)
  end

  fn look_positions(row : List(String)) : PerReel(Float) do
    List.fold_left(List.enumerate(Skee.HoleMap.reel_holes()), Skee.HoleMap.fill_reels(0.0), fn (m, e) -> put_position(m, row, e))
  end

  fn put_position(m : PerReel(Float), row : List(String), e : (Int, Hole)) : PerReel(Float) do
    match e do
    (i, h) -> Skee.HoleMap.reel_put(m, h, fl(reel_field(row, i, 0)))
    end
  end

  fn look_cue(row : List(String)) : Skee.Scene.FrameCue do
    let base = frame_cue(row)
    { base with kind: kind_of(token_at(row, 18)), excited: token_at(row, 20) == "1", reel_cue: { setup: Skee.Types.standard_setup(), positions: look_positions(row), have: symbols_of(token_at(row, 21)), slot: slot_of(token_at(row, 22)) } }
  end

  -- Where the camera looks: SceneKit's worldFront after simdLook(at:), a
  -- 32-bit unit vector.
  fn look_tol() : Float do
    0.000002
  end

  fn reel_check(s : Skee.Scene.Scenery, row : List(String), what : String, e : (Int, Hole)) : Outcome do
    match e do
    (i, h) -> do
      let look = Skee.Scene.reel_look_at(s.reels, h)
      let (opacity, colour) = Skee.Scene.halo(look)
      let layout = Skee.Scene.reel_layout(k(), s.world.table.board, h)
      let c = Skee.Scene.coin(k(), layout, look, 0)
      let glow = Skee.Scene.coin_emission(look)
      let w = what ++ " " ++ hole_token(h)
      all([expect_string(symbol_token(look.symbol), reel_field(row, i, 1), w ++ " symbol"), near(opacity, reel_field(row, i, 2), unit_tol(), w ++ " halo opacity"), expect_string(colour_token(Some(colour)), reel_field(row, i, 3), w ++ " halo colour"), near(c.swell, reel_field(row, i, 4), unit_tol(), w ++ " coin swell"), expect_string(if c.coin_hidden do "1" else "0" end, reel_field(row, i, 5), w ++ " coin hidden"), compare_floats([glow.glow_r, glow.glow_g, glow.glow_b], [reel_field(row, i, 6), reel_field(row, i, 7), reel_field(row, i, 8)], unit_tol(), w ++ " coin emission")])
    end
    end
  end

  fn bulb_glow(light_ : Skee.Scene.BulbLight, i : Int) : Float do
    if Skee.Scene.bulb_lit(light_, i) do light_.level else 0.0 end
  end

  fn wave_floats(wv : Skee.Scene.Wave) : List(Float) do
    let (scale, opacity) = Skee.Scene.wave_look(wv)
    [scale, opacity]
  end

  fn look_check(s : Skee.Scene.Scenery, row : List(String), bulbs : List(String), waves : List(String)) : Outcome do
    let what = "look " ++ String.join(List.take(row, 2), " ")
    let cam = s.camera
    let front = unit(minus(cam.target, cam.eye))
    let reels =
      List.map(List.enumerate(Skee.HoleMap.reel_holes()), fn e -> reel_check(s, row, what, e))
    let lit = List.drop(bulbs, 2)
    let got_lit = List.map(List.range(0, List.length(lit)), fn i -> bulb_glow(s.bulbs, i))
    let ring_count = GoldenIo.int(token_at(waves, 2))
    let rings = List.flat_map(s.waves, wave_floats)
    all([expect_string(token_at(row, 23), "1", what ++ " standard setup"), all(reels), expect_int(List.length(lit), List.length(Skee.Scene.bulb_spots(s.world)), what ++ " bulb count"), compare_floats(got_lit, lit, unit_tol(), what ++ " bulbs"), expect_int(List.length(s.waves), ring_count, what ++ " rings of light"), if ring_count == 0 do expect(List.length(rings) == 0, what ++ " no rings") else compare_floats(rings, List.drop(waves, 3), unit_tol(), what ++ " ring scale, opacity") end, near3(cam.eye, token_at(row, 87), token_at(row, 88), token_at(row, 89), metres_tol(), what ++ " camera"), near3(front, token_at(row, 90), token_at(row, 91), token_at(row, 92), look_tol(), what ++ " camera looks")])
  end

  -- What replay "b" went through, so a path it never reaches shows up.
  type LookSeen = {
    glow_one : Int,
    glow_two : Int,
    flashed : Int,
    slot_halo : Int,
    excited : Int,
    leaning : Int,
    rings : Int
  }

  type LookReplay = {
    world : World,
    rig : Skee.Camera.Rig,
    kept : Skee.Scene.Keep,
    outcomes : List(Outcome),
    seen : LookSeen
  }

  fn some_reel(s : Skee.Scene.Scenery, test : Skee.Scene.ReelLook -> Bool) : Int do
    count_if(List.any(List.map(Skee.HoleMap.reel_holes(), fn h -> Skee.Scene.reel_look_at(s.reels, h)), test))
  end

  fn is_glow_one(l : Skee.Scene.ReelLook) : Bool do
    l.glow == 1.0
  end

  fn is_glow_two(l : Skee.Scene.ReelLook) : Bool do
    l.glow == 2.0
  end

  fn is_flashed(l : Skee.Scene.ReelLook) : Bool do
    l.pulse > 1.0
  end

  fn is_slot_halo(l : Skee.Scene.ReelLook) : Bool do
    l.glow == 0.0 && l.slot_match
  end

  fn saw(seen : LookSeen, s : Skee.Scene.Scenery, c : Skee.Scene.FrameCue, lean : Float) : LookSeen do
    {
      glow_one: seen.glow_one + some_reel(s, is_glow_one),
      glow_two: seen.glow_two + some_reel(s, is_glow_two),
      flashed: seen.flashed + some_reel(s, is_flashed),
      slot_halo: seen.slot_halo + some_reel(s, is_slot_halo),
      excited: seen.excited + count_if(c.excited),
      leaning: seen.leaning + count_if(lean > 0.0),
      rings: seen.rings + count_if(List.length(s.waves) > 0)
    }
  end

  fn look_step(acc : LookReplay, rows3 : (List(String), (List(String), List(String)))) : LookReplay do
    match rows3 do
    (row, (bulbs, waves)) -> do
      let cue = look_cue(row)
      let (scene, kept) =
        Skee.Scene.present(acc.world, Skee.Rooms.palette(Boardwalk), acc.rig, Skee.Camera.viewport(390.0, 844.0), acc.kept, cue, 1.0 /. 60.0)
      {
        world: acc.world,
        rig: acc.rig,
        kept: kept,
        outcomes: Cons(look_check(scene, row, bulbs, waves), acc.outcomes),
        seen: saw(acc.seen, scene, cue, kept.lean)
      }
    end
    end
  end

  fn look_replayed() : LookReplay do
    let w = boardwalk()
    let fresh = Skee.Scene.keep_fresh()
    let spot = plus(lane(w, 0.0, 0.12), times(lane_normal(w), ball_radius(w)))
    let start = { fresh with motion: { fresh.motion with last: Some(spot) } }
    let none =
      {
        glow_one: 0,
        glow_two: 0,
        flashed: 0,
        slot_halo: 0,
        excited: 0,
        leaning: 0,
        rings: 0
      }
    let inputs = List.zip(rows("look"), List.zip(rows("lookbulbs"), rows("lookwaves")))
    List.fold_left(inputs, { world: w, rig: fitted(), kept: start, outcomes: [], seen: none }, look_step)
  end

  fn look_outcome() : Outcome do
    let r = look_replayed()
    let n = r.seen
    let covered =
      [
        expect(n.glow_one > 0, "replay b never glows a reel once"),
        expect(n.glow_two > 0, "replay b never glows a reel twice"),
        expect(n.flashed > 0, "replay b never flashes a hole"),
        expect(n.slot_halo > 0, "replay b never shows a slot match"),
        expect(n.excited > 0, "replay b is never excited"),
        expect(n.leaning > 0, "replay b never leans"),
        expect(n.rings > 0, "replay b has no rings of light")
      ]
    all(List.concat([[expect_int(List.length(r.outcomes), List.length(rows("lookwaves")), "every look row replayed")], covered, List.reverse(r.outcomes)]))
  end

  doc """How many frames of replay b reached each path, printed by the runner."""
  fn look_seen() : String do
    let r = look_replayed()
    let n = r.seen
    "glow1 " ++ int_to_string(n.glow_one) ++ ", glow2 " ++ int_to_string(n.glow_two) ++ ", flash " ++ int_to_string(n.flashed) ++ ", slot " ++ int_to_string(n.slot_halo) ++ ", excited " ++ int_to_string(n.excited) ++ ", leaning " ++ int_to_string(n.leaning) ++ ", rings " ++ int_to_string(n.rings)
  end

  -- ---- Drawing ----
  fn finite(x : Float) : Bool do
    x == x && x < 100000000.0 && x > -100000000.0
  end

  fn shape_points(sh : Skee.Scene.Shape) : List(Vec2) do
    match sh do
    Poly(ps) -> ps
    Holed(a, b) -> List.append(a, b)
    Polys(rs) -> List.concat(rs)
    Disc(c, _) -> [c]
    Outline(steps) -> List.flat_map(steps, step_pts)
    end
  end

  fn step_pts(s : Skee.Scene.PathStep) : List(Vec2) do
    match s do
    MoveTo(a) -> [a]
    LineTo(a) -> [a]
    QuadTo(a, b) -> [a, b]
    CubicTo(a, b, c) -> [a, b, c]
    ClosePath -> []
    end
  end

  fn op_points(op : Skee.Scene.DrawOp) : List(Vec2) do
    match op do
    ClearTo(_) -> []
    FillShape(sh, _, _) -> shape_points(sh)
    StrokeShape(sh, _, _) -> shape_points(sh)
    DrawText(t) -> [t.middle]
    PushClip(sh) -> shape_points(sh)
    PopClip -> []
    end
  end

  fn polys_ok(op : Skee.Scene.DrawOp) : Bool do
    match op do
    FillShape(Poly(ps), _, _) -> List.length(ps) >= 3
    _ -> true
    end
  end

  fn clip_depth(ops : List(Skee.Scene.DrawOp)) : (Int, Bool) do
    List.fold_left(ops, (0, true), fn (acc, op) -> clip_step(acc, op))
  end

  fn clip_step(acc : (Int, Bool), op : Skee.Scene.DrawOp) : (Int, Bool) do
    match acc do
    (d, ok) -> do
      match op do
      PushClip(_) -> (d + 1, ok)
      PopClip -> (d - 1, ok && d > 0)
      _ -> (d, ok)
      end
    end
    end
  end

  -- The fresh cabinet with the ball somewhere along a real path.
  fn stage_at(sample : Option(PathSample), resting : Option((PathSample, Float)), clock : Float) : Skee.Scene.Scenery do
    let w = boardwalk()
    let bc =
      {
        sample: sample,
        busy: true,
        beat_is_roll: true,
        resting: resting,
        clock: clock,
        throwing: true,
        held: None
      }
    let cue =
      {
        ball_cue: { bc with busy: no_rest(resting), beat_is_roll: no_rest(resting) },
        sparks: [SparkHump, SparkDrop(Ring40)],
        kind: ClassicBall,
        anticipation: 0.0,
        shake: 0.0,
        balls_left: 8,
        excited: true,
        reel_cue: {
          setup: Skee.Types.standard_setup(),
          positions: Skee.HoleMap.fill_reels(1.0),
          have: [Cherry, Cherry],
          slot: None
        }
      }
    let (scene, _) =
      Skee.Scene.present(w, Skee.Rooms.palette(Boardwalk), fitted(), Skee.Camera.viewport(390.0, 844.0), Skee.Scene.keep_fresh(), cue, 1.0 /. 60.0)
    scene
  end

  -- What a new run shows before its first pull: the ball waiting, nothing lit.
  fn idle_stage() : Skee.Scene.Scenery do
    let w = boardwalk()
    let bc =
      {
        sample: None,
        busy: false,
        beat_is_roll: false,
        resting: None,
        clock: 0.05,
        throwing: true,
        held: None
      }
    let cue =
      {
        ball_cue: bc,
        sparks: [],
        kind: ClassicBall,
        anticipation: 0.0,
        shake: 0.0,
        balls_left: 9,
        excited: false,
        reel_cue: {
          setup: Skee.Types.standard_setup(),
          positions: Skee.HoleMap.fill_reels(0.0),
          have: [],
          slot: None
        }
      }
    let (scene, _) =
      Skee.Scene.present(w, Skee.Rooms.palette(Boardwalk), fitted(), Skee.Camera.viewport(390.0, 844.0), Skee.Scene.keep_fresh(), cue, 1.0 /. 60.0)
    scene
  end

  fn no_rest(r : Option((PathSample, Float))) : Bool do
    match r do
    Some(_) -> false
    None -> true
    end
  end

  fn stages() : List((String, Skee.Scene.Scenery)) do
    [
      ("waiting", stage_at(None, None, 0.0)),
      ("on the lane", stage_at(Some(sample_n(1)), None, 1.0)),
      ("in the air", stage_at(Some(sample_n(4)), None, 2.0)),
      ("on the board", stage_at(Some(sample_n(6)), None, 3.0)),
      ("sinking", stage_at(Some(sample_n(6)), Some((sample_n(6), 3.4)), 3.0)),
      ("idle, as a new run opens", idle_stage())
    ]
  end

  fn draw_case(named : (String, Skee.Scene.Scenery)) : Outcome do
    match named do
    (name, scene) -> do
      let ops = Skee.Scene.draw(k(), scene)
      let n = List.length(ops)
      let pts = List.flat_map(ops, op_points)
      let (depth, nested) = clip_depth(ops)
      let first_ok =
        match ops do
        Cons(ClearTo(c), _) -> c.red == 255 && c.green == 233 && c.blue == 246
        _ -> false
        end
      all([expect(n > 300 && n < 2000, name ++ ": " ++ int_to_string(n) ++ " ops, want 300 to 2000"), expect(List.all(pts, fn p -> finite(p.x) && finite(p.y)), name ++ ": every point finite"), expect(List.all(ops, polys_ok), name ++ ": every polygon has 3 points"), expect(depth == 0 && nested, name ++ ": clips balanced"), expect(first_ok, name ++ ": cleared to the backdrop")])
    end
    end
  end

  fn sink_clip_case() : Outcome do
    let sunk =
      Skee.Scene.draw(k(), stage_at(Some(sample_n(6)), Some((sample_n(6), 3.4)), 3.0))
    let rolling = Skee.Scene.draw(k(), stage_at(Some(sample_n(6)), None, 3.0))
    all([expect(clip_count(sunk) > clip_count(rolling), "a sinking ball is clipped to its hole")])
  end

  fn clip_count(ops : List(Skee.Scene.DrawOp)) : Int do
    List.length(List.filter(ops, is_push))
  end

  fn is_push(op : Skee.Scene.DrawOp) : Bool do
    match op do
    PushClip(_) -> true
    _ -> false
    end
  end

  fn light_case() : Outcome do
    let up = v3(0.0, 1.0, 0.0)
    let l = Skee.Scene.light(up, up)
    let down = Skee.Scene.light(v3(0.0, -1.0, 0.0), v3(0.0, -1.0, 0.0))
    let grey = Skee.Scene.hex(8421504)
    let lit_up = Skee.Scene.shade(grey, l)
    let lit_down = Skee.Scene.shade(grey, down)
    let unlit = Skee.Scene.shade(grey, Skee.Scene.unlit())
    let white = white_lit(l)
    let edge_on = Skee.Scene.light(up, v3(1.0, 0.0, 0.0))
    all([expect(edge_on.rim > 0.27, "a face seen edge-on gets the rim band"), expect(l.rim == 0.0, "a face seen square-on gets none"), expect(lit_up.red > lit_down.red, "faces toward the sun are brighter"), expect(unlit.red == 128 && unlit.green == 128 && unlit.blue == 128, "unlit keeps the colour"), expect(l.lb > l.lg && down.lb > down.lr, "the sky fill is pink-white, the ground fill lilac"), expect(white.red == 255, "white saturates")])
  end

  fn white_lit(l : Skee.Scene.Light) : Skee.Scene.Rgba do
    Skee.Scene.shade(Skee.Scene.hex(16777215), l)
  end

  fn symbol_case() : Outcome do
    let l = Skee.Scene.unlit()
    let o = vec2(0.0, 0.0)
    all([expect(List.length(Skee.Scene.symbol_ops(l, o, 100.0, Blank)) == 0, "a blank draws nothing"), expect(List.length(Skee.Scene.symbol_ops(l, o, 100.0, Seven)) == 1, "a seven is one outlined glyph"), expect(List.length(Skee.Scene.symbol_ops(l, o, 100.0, Cherry)) > 6, "a cherry has stems, a leaf and two fruit")])
  end

  fn css_case() : Outcome do
    let c = Skee.Scene.with_alpha(Skee.Scene.hex(3810118), 0.55)
    all([expect_string(Skee.Scene.css(c), "rgba(58,35,70,0.550)", "css colour"), expect_string(Skee.Scene.css(Skee.Scene.hex(16777215)), "rgba(255,255,255,1)", "opaque css colour"), expect_string(Skee.Scene.css_number(112.0), "112", "whole css number"), expect_string(Skee.Scene.css_number(-3.456), "-3.46", "css number")])
  end

  fn hull_case() : Outcome do
    let h =
      Skee.Scene.hull([vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.5, 0.5), vec2(1.0, 1.0), vec2(0.0, 1.0)])
    expect_int(List.length(h), 4, "hull drops the inside point")
  end

  -- A new run's Presentation through the bridge: the ball waits on the lane,
  -- one in hand and the rest in the trough.
  fn bridge_case() : Outcome do
    let run =
      Skee.Reducer.new_run(k(), Skee.U64.make(0, 7), Skee.Types.standard_config(), Boardwalk, Tickets(0))
    let p = Skee.Presentation.make(run)
    let cue = Skee.SceneCue.frame_cue(k(), p, None)
    let w = boardwalk()
    let (scene, _) =
      Skee.Scene.present(w, Skee.Rooms.palette(Boardwalk), fitted(), Skee.Camera.viewport(390.0, 844.0), Skee.Scene.keep_fresh(), cue, 1.0 /. 60.0)
    let spot = plus(lane(w, 0.0, 0.12), times(lane_normal(w), ball_radius(w)))
    let ops = Skee.Scene.draw(k(), scene)
    all([expect(scene.ball.place.visible, "the waiting ball shows"), expect(length3(minus(scene.ball.place.centre, spot)) < 0.000001, "at the release spot"), expect_int(scene.waiting, Skee.Reducer.balls_left(run.round) - 1, "the rest wait in the trough"), expect(List.length(cue.sparks) == 0, "no sparks yet"), expect(List.length(ops) > 300, "the cabinet draws")])
  end

  -- Textures.lane's boards, read off the real texture as 8-bit sRGB: each
  -- board's commonest pixel. The port's tone is rounded the same way.
  fn lane_tone_case() : Outcome do
    let tones = Skee.Scene.lane_plank_tones(k())
    let want = rows("lanetone")
    all(Cons(expect_int(List.length(tones), List.length(want), "nine boards"), List.zip_with(tones, want, lane_tone_row)))
  end

  fn lane_tone_row(c : Skee.Scene.Rgba, row : List(String)) : Outcome do
    match row do
    Cons(i, Cons(r, Cons(g, Cons(b, Nil)))) -> do
      let what = "board " ++ i
      all([within_one(c.red, r, what ++ " red"), within_one(c.green, g, what ++ " green"), within_one(c.blue, b, what ++ " blue")])
    end
    _ -> Mismatch("bad lanetone row")
    end
  end

  -- CoreGraphics rounds its 8-bit channels its own way: one step either side.
  fn within_one(got : Int, token : String, what : String) : Outcome do
    let d = got - GoldenIo.int(token)
    expect(d <= 1 && d >= -1, what ++ ": got " ++ int_to_string(got) ++ ", want " ++ token)
  end

  fn draw_cases() : List(Case) do
    List.concat([List.map(stages(), fn st -> case("draw: " ++ Tuple.first(st), fn () -> draw_case(st))), [case("draw: a sinking ball is clipped", fn () -> sink_clip_case()), case("toon light", fn () -> light_case()), case("symbols", fn () -> symbol_case()), case("silhouette hull", fn () -> hull_case()), case("CSS text for colours and fonts", fn () -> css_case()), case("Textures.lane: every board's tone", fn () -> lane_tone_case()), case("Presentation to scene, through Skee.SceneCue", fn () -> bridge_case())]])
  end

  -- ---- Measured error, printed by the runner ----
  fn off(actual : Float, token : String) : Float do
    Math.abs(actual -. fl(token))
  end

  fn worst(xs : List(Float)) : Float do
    List.fold_left(xs, 0.0, fn (a, b) -> if b > a do b else a end)
  end

  fn proj_off(rig : Skee.Camera.Rig, row : List(String)) : List(Float) do
    match row do
    Cons(w, Cons(h, Cons(name, Cons(px, Cons(py, Nil))))) -> do
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      let p = Skee.Camera.pixel(k(), l, proj_point(boardwalk(), name))
      [off(p.x, px), off(p.y, py)]
    end
    _ -> []
    end
  end

  fn lane_off(row : List(String)) : List(Float) do
    match row do
    Cons(r, Cons(x, Cons(s, Cons(px, Cons(py, Cons(pz, Nil)))))) -> do
      let p = lane(world_of(r), fl(x), fl(s))
      [off(p.x, px), off(p.y, py), off(p.z, pz)]
    end
    _ -> []
    end
  end

  fn ball_off(row : List(String)) : List(Float) do
    match row do
    Cons(r, Cons(phase, Cons(x, Cons(along, Cons(height, Cons(_, Cons(cx, Cons(cy, Cons(cz, Cons(_, Cons(_, Cons(_, Nil)))))))))))) -> do
      let c = ball_center(world_of(r), sample_of(phase, x, along, height))
      [off(c.x, cx), off(c.y, cy), off(c.z, cz)]
    end
    _ -> []
    end
  end

  doc """Worst pixel error over every projected golden point, every viewport."""
  fn worst_pixels() : Float do
    let rig = fitted()
    worst(List.flat_map(rows("proj"), fn r -> proj_off(rig, r)))
  end

  doc """Worst position error in metres over the lane and ball-centre goldens."""
  fn worst_metres() : Float do
    worst(List.append(List.flat_map(rows("lane"), lane_off), List.flat_map(rows("ball"), ball_off)))
  end

  fn cases() : List(Case) do
    let rig = fitted()
    List.concat([world_cases(), camera_cases(rig), model_cases(), reel_cases(), presenter_cases(), draw_cases()])
  end

end
