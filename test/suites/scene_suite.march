mod SceneSuite do

  -- The scene piece: Skee.World, Skee.Camera and Skee.Scene. Golden rows come
  -- from the real SkeeScene (tools/golden_scene). SkeeScene computes in 32-bit
  -- Float and this port in 64-bit, so values are compared within a tolerance
  -- stated next to each reader, and the worst measured error is printed.
  import Harness
  import Skee.Maths
  import Skee.World

  fn rows(kind : String) : List(List(String)) do
    GoldenIo.of_kind(GoldenIo.rows(Golden.Scene.chunks()), kind)
  end

  fn k() : Skee.Consts.Consts do
    Skee.Consts.make()
  end

  fn fl(token : String) : Float do
    GoldenIo.float_of_bits(token)
  end

  -- Tolerances. Float32 carries 24 bits: a scene coordinate near 3 m is good
  -- to about 2.4e-7 m, and a few roundings stack. Pixels are fractions of a
  -- 1920-pixel screen through a 32-bit projection.
  fn metres_tol() : Float do
    0.000001
  end

  fn pixels_tol() : Float do
    0.001
  end

  -- A lane point is a 32-bit ray cast about a metre: measured worst 1.43e-6 m.
  fn ray_tol() : Float do
    0.000002
  end

  fn unit_tol() : Float do
    0.000001
  end

  fn near(actual : Float, token : String, tol : Float, what : String) : Outcome do
    let want = fl(token)
    let d = Math.abs(actual -. want)
    if d <= tol do
      Passed(1)
    else
      Mismatch(what ++ ": got " ++ float_to_string(actual) ++ ", want " ++ float_to_string(want) ++ " (off " ++ float_to_string(d) ++ ")")
    end
  end

  fn near3(p : Vec3, x : String, y : String, z : String, tol : Float, what : String) : Outcome do
    all([near(p.x, x, tol, what ++ ".x"), near(p.y, y, tol, what ++ ".y"), near(p.z, z, tol, what ++ ".z")])
  end

  fn near2(p : Vec2, x : String, y : String, tol : Float, what : String) : Outcome do
    all([near(p.x, x, tol, what ++ ".x"), near(p.y, y, tol, what ++ ".y")])
  end

  fn room_of(token : String) : Room do
    match List.find(Skee.Rooms.all_rooms(), fn r -> room_token(r) == token) do
    Some(r) -> r
    None -> panic("bad golden room: " ++ token)
    end
  end

  fn room_token(r : Room) : String do
    match r do
    Boardwalk -> "boardwalk"
    NeonLounge -> "neonLounge"
    HighRoller -> "highRoller"
    Penthouse -> "penthouse"
    end
  end

  fn world_of(token : String) : World do
    Skee.World.make(k(), Skee.Rooms.table(k(), room_of(token)))
  end

  fn phase_of(token : String) : PathPhase do
    if token == "lane" do OnLane else if token == "air" do InAir else OnBoard end end
  end

  fn hole_of(token : String) : Hole do
    match List.find(Skee.HoleMap.all_holes(), fn h -> hole_token(h) == token) do
    Some(h) -> h
    None -> panic("bad golden hole: " ++ token)
    end
  end

  fn hole_token(h : Hole) : String do
    match h do
    Gutter -> "gutter"
    Ring10 -> "ring10"
    Ring20 -> "ring20"
    Ring30 -> "ring30"
    Ring40 -> "ring40"
    Ring50 -> "ring50"
    PocketLeft -> "pocketLeft"
    PocketRight -> "pocketRight"
    end
  end

  -- ---- World ----
  fn world_row(row : List(String)) : Outcome do
    match row do
    [r, length, br, nx, ny, nz, fx, fy, fz, ox, oy, oz, ux, uy, uz, nbx, nby, nbz] -> do
      let w = world_of(r)
      all([near(lane_length(w), length, metres_tol(), r ++ " laneLength"), near(ball_radius(w), br, metres_tol(), r ++ " ballRadius"), near3(lane_normal(w), nx, ny, nz, unit_tol(), r ++ " laneNormal"), near3(lane_forward(w), fx, fy, fz, unit_tol(), r ++ " laneForward"), near3(board_origin(w), ox, oy, oz, metres_tol(), r ++ " boardOrigin"), near3(board_up(w), ux, uy, uz, unit_tol(), r ++ " boardUp"), near3(board_normal(w), nbx, nby, nbz, unit_tol(), r ++ " boardNormal")])
    end
    _ -> Mismatch("bad world row")
    end
  end

  fn lane_row(row : List(String)) : Outcome do
    match row do
    [r, x, s, px, py, pz] -> near3(lane(world_of(r), fl(x), fl(s)), px, py, pz, metres_tol(), r ++ " lane " ++ x ++ " " ++ s)
    _ -> Mismatch("bad lane row")
    end
  end

  fn board_row(row : List(String)) : Outcome do
    match row do
    [r, x, y, z, px, py, pz] -> near3(board(world_of(r), vec2(fl(x), fl(y)), fl(z)), px, py, pz, metres_tol(), r ++ " board")
    _ -> Mismatch("bad board row")
    end
  end

  fn sample_of(phase : String, x : String, along : String, height : String) : PathSample do
    { t: 0.0, phase: phase_of(phase), px: fl(x), along: fl(along), height: fl(height) }
  end

  fn ball_row(row : List(String)) : Outcome do
    match row do
    [r, phase, x, along, height, scale, cx, cy, cz, nx, ny, nz] -> do
      let w = world_of(r)
      let s = sample_of(phase, x, along, height)
      all([near(ball_scale(w, s), scale, unit_tol(), r ++ " ballScale"), near3(ball_center(w, s), cx, cy, cz, metres_tol(), r ++ " ballCenter"), near3(surface_normal(w, s), nx, ny, nz, unit_tol(), r ++ " surfaceNormal")])
    end
    _ -> Mismatch("bad ball row")
    end
  end

  -- ---- Camera ----
  fn boardwalk() : World do
    world_of("boardwalk")
  end

  fn fitted() : Skee.Camera.Rig do
    Skee.Camera.fit_world(k(), boardwalk())
  end

  fn view_of(w : String, h : String) : Skee.Camera.Viewport do
    Skee.Camera.viewport(int_to_float(GoldenIo.int(w)), int_to_float(GoldenIo.int(h)))
  end

  fn framing_row(row : List(String)) : Outcome do
    match row do
    [nx, ny, nz, hx, hy, hz, tx, ty, tz] -> do
      let f = Skee.Camera.framing(boardwalk())
      all([near3(f.near_point, nx, ny, nz, metres_tol(), "near"), near3(f.hump_point, hx, hy, hz, metres_tol(), "hump"), near3(f.top_point, tx, ty, tz, metres_tol(), "top")])
    end
    _ -> Mismatch("bad framing row")
    end
  end

  fn fit_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, ex, ey, ez, tx, ty, tz, fov] -> do
      let what = "fit " ++ w ++ "x" ++ h
      all([near3(rig.eye, ex, ey, ez, metres_tol(), what ++ " eye"), near3(rig.target, tx, ty, tz, metres_tol(), what ++ " target"), near(rig.fov, fov, unit_tol(), what ++ " fov")])
    end
    _ -> Mismatch("bad fit row")
    end
  end

  fn proj_point(w : World, name : String) : Vec3 do
    let span = w.table.lane.length
    let hw = w.table.lane.width /. 2.0
    let f = Skee.Camera.framing(w)
    if name == "laneNearLeft" do
      lane(w, -hw, 0.0)
    else if name == "laneNearRight" do
      lane(w, hw, 0.0)
    else if name == "laneFarLeft" do
      lane(w, -hw, span)
    else if name == "laneFarRight" do
      lane(w, hw, span)
    else if name == "hump" do
      f.hump_point
    else if name == "near" do
      f.near_point
    else if name == "top" do
      f.top_point
    else if String.starts_with(name, "sample") do
      ball_center(w, sample_n(GoldenIo.int(String.replace_all(name, "sample", ""))))
    else
      board(w, Skee.Physics.hole_center(w.table.board, hole_of(name)), 0.0)
    end end end end end end end end
  end

  -- The samples golden-scene projects, in its order.
  fn samples() : List(PathSample) do
    [
      sample_of_floats(OnLane, 0.0, 0.0, 0.0),
      sample_of_floats(OnLane, -0.21, 0.7, 0.0),
      sample_of_floats(OnLane, 0.25, 2.4, 0.0),
      sample_of_floats(InAir, 0.05, 2.45, 0.04),
      sample_of_floats(InAir, -0.1, 2.52, 0.11),
      sample_of_floats(OnBoard, 0.12, 2.65, 0.002),
      sample_of_floats(OnBoard, 0.0, 2.9, 0.0),
      sample_of_floats(OnBoard, -0.2, 3.26, 0.0)
    ]
  end

  fn sample_of_floats(p : PathPhase, x : Float, along : Float, h : Float) : PathSample do
    { t: 0.0, phase: p, px: x, along: along, height: h }
  end

  fn sample_n(n : Int) : PathSample do
    match List.nth_opt(samples(), n) do
    Some(s) -> s
    None -> panic("no sample " ++ int_to_string(n))
    end
  end

  fn proj_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, name, px, py] -> do
      let world = boardwalk()
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      near2(Skee.Camera.pixel(k(), l, proj_point(world, name)), px, py, pixels_tol(), w ++ "x" ++ h ++ " " ++ name)
    end
    _ -> Mismatch("bad proj row")
    end
  end

  fn holes_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, name, px, py] -> do
      let spots = Skee.Camera.hole_on_screen(k(), boardwalk(), rig, view_of(w, h))
      if List.any(Skee.HoleMap.all_holes(), fn x -> hole_token(x) == name) do
        near2(Skee.HoleMap.at(spots, hole_of(name)), px, py, pixels_tol(), "holeOnScreen " ++ name)
      else
        Passed(0)
      end
    end
    _ -> Mismatch("bad proj row")
    end
  end

  fn flick_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, crease, cx, half, give] -> do
      let g = Skee.Camera.flick_geometry(k(), boardwalk(), rig, view_of(w, h))
      let what = "flick " ++ w ++ "x" ++ h
      all([near(g.crease_y, crease, pixels_tol(), what ++ " creaseY"), near(g.lane_center_x, cx, pixels_tol(), what ++ " laneCenterX"), near(g.lane_half_width, half, pixels_tol(), what ++ " laneHalfWidth"), near(g.foul_give, give, 0.0, what ++ " foulGive")])
    end
    _ -> Mismatch("bad flick row")
    end
  end

  fn guide_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    Cons(w, Cons(h, Cons(line, coords))) -> do
      let pts = Skee.Camera.guide(k(), boardwalk(), rig, view_of(w, h), fl(line))
      let got = List.flat_map(pts, fn p -> [p.x, p.y])
      if List.length(got) == List.length(coords) do
        all(List.zip_with(got, coords, fn (g, c) -> near(g, c, pixels_tol(), "guide " ++ w ++ "x" ++ h ++ " line " ++ line)))
      else
        Mismatch("guide length")
      end
    end
    _ -> Mismatch("bad guide row")
    end
  end

  fn waiting_row(row : List(String)) : Outcome do
    match row do
    [line, x, y, z] -> near3(Skee.Camera.waiting_ball(boardwalk(), fl(line)), x, y, z, metres_tol(), "waitingBall " ++ line)
    _ -> Mismatch("bad waiting row")
    end
  end

  fn lane_point_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, fx, fy, hit, x, y, z] -> do
      let got = Skee.Camera.lane_point(k(), boardwalk(), rig, view_of(w, h), vec2(fl(fx), fl(fy)))
      match got do
      Some(p) -> if hit == "1" do near3(p, x, y, z, ray_tol(), "lanePoint") else Mismatch("lanePoint hit, Swift missed") end
      None -> Mismatch("lanePoint missed, Swift hit")
      end
    end
    [w, h, fx, fy, _] -> do
      match Skee.Camera.lane_point(k(), boardwalk(), rig, view_of(w, h), vec2(fl(fx), fl(fy))) do
      Some(_) -> Mismatch("lanePoint hit, Swift missed")
      None -> Passed(1)
      end
    end
    _ -> Mismatch("bad lanepoint row")
    end
  end

  fn lane_coords_row(row : List(String)) : Outcome do
    match row do
    [px, py, pz, x, s] -> do
      let (gx, gs) = Skee.Camera.lane_coordinates(boardwalk(), v3(fl(px), fl(py), fl(pz)))
      all([near(gx, x, metres_tol(), "laneCoordinates x"), near(gs, s, metres_tol(), "laneCoordinates s")])
    end
    _ -> Mismatch("bad lanecoords row")
    end
  end

  fn ray_row(rig : Skee.Camera.Rig, row : List(String)) : Outcome do
    match row do
    [w, h, ox, oy, oz, dx, dy, dz] -> do
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      let (o, d) = Skee.Camera.ray(l, vec2(0.3, 0.6))
      all([near3(o, ox, oy, oz, metres_tol(), "ray origin"), near3(d, dx, dy, dz, unit_tol(), "ray direction")])
    end
    _ -> Mismatch("bad ray row")
    end
  end

  fn camera0_row(row : List(String)) : Outcome do
    match row do
    [_, x, y, z, fov] -> do
      let r = Skee.Camera.initial()
      all([near3(r.eye, x, y, z, metres_tol(), "initial camera"), near(r.fov, fov, 0.0, "initial fov")])
    end
    _ -> Mismatch("bad camera0 row")
    end
  end

  fn tap_case() : Outcome do
    let w = boardwalk()
    let rig = fitted()
    let v = Skee.Camera.viewport(390.0, 844.0)
    let spots = Skee.Camera.hole_on_screen(k(), w, rig, v)
    let at50 = spots.ring50
    let near50 = Skee.Camera.tapped_hole(k(), w, rig, v, vec2(at50.x +. 3.0, at50.y -. 2.0))
    let far = Skee.Camera.tapped_hole(k(), w, rig, v, vec2(5.0, 840.0))
    let gutter = Skee.Camera.tapped_hole(k(), w, rig, v, spots.gutter)
    all([expect(near50 == Some(Ring50), "tap by the 50 picks the 50"), expect(far == None, "a tap far from every hole picks none"), expect(gutter != Some(Gutter), "the gutter is never a target")])
  end

  fn lean_case() : Outcome do
    let w = boardwalk()
    let rig = fitted()
    let still = Skee.Camera.framed(w, rig, 0.0, 0.0, 3.0)
    let up = Skee.Camera.lean_step(0.0, 1.0, 0.1)
    let down = Skee.Camera.lean_step(1.0, 0.0, 0.1)
    let big = Skee.Camera.lean_step(0.2, 1.0, 1.0)
    all([expect(Skee.World.length3(Skee.World.minus(still.eye, rig.eye)) == 0.0, "no lean, no shake: the fitted rig"), expect(Math.abs(up -. 0.5) < 0.0000001, "lean eases in at 5 per second"), expect(Math.abs(down -. 0.75) < 0.0000001, "lean eases out at 2.5 per second"), expect(big == 1.0, "a long frame lands on the target")])
  end

  fn world_cases() : List(Case) do
    [
      case("World constants, every room", fn () -> all(List.map(rows("world"), world_row))),
      case("World.lane", fn () -> all(List.map(rows("lane"), lane_row))),
      case("World.board", fn () -> all(List.map(rows("board"), board_row))),
      case("World.ballCenter, ballScale, surfaceNormal", fn () -> all(List.map(rows("ball"), ball_row)))
    ]
  end

  fn camera_cases(rig : Skee.Camera.Rig) : List(Case) do
    [
      case("Cabinet.framingPoints", fn () -> all(List.map(rows("framing"), framing_row))),
      case("Cabinet.fit, every viewport", fn () -> all(List.map(rows("fit"), fn r -> fit_row(rig, r)))),
      case("projected points, every viewport", fn () -> all(List.map(rows("proj"), fn r -> proj_row(rig, r)))),
      case("hole_on_screen, every viewport", fn () -> all(List.map(rows("proj"), fn r -> holes_row(rig, r)))),
      case("flickGeometry, every viewport", fn () -> all(List.map(rows("flick"), fn r -> flick_row(rig, r)))),
      case("guide, every viewport", fn () -> all(List.map(rows("guide"), fn r -> guide_row(rig, r)))),
      case("waitingBall", fn () -> all(List.map(rows("waiting"), waiting_row))),
      case("lanePoint", fn () -> all(List.map(rows("lanepoint"), fn r -> lane_point_row(rig, r)))),
      case("laneCoordinates", fn () -> all(List.map(rows("lanecoords"), lane_coords_row))),
      case("CameraRig.ray", fn () -> all(List.map(rows("ray"), fn r -> ray_row(rig, r)))),
      case("the camera before a fit", fn () -> all(List.map(rows("camera0"), camera0_row))),
      case("tapBoard picks the nearest reel hole within 44 px", fn () -> tap_case()),
      case("camera lean and shake", fn () -> lean_case())
    ]
  end

  -- ---- The cabinet model against the real node tree ----
  fn fresh_stage(r : Room) : Skee.Scene.Scenery do
    let w = Skee.World.make(k(), Skee.Rooms.table(k(), r))
    let rad = ball_radius(w)
    let place = { centre: plus(lane(w, 0.0, 0.15), times(lane_normal(w), rad)), scale: 1.0, normal: lane_normal(w), airborne: false, visible: true, sink: 0.0, over_board: false }
    let motion = { orientation: Skee.Scene.quat_identity(), last: None, spin: origin(), pop: 0.0 }
    let shadow = { spot: origin(), facing: v3(0.0, 0.0, 1.0), size: 1.0, fade: 1.0, shown: true }
    let look = { symbol: Blank, turn: 0.0, glow: 0.0, slot_match: false, pulse: 1.0 }
    {
      world: w,
      palette: Skee.Rooms.palette(r),
      viewport: Skee.Camera.viewport(390.0, 844.0),
      camera: Skee.Camera.initial(),
      ball: { place: place, motion: motion, kind: ClassicBall, shadow: shadow },
      waiting: 12,
      reels: Skee.HoleMap.fill_reels(look),
      bulbs: { chase: 0, level: 0.0 },
      waves: []
    }
  end

  fn solid_tokens(s : Skee.Scene.Solid) : List(Float) do
    match s do
    Slab(a, b, c, d) -> [a, b, c, d]
    Drum(a, b) -> [a, b]
    Orb(a) -> [a]
    Hoop(a, b) -> [a, b]
    Card(a, b) -> [a, b]
    Band(a, b) -> [a, b]
    LipArc(_, _, _, _, _) -> []
    end
  end

  fn solid_kind(s : Skee.Scene.Solid) : String do
    match s do
    Slab(_, _, _, _) -> "box"
    Drum(_, _) -> "cylinder"
    Orb(_) -> "sphere"
    Hoop(_, _) -> "torus"
    Card(_, _) -> "plane"
    Band(_, _) -> "tube"
    LipArc(_, _, _, _, _) -> "mesh"
    end
  end

  fn colour_token(c : Option(Skee.Scene.Rgba)) : String do
    match c do
    Some(x) -> int_to_string(x.red * 65536 + x.green * 256 + x.blue)
    None -> "-"
    end
  end

  fn is_coin(p : Skee.Scene.Part) : Bool do
    match p.role do
    CoinPart(_) -> true
    _ -> false
    end
  end

  fn is_halo(p : Skee.Scene.Part) : Bool do
    match p.role do
    HaloPart(_) -> true
    _ -> false
    end
  end

  fn frame_floats(f : Skee.Scene.Frame) : List(Float) do
    [f.ax.x, f.ax.y, f.ax.z, f.ay.x, f.ay.y, f.ay.z, f.az.x, f.az.y, f.az.z, f.at.x, f.at.y, f.at.z]
  end

  fn compare_floats(got : List(Float), want : List(String), tol : Float, what : String) : Outcome do
    if List.length(got) == List.length(want) do
      all(List.zip_with(got, want, fn (g, t) -> near(g, t, tol, what)))
    else
      Mismatch(what ++ ": " ++ int_to_string(List.length(got)) ++ " values, want " ++ int_to_string(List.length(want)))
    end
  end

  fn node_row(p : Skee.Scene.Part, row : List(String)) : Outcome do
    match row do
    Cons(_, Cons(i, Cons(kind, rest))) -> do
      let what = "node " ++ i ++ " " ++ kind
      let dims = List.length(solid_tokens(p.solid))
      let mesh = if kind == "mesh" do 1 else 0 end
      let dim_tokens = List.take(rest, dims + mesh)
      let after = List.drop(rest, dims + mesh)
      match after do
      Cons(colour, Cons(thick, Cons(hidden, Cons(opacity, frame)))) -> do
        let kind_ok = expect_string(solid_kind(p.solid), kind, what ++ " kind")
        let dims_ok = if mesh == 1 do Passed(1) else compare_floats(solid_tokens(p.solid), dim_tokens, metres_tol(), what ++ " size") end
        let colour_ok = if is_halo(p) do Passed(0) else expect_string(colour_token(p.colour), colour, what ++ " colour") end
        let thick_ok = near(p.outline, thick, unit_tol(), what ++ " outline")
        let hidden_ok = if is_coin(p) do Passed(0) else expect_string(if p.hidden do "1" else "0" end, hidden, what ++ " hidden") end
        let opacity_ok = near(p.opacity, opacity, unit_tol(), what ++ " opacity")
        let frame_ok = if is_coin(p) do Passed(0) else compare_floats(frame_floats(p.frame), frame, metres_tol(), what ++ " transform") end
        all([kind_ok, dims_ok, colour_ok, thick_ok, hidden_ok, opacity_ok, frame_ok])
      end
      _ -> Mismatch("bad node row")
      end
    end
    _ -> Mismatch("bad node row")
    end
  end

  fn room_model(r : Room) : Outcome do
    let parts = Skee.Scene.model(k(), fresh_stage(r))
    let want = List.filter(rows("node"), fn row -> List.take(row, 1) == [room_token(r)])
    let count = List.filter(rows("nodecount"), fn row -> List.take(row, 1) == [room_token(r)])
    let count_ok = match count do
    [[_, n]] -> expect_int(List.length(parts), GoldenIo.int(n), room_token(r) ++ " node count")
    _ -> Mismatch("no nodecount row")
    end
    if List.length(parts) == List.length(want) do
      all(Cons(count_ok, List.zip_with(parts, want, node_row)))
    else
      Mismatch(room_token(r) ++ ": " ++ int_to_string(List.length(parts)) ++ " parts, Swift has " ++ int_to_string(List.length(want)))
    end
  end

  fn model_cases() : List(Case) do
    List.map(Skee.Rooms.all_rooms(), fn r -> case("Cabinet node tree, " ++ room_token(r), fn () -> room_model(r)))
  end

  -- ---- Cabinet.setReel and lightBulbs ----
  fn look_of(turn : String, glow : String, slot : String, pulse : String) : Skee.Scene.ReelLook do
    { symbol: Bell, turn: fl(turn), glow: fl(glow), slot_match: slot == "1", pulse: fl(pulse) }
  end

  fn reel_parts_for(h : Hole, look : Skee.Scene.ReelLook) : List(Skee.Scene.Part) do
    let st = { fresh_stage(Boardwalk) with reels: Skee.HoleMap.fill_reels(look) }
    List.filter(Skee.Scene.model(k(), st), fn p -> p.role == Skee.Scene.CoinPart(h) || p.role == Skee.Scene.HaloPart(h))
  end

  fn decal_row(row : List(String)) : Outcome do
    match row do
    [h, turn, glow, slot, pulse, i, hidden, scale, lx, ly, lz, wx, wy, wz] -> do
      let hole = hole_of(h)
      let look = look_of(turn, glow, slot, pulse)
      let table = Skee.Rooms.table(k(), Boardwalk)
      let layout = Skee.Scene.reel_layout(k(), table.board, hole)
      let c = Skee.Scene.coin(k(), layout, look, GoldenIo.int(i))
      let what = "decal " ++ h ++ " " ++ i ++ " turn " ++ float_to_string(fl(turn))
      let coins = List.filter(reel_parts_for(hole, look), fn p -> p.role == Skee.Scene.CoinPart(hole))
      let world_ok = match List.nth_opt(coins, GoldenIo.int(i)) do
      Some(p) -> near3(p.frame.at, wx, wy, wz, metres_tol(), what ++ " world")
      None -> Mismatch(what ++ ": no such coin")
      end
      all([expect_string(if c.coin_hidden do "1" else "0" end, hidden, what ++ " hidden"), near(c.swell, scale, unit_tol(), what ++ " scale"), near3(c.local, lx, ly, lz, metres_tol(), what ++ " local"), world_ok])
    end
    _ -> Mismatch("bad decal row")
    end
  end

  fn halo_row(row : List(String)) : Outcome do
    match row do
    [h, turn, glow, slot, pulse, opacity, colour, wx, wy, wz] -> do
      let hole = hole_of(h)
      let look = look_of(turn, glow, slot, pulse)
      let (o, c) = Skee.Scene.halo(look)
      let halos = List.filter(reel_parts_for(hole, look), fn p -> p.role == Skee.Scene.HaloPart(hole))
      let what = "halo " ++ h
      let at_ok = match halos do
      [p] -> all([near3(p.frame.at, wx, wy, wz, metres_tol(), what ++ " world"), near(p.opacity, opacity, unit_tol(), what ++ " part opacity")])
      _ -> Mismatch(what ++ ": want one halo")
      end
      all([near(o, opacity, unit_tol(), what ++ " opacity"), expect_string(colour_token(Some(c)), colour, what ++ " colour"), at_ok])
    end
    _ -> Mismatch("bad halo row")
    end
  end

  fn bulbs_row(row : List(String)) : Outcome do
    match row do
    Cons(phase, Cons(level, lit)) -> do
      let light = { chase: GoldenIo.int(phase), level: fl(level) }
      let st = { fresh_stage(Boardwalk) with bulbs: light }
      let bulbs = List.filter(Skee.Scene.model(k(), st), fn p -> p.role == Skee.Scene.BulbPart)
      let got = List.map(bulbs, fn p -> p.emission.glow_r)
      compare_floats(got, lit, unit_tol(), "bulbs phase " ++ phase)
    end
    _ -> Mismatch("bad bulbs row")
    end
  end

  fn reel_cases() : List(Case) do
    [
      case("Cabinet.setReel: coins", fn () -> all(List.map(rows("decal"), decal_row))),
      case("Cabinet.setReel: halos", fn () -> all(List.map(rows("halo"), halo_row))),
      case("Cabinet.lightBulbs", fn () -> all(List.map(rows("bulbs"), bulbs_row)))
    ]
  end

  -- ---- ScenePresenter.update replayed frame by frame ----
  fn spark_of(token : String) : List(Skee.Scene.Spark) do
    if token == "hump" do
      [Skee.Scene.SparkHump]
    else if token == "lip" do
      [Skee.Scene.SparkLip]
    else if token == "hop" do
      [Skee.Scene.SparkHop]
    else if token == "landed" do
      [Skee.Scene.SparkLanded]
    else if token == "backwall" do
      [Skee.Scene.SparkBackwall]
    else if token == "rail" do
      [Skee.Scene.SparkRail]
    else if String.starts_with(token, "drop-") do
      [Skee.Scene.SparkDrop(hole_of(String.replace_all(token, "drop-", "")))]
    else
      []
    end end end end end end end
  end

  fn sparks_of(token : String) : List(Skee.Scene.Spark) do
    if token == "-" do [] else List.flat_map(String.split(token, ","), spark_of) end
  end

  fn sample_or_none(fields : List(String)) : Option(PathSample) do
    match fields do
    [phase, x, along, h] -> if phase == "-" do None else Some(sample_of(phase, x, along, h)) end
    _ -> None
    end
  end

  fn resting_of(fields : List(String)) : Option((PathSample, Float)) do
    match fields do
    [phase, x, along, h, until] -> if phase == "-" do None else Some((sample_of(phase, x, along, h), fl(until))) end
    _ -> None
    end
  end

  fn token_at(row : List(String), i : Int) : String do
    match List.nth_opt(row, i) do
    Some(t) -> t
    None -> "-"
    end
  end

  fn frame_cue(row : List(String)) : Skee.Scene.FrameCue do
    let bc = { sample: sample_or_none(List.take(List.drop(row, 5), 4)), busy: token_at(row, 3) == "1", beat_is_roll: token_at(row, 4) == "1", resting: resting_of(List.take(List.drop(row, 9), 5)), clock: fl(token_at(row, 2)), throwing: token_at(row, 14) == "1", held: None }
    let reel_cue = { setup: Skee.Types.standard_setup(), positions: Skee.HoleMap.fill_reels(0.0), have: [], slot: None }
    { ball_cue: bc, sparks: sparks_of(token_at(row, 19)), kind: ClassicBall, anticipation: fl(token_at(row, 16)), shake: fl(token_at(row, 17)), balls_left: GoldenIo.int(token_at(row, 15)), excited: false, reel_cue: reel_cue }
  end

  -- Tolerance for the roll: 32-bit quaternion products over hundreds of frames.
  fn spin_tol() : Float do
    0.0001
  end

  fn frame_check(s : Skee.Scene.Scenery, row : List(String)) : Outcome do
    let tail = List.drop(row, 20)
    let what = "frame " ++ String.join(List.take(row, 2), " ")
    let b = s.ball
    let q = b.motion.orientation
    let size = b.place.scale *. (1.0 +. 0.35 *. b.motion.pop)
    let sh = b.shadow
    let sq = Skee.Scene.quat_between(v3(0.0, 0.0, 1.0), sh.facing)
    let cam = s.camera.eye
    let got = [b.place.centre.x, b.place.centre.y, b.place.centre.z, q.qw, q.qx, q.qy, q.qz, size]
    let got_shadow = [sh.spot.x, sh.spot.y, sh.spot.z, sq.qw, sq.qx, sq.qy, sq.qz, sh.size, sh.fade]
    match tail do
    [px, py, pz, qr, qx, qy, qz, scale, hidden, sx, sy, sz, sr, sqx, sqy, sqz, ss, so, shidden, waiting, cx, cy, cz] -> do
      all([compare_floats(List.take(got, 3), [px, py, pz], metres_tol(), what ++ " ball"), compare_floats(List.drop(got, 3), [qr, qx, qy, qz, scale], spin_tol(), what ++ " roll"), expect_string(if b.place.visible do "0" else "1" end, hidden, what ++ " ball hidden"), compare_floats(got_shadow, [sx, sy, sz, sr, sqx, sqy, sqz, ss, so], metres_tol(), what ++ " shadow"), expect_string(if sh.shown do "0" else "1" end, shidden, what ++ " shadow hidden"), expect_int(s.waiting, GoldenIo.int(waiting), what ++ " waiting"), near3(cam, cx, cy, cz, metres_tol(), what ++ " camera")])
    end
    _ -> Mismatch("bad frame row")
    end
  end

  type Replay = { kept : Skee.Scene.Keep, outcomes : List(Outcome), worst_spin : Float }

  fn replay_step(acc : Replay, row : List(String)) : Replay do
    let w = boardwalk()
    let (scene, kept) = Skee.Scene.present(w, Skee.Rooms.palette(Boardwalk), fitted(), Skee.Camera.viewport(390.0, 844.0), acc.kept, frame_cue(row), 1.0 /. 60.0)
    let q = scene.ball.motion.orientation
    let off_q = match List.drop(row, 23) do
    Cons(qr, Cons(qx, Cons(qy, Cons(qz, _)))) -> worst([off(q.qw, qr), off(q.qx, qx), off(q.qy, qy), off(q.qz, qz)])
    _ -> 0.0
    end
    { kept: kept, outcomes: Cons(frame_check(scene, row), acc.outcomes), worst_spin: if off_q > acc.worst_spin do off_q else acc.worst_spin end }
  end

  -- Before the first recorded frame the pull finished and one idle frame put
  -- the waiting ball at the release spot: that is the last centre the roll
  -- starts from.
  fn replayed() : Replay do
    let w = boardwalk()
    let fresh = Skee.Scene.keep_fresh()
    let spot = plus(lane(w, 0.0, 0.12), times(lane_normal(w), ball_radius(w)))
    let start = { fresh with motion: { fresh.motion with last: Some(spot) } }
    List.fold_left(rows("frame"), { kept: start, outcomes: [], worst_spin: 0.0 }, replay_step)
  end

  doc """Worst quaternion component error over the replay."""
  fn worst_spin() : Float do
    let r = replayed()
    r.worst_spin
  end

  fn presenter_cases() : List(Case) do
    [case("ScenePresenter.update over three real throws", fn () -> replay_outcome())]
  end

  fn replay_outcome() : Outcome do
    let r = replayed()
    all(List.reverse(r.outcomes))
  end

  -- ---- Measured error, printed by the runner ----
  fn off(actual : Float, token : String) : Float do
    Math.abs(actual -. fl(token))
  end

  fn worst(xs : List(Float)) : Float do
    List.fold_left(xs, 0.0, fn (a, b) -> if b > a do b else a end)
  end

  fn proj_off(rig : Skee.Camera.Rig, row : List(String)) : List(Float) do
    match row do
    [w, h, name, px, py] -> do
      let l = Skee.Camera.lens(k(), rig, view_of(w, h))
      let p = Skee.Camera.pixel(k(), l, proj_point(boardwalk(), name))
      [off(p.x, px), off(p.y, py)]
    end
    _ -> []
    end
  end

  fn lane_off(row : List(String)) : List(Float) do
    match row do
    [r, x, s, px, py, pz] -> do
      let p = lane(world_of(r), fl(x), fl(s))
      [off(p.x, px), off(p.y, py), off(p.z, pz)]
    end
    _ -> []
    end
  end

  fn ball_off(row : List(String)) : List(Float) do
    match row do
    [r, phase, x, along, height, _, cx, cy, cz, _, _, _] -> do
      let c = ball_center(world_of(r), sample_of(phase, x, along, height))
      [off(c.x, cx), off(c.y, cy), off(c.z, cz)]
    end
    _ -> []
    end
  end

  doc """Worst pixel error over every projected golden point, every viewport."""
  fn worst_pixels() : Float do
    let rig = fitted()
    worst(List.flat_map(rows("proj"), fn r -> proj_off(rig, r)))
  end

  doc """Worst position error in metres over the lane and ball-centre goldens."""
  fn worst_metres() : Float do
    worst(List.append(List.flat_map(rows("lane"), lane_off), List.flat_map(rows("ball"), ball_off)))
  end

  fn cases() : List(Case) do
    let rig = fitted()
    List.concat([world_cases(), camera_cases(rig), model_cases(), reel_cases(), presenter_cases()])
  end

end
