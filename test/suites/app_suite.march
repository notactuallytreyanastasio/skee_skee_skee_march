        CueFoul
      ]
    let want =
      [
        "SndLaunch",
        "SndRail",
        "SndHump",
        "SndLip",
        "SndBackwall",
        "SndLanded",
        "SndDrop(Ring40)",
        "SndGutter",
        "SndHop",
