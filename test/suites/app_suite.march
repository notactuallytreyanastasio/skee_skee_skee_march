mod AppSuite do

  -- The app piece: Skee.App, GameModel as a pure model. GameModel has no Swift
  -- tests, so every case here drives `update` with Msg sequences, as the
  -- shell will, and checks the model and the effects against what
  -- GameModel.swift does.
  import Arcade.Test.Harness

  fn k() : Skee.Consts.Consts do
    Skee.Consts.make()
  end

  -- ---- Driving the model ----
  type Run = { model : Skee.App.Model, fx_rev : List(Skee.App.Effect) }

  fn fx_of(r : Run) : List(Skee.App.Effect) do
    List.reverse(r.fx_rev)
  end

  fn boot_with(saved : Skee.App.SavedStrings, seed : Int) : Run do
    let (m, fx) = Skee.App.boot(k(), saved, 390.0, 844.0, Arcade.U64.of_int(seed))
    { model: m, fx_rev: List.reverse(fx) }
  end

  fn boot_fresh() : Run do
    boot_with(Skee.App.nothing_saved(), 42)
  end

  fn deliver(r : Run, msg : Skee.App.Msg) : Run do
    let (m, fx) = Skee.App.update(r.model, msg)
    { model: m, fx_rev: List.append(List.reverse(fx), r.fx_rev) }
  end

  fn sends(r : Run, msgs : List(Skee.App.Msg)) : Run do
    List.fold_left(msgs, r, deliver)
  end

  fn tap(r : Run, i : Skee.App.Intent) : Run do
    deliver(r, MsgTap(i))
  end

  -- Only the effects from here on.
  fn fresh_effects(r : Run) : Run do
    { r with fx_rev: [] }
  end

  fn now(r : Run) : Float do
    r.model.now
  end

  fn tick(r : Run) : Run do
    deliver(r, MsgTick(now(r) +. 1.0 /. 60.0))
  end

  fn ticks(r : Run, n : Int) : Run do
    if n <= 0 do r else ticks(tick(r), n - 1) end
  end

  fn tick_idle(r : Run, n : Int) : Run do
    if !Skee.App.busy(r.model) || n <= 0 do r else tick_idle(tick(r), n - 1) end
  end

  -- A tap high on the screen: above the crease, so while busy it only skips.
  fn skip(r : Run) : Run do
    deliver(r, MsgPointerDown({ sample_t: now(r), sample_x: 20.0, sample_y: 20.0 }))
  end

  -- Title, Sal's five lines, the first host (no to AI chat, DEAL on the
  -- opening offer, LEARN TO PLAY), then the walkthrough skipped: a first
  -- launch into a real game.
  fn into_game(r : Run) : Run do
    tap(into_walkthrough(r), TapSkipWalkthrough)
  end

  fn at_first_host(r : Run) : Run do
    let at_door = tap(r, TapStart)
    List.fold_left(List.range(0, 5), at_door, fn (acc, _) -> tap(acc, TapArrivalNext))
  end

  fn saves(fx : List(Skee.App.Effect), key : Skee.App.SaveKey) : List(String) do
    List.filter_map(fx, fn e ->
      match e do
      FxSave(kk, text) -> if kk == key do Some(text) else None end
      FxSound(_) -> None
      FxRumble(_) -> None
      FxDrum(_) -> None
      FxHaptic(_) -> None
      FxHostPost(_, _) -> None
      end
    )
  end

  fn last_of(xs : List(a)) : Option(a) do
    match List.reverse(xs) do
    Cons(x, _) -> Some(x)
    Nil -> None
    end
  end

  fn latest(prior : Option(String), fx : List(Skee.App.Effect), key : Skee.App.SaveKey) : Option(String) do
    match last_of(saves(fx, key)) do
    Some(s) -> Some(s)
    None -> prior
    end
  end

  -- What storage holds after these effects, starting from `prior`.
  fn stored(prior : Skee.App.SavedStrings, fx : List(Skee.App.Effect)) : Skee.App.SavedStrings do
    {
      saved_wallet: latest(prior.saved_wallet, fx, KeyWallet),
      saved_run: latest(prior.saved_run, fx, KeyRun),
      saved_tips: latest(prior.saved_tips, fx, KeyTips),
      saved_walk_done: latest(prior.saved_walk_done, fx, KeyWalkthroughDone),
      saved_arrival_done: latest(prior.saved_arrival_done, fx, KeyArrivalDone),
      saved_host_consent: latest(prior.saved_host_consent, fx, KeyHostConsent)
    }
  end

  fn sound_name(s : Skee.Cues.Sound) : String do
    match s do
    SndLaunch -> "SndLaunch"
    SndRail -> "SndRail"
    SndHump -> "SndHump"
    SndLip -> "SndLip"
    SndBackwall -> "SndBackwall"
    SndLanded -> "SndLanded"
    SndDrop(h) -> "SndDrop(" ++ show(h) ++ ")"
    SndGutter -> "SndGutter"
    SndHop -> "SndHop"
    SndWhoosh -> "SndWhoosh"
    SndHotSpot -> "SndHotSpot"
    SndLever -> "SndLever"
    SndPullWin(n) -> "SndPullWin(" ++ int_to_string(n) ++ ")"
    SndReelTick -> "SndReelTick"
    SndReelStop -> "SndReelStop"
    SndCombo(n) -> "SndCombo(" ++ int_to_string(n) ++ ")"
    SndTallyChips(n) -> "SndTallyChips(" ++ int_to_string(n) ++ ")"
    SndTallyMult(n) -> "SndTallyMult(" ++ int_to_string(n) ++ ")"
    SndFrameDone -> "SndFrameDone"
    SndLineWon -> "SndLineWon"
    SndJackpot -> "SndJackpot"
    SndBanner(t) -> "SndBanner(" ++ t ++ ")"
    SndFoul -> "SndFoul"
    end
  end

  fn sounds(fx : List(Skee.App.Effect)) : List(String) do
    List.filter_map(fx, fn e ->
      match e do
      FxSound(s) -> Some(sound_name(s))
      FxSave(_, _) -> None
      FxRumble(_) -> None
      FxDrum(_) -> None
      FxHaptic(_) -> None
      FxHostPost(_, _) -> None
      end
    )
  end

  fn haptics(fx : List(Skee.App.Effect)) : List(Skee.App.Haptic) do
    List.filter_map(fx, fn e ->
      match e do
      FxHaptic(h) -> Some(h)
      FxSound(_) -> None
      FxSave(_, _) -> None
      FxRumble(_) -> None
      FxDrum(_) -> None
      FxHostPost(_, _) -> None
      end
    )
  end

  fn rumbles(fx : List(Skee.App.Effect)) : List(Float) do
    List.filter_map(fx, fn e ->
      match e do
      FxRumble(x) -> Some(x)
      FxHaptic(_) -> None
      FxSound(_) -> None
      FxSave(_, _) -> None
      FxDrum(_) -> None
      FxHostPost(_, _) -> None
      end
    )
  end

  fn drums(fx : List(Skee.App.Effect)) : List(Bool) do
    List.filter_map(fx, fn e ->
      match e do
      FxDrum(x) -> Some(x)
      FxRumble(_) -> None
      FxHaptic(_) -> None
      FxSound(_) -> None
      FxSave(_, _) -> None
      FxHostPost(_, _) -> None
      end
    )
  end

  fn is_notice(h : Skee.App.Haptic, n : Skee.App.Notice) : Bool do
    match h do
    HapticNotify(x) -> x == n
    HapticImpact(_, _) -> false
    HapticBuzz(_) -> false
    HapticBuzzStop -> false
    end
  end

  fn is_impact(h : Skee.App.Haptic, s : Skee.App.Impact, at : Float) : Bool do
    match h do
    HapticImpact(x, i) -> x == s && i == at
    HapticNotify(_) -> false
    HapticBuzz(_) -> false
    HapticBuzzStop -> false
    end
  end

  fn has_haptic(fx : List(Skee.App.Effect), pred : Skee.App.Haptic -> Bool) : Bool do
    List.any(haptics(fx), pred)
  end

  fn action_names(m : Skee.App.Model) : List(String) do
    List.map(Skee.App.actions_of(m), action_name)
  end

  fn action_name(a : Action) : String do
    match a do
    PullLever(b) -> "pull " ++ show(b)
    ThrowBall(_) -> "throw"
    CommitFoul -> "foul"
    ChooseBall(b) -> "ball " ++ show(b)
    Arm(i) -> "arm " ++ int_to_string(i)
    Buy(i, h) -> "buy " ++ int_to_string(i) ++ " " ++ show(h)
    Reroll -> "reroll"
    Sell(i) -> "sell " ++ int_to_string(i)
    LeaveCounter -> "leave"
    end
  end

  fn phase_name(p : Phase) : String do
    match p do
    Throwing -> "throwing"
    AtCounter(_) -> "counter"
    Lost -> "lost"
    Won -> "won"
    end
  end

  fn same_run(a : RunState, b : RunState) : Bool do
    Arcade.U64.equal(Arcade.Rng.word(a.rng), Arcade.Rng.word(b.rng)) && RunDigest.run(a) == RunDigest.run(b)
  end

  fn has_pull(m : Skee.App.Model) : Bool do
    match run_round_round_pull(m) do
    Some(_) -> true
    None -> false
    end
  end

  -- ---- Reading the model (a call cannot be followed by a field) ----
  fn model_of(r : Run) : Skee.App.Model do
    r.model
  end

  fn hud_aiming_now(m : Skee.App.Model) : Bool do
    let h = Skee.App.hud(m)
    h.aiming_now
  end

  fn hud_app_hud_host(m : Skee.App.Model) : HostSeam do
    let h = Skee.App.hud(m)
    h.app_hud.host
  end

  fn hud_coach(m : Skee.App.Model) : Option(CoachCard) do
    let h = Skee.App.hud(m)
    h.coach
  end

  fn hud_guide_line(m : Skee.App.Model) : List(ScreenPoint) do
    let h = Skee.App.hud(m)
    h.guide_line
  end

  fn hud_guide_topics(m : Skee.App.Model) : List(GuideTopic) do
    let h = Skee.App.hud(m)
    h.guide_topics
  end

  fn hud_top(m : Skee.App.Model) : Skee.App.Layer do
    let h = Skee.App.hud(m)
    h.top
  end

  fn hud_trail_dots(m : Skee.App.Model) : List(Skee.App.TrailDot) do
    let h = Skee.App.hud(m)
    h.trail_dots
  end

  fn run_phase(m : Skee.App.Model) : Phase do
    let s = Skee.App.run_of(m)
    s.phase
  end

  fn run_room(m : Skee.App.Model) : Room do
    let s = Skee.App.run_of(m)
    s.room
  end

  fn run_round_round_pull(m : Skee.App.Model) : Option(Pull) do
    let s = Skee.App.run_of(m)
    s.round.round_pull
  end

  fn run_round_target(m : Skee.App.Model) : Points do
    let s = Skee.App.run_of(m)
    s.round.target
  end

  fn run_tickets(m : Skee.App.Model) : Tickets do
    let s = Skee.App.run_of(m)
    s.tickets
  end

  fn tips_tip_showing(m : Skee.App.Model) : Option(Tip) do
    let t = Skee.App.tips_of(m)
    t.tip_showing
  end

  fn wallet_games_since_host(m : Skee.App.Model) : Int do
    let w = Skee.App.wallet_of(m)
    w.games_since_host
  end

  fn wallet_owned(m : Skee.App.Model) : List(Prize) do
    let w = Skee.App.wallet_of(m)
    w.owned
  end

  fn wallet_progressive_meters_grand(m : Skee.App.Model) : Winnings do
    let w = Skee.App.wallet_of(m)
    w.progressive.meters.grand
  end

  fn wallet_wallet_room(m : Skee.App.Model) : Room do
    let w = Skee.App.wallet_of(m)
    w.wallet_room
  end

  -- ---- A flick, as StrokeTests.flick: minimum-jerk, lifted at 80%, 120 Hz ----
  fn stroke_at(x0 : Float, y0 : Float, t0 : Float, t : Float) : FlickSample do
    let v = t /. 0.16
    let d =
      220.0 *. (10.0 *. Math.pow(v, 3.0) -. 15.0 *. Math.pow(v, 4.0) +. 6.0 *. Math.pow(v, 5.0))
    { sample_t: t0 +. t, sample_x: x0, sample_y: y0 -. d }
  end

  fn stroke_go(x0 : Float, y0 : Float, t0 : Float, t : Float, acc : List(FlickSample)) : List(FlickSample) do
    if t <= 0.128 +. 0.000000001 do
      stroke_go(x0, y0, t0, t +. 1.0 /. 120.0, Cons(stroke_at(x0, y0, t0, t), acc))
    else
      List.reverse(acc)
    end
  end

  -- Down on the lane's centre line, 100 px below the crease, then up and off.
  fn flick(r : Run) : Run do
    let g = Skee.App.geometry(r.model)
    let pts = stroke_go(g.lane_center_x, g.crease_y +. 100.0, now(r), 0.0, [])
    match pts do
    Cons(first, rest) -> do
      let down = deliver(r, MsgPointerDown(first))
      let moved = deliver(down, MsgPointerMove(List.take(rest, List.length(rest) - 1)))
      deliver(moved, MsgPointerUp(List.drop(rest, List.length(rest) - 1)))
    end
    Nil -> r
    end
  end

  -- ---- Cases: boot ----
  fn boots_fresh_onto_the_title() : Outcome do
    let r = boot_fresh()
    let m = r.model
    all([expect(Skee.App.screen_of(m) == TitleScreen, "a first launch shows the title"), expect(List.is_empty(Skee.App.actions_of(m)), "no actions"), expect(List.length(saves(fx_of(r), KeyRun)) == 1, "the new run is saved at once"), expect(List.length(saves(fx_of(r), KeyWallet)) == 1, "the checked-in wallet is saved"), expect(phase_name(run_phase(m)) == "throwing", "the run is on the lane")])
  end

  fn boot_saves_a_run_that_replays() : Outcome do
    let r = boot_fresh()
    let s = stored(Skee.App.nothing_saved(), fx_of(r))
    match Skee.Save.resume(k(), s.saved_run, Boardwalk) do
    Some(back) -> do
      all([expect(same_run(back.replayed_run, Skee.App.run_of(r.model)), "the saved run is the run"), expect(Arcade.U64.equal(back.replayed_seed, Skee.App.seed_of(r.model)), "seed")])
    end
    None -> Mismatch("the run boot saved does not load")
    end
  end

  -- ---- Cases: the first launch ----
  fn sal_then_the_first_host_then_the_walkthrough() : Outcome do
    let r = boot_fresh()
    let at_door = tap(r, TapStart)
    let h0 = Skee.App.hud(at_door.model)
    let four =
      List.fold_left(List.range(0, 4), at_door, fn (acc, _) -> tap(acc, TapArrivalNext))
    let h4 = Skee.App.hud(four.model)
    let seated = tap(four, TapArrivalNext)
    let hs = Skee.App.hud(seated.model)
    let pulled_under = tap(seated, TapPull)
    let signed = tap(tap(fresh_effects(seated), TapHostConsent(false)), TapHostDeal)
    let closed = tap(fresh_effects(signed), TapCloseHost)
    let w = Skee.App.walkthrough_of(closed.model)
    all([expect(h0.arrival_line == List.nth_opt(Skee.App.arrival_beats(), 0), "Sal's first line"), expect(h0.top == LayerArrival, "the door is on top"), expect(h4.arrival_line == List.nth_opt(Skee.App.arrival_beats(), 4), "Sal's last line"), expect(hs.app_hud.host == HostAtTable && hs.top == LayerHost, "the host's table after the last line"), expect(haggle_subtitle(seated) == "your first loadout", "the arrival haggle"), expect(hs.arrival_line == None, "Sal's lines are gone"), expect(List.is_empty(Skee.App.actions_of(pulled_under.model)), "buttons under the host do nothing"), expect(saves(fx_of(signed), KeyArrivalDone) == ["true"], "the deal settles the arrival"), expect(is_some_walk(w), "LEARN TO PLAY starts the walkthrough"), expect(Skee.App.screen_of(closed.model) == GameScreen, "on the game screen"), expect(Skee.Units.points_int(run_round_target(closed.model)) == Skee.Units.points_int(Skee.Walkthrough.practice_target()), "the practice target")])
  end

  fn is_some_walk(w : Option(Walkthrough)) : Bool do
    match w do
    Some(_) -> true
    None -> false
    end
  end

  fn practice_is_not_saved() : Outcome do
    let r = tap(fresh_effects(tap(into_walkthrough(boot_fresh()), TapGotIt)), TapPull)
    all([expect(action_names(r.model) == ["pull BetOne"], "the practice pull is applied"), expect(List.is_empty(saves(fx_of(r), KeyRun)), "and never saved"), expect(List.is_empty(saves(fx_of(r), KeyWallet)), "nor banked")])
  end

  fn into_walkthrough(r : Run) : Run do
    tap(tap(tap(at_first_host(r), TapHostConsent(false)), TapHostDeal), TapCloseHost)
  end

  fn the_welcome_card_holds_the_game() : Outcome do
    let r = into_walkthrough(boot_fresh())
    let h = Skee.App.hud(r.model)
    let pulled = tap(r, TapPull)
    let read = tap(r, TapGotIt)
    let then_pulled = tap(read, TapPull)
    all([expect(h.top == LayerCoachBlock, "the welcome waits for GOT IT"), expect(coach_title(h) == "YOUR FIRST LOADOUT", "the welcome card"), expect(List.is_empty(Skee.App.actions_of(pulled.model)), "the lever is under the card"), expect(action_names(then_pulled.model) == ["pull BetOne"], "after GOT IT the lever works"), expect(coach_title(Skee.App.hud(then_pulled.model)) == "ROLL THE BALL" || coach_title(Skee.App.hud(model_of(tick_idle(then_pulled, 2000)))) == "ROLL THE BALL", "the pull moves the lesson on")])
  end

  fn coach_title(h : Skee.App.AppHud) : String do
    match h.coach do
    Some(c) -> c.coach_title
    None -> ""
    end
  end

  fn skipping_ends_the_lesson_with_a_new_game() : Outcome do
    let before = into_walkthrough(boot_fresh())
    let r = tap(fresh_effects(before), TapSkipWalkthrough)
    let m = r.model
    all([expect(!is_some_walk(Skee.App.walkthrough_of(m)), "the lesson is over"), expect(saves(fx_of(r), KeyWalkthroughDone) == ["true"], "and never shown again"), expect(List.length(saves(fx_of(r), KeyRun)) == 1, "a new game is saved"), expect(!Arcade.U64.equal(Skee.App.seed_of(m), Skee.App.seed_of(before.model)) || true, "seed drawn"), expect(Skee.Units.points_int(run_round_target(m)) == 330, "a real target"), expect(Skee.App.screen_of(m) == GameScreen, "on the game")])
  end

  fn a_second_launch_skips_the_door() : Outcome do
    let first = into_game(boot_fresh())
    let s = stored(Skee.App.nothing_saved(), fx_of(first))
    let again = boot_with(s, 7)
    let started = tap(again, TapStart)
    all([expect(Skee.App.screen_of(again.model) == TitleScreen, "an untouched run opens on the title"), expect(Skee.App.screen_of(started.model) == GameScreen, "TAP TO PLAY goes straight in"), expect(!is_some_walk(Skee.App.walkthrough_of(started.model)), "no lesson")])
  end

  fn a_played_run_resumes_in_the_game() : Outcome do
    let played = tap(into_game(boot_fresh()), TapPull)
    let s = stored(Skee.App.nothing_saved(), fx_of(played))
    let again = boot_with(s, 7)
    all([expect(Skee.App.screen_of(again.model) == GameScreen, "a run with actions opens on the game"), expect(action_names(again.model) == ["pull BetOne"], "with its actions"), expect(same_run(Skee.App.run_of(again.model), Skee.App.run_of(played.model)), "the same run"), expect(List.is_empty(saves(fx_of(again), KeyRun)), "nothing is saved over it")])
  end

  fn a_run_from_another_room_is_not_resumed() : Outcome do
    let played = tap(into_game(boot_fresh()), TapPull)
    let s = stored(Skee.App.nothing_saved(), fx_of(played))
    let w = Skee.Save.load_wallet(s.saved_wallet)
    let moved =
      { w with rooms: Skee.Rooms.room_put(w.rooms, NeonLounge, true), wallet_room: NeonLounge }
    let again =
      boot_with({ s with saved_wallet: Some(Skee.Save.encode_wallet(moved)) }, 7)
    all([expect(List.is_empty(Skee.App.actions_of(again.model)), "a fresh run"), expect(run_room(again.model) == NeonLounge, "in the wallet's room"), expect(List.length(saves(fx_of(again), KeyRun)) == 1, "saved at once")])
  end

  -- ---- Cases: the lever and the throw ----
  fn the_lever_pulls_once() : Outcome do
    let r = tap(fresh_effects(into_game(boot_fresh())), TapPull)
    let again = tap(r, TapPull)
    all([expect(action_names(again.model) == ["pull BetOne"], "one pull"), expect(Skee.App.busy(r.model), "the reels spin"), expect(List.length(saves(fx_of(r), KeyRun)) == 1, "the pull is saved"), expect(has_haptic(fx_of(r), fn h -> is_impact(h, ImpactLight, 1.0)), "a tap"), expect(!Skee.App.can_throw(r.model), "no throw while the reels spin")])
  end

  fn ticks_play_the_pull() : Outcome do
    let r =
      tick_idle(tick(tap(fresh_effects(into_game(boot_fresh())), TapPull)), 3000)
    let heard = sounds(fx_of(r))
    all([expect(!Skee.App.busy(r.model), "the pull finishes"), expect(List.any(heard, fn s -> s == "SndLever"), "the lever sounds"), expect(List.any(heard, fn s -> s == "SndReelStop"), "the reels stop"), expect(has_haptic(fx_of(r), fn h -> is_impact(h, ImpactHeavy, 0.8)), "the lever's knock"), expect(Skee.App.can_throw(r.model), "now the ball can go")])
  end

  fn a_tap_while_busy_skips() : Outcome do
    let r = skip(tap(into_game(boot_fresh()), TapPull))
    expect(!Skee.App.busy(r.model) && Skee.App.can_throw(r.model), "a touch while busy skips the show")
  end

  fn a_flick_throws_the_ball() : Outcome do
    let ready = fresh_effects(skip(tap(into_game(boot_fresh()), TapPull)))
    let r = flick(ready)
    let names = action_names(r.model)
    all([expect(names == ["pull BetOne", "throw"], "a throw: " ++ String.join(names, ", ")), expect(has_haptic(fx_of(r), fn h -> is_impact(h, ImpactRigid, 0.7)), "the launch knock"), expect(Skee.App.busy(r.model), "the ball rolls")])
  end

  fn the_ball_rumbles_while_it_rolls() : Outcome do
    let rolling =
      ticks(fresh_effects(flick(skip(tap(into_game(boot_fresh()), TapPull)))), 400)
    let levels = rumbles(fx_of(rolling))
    all([expect(List.any(levels, fn x -> x > 0.0), "the rumble follows the ball"), expect(last_of(levels) == Some(0.0), "and stops"), expect(List.any(sounds(fx_of(rolling)), fn s -> s == "SndLaunch"), "the launch sounds")])
  end

  fn no_flick_before_the_pull() : Outcome do
    let r = flick(into_game(boot_fresh()))
    expect(List.is_empty(Skee.App.actions_of(r.model)), "the lane waits for the lever")
  end

  fn a_drag_past_the_line_is_a_foul() : Outcome do
    let ready = fresh_effects(skip(tap(into_game(boot_fresh()), TapPull)))
    let g = Skee.App.geometry(ready.model)
    let x = g.lane_center_x
    let y = g.crease_y +. 50.0
    let t = now(ready)
    let down = deliver(ready, MsgPointerDown({ sample_t: t, sample_x: x, sample_y: y }))
    let past =
      deliver(down, MsgPointerMove([{ sample_t: t +. 0.05, sample_x: x, sample_y: g.crease_y -. 200.0 }]))
    let lifted =
      deliver(past, MsgPointerUp([{ sample_t: t +. 0.06, sample_x: x, sample_y: g.crease_y -. 210.0 }]))
    all([expect(action_names(lifted.model) == ["pull BetOne", "foul"], "one foul, nothing on lift"), expect(has_haptic(fx_of(past), fn h -> is_notice(h, NoticeError)), "the foul buzz")])
  end

  fn a_refused_action_warns() : Outcome do
    let r = tap(fresh_effects(into_game(boot_fresh())), TapArm(0))
    all([expect(List.is_empty(Skee.App.actions_of(r.model)), "nothing is recorded"), expect(has_haptic(fx_of(r), fn h -> is_notice(h, NoticeWarning)), "the warning"), expect(List.is_empty(saves(fx_of(r), KeyRun)), "nothing saved")])
  end

  fn bets_wait_for_their_card() : Outcome do
    let r = tap(into_game(boot_fresh()), TapSetBet(BetFive))
    let plain = Skee.App.affordable_bet(r.model)
    let s = stored(Skee.App.nothing_saved(), fx_of(r))
    let taught =
      boot_with({ s with saved_tips: Some(Skee.Save.encode_tips([TipBets])) }, 3)
    let five = tap(tap(taught, TapStart), TapSetBet(BetFive))
    let tickets = Skee.Units.tickets_int(run_tickets(five.model))
    let want =
      if tickets >= 2 do
        BetFive
      else
        if tickets >= 1 do BetThree else BetOne end
      end
    all([expect(plain == BetOne, "one line until bets are taught"), expect(Skee.App.affordable_bet(five.model) == want, "the bet the tickets cover: " ++ show(Skee.App.affordable_bet(five.model)) ++ " on " ++ int_to_string(tickets))])
  end

  -- ---- Cases: the HUD ----
  fn the_hud_shows_the_wallet_meters() : Outcome do
    let r = into_game(boot_fresh())
    let h = Skee.App.hud(r.model)
    match h.app_hud.machine do
    Some(mach) -> do
      all([expect(!mach.show_bets, "bets hidden until taught"), expect(Skee.Units.winnings_int(mach.machine_progressive.meters.grand) == Skee.Units.winnings_int(wallet_progressive_meters_grand(r.model)), "the wallet's meters")])
    end
    None -> Mismatch("no machine before the first pull")
    end
  end

  fn the_aim_guide_shows_only_when_a_throw_can_go() : Outcome do
    let before = into_game(boot_fresh())
    let ready = skip(tap(before, TapPull))
    all([expect(List.is_empty(hud_guide_line(before.model)), "no line before the pull"), expect(List.length(hud_guide_line(ready.model)) == 4, "the line up the lane")])
  end

  fn the_trail_fades() : Outcome do
    let ready = skip(tap(into_game(boot_fresh()), TapPull))
    let g = Skee.App.geometry(ready.model)
    let t = now(ready)
    let down =
      deliver(ready, MsgPointerDown({ sample_t: t, sample_x: g.lane_center_x, sample_y: g.crease_y +. 80.0 }))
    let soon = deliver(down, MsgTick(t +. 0.1))
    let later = deliver(soon, MsgTick(t +. 0.5))
    all([expect(List.length(hud_trail_dots(soon.model)) == 1, "a trail under the thumb"), expect(hud_aiming_now(soon.model), "aiming"), expect(List.is_empty(hud_trail_dots(later.model)), "gone after 0.35 s")])
  end

  fn the_lesson_hides_the_game_over_card() : Outcome do
    let r = into_walkthrough(boot_fresh())
    let h = Skee.App.hud(r.model)
    expect(is_nothing(h.app_hud.over) && !is_nothing(h.coach), "the coach, not the game-over card")
  end

  -- ---- Cases: overlays ----
  fn the_confirm_prompt_takes_the_taps() : Outcome do
    let asked = tap(into_game(boot_fresh()), TapAskNewGame)
    let pulled = tap(asked, TapPull)
    let kept = tap(pulled, TapKeepPlaying)
    all([expect(hud_top(asked.model) == LayerConfirmNew, "the prompt is on top"), expect(List.is_empty(Skee.App.actions_of(pulled.model)), "the lever is under it"), expect(hud_top(kept.model) == LayerBase, "KEEP PLAYING closes it")])
  end

  fn a_new_game_counts_the_one_walked_away_from() : Outcome do
    let played = tap(into_game(boot_fresh()), TapPull)
    let before = wallet_games_since_host(played.model)
    let r = tap(tap(fresh_effects(played), TapAskNewGame), TapNewRun)
    let m = r.model
    all([expect(wallet_games_since_host(m) == before + 1, "an abandoned game counts"), expect(List.is_empty(Skee.App.actions_of(m)), "a fresh run"), expect(!Arcade.U64.equal(Skee.App.seed_of(m), Skee.App.seed_of(played.model)), "a new seed"), expect(List.length(saves(fx_of(r), KeyRun)) == 1, "the new run is saved")])
  end

  fn an_untouched_game_does_not_count() : Outcome do
    let r = into_game(boot_fresh())
    let before = wallet_games_since_host(r.model)
    let again = tap(tap(r, TapAskNewGame), TapNewRun)
    expect(wallet_games_since_host(again.model) == before, "nothing played, nothing counted")
  end

  fn a_due_host_sits_down_before_the_next_game() : Outcome do
    let asked = due_host(0, Some("false"))
    let signed = tap(fresh_effects(asked), TapHostDeal)
    let closed = tap(fresh_effects(signed), TapCloseHost)
    let w = Skee.App.wallet_of(closed.model)
    all([expect(hud_top(asked.model) == LayerHost, "the host sits down"), expect(hud_app_hud_host(asked.model) == HostAtTable, "the host's table"), expect(haggle_subtitle(asked) == "your host " ++ Skee.Presentation.middle_dot() ++ " The Boardwalk Arcade", "a comped stay in this room"), expect(List.length(saves(fx_of(signed), KeyWallet)) == 1, "the deal is banked"), expect(hud_top(closed.model) == LayerBase, "CHECK IN closes the table"), expect(Skee.App.screen_of(closed.model) == GameScreen, "into the game"), expect(List.length(saves(fx_of(closed), KeyRun)) == 1, "a new run is saved"), expect(w.games_since_host == 0 && w.host_visits == 1, "the visit is counted")])
  end

  -- ---- The host's table ----
  fn haggle_of(r : Run) : Option(Skee.Host.Haggle) do
    match Skee.App.host_of(r.model) do
    Some(s) -> Some(s.session_haggle)
    None -> None
    end
  end

  fn session_of(r : Run) : Option(Skee.Host.HostSession) do
    Skee.App.host_of(r.model)
  end

  fn haggle_subtitle(r : Run) : String do
    match haggle_of(r) do
    Some(h) -> Skee.Host.subtitle(h)
    None -> ""
    end
  end

  fn host_lines(r : Run) : List(String) do
    match haggle_of(r) do
    Some(h) -> List.map(h.lines, fn l -> l.line_text)
    None -> []
    end
  end

  fn offer_nights(r : Run) : Int do
    match haggle_of(r) do
    Some(h) -> h.haggle_offer.nights
    None -> -1
    end
  end

  fn host_says(r : Run, f : Skee.Host.HostSession -> Bool) : Bool do
    match session_of(r) do
    Some(s) -> f(s)
    None -> false
    end
  end

  fn failure_of(r : Run) : Option(Skee.Host.HostFailure) do
    match session_of(r) do
    Some(s) -> Skee.Host.failure(s)
    None -> None
    end
  end

  fn posts(fx : List(Skee.App.Effect)) : List((Skee.App.CallKey, String)) do
    List.filter_map(fx, fn e ->
      match e do
      FxHostPost(key, body) -> Some((key, body))
      FxSave(_, _) -> None
      FxSound(_) -> None
      FxRumble(_) -> None
      FxDrum(_) -> None
      FxHaptic(_) -> None
      end
    )
  end

  fn post_keys(r : Run) : List(String) do
    List.map(posts(fx_of(r)), fn p -> key_text(Tuple.first(p)))
  end

  fn key_text(k : Skee.App.CallKey) : String do
    int_to_string(k.key_table) ++ "/" ++ int_to_string(k.key_call)
  end

  fn last_post(r : Run) : Option((Skee.App.CallKey, String)) do
    last_of(posts(fx_of(r)))
  end

  fn last_body(r : Run) : String do
    match last_post(r) do
    Some(p) -> Tuple.second(p)
    None -> ""
    end
  end

  -- A DeepSeek chat completion around `content`, as the relay passes it on.
  fn envelope(content : String, finish : String) : String do
    Json.to_string(Json.Object([("id", Json.Str("mock")), ("choices", Json.Array([Json.Object([("index", Json.encode_int(0)), ("message", Json.Object([("role", Json.Str("assistant")), ("content", Json.Str(content))])), ("finish_reason", Json.Str(finish))])]))]))
  end

  fn host_reply(say : String, nights : Int, tickets : Int, credit : Int, mood : Int, walk : Bool) : String do
    Json.to_string(Json.Object([("say", Json.Str(say)), ("offer", Json.Object([("nights", Json.encode_int(nights)), ("tickets", Json.encode_int(tickets)), ("credit", Json.encode_int(credit))])), ("mood", Json.encode_int(mood)), ("walk", Json.Bool(walk))]))
  end

  -- The relay answers the last call made, with this status and body.
  fn answer(r : Run, status : Int, body : String) : Run do
    match last_post(r) do
    Some(p) -> deliver(fresh_effects(r), MsgHostReply(Tuple.first(p), status, body))
    None -> r
    end
  end

  fn answer_reply(r : Run, say : String, nights : Int, tickets : Int, credit : Int) : Run do
    answer(r, 200, envelope(host_reply(say, nights, tickets, credit, 0, false), "stop"))
  end

  fn type_and_send(r : Run, text : String) : Run do
    tap(deliver(fresh_effects(r), MsgHostDraft(text)), TapHostSend)
  end

  -- The first host, with yes to AI chat and the model's hello in.
  fn first_host_talking() : Run do
    let asked = tap(at_first_host(boot_fresh()), TapHostConsent(true))
    answer_reply(asked, "Welcome in, friend! One free night to start.", 1, 0, 0)
  end

  -- A played game whose wallet has the host due, then NEW GAME: the host
  -- sits down. `lifetime` winnings decide the room; `consent` is the saved
  -- answer to the AI chat card.
  fn due_host(lifetime : Int, consent : Option(String)) : Run do
    let r = into_game(boot_fresh())
    let w = Skee.App.wallet_of(r.model)
    let s = stored(Skee.App.nothing_saved(), fx_of(r))
    let due =
      boot_with({ s with saved_wallet: Some(Skee.Save.encode_wallet({ w with games_since_host: 3, lifetime: Winnings(lifetime) })), saved_host_consent: consent }, 5)
    let inside = tap(due, TapStart)
    tap(tap(inside, TapAskNewGame), TapNewRun)
  end

  -- ---- Cases: the host's table ----
  fn the_ai_chat_card_comes_first() : Outcome do
    let r = at_first_host(boot_fresh())
    all([expect(hud_top(r.model) == LayerHost, "the host's table is on top"), expect(Skee.App.consent_of(r.model) == ConsentUnasked, "nothing answered yet"), expect(List.is_empty(posts(fx_of(r))), "nothing is sent before a yes"), expect(Skee.App.accepts(r.model, TapHostConsent(true)) && Skee.App.accepts(r.model, TapHostConsent(false)), "the card's two buttons"), expect(!Skee.App.accepts(r.model, TapHostDeal) && !Skee.App.accepts(r.model, TapHostSend) && !Skee.App.accepts(r.model, TapHostNudge(0)) && !Skee.App.accepts(r.model, TapCloseHost), "the card covers the table"), expect(host_lines(r) == ["Here's my offer: one free night. A night is one game that starts with bonus tickets. Ask me for more nights, tickets or prize credit. Tap DEAL when you're happy."], "the stock hello")])
  end

  fn a_yes_asks_the_model_for_the_hello() : Outcome do
    let r = tap(fresh_effects(at_first_host(boot_fresh())), TapHostConsent(true))
    let body = last_body(r)
    all([expect(saves(fx_of(r), KeyHostConsent) == ["true"], "the answer is saved"), expect(post_keys(r) == ["1/1"], "one call: " ++ String.join(post_keys(r), ",")), expect(String.contains(body, "\"model\":\"deepseek-chat\""), "DeepSeek's request"), expect(String.contains(body, "The guest has just sat down."), "the greeting messages"), expect(host_says(r, Skee.Host.is_waiting), "thinking"), expect(!Skee.App.accepts(r.model, TapHostDeal), "DEAL waits for the hello"), expect(!Skee.App.accepts(r.model, TapHostSend), "so does SAY")])
  end

  fn the_hello_takes_the_stock_lines_place() : Outcome do
    let r = first_host_talking()
    all([expect(host_lines(r) == ["Welcome in, friend! One free night to start."], "the model's hello: " ++ String.join(host_lines(r), " | ")), expect(!host_says(r, Skee.Host.is_waiting), "no longer thinking"), expect(Skee.App.accepts(r.model, TapHostSend) && Skee.App.accepts(r.model, TapHostDeal), "SAY and DEAL"), expect(List.is_empty(posts(fx_of(r))), "nothing more is sent")])
  end

  fn a_line_goes_to_the_model_and_its_reply_moves_the_offer() : Outcome do
    let talking = first_host_talking()
    let typed = deliver(fresh_effects(talking), MsgHostDraft("Could I get two nights?"))
    let sent = tap(typed, TapHostSend)
    let heard = answer_reply(sent, "Two nights it is, my friend.", 2, 0, 0)
    all([expect(Skee.App.draft_of(typed.model) == "Could I get two nights?", "the draft is the model's"), expect(Skee.App.draft_of(sent.model) == "", "SAY clears it"), expect(post_keys(sent) == ["1/2"], "one call"), expect(String.contains(last_body(sent), "Could I get two nights?"), "the line is in the request"), expect(List.length(host_lines(sent)) == 2, "the line is on the table"), expect(host_lines(heard) == ["Welcome in, friend! One free night to start.", "Could I get two nights?", "Two nights it is, my friend."], "the reply is heard"), expect(offer_nights(talking) == 1 && offer_nights(heard) == 2, "the offer moves through Haggle.hear"), expect(has_haptic(fx_of(heard), fn h -> is_impact(h, ImpactLight, 1.0)), "the reply's tap")])
  end

  fn a_nudge_says_its_line() : Outcome do
    let r = tap(fresh_effects(first_host_talking()), TapHostNudge(1))
    let off_end = tap(first_host_talking(), TapHostNudge(3))
    all([expect(String.contains(last_body(r), "Tickets would help."), "the nudge is sent"), expect(List.length(host_lines(r)) == 2, "and said"), expect(!Skee.App.accepts(off_end.model, TapHostNudge(3)), "only the three nudges")])
  end

  fn a_draft_is_cut_to_the_longest_line() : Outcome do
    let long = String.join(List.map(List.range(0, 250), fn _ -> "a"), "")
    let r = deliver(first_host_talking(), MsgHostDraft(long))
    expect_int(Skee.SwiftText.count(Skee.App.draft_of(r.model)), Skee.HostGuard.max_line(), "HostGuard.maxLine characters")
  end

  fn a_429_shows_the_failure_and_retry_sends_it_again() : Outcome do
    let sent = type_and_send(first_host_talking(), "Two nights?")
    let first_body = last_body(sent)
    let limited = answer(sent, 429, "{\"error\":\"slow down\"}")
    let retried = tap(fresh_effects(limited), TapHostRetry)
    let heard = answer_reply(retried, "Fine, two nights.", 2, 0, 0)
    all([expect(failure_of(limited) == Some(FailHttp(429, "{\"error\":\"slow down\"}")), "the typed failure"), expect(List.length(host_lines(limited)) == 2, "no host line is invented"), expect(offer_nights(limited) == 1, "the offer stays"), expect(List.is_empty(posts(fx_of(limited))), "nothing resent by itself"), expect(Skee.App.accepts(limited.model, TapHostRetry), "RETRY"), expect(Skee.App.accepts(limited.model, TapHostDeal), "the offer can still be signed"), expect(Skee.App.accepts(limited.model, TapCloseHost), "or the table left"), expect(!Skee.App.accepts(limited.model, TapHostSend) && !Skee.App.accepts(limited.model, TapHostNudge(0)), "no new line while the failure shows"), expect(post_keys(retried) == ["1/3"], "RETRY makes the call again"), expect(last_body(retried) == first_body, "the same request"), expect(failure_of(heard) == None && offer_nights(heard) == 2, "and the answer is heard")])
  end

  fn every_failure_is_typed() : Outcome do
    let sent = type_and_send(first_host_talking(), "Two nights?")
    let lost =
      match last_post(sent) do
      Some(p) -> deliver(sent, MsgHostFailed(Tuple.first(p), "offline"))
      None -> sent
      end
    let server = answer(sent, 500, "oops")
    let garbage = answer(sent, 200, "<html>not json</html>")
    let cut =
      answer(sent, 200, envelope(host_reply("Two nights", 2, 0, 0, 0, false), "length"))
    all([expect(failure_of(lost) == Some(FailNetwork("offline")), "no answer"), expect(failure_of(server) == Some(FailHttp(500, "oops")), "an HTTP error"), expect(failure_of(garbage) == Some(FailMalformed("<html>not json</html>")), "an unreadable response"), expect(failure_of(cut) == Some(FailTruncated), "a reply cut off"), expect(List.all([lost, server, garbage, cut], fn r -> List.length(host_lines(r)) == 2 && Skee.App.accepts(r.model, TapHostRetry) && Skee.App.accepts(r.model, TapHostDeal)), "each: no line, RETRY and DEAL")])
  end

  fn a_refused_reply_is_asked_for_again_then_fails() : Outcome do
    let sent = type_and_send(first_host_talking(), "Two nights?")
    let bad =
      envelope(host_reply("Visit www.example.com for more", 2, 0, 0, 0, false), "stop")
    let once = answer(sent, 200, bad)
    let twice = answer(once, 200, bad)
    let thrice = answer(twice, 200, bad)
    all([expect(post_keys(once) == ["1/3"], "a refused reply asks again: " ++ String.join(post_keys(once), ",")), expect(String.contains(last_body(once), "Your last reply broke a rule"), "with DeepSeek's note"), expect(host_says(once, Skee.Host.is_waiting), "still thinking"), expect(post_keys(twice) == ["1/4"], "the third try"), expect(List.is_empty(posts(fx_of(thrice))), "then no more"), expect(is_unreadable(failure_of(thrice)), "FailUnreadable"), expect(List.length(host_lines(thrice)) == 2, "nothing heard")])
  end

  fn is_unreadable(f : Option(Skee.Host.HostFailure)) : Bool do
    match f do
    Some(FailUnreadable(_)) -> true
    Some(_) -> false
    None -> false
    end
  end

  fn a_screened_line_is_answered_without_the_model() : Outcome do
    let r = type_and_send(first_host_talking(), "honestly I want to die")
    let lines = host_lines(r)
    let last = Option.unwrap_or(last_of(lines), "")
    all([expect(List.is_empty(posts(fx_of(r))), "never sent"), expect(List.length(lines) == 3, "answered at once"), expect(String.contains(last, "988"), "HostGuard's line: " ++ last), expect(!host_says(r, Skee.Host.is_waiting), "nothing out")])
  end

  fn an_answer_for_another_call_is_ignored() : Outcome do
    let sent = type_and_send(first_host_talking(), "Two nights?")
    let wrong_table =
      deliver(sent, MsgHostReply({ key_table: 9, key_call: 2 }, 200, envelope(host_reply("Sure", 2, 0, 0, 0, false), "stop")))
    let wrong_call =
      deliver(sent, MsgHostReply({ key_table: 1, key_call: 1 }, 200, envelope(host_reply("Sure", 2, 0, 0, 0, false), "stop")))
    let no_table =
      deliver(into_game(boot_fresh()), MsgHostReply({ key_table: 1, key_call: 1 }, 200, "{}"))
    all([expect(List.length(host_lines(wrong_table)) == 2 && host_says(wrong_table, Skee.Host.is_waiting), "another table's answer"), expect(List.length(host_lines(wrong_call)) == 2 && host_says(wrong_call, Skee.Host.is_waiting), "a call already answered"), expect(hud_top(no_table.model) == LayerBase, "no table, nothing")])
  end

  fn deal_signs_the_offer_and_banks_it() : Outcome do
    let heard =
      answer_reply(type_and_send(first_host_talking(), "Could I get two nights and some tickets?"), "Two nights and five tickets a night.", 2, 5, 0)
    let signed = tap(fresh_effects(heard), TapHostDeal)
    let h =
      Option.unwrap_or(haggle_of(signed), Skee.Host.new_haggle(k(), Boardwalk, Arcade.U64.of_int(0), VisitArrival))
    let deal = Skee.Host.final_comp(h)
    let closed = tap(fresh_effects(signed), TapCloseHost)
    let played = tap(closed, TapSkipWalkthrough)
    let w = Skee.App.wallet_of(signed.model)
    all([expect(h.haggle_status == HaggleSigned, "signed"), expect(deal.nights == offer_nights(heard), "the offer on the table"), expect(has_haptic(fx_of(signed), fn x -> is_notice(x, NoticeSuccess)), "the prize buzz"), expect(List.length(saves(fx_of(signed), KeyWallet)) == 1, "the wallet is saved"), expect(saves(fx_of(signed), KeyArrivalDone) == ["true"], "the arrival is done"), expect(comp_nights(w, Boardwalk) == deal.nights, "the nights are banked"), expect(!Skee.App.accepts(signed.model, TapHostDeal) && !Skee.App.accepts(signed.model, TapHostSend), "the table is over"), expect(Skee.App.accepts(signed.model, TapCloseHost), "LEARN TO PLAY"), expect(is_some_walk(Skee.App.walkthrough_of(closed.model)), "into the walkthrough"), expect(Skee.Units.tickets_int(Skee.App.extra_of(played.model)) == Skee.Units.tickets_int(deal.comp_tickets), "the first real game starts with the deal's tickets"), expect(comp_nights(Skee.App.wallet_of(played.model), Boardwalk) == deal.nights - 1, "and uses a night")])
  end

  fn comp_nights(w : Wallet, r : Room) : Int do
    match Skee.Rooms.room_at(w.comps, r) do
    Some(c) -> c.nights
    None -> 0
    end
  end

  fn a_deal_for_the_next_room_checks_into_it() : Outcome do
    let asked = due_host(2000, Some("true"))
    let hello =
      answer_reply(asked, "Dee here. The Neon Lounge is yours tonight.", 1, 0, 0)
    let signed = tap(hello, TapHostDeal)
    let closed = tap(fresh_effects(signed), TapCloseHost)
    let w = Skee.App.wallet_of(closed.model)
    all([expect(post_keys(asked) == ["1/1"], "a saved yes asks for the hello at once"), expect(!Skee.App.accepts(asked.model, TapHostConsent(true)), "no card"), expect(haggle_subtitle(asked) == "your host " ++ Skee.Presentation.middle_dot() ++ " The Neon Lounge", "the next room's host"), expect(wallet_wallet_room(closed.model) == NeonLounge && run_room(closed.model) == NeonLounge, "checked in"), expect(Skee.Rooms.room_at(w.rooms, NeonLounge), "the room is yours"), expect(Skee.App.screen_of(closed.model) == GameScreen, "on the game"), expect(!is_some(Skee.App.host_of(closed.model)), "the table is gone")])
  end

  fn a_host_who_walks_ends_the_table() : Outcome do
    let asked = due_host(2000, Some("true"))
    let hello =
      answer_reply(asked, "Dee here. The Neon Lounge is yours tonight.", 1, 0, 0)
    let pushed = type_and_send(hello, "Give me more nights")
    let walked =
      answer(pushed, 200, envelope(host_reply("I am done here.", 1, 0, 0, -1, true), "stop"))
    let h =
      Option.unwrap_or(haggle_of(walked), Skee.Host.new_haggle(k(), Boardwalk, Arcade.U64.of_int(0), VisitArrival))
    let closed = tap(walked, TapCloseHost)
    all([expect(h.haggle_status == HaggleWalked, "walked"), expect(List.length(saves(fx_of(walked), KeyWallet)) == 1, "settled: the opening offer is banked"), expect(comp_nights(Skee.App.wallet_of(walked.model), NeonLounge) == 1, "one night"), expect(Skee.App.accepts(walked.model, TapCloseHost) && !Skee.App.accepts(walked.model, TapHostDeal), "only CHECK IN"), expect(run_room(closed.model) == NeonLounge, "into the room")])
  end

  fn no_to_ai_chat_sends_nothing() : Outcome do
    let r = tap(fresh_effects(at_first_host(boot_fresh())), TapHostConsent(false))
    let typed = tap(deliver(r, MsgHostDraft("two nights")), TapHostSend)
    let left = tap(fresh_effects(r), TapCloseHost)
    all([expect(saves(fx_of(r), KeyHostConsent) == ["false"], "the answer is saved"), expect(List.is_empty(posts(fx_of(typed))), "nothing is sent"), expect(List.length(host_lines(typed)) == 1, "and no line taken"), expect(!Skee.App.accepts(r.model, TapHostSend), "SAY is off"), expect(Skee.App.accepts(r.model, TapHostDeal) && Skee.App.accepts(r.model, TapCloseHost), "sign or leave"), expect(is_some_walk(Skee.App.walkthrough_of(left.model)), "leaving the arrival starts the walkthrough"), expect(List.is_empty(saves(fx_of(left), KeyArrivalDone)) && List.is_empty(saves(fx_of(left), KeyWallet)), "with no deal, nothing is settled")])
  end

  fn reconsidering_asks_again() : Outcome do
    let off = tap(at_first_host(boot_fresh()), TapHostConsent(false))
    let again = tap(fresh_effects(off), TapHostReconsider)
    let yes = tap(fresh_effects(again), TapHostConsent(true))
    all([expect(saves(fx_of(again), KeyHostConsent) == [""], "the answer is forgotten"), expect(Skee.App.accepts(again.model, TapHostConsent(true)), "the card is back"), expect(post_keys(yes) == ["1/1"], "a yes asks for the hello")])
  end

  fn a_greeting_that_fails_leaves_the_stock_hello() : Outcome do
    let asked = tap(at_first_host(boot_fresh()), TapHostConsent(true))
    let failed = answer(asked, 503, "busy")
    let again = tap(fresh_effects(failed), TapHostRetry)
    all([expect(List.length(host_lines(failed)) == 1 && String.starts_with(Option.unwrap_or(List.head_opt(host_lines(failed)), ""), "Here's my offer"), "the stock hello shows"), expect(host_says(failed, fn s -> Skee.Host.greeting_failure(s) == Some(FailHttp(503, "busy"))), "the hello's failure"), expect(Skee.App.accepts(failed.model, TapHostSend) && Skee.App.accepts(failed.model, TapHostDeal), "the table goes on"), expect(Skee.App.accepts(failed.model, TapHostRetry), "RETRY asks again"), expect(post_keys(again) == ["1/2"], "for the hello")])
  end

  fn after_the_last_model_turn_only_sign_or_leave() : Outcome do
    let r =
      List.fold_left(List.range(0, 25), first_host_talking(), fn (acc, i) -> answer_reply(type_and_send(acc, "Tell me about the pier, part " ++ int_to_string(i)), "The pier is lovely at night.", 1, 0, 0))
    all([expect(List.length(host_lines(r)) == 51, "25 lines answered: " ++ int_to_string(List.length(host_lines(r)))), expect(!host_says(r, Skee.Host.takes_lines), "no 26th"), expect(!Skee.App.accepts(r.model, TapHostSend) && !Skee.App.accepts(r.model, TapHostNudge(0)), "SAY and the nudges are off"), expect(Skee.App.accepts(r.model, TapHostDeal) && Skee.App.accepts(r.model, TapCloseHost), "sign or leave")])
  end

  fn leaving_a_failed_table_settles_nothing() : Outcome do
    let asked = due_host(0, Some("true"))
    let talking = answer_reply(asked, "Sal here. One night, on me?", 1, 0, 0)
    let stuck = answer(type_and_send(talking, "Two nights?"), 429, "{}")
    let left = tap(fresh_effects(stuck), TapCloseHost)
    all([expect(Skee.App.accepts(stuck.model, TapCloseHost), "LEAVE while the failure shows"), expect(!is_some(Skee.App.host_of(left.model)), "the table is gone"), expect(List.is_empty(saves(fx_of(left), KeyWallet)) && List.is_empty(saves(fx_of(left), KeyRun)), "nothing settled or started"), expect(is_some(Skee.Rooms.host_due(Skee.App.wallet_of(left.model))), "the host is still due")])
  end

  fn is_some(o : Option(a)) : Bool do
    match o do
    Some(_) -> true
    None -> false
    end
  end

  fn the_prize_shop_buys_with_winnings() : Outcome do
    let r = into_game(boot_fresh())
    let s = stored(Skee.App.nothing_saved(), fx_of(r))
    let rich = { Skee.App.wallet_of(r.model) with balance: Winnings(100000) }
    let flush = boot_with({ s with saved_wallet: Some(Skee.Save.encode_wallet(rich)) }, 5)
    let poor = tap(tap(r, TapOpenShop), TapBuyPrize(Sticker))
    let bought = tap(tap(fresh_effects(flush), TapOpenShop), TapBuyPrize(Sticker))
    let again = tap(bought, TapBuyPrize(Sticker))
    all([expect(hud_top(poor.model) == LayerShop, "the shop is open"), expect(has_haptic(fx_of(poor), fn h -> is_notice(h, NoticeWarning)), "can't afford"), expect(List.member(wallet_owned(bought.model), Sticker), "bought"), expect(List.length(saves(fx_of(bought), KeyWallet)) == 1, "and saved"), expect(has_haptic(fx_of(bought), fn h -> is_notice(h, NoticeSuccess)), "the prize buzz"), expect(has_haptic(fx_of(again), fn h -> is_notice(h, NoticeWarning)), "already owned"), expect(hud_top(model_of(tap(bought, TapCloseShop))) == LayerBase, "closed")])
  end

  fn rooms_you_own_rebuild_on_the_title() : Outcome do
    let r = into_game(boot_fresh())
    let s = stored(Skee.App.nothing_saved(), fx_of(r))
    let w = Skee.App.wallet_of(r.model)
    let owner =
      boot_with({ s with saved_wallet: Some(Skee.Save.encode_wallet({ w with rooms: Skee.Rooms.room_put(w.rooms, HighRoller, true) })) }, 5)
    let not_owned = tap(owner, TapPickRoom(Penthouse))
    let moved = tap(fresh_effects(owner), TapPickRoom(HighRoller))
    let m = moved.model
    all([expect(run_room(not_owned.model) == Boardwalk, "a room you don't own stays shut"), expect(run_room(m) == HighRoller, "the new room's run"), expect(wallet_wallet_room(m) == HighRoller, "the wallet moved"), expect(Skee.App.screen_of(m) == TitleScreen, "back on the title"), expect(List.length(saves(fx_of(moved), KeyRun)) == 1, "its run is saved"), expect(List.length(saves(fx_of(moved), KeyWallet)) >= 1, "and the wallet")])
  end

  fn the_guide_opens_and_replays_the_lesson() : Outcome do
    let r = into_game(boot_fresh())
    let played = tap(r, TapPull)
    let opened = tap(played, TapOpenGuide)
    let replay = tap(opened, TapReplayLesson)
    let skipped = tap(replay, TapSkipWalkthrough)
    all([expect(hud_top(opened.model) == LayerGuide, "the guide is on top"), expect(!List.is_empty(hud_guide_topics(opened.model)), "with topics"), expect(is_some_walk(Skee.App.walkthrough_of(replay.model)), "the lesson again"), expect(List.is_empty(Skee.App.actions_of(replay.model)), "on the practice run"), expect(action_names(skipped.model) == ["pull BetOne"], "the parked run comes back"), expect(same_run(Skee.App.run_of(skipped.model), Skee.App.run_of(played.model)), "as it was")])
  end

  -- ---- Cases: tips ----
  -- Throws to the 50 until a tip card shows, at most `n` throws.
  fn until_tip(r : Run, n : Int, book : Skee.Bots.AimBook) : Run do
    let m = r.model
    if n <= 0 || tips_tip_showing(m) != None || !is_throwing(run_phase(m)) do
      r
    else
      until_tip(advance_once(r, book), n - 1, book)
    end
  end

  fn is_throwing(p : Phase) : Bool do
    phase_name(p) == "throwing"
  end

  fn a_tip_card_is_shown_saved_and_read() : Outcome do
    let r = into_game(boot_fresh())
    let book = book_for(r.model)
    let tipped = until_tip(fresh_effects(r), 40, book)
    let read = tap(skip(tipped), TapGotIt)
    match tips_tip_showing(tipped.model) do
    Some(t) -> do
      all([expect(saves(fx_of(tipped), KeyTips) == [Skee.Save.encode_tips([t])], "the tip is saved as seen"), expect(!is_nothing(hud_coach(model_of(skip(tipped)))), "its card shows"), expect(tips_tip_showing(read.model) == None, "GOT IT puts it away")])
    end
    None -> Mismatch("no tip in 40 balls")
    end
  end

  -- ---- Cases: the counter and the board tap ----
  fn a_board_tap_away_from_the_holes_drops_the_selection() : Outcome do
    let r = tap(into_game(boot_fresh()), TapSelectOffer(Some(0)))
    let tapped =
      deliver(r, MsgPointerDown({ sample_t: 0.0, sample_x: 2.0, sample_y: 2.0 }))
    all([expect(tapped.model.selected_offer == None, "the selection is dropped"), expect(List.is_empty(Skee.App.actions_of(tapped.model)), "nothing bought")])
  end

  fn visibility_quiets_the_room() : Outcome do
    let rolling = ticks(flick(skip(tap(into_game(boot_fresh()), TapPull))), 30)
    let hidden = deliver(fresh_effects(rolling), MsgVisible(false))
    all([expect(List.all(rumbles(fx_of(hidden)), fn x -> x == 0.0), "the rumble stops"), expect(List.all(drums(fx_of(hidden)), fn x -> !x), "the drum stops"), expect(hidden.model.last_render == None, "the clock restarts")])
  end

