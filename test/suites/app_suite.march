        CueTallyMult(5),
        CueFrameDone,
        CueLineWon,
        CueJackpot,
        CueBanner("CLEARED"),
        CueFoul
      ]
    let want =
      [
        "SndLaunch",
        "SndRail",
        "SndHump",
        "SndLip",
        "SndBackwall",
        "SndLanded",
        "SndDrop(Ring40)",
        "SndGutter",
        "SndHop",
        "SndWhoosh",
        "SndHotSpot",
        "SndLever",
        "SndPullWin(3)",
        "SndReelTick",
        "SndReelStop",
        "SndCombo(2)",
        "SndTallyChips(4)",
        "SndTallyMult(5)",
        "SndFrameDone",
        "SndLineWon",
        "SndJackpot",
        "SndBanner(CLEARED)",
        "SndFoul"
      ]
    let got = List.map(cues, fn c -> sound_name(Skee.App.sound_of(c)))
    expect(got == want, "cue sounds: " ++ String.join(got, " "))
