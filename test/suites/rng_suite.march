mod RngSuite do

  -- Parity of the numeric foundation against the real Swift: float bit reading,
  -- constants, the math module and SplitMix64. All expected values come from
  -- test/golden/rng.march, generated by tools/golden.
  import Arcade.Test.Harness

  fn golden() : List(List(String)) do
    Arcade.Test.GoldenIo.rows(Golden.Rng.chunks())
  end

  fn kind(k : String) : List(List(String)) do
    Arcade.Test.GoldenIo.of_kind(golden(), k)
  end

  fn bits_row(row : List(String)) : Outcome do
    match row do
    Cons(bits, Cons(text, Nil)) -> do
      Arcade.Test.GoldenIo.expect_float(Arcade.Test.GoldenIo.float_of_decimal(text), bits, text)
    end
    _ -> Mismatch("bad row")
    end
  end

  fn single(k : String) : String do
    match kind(k) do
    Cons(Cons(token, Nil), Nil) -> token
    _ -> panic("expected one row of kind " ++ k)
    end
  end

  fn huge() : Float do
    Arcade.Test.GoldenIo.float_of_decimal("1e308")
  end

  fn non_finite() : Outcome do
    all([Arcade.Test.GoldenIo.expect_float(huge() *. 10.0, single("posinf"), "+inf"), Arcade.Test.GoldenIo.expect_float(0.0 -. huge() *. 10.0, single("neginf"), "-inf"), Arcade.Test.GoldenIo.expect_float(Math.sqrt(0.0 -. 1.0), single("nan"), "nan")])
  end

  fn const_row(row : List(String)) : Outcome do
    let k = Skee.Consts.make()
    match row do
    Cons("pi", Cons(bits, Nil)) -> do
      all([Arcade.Test.GoldenIo.expect_float(k.pi, bits, "pi"), Arcade.Test.GoldenIo.expect_float(k.num.pi, bits, "num.pi")])
    end
    Cons("tau", Cons(bits, Nil)) -> do
      all([Arcade.Test.GoldenIo.expect_float(k.tau, bits, "tau"), Arcade.Test.GoldenIo.expect_float(k.num.tau, bits, "num.tau")])
    end
    Cons("dt", Cons(bits, Nil)) -> Arcade.Test.GoldenIo.expect_float(k.dt, bits, "dt")
    Cons("unit53", Cons(bits, Nil)) -> do
      all([Arcade.Test.GoldenIo.expect_float(k.unit53, bits, "unit53"), Arcade.Test.GoldenIo.expect_float(k.num.unit53, bits, "num.unit53")])
    end
    Cons("floor_u1", Cons(bits, Nil)) -> do
      all([Arcade.Test.GoldenIo.expect_float(k.floor_u1, bits, "floor_u1"), Arcade.Test.GoldenIo.expect_float(k.num.floor_u1, bits, "num.floor_u1")])
    end
    _ -> Mismatch("unknown constant row")
    end
  end

  fn f(token : String) : Float do
    Arcade.Test.GoldenIo.float_of_bits(token)
  end

  fn clamp_row(row : List(String)) : Outcome do
    match row do
    Cons(x, Cons(lo, Cons(hi, Cons(want, Nil)))) -> do
      Arcade.Test.GoldenIo.expect_float(Arcade.Num.clamp(f(x), f(lo), f(hi)), want, "clamp " ++ x)
    end
    _ -> Mismatch("bad clamp row")
    end
  end

  fn clamp_int_row(row : List(String)) : Outcome do
    let n = List.map(row, Arcade.Test.GoldenIo.int)
    match n do
    Cons(x, Cons(lo, Cons(hi, Cons(want, Nil)))) -> expect_int(Arcade.Num.clamp_int(x, lo, hi), want, "clamp_int")
    _ -> Mismatch("bad clampi row")
    end
  end

  fn degrees_row(row : List(String)) : Outcome do
    match row do
    Cons(d, Cons(want, Nil)) -> do
      Arcade.Test.GoldenIo.expect_float(Arcade.Num.degrees(Arcade.Numerics.make(), f(d)), want, "degrees " ++ d)
    end
    _ -> Mismatch("bad deg row")
    end
  end

  fn expect_vec(v : Arcade.Vec2.Vec2, x : String, y : String, what : String) : Outcome do
    all([Arcade.Test.GoldenIo.expect_float(v.x, x, what ++ ".x"), Arcade.Test.GoldenIo.expect_float(v.y, y, what ++ ".y")])
  end

  fn vec_row(row : List(String)) : Outcome do
    match row do
    Cons(ax, Cons(ay, Cons(cx, Cons(cy, Cons(k, Cons(sx, Cons(sy, Cons(dx, Cons(dy, Cons(mx, Cons(my, Cons(nx, Cons(ny, Cons(dot, Cons(len, Cons(ux, Cons(uy, Nil))))))))))))))))) -> do
      let a = Arcade.Vec2.vec2(f(ax), f(ay))
      let c = Arcade.Vec2.vec2(f(cx), f(cy))
      all([expect_vec(Arcade.Vec2.add(a, c), sx, sy, "add"), expect_vec(Arcade.Vec2.sub(a, c), dx, dy, "sub"), expect_vec(Arcade.Vec2.scale(a, f(k)), mx, my, "scale"), expect_vec(Arcade.Vec2.neg(a), nx, ny, "neg"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.dot(a, c), dot, "dot"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.length(a), len, "length"), expect_vec(Arcade.Vec2.normalized(a), ux, uy, "normalized")])
    end
    _ -> Mismatch("bad vec row")
    end
  end

  fn vec_zero() : Outcome do
    let z = Arcade.Vec2.zero()
    match kind("veczero") do
    Cons(Cons(nx, Cons(ny, Cons(len, Nil))), Nil) -> do
      all([expect_vec(Arcade.Vec2.normalized(z), nx, ny, "zero.normalized"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.length(z), len, "zero.length")])
    end
    _ -> Mismatch("expected one veczero row")
    end
  end

  fn vec_examples() : Outcome do
    let v =
      Arcade.Vec2.add(Arcade.Vec2.vec2(1.0, 2.0), Arcade.Vec2.vec2(3.0, 0.0 -. 1.0))
    all([expect(Arcade.Vec2.equal(v, Arcade.Vec2.vec2(4.0, 1.0)), "add and scale: sum"), expect(Arcade.Vec2.equal(Arcade.Vec2.scale(v, 2.0), Arcade.Vec2.vec2(8.0, 2.0)), "add and scale: product"), expect(Arcade.Vec2.length(Arcade.Vec2.vec2(3.0, 4.0)) == 5.0, "length of 3,4"), expect(Arcade.Vec2.dot(Arcade.Vec2.vec2(1.0, 0.0), Arcade.Vec2.vec2(0.0, 1.0)) == 0.0, "perpendicular dot"), expect(Arcade.Vec2.equal(Arcade.Vec2.normalized(Arcade.Vec2.vec2(3.0, 4.0)), Arcade.Vec2.vec2(0.6, 0.8)), "normalized 3,4")])
  end

  -- Replay one kind of row in file order. Rows of one seed are contiguous, and
  -- the generator carries from row to row, so any drift fails every later row.
  fn replay(rows : List(List(String)), step : Arcade.Rng.Rng -> List(String) -> (Outcome, Arcade.Rng.Rng)) : Outcome do
    let start = (("", Arcade.Rng.seed(Arcade.U64.make(0, 0))), [])
    let (_, outcomes) =
      List.fold_left(rows, start, fn (acc, row) ->
        match (acc, row) do
        (((prev, rng), outs), Cons(seed, rest)) -> do
          let current =
            if seed == prev do
              rng
            else
              Arcade.Rng.seed(Arcade.Test.GoldenIo.u64(seed))
            end
          let (outcome, after) = step(current, rest)
          ((seed, after), Cons(outcome, outs))
        end
        (_, Nil) -> panic("empty golden row")
        end
      )
    all(outcomes)
  end

  fn next_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    let (v, after) = Arcade.Rng.next(rng)
    match row do
    Cons(_, Cons(want, Cons(word, Nil))) -> do
      (all([Arcade.Test.GoldenIo.expect_u64(v, want, "next"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad next row"), after)
    end
  end

  fn unit_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    let (v, after) = Arcade.Rng.next_unit(Arcade.Numerics.make(), rng)
    match row do
    Cons(_, Cons(want, Cons(word, Nil))) -> do
      (all([Arcade.Test.GoldenIo.expect_float(v, want, "unit"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad unit row"), after)
    end
  end

  fn below_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    match row do
    Cons(_, Cons(bound, Cons(want, Cons(word, Nil)))) -> do
      let (v, after) = Arcade.Rng.next_int_below(rng, Arcade.Test.GoldenIo.int(bound))
      (all([expect_int(v, Arcade.Test.GoldenIo.int(want), "below " ++ bound), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad below row"), rng)
    end
  end

  fn gauss_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    let (v, after) = Arcade.Rng.next_gaussian(Arcade.Numerics.make(), rng)
    match row do
    Cons(_, Cons(want, Cons(word, Nil))) -> do
      (all([Arcade.Test.GoldenIo.expect_libm_float(v, want, "gaussian"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad gauss row"), after)
    end
  end

  fn expect_ints(actual : List(Int), expected : List(String), what : String) : Outcome do
    expect(actual == List.map(expected, Arcade.Test.GoldenIo.int), what ++ ": got " ++ show(actual))
  end

  fn shuffle_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    match row do
    Cons(n, Cons(word, want)) -> do
      let (out, after) = Arcade.Rng.shuffled(rng, List.range(0, Arcade.Test.GoldenIo.int(n)))
      (all([expect_ints(out, want, "shuffle " ++ n), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad shuffle row"), rng)
    end
  end

  fn pick_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    match row do
    Cons(_, Cons(count, Cons(want, Cons(word, Nil)))) -> do
      let (v, after) =
        Arcade.Rng.pick(rng, List.range(100, 100 + Arcade.Test.GoldenIo.int(count)))
      (all([expect_int(v, Arcade.Test.GoldenIo.int(want), "pick"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(after), word, "state")]), after)
    end
    _ -> (Mismatch("bad pick row"), rng)
    end
  end

  fn mixed_step(rng : Arcade.Rng.Rng, row : List(String)) : (Outcome, Arcade.Rng.Rng) do
    let k = Skee.Consts.make()
    let (a, r1) = Arcade.Rng.next(rng)
    let (u, r2) = Arcade.Rng.next_unit(k.num, r1)
    let (below, r3) = Arcade.Rng.next_int_below(r2, 20)
    let (z, r4) = Arcade.Rng.next_gaussian(k.num, r3)
    let (s, r5) = Arcade.Rng.shuffled(r4, [0, 1, 2, 3, 4])
    let (p, r6) = Arcade.Rng.pick(r5, [7, 8, 9])
    match row do
    Cons(_, Cons(wa, Cons(wu, Cons(wk, Cons(wz, Cons(wp, Cons(word, ws))))))) -> do
      (all([Arcade.Test.GoldenIo.expect_u64(a, wa, "next"), Arcade.Test.GoldenIo.expect_float(u, wu, "unit"), expect_int(below, Arcade.Test.GoldenIo.int(wk), "below"), Arcade.Test.GoldenIo.expect_libm_float(z, wz, "gaussian"), expect_ints(s, ws, "shuffled"), expect_int(p, Arcade.Test.GoldenIo.int(wp), "pick"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(r6), word, "state")]), r6)
    end
    _ -> (Mismatch("bad mixed row"), r6)
    end
  end

  fn shuffle_is_permutation() : Outcome do
    let xs = List.range(0, 20)
    let rng = Arcade.Rng.seed(Arcade.U64.of_int(3))
    let (a, _) = Arcade.Rng.shuffled(rng, xs)
    let (b, _) = Arcade.Rng.shuffled(rng, xs)
    all([expect(a == b, "same seed, same shuffle"), expect(List.sort_by(a, fn (x, y) -> x < y) == xs, "shuffle is a permutation")])
  end

  fn libm_rows(name : String, apply : Float -> Float) : Outcome do
    all(List.filter_map(kind("libm"), fn row ->
      match row do
      Cons(n, Cons(x, Cons(want, Nil))) -> do
        if n == name do
          Some(Arcade.Test.GoldenIo.expect_libm_float(apply(f(x)), want, name ++ " " ++ x))
        else
          None
        end
      end
      _ -> Some(Mismatch("bad libm row"))
      end
    ))
  end

  fn atan2_rows() : Outcome do
    all(List.map(kind("libm2"), fn row ->
      match row do
      Cons(_, Cons(y, Cons(x, Cons(want, Nil)))) -> do
        Arcade.Test.GoldenIo.expect_libm_float(Math.atan2(f(y), f(x)), want, "atan2 " ++ y)
      end
      _ -> Mismatch("bad libm2 row")
      end
    ))
  end

  fn sqrt_rows() : Outcome do
    all(List.filter_map(kind("libm"), fn row ->
      match row do
      Cons("sqrt", Cons(x, Cons(want, Nil))) -> do
        Some(Arcade.Test.GoldenIo.expect_float(Math.sqrt(f(x)), want, "sqrt " ++ x))
      end
      _ -> None
      end
    ))
  end

  fn div_row(row : List(String)) : Outcome do
    match row do
    Cons(a, Cons(b, Cons(want, Nil))) -> do
      Arcade.Test.GoldenIo.expect_float(Arcade.Num.ieee_div(Arcade.Numerics.make(), f(a), f(b)), want, "div " ++ a ++ " " ++ b)
    end
    _ -> Mismatch("bad div row")
    end
  end

  fn clamp_nan() : Outcome do
    match kind("clampnan") do
    Cons(Cons(want, Nil), Nil) -> do
      Arcade.Test.GoldenIo.expect_float(Arcade.Num.clamp(Math.sqrt(0.0 -. 1.0), 0.0, 1.0), want, "clamp nan")
    end
    _ -> Mismatch("expected one clampnan row")
    end
  end

  fn first_value() : Outcome do
    let (v, _) = Arcade.Rng.next(Arcade.Rng.seed(Arcade.U64.make(0, 0)))
    expect(Arcade.U64.equal(v, Arcade.U64.make(3793791033, 2065550767)), "reference value 0xE220A8397B1DCDAF")
  end

  -- A comparator that cannot fail proves nothing, so prove this one can.
  fn comparator_controls() : Outcome do
    let zero = Arcade.Test.GoldenIo.float_bits(0.0)
    let minus_zero = Arcade.Test.GoldenIo.float_bits(-0.0)
    let one = f("3ff0000000000000")
    let next_up = f("3ff0000000000001")
    let is_mismatch =
      fn o ->
        match o do
        Mismatch(_) -> true
        Passed(_) -> false
        Drifted(_, _, _) -> false
        end
    all([expect(!Arcade.U64.equal(zero, minus_zero), "0.0 and -0.0 have different bits"), expect(is_mismatch(Arcade.Test.GoldenIo.expect_float(next_up, "3ff0000000000000", "control")), "one ulp is a mismatch"), expect(Arcade.U64.equal(Arcade.Test.GoldenIo.float_bits(one), Arcade.Test.GoldenIo.u64("3ff0000000000000")), "1.0 reads back")])
  end

  fn cases() : List(Case) do
    [
      case("the float comparator tells values apart", fn () -> comparator_controls()),
      case("float bits read back exactly", fn () -> all(List.map(kind("bits"), bits_row))),
      case("non-finite floats read back exactly", fn () -> non_finite()),
      case("constants match Swift bit for bit", fn () -> all(List.map(kind("const"), const_row))),
      case("clamp keeps Swift's argument order", fn () -> all(List.map(kind("clamp"), clamp_row))),
      case("clamp leaves NaN alone", fn () -> clamp_nan()),
      case("clamp on Ints", fn () -> all(List.map(kind("clampi"), clamp_int_row))),
      case("ieee_div divides by zero as Swift does", fn () -> all(List.map(kind("div"), div_row))),
      case("degrees", fn () -> all(List.map(kind("deg"), degrees_row))),
      case("Vec2 examples from MathAndRandomTests", fn () -> vec_examples()),
      case("Vec2 ops", fn () -> all(List.map(kind("vec"), vec_row))),
      case("the zero vector stays zero", fn () -> vec_zero()),
      case("next matches Swift", fn () -> replay(kind("next"), next_step)),
      case("next_unit matches Swift", fn () -> replay(kind("unit"), unit_step)),
      case("next_int_below matches Swift", fn () -> replay(kind("below"), below_step)),
      case("next_gaussian matches Swift", fn () -> replay(kind("gauss"), gauss_step)),
      case("shuffled matches Swift", fn () -> replay(kind("shuffle"), shuffle_step)),
      case("pick matches Swift", fn () -> replay(kind("pick"), pick_step)),
      case("draws interleave exactly as in Swift", fn () -> replay(kind("mixed"), mixed_step)),
      case("shuffle is a deterministic permutation", fn () -> shuffle_is_permutation()),
      case("libm sin", fn () -> libm_rows("sin", Math.sin)),
      case("libm cos", fn () -> libm_rows("cos", Math.cos)),
      case("libm log", fn () -> libm_rows("log", Math.log)),
      case("libm atan2", fn () -> atan2_rows()),
      case("sqrt is exact everywhere", fn () -> sqrt_rows()),
      case("known first value for seed 0", fn () -> first_value())
    ]
  end

end
