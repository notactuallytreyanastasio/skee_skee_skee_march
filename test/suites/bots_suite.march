mod BotsSuite do

  -- Owned by the reducer piece. The ported Swift BotTests, and goldens from
  -- tools/golden/Sources/golden-bots. Whole bot runs come from golden-run.
  import Arcade.Test.Harness
  import Skee.Bots

  fn consts() : Skee.Consts.Consts do
    Skee.Consts.make()
  end

  fn standard() : Table do
    Skee.Types.standard_table(consts())
  end

  fn aim_book_finds_a_window_for_every_hole() : Outcome do
    let k = consts()
    let t = standard()
    let book = aim_book(k, t, 120, default_aims(), 0.0, ClassicBall)
    all(List.map(Skee.HoleMap.reel_holes(), fn hole ->
      match Skee.HoleMap.at(book.best, hole) do
      None -> Mismatch("no window for " ++ show(hole))
      Some(w) -> do
        let r =
          Skee.Physics.simulate_shot(k, w.launch, t, ClassicBall, Arcade.U64.of_int(0))
        expect(r.hole == hole, "window for " ++ show(hole) ++ " lands in " ++ show(r.hole))
      end
      end
    ))
  end

  fn perfect_bot_hits_what_it_aims_at() : Outcome do
    let k = consts()
    let t = standard()
    let book = aim_book(k, t, 160, [0.0], 0.0, ClassicBall)
    match Skee.HoleMap.at(book.best, Ring50) do
    None -> Mismatch("no window for the 50")
    Some(w) -> do
      let (l, _) = perturb(k, perfect(), w.launch, Arcade.Rng.seed(Arcade.U64.of_int(1)))
      let r = Skee.Physics.simulate_shot(k, l, t, ClassicBall, Arcade.U64.of_int(0))
      expect(r.hole == Ring50, "landed in " ++ show(r.hole))
    end
    end
  end

  -- ---- Goldens ----
  fn f(token : String) : Float do
    Arcade.Test.GoldenIo.float_of_bits(token)
  end

  fn skill_at(token : String) : Skill do
    List.nth(all_skills(), Arcade.Test.GoldenIo.int(token))
  end

  fn hand_row(row : List(String)) : Outcome do
    match row do
    Cons(seed, Cons(skill, Cons(power, Cons(aim, Cons(start, Cons(fold, Cons(new_power, Cons(new_aim, Cons(word, Nil))))))))) -> do
      let k = consts()
      let l =
        Skee.Physics.launch_of_power(k, f(power), f(aim), f(start), f(fold), 0.0, 0.0)
      let (out, hand) =
        perturb(k, skill_at(skill), l, Arcade.Rng.seed(Arcade.Test.GoldenIo.u64(seed)))
      all([Arcade.Test.GoldenIo.expect_libm_float(out.power, new_power, "power"), Arcade.Test.GoldenIo.expect_libm_float(out.aim, new_aim, "aim"), Arcade.Test.GoldenIo.expect_float(out.start, start, "start"), Arcade.Test.GoldenIo.expect_float(out.fold, fold, "fold"), Arcade.Test.GoldenIo.expect_u64(Arcade.Rng.word(hand), word, "rng")])
    end
    _ -> Mismatch("bad hand row")
    end
  end

  fn grid_hash(book : AimBook) : Int do
    List.fold_left(book.grid, Arcade.Test.Digest.start(), fn (h, row) -> List.fold_left(row, h, fn (acc, hole) -> Arcade.Test.Digest.word(acc, RunDigest.hole_index(hole))))
  end

  type BookSpec = {
    table : Table,
    ball : BallKind,
    steps : Int,
    grid_digest : String
  }

  fn book_table(row : List(String)) : BookSpec do
    match row do
    Cons(room, Cons(ante, Cons(boss, Cons(ball, Cons(steps, Cons(digest, Nil)))))) -> do
      let k = consts()
      let kind = List.nth(Skee.Items.all_balls(), Arcade.Test.GoldenIo.int(ball))
      let base =
        Skee.Rooms.table(k, List.nth(Skee.Rooms.all_rooms(), Arcade.Test.GoldenIo.int(room)))
      let tight = Skee.Items.difficulty_table(Arcade.Test.GoldenIo.int(ante), base, 8)
      let bossed =
        if boss == "n" do
          tight
        else
          Skee.Items.modify_for_boss(List.nth(Skee.Items.all_bosses(), Arcade.Test.GoldenIo.int(boss)), tight)
        end
      {
        table: Skee.Items.modify_for_ball(kind, bossed),
        ball: kind,
        steps: Arcade.Test.GoldenIo.int(steps),
        grid_digest: digest
      }
    end
    _ -> panic("bad book row")
    end
  end

  fn window_row(book : AimBook, row : List(String)) : Outcome do
    match row do
    Cons(hole, Cons(power, Cons(aim, Cons(width, Nil)))) -> do
      match Skee.HoleMap.at(book.best, List.nth(Skee.HoleMap.all_holes(), Arcade.Test.GoldenIo.int(hole))) do
      None -> Mismatch("no window for hole " ++ hole)
      Some(w) -> do
        all([Arcade.Test.GoldenIo.expect_float(w.launch.power, power, "window power"), Arcade.Test.GoldenIo.expect_float(w.launch.aim, aim, "window aim"), Arcade.Test.GoldenIo.expect_float(w.width, width, "window width")])
      end
      end
    end
    _ -> Mismatch("bad window row")
    end
  end

  fn rate_row(rates : List(PerHole(Option(PerHole(Float)))), row : List(String)) : Outcome do
    match row do
    Cons(skill, Cons(hole, shares)) -> do
      let spread =
        Skee.HoleMap.at(List.nth(rates, Arcade.Test.GoldenIo.int(skill)), List.nth(Skee.HoleMap.all_holes(), Arcade.Test.GoldenIo.int(hole)))
      match spread do
      None -> Mismatch("no rates for hole " ++ hole)
      Some(s) -> do
        let pairs = List.zip(Skee.HoleMap.all_holes(), shares)
        all(List.map(pairs, fn pair -> Arcade.Test.GoldenIo.expect_float(Skee.HoleMap.at(s, Tuple.first(pair)), Tuple.second(pair), "rate")))
      end
      end
    end
    _ -> Mismatch("bad rate row")
    end
  end

  fn book_rows(row : List(String), rows : List(List(String))) : Outcome do
    let k = consts()
    let spec = book_table(row)
    let book = aim_book(k, spec.table, spec.steps, default_aims(), 0.0, spec.ball)
    let rates =
      List.map(all_skills(), fn skill -> landings(k, book, spec.table, skill, spec.ball))
    let windows = Arcade.Test.GoldenIo.of_kind(rows, "window")
    let shares = Arcade.Test.GoldenIo.of_kind(rows, "rate")
    all([expect_string(int_to_string(grid_hash(book)), spec.grid_digest, "grid"), all(List.map(windows, fn r -> window_row(book, r))), all(List.map(shares, fn r -> rate_row(rates, r)))])
  end

  -- A book row owns the rows after it, up to the next book row.
  fn book_groups(rows : List(List(String)), acc : List((List(String), List(List(String))))) : List((List(String), List(List(String)))) do
    match rows do
    Nil -> List.reverse(acc)
    Cons(row, rest) -> do
      match row do
      Cons("book", spec) -> do
        let is_book = fn r -> List.head_opt(r) == Some("book")
        let mine = List.take_while(rest, fn r -> !is_book(r))
        book_groups(List.drop_while(rest, fn r -> !is_book(r)), Cons((spec, mine), acc))
      end
      _ -> book_groups(rest, acc)
      end
    end
    end
  end

  -- ---- Whole runs ----
  -- Bot runs from golden-run: the bot plays again here, every action must be
  -- Swift's, and the run must end in Swift's state. Native plays two runs, which
  -- takes minutes; JS plays the first 24: every ball, room and skill.
  type BotGolden = {
    seed : Arcade.U64.U64,
    room : Room,
    skill : Skill,
    ball : BallKind,
    actions : List(String),
    end_digest : String
  }

  fn skill_named(name : String) : Skill do
    match List.find(all_skills(), fn s -> s.skill_name == name) do
    Some(s) -> s
    None -> panic("bad skill: " ++ name)
    end
  end

  fn golden_bot(label : String, seed : String, room : String, rows : List(List(String))) : BotGolden do
    match String.split(label, ",") do
    Cons(_, Cons(skill, Cons(ball, Nil))) -> do
      let steps =
        List.filter_map(rows, fn r ->
          match r do
          Cons("s", Cons(token, Cons(digest, _))) -> Some((token, digest))
          Cons("t", Cons(token, Cons(_, Cons(_, Cons(digest, _))))) -> Some((token, digest))
          _ -> None
          end
        )
      let last_digest =
        match List.reverse(steps) do
        Cons((_, digest), _) -> digest
        Nil -> ""
        end
      {
        seed: Arcade.Test.GoldenIo.u64(seed),
        room: List.nth(Skee.Rooms.all_rooms(), Arcade.Test.GoldenIo.int(room)),
        skill: skill_named(skill),
        ball: List.nth(Skee.Items.all_balls(), Arcade.Test.GoldenIo.int(ball)),
        actions: List.map(steps, Tuple.first),
        end_digest: last_digest
      }
    end
    _ -> panic("bad bot label: " ++ label)
    end
  end

  fn golden_bots(rows : List(List(String)), acc : List(BotGolden)) : List(BotGolden) do
    let is_run = fn r -> List.head_opt(r) == Some("run")
    match List.drop_while(rows, fn r -> !is_run(r)) do
    Nil -> List.reverse(acc)
    Cons(head, rest) -> do
      let mine = List.take_while(rest, fn r -> !is_run(r))
      let others = List.drop_while(rest, fn r -> !is_run(r))
      match head do
      Cons(_, Cons(label, Cons(seed, Cons(room, _)))) -> do
        if String.starts_with(label, "bot,") do
          golden_bots(others, Cons(golden_bot(label, seed, room, mine), acc))
        else
          golden_bots(others, acc)
        end
      end
      _ -> golden_bots(others, acc)
      end
    end
    end
  end

  fn compare_launch(a : Launch, b : Launch, what : String) : Outcome do
    all([near(a.power, b.power, what ++ " power"), near(a.aim, b.aim, what ++ " aim")])
  end

  -- The hand adds noise to a launch, and the noise goes through libm. Exact on
  -- native. On JS the noise is within Arcade.Test.GoldenIo.libm_ulps(), but a sum that lands
  -- near zero has far smaller ulps than the noise it came from, so ulps of the sum
  -- mean nothing there. The allowance is 2^-51: two ulps of 1, the largest the
  -- noise reaches. It covers the bot's hand only, and always reports. The state
  -- the run ends in is still compared exactly.
  fn near(a : Float, b : Float, what : String) : Outcome do
    let ulps =
      Arcade.Test.GoldenIo.ulps_between(Arcade.Test.GoldenIo.float_bits(a), Arcade.Test.GoldenIo.float_bits(b))
    let apart = if a > b do a -. b else b -. a end
    let k = consts()
    if ulps == 0 do
      Passed(1)
    else
      if on_js() && apart <= k.unit53 *. 4.0 do
        Drifted(1, 1, ulps)
      else
        Mismatch(what ++ ": " ++ int_to_string(ulps) ++ " ulp from Swift's")
      end
    end
  end

  fn compare_action(got : Action, want : Action, at : Int) : Outcome do
    let what = "action #" ++ int_to_string(at)
    match (got, want) do
    (ThrowBall(a), ThrowBall(b)) -> compare_launch(a, b, what)
    (_, _) -> expect_string(show(got), show(want), what)
    end
  end

  fn compare_actions(got : List(Action), want : List(Action), at : Int, acc : List(Outcome)) : List(Outcome) do
    match (got, want) do
    (Nil, Nil) -> acc
    (Cons(a, more_got), Cons(b, more_want)) -> do
      let o = compare_action(a, b, at)
      match o do
      Mismatch(_) -> Cons(o, acc)
      Passed(_) -> compare_actions(more_got, more_want, at + 1, Cons(o, acc))
      Drifted(_, _, _) -> compare_actions(more_got, more_want, at + 1, Cons(o, acc))
      end
    end
    (Nil, Cons(_, _)) -> Cons(Mismatch("bot stopped early at #" ++ int_to_string(at)), acc)
    (Cons(_, _), Nil) -> Cons(Mismatch("bot played on past #" ++ int_to_string(at)), acc)
    end
  end

  fn bot_matches(k : Skee.Consts.Consts, g : BotGolden, books : Books) : (Outcome, Books) do
    let (run, next_books) =
      play_bot_run(k, g.seed, g.skill, Skee.Types.standard_config(), g.room, g.ball, books)
    let want = List.map(g.actions, fn token -> ReducerSuite.action_of(k, token))
    let compared = compare_actions(run.bot_actions, want, 0, [])
    let digest =
      expect_string(int_to_string(RunDigest.run(run.bot_final)), g.end_digest, "end state")
    (all(Cons(digest, compared)), next_books)
  end

  fn bot_runs_match(picked : List(BotGolden)) : Outcome do
    let k = consts()
    let (outcomes, _) =
      List.fold_left(picked, ([], no_books()), fn (held, g) ->
        let (done, books) = held
        let (o, next) = bot_matches(k, g, books)
        (Cons(o, done), next)
      )
    all(outcomes)
  end

  fn bot_run_is_deterministic() : Outcome do
    let k = consts()
    let play =
      fn books -> play_bot_run(k, Arcade.U64.of_int(4), regular(), Skee.Types.standard_config(), Boardwalk, ClassicBall, books)
    let (a, books) = play(no_books())
    let (b, _) = play(books)
    all([expect_int(RunDigest.run(a.bot_final), RunDigest.run(b.bot_final), "final"), expect_int(List.length(a.bot_actions), List.length(b.bot_actions), "actions")])
  end

  fn rounds_cleared(k : Skee.Consts.Consts, skill : Skill) : Int do
    let (total, _) =
      List.fold_left([1, 2, 3, 4, 5, 6], (0, no_books()), fn (held, seed) ->
        let (n, books) = held
        let (run, next) =
          play_bot_run(k, Arcade.U64.of_int(seed), skill, Skee.Types.standard_config(), Boardwalk, Comet, books)
        let done = run.bot_final
        (n + done.stats.rounds_cleared, next)
      )
    total
  end

  -- On the comet: the base game is tuned so a shaky hand wins often, which is the
  -- point, so skill shows where it is meant to.
  fn skill_matters() : Outcome do
    let k = consts()
    expect(rounds_cleared(k, expert()) > rounds_cleared(k, novice()), "expert beats novice")
  end

  fn cases() : List(Case) do
    let rows = Arcade.Test.GoldenIo.rows(Golden.Bots.chunks())
    let bots = golden_bots(Arcade.Test.GoldenIo.rows(Golden.Run.chunks()), [])
    [
      case("aim book finds a window for every hole", fn () -> aim_book_finds_a_window_for_every_hole()),
      case("perfect bot hits what it aims at", fn () -> perfect_bot_hits_what_it_aims_at()),
      case("hand noise goldens", fn () -> all(List.map(Arcade.Test.GoldenIo.of_kind(rows, "hand"), hand_row))),
      case("aim book and landing goldens", fn () -> all(List.map(book_groups(rows, []), fn g -> book_rows(Tuple.first(g), Tuple.second(g))))),
      case("bot run is deterministic", fn () -> bot_run_is_deterministic()),
      case("skill matters", fn () -> skill_matters()),
      case("bot runs match Swift's, action by action", fn () -> bot_runs_match(List.take(bots, if on_js() do 24 else 2 end)))
    ]
  end

end
