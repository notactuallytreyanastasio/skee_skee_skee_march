-- The test harness shared by forge test (native) and the plain-main runners
-- (native and JS). `test` blocks do not run on the JS target, so a suite is
-- data: a list of named cases that both entry points execute.
mod Harness do
  needs IO.Console

  -- How a case went. Passed counts the values that matched exactly. Drifted
  -- is Passed plus a measured, declared tolerance: `differing` of `values`
  -- were not bit-identical, the worst by `max_ulps`. It can only be produced
  -- on the JS target, for values that went through libm, and it is always
  -- printed. A case that compared nothing is a failure, so an empty golden
  -- table can never look green.
  type Outcome = Passed(Int) | Drifted(Int, Int, Int) | Mismatch(String)

  type Case = { name : String, run : () -> Outcome }

  -- True on the JS target. string_to_int refuses what a double cannot hold.
  fn on_js() : Bool do
    match string_to_int("9007199254740993") do
      Some(_) -> false
      None -> true
    end
  end

  fn case(name : String, run : () -> Outcome) : Case do
    { name: name, run: run }
  end

  fn expect(ok : Bool, message : String) : Outcome do
    if ok do Passed(1) else Mismatch(message) end
  end

  fn expect_int(actual : Int, expected : Int, what : String) : Outcome do
    if actual == expected do
      Passed(1)
    else
      Mismatch(what ++ ": got " ++ int_to_string(actual) ++ ", want " ++ int_to_string(expected))
    end
  end

  fn expect_string(actual : String, expected : String, what : String) : Outcome do
    if actual == expected do Passed(1) else Mismatch(what ++ ": got " ++ actual ++ ", want " ++ expected) end
  end

  type Tally = { values : Int, differing : Int, max_ulps : Int, bad : Int, shown : List(String) }

  fn tally(acc : Tally, o : Outcome) : Tally do
    match o do
      Passed(n) -> { acc with values: acc.values + n }
      Drifted(n, d, u) ->
        {
          acc with
          values: acc.values + n,
          differing: acc.differing + d,
          max_ulps: Math.max_int(acc.max_ulps, u)
        }
      Mismatch(m) ->
        let keep = if acc.bad < 5 do Cons(m, acc.shown) else acc.shown end
        { acc with bad: acc.bad + 1, shown: keep }
    end
  end

  -- Fold outcomes into one, keeping the totals and at most five messages.
  fn all(outcomes : List(Outcome)) : Outcome do
    let t = List.fold_left(outcomes, { values: 0, differing: 0, max_ulps: 0, bad: 0, shown: [] }, tally)
    match do
      t.bad > 0 ->
        let head = int_to_string(t.bad) ++ " of " ++ int_to_string(t.values + t.bad) ++ " mismatched: "
        Mismatch(head ++ String.join(List.reverse(t.shown), " | "))
      t.values == 0 -> Mismatch("compared nothing")
      t.differing > 0 -> Drifted(t.values, t.differing, t.max_ulps)
      true -> Passed(t.values)
    end
  end

  fn run_case(c : Case) : (String, Outcome) do
    (c.name, c.run())
  end

  fn failures_of(results : List((String, Outcome))) : List(String) do
    List.filter_map(results, fn r ->
      match r do
        (name, Mismatch(m)) -> Some(name ++ ": " ++ m)
        (_, Passed(_)) -> None
        (_, Drifted(_, _, _)) -> None
      end)
  end

  -- For forge test: the failures, or one failure if the suite is empty.
  fn failures(cases : List(Case)) : List(String) do
    match cases do
      Nil -> ["suite has no cases"]
      Cons(_, _) -> failures_of(List.map(cases, run_case))
    end
  end

  fn values_of(results : List((String, Outcome))) : Int do
    List.fold_left(results, 0, fn (acc, r) ->
      match r do
        (_, Passed(n)) -> acc + n
        (_, Drifted(n, _, _)) -> acc + n
        (_, Mismatch(_)) -> acc
      end)
  end

  fn drift_of(results : List((String, Outcome))) : Int do
    List.fold_left(results, 0, fn (acc, r) ->
      match r do
        (_, Drifted(_, d, _)) -> acc + d
        (_, Passed(_)) -> acc
        (_, Mismatch(_)) -> acc
      end)
  end

  fn print_result(r : (String, Outcome)) : () do
    match r do
      (name, Passed(n)) -> println("ok   " ++ name ++ " (" ++ int_to_string(n) ++ " values)")
      (name, Drifted(n, d, u)) ->
        println("ok~  " ++ name ++ " (" ++ int_to_string(n) ++ " values, " ++ int_to_string(d) ++ " differ from Swift, worst " ++ int_to_string(u) ++ " ulp)")
      (name, Mismatch(m)) -> println("FAIL " ++ name ++ ": " ++ m)
    end
  end

  -- For the plain-main runners. Prints every case, then one summary line that
  -- scripts/run-suite.sh checks. Panics on any failure or on an empty suite:
  -- process_exit has no JS implementation, and an uncaught panic is how a JS
  -- program exits non-zero.
  fn report(suite : String, cases : List(Case)) : () do
    let results = List.map(cases, run_case)
    List.each(results, print_result)
    let bad = List.length(failures_of(results))
    let total = List.length(results)
    let values = values_of(results)
    let counts = "cases=" ++ int_to_string(total) ++ " failed=" ++ int_to_string(bad) ++ " drift=" ++ int_to_string(drift_of(results)) ++ " values=" ++ int_to_string(values)
    if total == 0 || bad > 0 || values == 0 do
      println("HARNESS FAIL " ++ suite ++ " " ++ counts)
      panic("suite " ++ suite ++ " failed")
    else
      println("HARNESS PASS " ++ suite ++ " " ++ counts)
    end
  end
end
