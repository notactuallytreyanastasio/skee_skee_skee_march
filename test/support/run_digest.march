mod RunDigest do

  -- The skee half of the run digest: hashes of skee types, fed through
  -- Arcade.Test.Digest (tools/golden/Sources/golden-run/digest.swift).
  fn hole_index(h : Hole) : Int do
    Skee.Units.hole_rank(h)
  end

  fn symbol_index(s : Symbol) : Int do
    match s do
    Blank -> 0
    Cherry -> 1
    Lemon -> 2
    Bell -> 3
    BarSym -> 4
    Seven -> 5
    Diamond -> 6
    Clover -> 7
    end
  end

  fn charm_index(c : Charm) : Int do
    Arcade.Test.Digest.index_of(Skee.Items.all_charms(), c, 0)
  end

  fn power_up_index(p : PowerUp) : Int do
    Arcade.Test.Digest.index_of(Skee.Items.all_power_ups(), p, 0)
  end

  fn ball_index(b : BallKind) : Int do
    Arcade.Test.Digest.index_of(Skee.Items.all_balls(), b, 0)
  end

  fn boss_index(b : Boss) : Int do
    Arcade.Test.Digest.index_of(Skee.Items.all_bosses(), b, 0)
  end

  fn kind_index(k : RoundKind) : Int do
    Arcade.Test.Digest.index_of(Skee.Items.all_round_kinds(), k, 0)
  end

  fn hole(h : Int, x : Hole) : Int do
    Arcade.Test.Digest.int(h, hole_index(x))
  end

  fn symbol(h : Int, x : Symbol) : Int do
    Arcade.Test.Digest.int(h, symbol_index(x))
  end

  fn charm(h : Int, c : Charm) : Int do
    Arcade.Test.Digest.int(h, charm_index(c))
  end

  fn power_up(h : Int, p : PowerUp) : Int do
    Arcade.Test.Digest.int(h, power_up_index(p))
  end

  fn tickets(h : Int, t : Tickets) : Int do
    Arcade.Test.Digest.int(h, Skee.Units.tickets_int(t))
  end

  fn points(h : Int, p : Points) : Int do
    Arcade.Test.Digest.int(h, Skee.Units.points_int(p))
  end

  fn chips(h : Int, c : Chips) : Int do
    Arcade.Test.Digest.int(h, Skee.Units.chips_int(c))
  end

  fn pull(h : Int, p : Pull) : Int do
    let stopped =
      match p.stops do
      Three(a, b, c) -> Arcade.Test.Digest.ints(h, [a, b, c])
      end
    Arcade.Test.Digest.int(Arcade.Test.Digest.bool(Arcade.Test.Digest.int(stopped, Skee.Units.bet_rank(p.bet)), p.free), Skee.Units.room_rank(p.pull_room))
  end

  fn record(h : Int, b : BallRecord) : Int do
    let front = chips(symbol(hole(h, b.record_hole), b.record_symbol), b.record_chips)
    let folded =
      Arcade.Test.Digest.float(Arcade.Test.Digest.int(front, b.rattles), b.record_fold)
    Arcade.Test.Digest.bool(Arcade.Test.Digest.int(Arcade.Test.Digest.ints(Arcade.Test.Digest.bool(folded, b.foul), [b.slot_hits, b.record_combo]), ball_index(b.record_ball)), b.hot)
  end

  -- The kind and the pay: see digest.swift for why not the symbol.
  fn payline(h : Int, p : Payline) : Int do
    match p do
    NoLine -> Arcade.Test.Digest.word(h, 0)
    Pair(_) -> do
      Arcade.Test.Digest.float(Arcade.Test.Digest.word(h, 1), Skee.Scoring.added_mult(p))
    end
    Triple(_) -> do
      Arcade.Test.Digest.float(Arcade.Test.Digest.word(h, 2), Skee.Scoring.added_mult(p))
    end
    end
  end

  fn source(h : Int, s : ScoreSource) : Int do
    match s do
    FromBase -> Arcade.Test.Digest.word(h, 0)
    FromPull -> Arcade.Test.Digest.word(h, 1)
    FromBall(i) -> Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 2), i)
    FromSlot(i) -> Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 3), i)
    FromPayline -> Arcade.Test.Digest.word(h, 4)
    FromCharm(c) -> charm(Arcade.Test.Digest.word(h, 5), c)
    FromFever -> Arcade.Test.Digest.word(h, 6)
    FromFreeGame -> Arcade.Test.Digest.word(h, 7)
    end
  end

  fn effect(h : Int, e : ScoreEffect) : Int do
    match e do
    SetBase(c, m) -> Arcade.Test.Digest.float(chips(Arcade.Test.Digest.word(h, 0), c), m)
    AddChips(c) -> chips(Arcade.Test.Digest.word(h, 1), c)
    AddMult(m) -> Arcade.Test.Digest.float(Arcade.Test.Digest.word(h, 2), m)
    TimesMult(m) -> Arcade.Test.Digest.float(Arcade.Test.Digest.word(h, 3), m)
    AddTickets(t) -> tickets(Arcade.Test.Digest.word(h, 4), t)
    Note(n) -> Arcade.Test.Digest.text(Arcade.Test.Digest.word(h, 5), n)
    end
  end

  fn step(h : Int, s : ScoreStep) : Int do
    effect(source(h, s.source), s.effect)
  end

  fn frame(h : Int, f : FrameScore) : Int do
    let front =
      Arcade.Test.Digest.list(payline(Arcade.Test.Digest.list(h, f.balls, record), f.payline), f.steps, step)
    Arcade.Test.Digest.int(tickets(Arcade.Test.Digest.float(chips(front, f.frame_chips), f.mult), f.frame_tickets), f.streak_after)
  end

  fn round(h : Int, r : RoundState) : Int do
    let front =
      Arcade.Test.Digest.int(points(Arcade.Test.Digest.int(h, kind_index(r.kind)), r.target), r.frames_total)
    let balls =
      Arcade.Test.Digest.list(Arcade.Test.Digest.list(front, r.frames, frame), r.current_balls, record)
    let armed =
      Arcade.Test.Digest.option(Arcade.Test.Digest.ints(balls, [r.streak, r.combo]), r.armed, power_up)
    let hot =
      Arcade.Test.Digest.option(Arcade.Test.Digest.int(Arcade.Test.Digest.option(armed, r.round_pull, pull), r.free_left), r.round_hot, hole)
    Arcade.Test.Digest.int(hot, Skee.Units.bet_rank(r.last_bet))
  end

  fn offer_words(h : Int, o : Offer) : Int do
    match o do
    OfferCharm(c) -> charm(Arcade.Test.Digest.word(h, 0), c)
    OfferStamp(s) -> symbol(Arcade.Test.Digest.word(h, 1), s)
    OfferGild -> Arcade.Test.Digest.word(h, 2)
    OfferPurge -> Arcade.Test.Digest.word(h, 3)
    OfferPowerUp(p) -> power_up(Arcade.Test.Digest.word(h, 4), p)
    end
  end

  fn phase(h : Int, p : Phase) : Int do
    match p do
    Throwing -> Arcade.Test.Digest.word(h, 0)
    AtCounter(c) -> do
      let held =
        Arcade.Test.Digest.list(Arcade.Test.Digest.word(h, 1), c.offers, fn (acc, slot) -> Arcade.Test.Digest.option(acc, slot, offer_words))
      tickets(held, c.reroll_cost)
    end
    Lost -> Arcade.Test.Digest.word(h, 2)
    Won -> Arcade.Test.Digest.word(h, 3)
    end
  end

  fn config(h : Int, c : RunConfig) : Int do
    let counts =
      Arcade.Test.Digest.ints(h, [c.antes, c.frames_per_round, c.balls_per_frame])
    let front =
      Arcade.Test.Digest.ints(tickets(counts, c.start_tickets), [c.charm_slots, c.power_up_slots, c.fever_heat])
    let bases =
      Arcade.Test.Digest.float(Arcade.Test.Digest.list(front, c.ante_base, points), c.target_scale)
    let kinds =
      List.fold_left(Skee.Items.all_round_kinds(), bases, fn (acc, k) -> tickets(Arcade.Test.Digest.float(acc, Skee.Items.per_round_at(c.kind_scale, k)), Skee.Items.per_round_at(c.round_tickets, k)))
    Arcade.Test.Digest.ints(Arcade.Test.Digest.float(kinds, c.overkill_step), [c.overkill_cap, c.interest_per, c.interest_cap, c.offer_count])
  end

  fn or_zero(x : Option(Int)) : Int do
    match x do
    Some(n) -> n
    None -> 0
    end
  end

  fn reel(h : Int, s : RunState, hole_at : Hole) : Int do
    let symbols = Arcade.Test.Digest.list(h, Skee.Scoring.reel(s.setup, hole_at), symbol)
    let gild =
      match Skee.HoleMap.reel_at(s.setup.gild, hole_at) do
      Some(c) -> Skee.Units.chips_int(c)
      None -> 0
      end
    Arcade.Test.Digest.int(Arcade.Test.Digest.int(symbols, gild), or_zero(Skee.HoleMap.reel_at(s.reel_stops, hole_at)))
  end

  fn stats(h : Int, t : RunStats) : Int do
    let holes =
      List.fold_left(Skee.HoleMap.all_holes(), Arcade.Test.Digest.int(h, t.stat_balls), fn (acc, x) -> Arcade.Test.Digest.int(acc, Skee.HoleMap.at(t.stat_holes, x)))
    let front =
      points(Arcade.Test.Digest.ints(holes, [t.jackpots, t.stat_rattles]), t.best_frame)
    let tiers = t.jackpot_tiers
    let counted =
      Arcade.Test.Digest.ints(front, [t.pulls, t.free_games, tiers.mini, tiers.minor, tiers.major, tiers.grand])
    Arcade.Test.Digest.int(points(counted, t.points), t.rounds_cleared)
  end

  doc """The digest of a whole state."""
  fn run(s : RunState) : Int do
    let front =
      Arcade.Test.Digest.int(Arcade.Test.Digest.int(config(Arcade.Test.Digest.start(), s.config), ball_index(s.ball)), Skee.Units.room_rank(s.room))
    let seeded = Arcade.Test.Digest.u64(Arcade.Test.Digest.u64(front, s.rng.word), s.seed)
    let phased =
      phase(round(Arcade.Test.Digest.int(Arcade.Test.Digest.int(seeded, s.ante), boss_index(s.boss)), s.round), s.phase)
    let reels =
      List.fold_left(Skee.HoleMap.reel_holes(), phased, fn (acc, x) -> reel(acc, s, x))
    let slotted =
      match s.top_slot.targets do
      Three(a, b, c) -> symbol(symbol(symbol(reels, a), b), c)
      end
    let items =
      Arcade.Test.Digest.list(Arcade.Test.Digest.list(slotted, s.charms, charm), s.power_ups, power_up)
    stats(Arcade.Test.Digest.bool(Arcade.Test.Digest.int(tickets(items, s.tickets), s.heat), s.fever), s.stats)
  end

  fn floats(h : Int, xs : List(Float)) : Int do
    List.fold_left(xs, h, Arcade.Test.Digest.float)
  end

  fn pocket(h : Int, p : Pocket) : Int do
    floats(hole(h, p.pocket_hole), [p.center.x, p.center.y, p.radius])
  end

  doc """Every field of a table, in the order digest.swift's `table` feeds them."""
  fn table(t : Table) : Int do
    let l = t.lane
    let g = t.hinge
    let d = t.board
    let w = d.ring_walls
    let front =
      floats(Arcade.Test.Digest.start(), [l.length, l.width, l.incline, l.rolling_friction, l.rail_restitution, l.min_speed, l.scoring_speed, l.max_speed, l.knee, l.max_aim_angle, l.hook, l.skid_loss, g.base_angle, g.fold_gain, g.carry, d.board_width, d.board_height, d.tilt, d.ring_center.x, d.ring_center.y, d.center_hole_offset.x, d.center_hole_offset.y, d.center_hole_radius, d.capture_speed, d.lip_min_fall])
    let walls =
      Arcade.Test.Digest.list(Arcade.Test.Digest.bool(front, d.pockets_need_flight), [w.wall40, w.wall30, w.wall20, w.wall10], Arcade.Test.Digest.float)
    let pockets = Arcade.Test.Digest.list(walls, [d.pockets.left, d.pockets.right], pocket)
    floats(pockets, [d.lip_height, d.ball_radius, d.lip_band, d.bounce, d.lip_bounce, d.lip_kick, d.wall_restitution, d.backwall_restitution, d.board_rolling_friction, d.landing_grip, d.wind.x, d.wind.y, d.ring_hole_radius, t.gravity, t.dt, t.max_duration])
  end

  fn shot_event(h : Int, e : ShotEvent) : Int do
    match e do
    ShotDud -> Arcade.Test.Digest.word(h, 0)
    ShotRail -> Arcade.Test.Digest.word(h, 1)
    ShotLaunched -> Arcade.Test.Digest.word(h, 2)
    ShotLanded -> Arcade.Test.Digest.word(h, 3)
    ShotLip(ring) -> Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 4), ring)
    ShotBackwall -> Arcade.Test.Digest.word(h, 5)
    ShotHop -> Arcade.Test.Digest.word(h, 6)
    ShotDropped(x) -> hole(Arcade.Test.Digest.word(h, 7), x)
    ShotSettled(x) -> hole(Arcade.Test.Digest.word(h, 8), x)
    ShotGutter -> Arcade.Test.Digest.word(h, 9)
    end
  end

  -- Everything but a shot's floats: those depend on libm, the rest is the
  -- reducer's to pass on. `detail` covers the floats.
  fn event(h : Int, e : GameEvent) : Int do
    match e do
    Pulled(p) -> pull(Arcade.Test.Digest.word(h, 0), p)
    FreeGamesWon(n) -> Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 1), n)
    JackpotHit(t) -> do
      Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 2), Skee.Units.tier_rank(t))
    end
    Shot(s, r) -> do
      record(Arcade.Test.Digest.list(hole(Arcade.Test.Digest.word(h, 3), s.hole), s.events, fn (acc, x) -> shot_event(acc, x.event)), r)
    end
    Fouled -> Arcade.Test.Digest.word(h, 4)
    FrameScored(f) -> frame(Arcade.Test.Digest.word(h, 5), f)
    FeverLit -> Arcade.Test.Digest.word(h, 6)
    RoundCleared(score, target, p) -> do
      tickets(tickets(tickets(points(points(Arcade.Test.Digest.word(h, 7), score), target), p.base), p.overkill), p.interest)
    end
    RoundFailed(score, target) -> points(points(Arcade.Test.Digest.word(h, 8), score), target)
    CounterOpened -> Arcade.Test.Digest.word(h, 9)
    Bought(o) -> offer_words(Arcade.Test.Digest.word(h, 10), o)
    Sold(c) -> charm(Arcade.Test.Digest.word(h, 11), c)
    Rerolled -> Arcade.Test.Digest.word(h, 12)
    Armed(p) -> power_up(Arcade.Test.Digest.word(h, 13), p)
    BallChosen(b) -> Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 14), ball_index(b))
    RoundStarted(k, target) -> do
      points(Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 15), kind_index(k)), target)
    end
    AnteStarted(a, b) -> do
      Arcade.Test.Digest.int(Arcade.Test.Digest.int(Arcade.Test.Digest.word(h, 16), a), boss_index(b))
    end
    RunWon -> Arcade.Test.Digest.word(h, 17)
    end
  end

  doc """The digest of a step's events, in order."""
  fn events(xs : List(GameEvent)) : Int do
    Arcade.Test.Digest.list(Arcade.Test.Digest.start(), xs, event)
  end

  doc """The floats of one shot, for measuring libm drift."""
  fn detail(s : ShotResult) : Int do
    let times =
      Arcade.Test.Digest.list(Arcade.Test.Digest.start(), s.events, fn (acc, x) -> Arcade.Test.Digest.float(acc, x.at))
    let hinge = Arcade.Test.Digest.option(times, s.hinge_speed, Arcade.Test.Digest.float)
    let landing =
      Arcade.Test.Digest.option(hinge, s.first_landing, fn (acc, v) -> Arcade.Test.Digest.float(Arcade.Test.Digest.float(acc, v.x), v.y))
    Arcade.Test.Digest.int(Arcade.Test.Digest.float(Arcade.Test.Digest.float(landing, s.peak_height), s.duration), List.length(s.path))
  end

end
