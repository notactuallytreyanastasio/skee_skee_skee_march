mod PuttNames do

  -- The names putt's two builds agree on: the AudioWorkletProcessor the
  -- worklet build registers and the main build asks for, and the globalThis
  -- name of the audio log the playtest reads.
  needs IO.Foreign

  fn processor() : String do
    "putt-synth"
  end

  fn debug_global() : String do
    "__puttAudio"
  end

end
