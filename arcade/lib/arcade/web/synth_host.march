mod Arcade.Web.SynthHost do

  -- The synth the speakers hear, in one cell per JS realm (arcade_synth_cell.mjs):
  -- the audio worklet's, or the main thread's when the fallback plays. `serve`
  -- is the whole audio callback, one Arcade.SynthFeed.block with the game's
  -- cue table; the glue only copies its samples out.
  needs IO.Foreign

  extern "./arcade_synth_cell.mjs" : Cap(IO.Foreign) do
    fn synth_cell_get() : Synth
    fn synth_cell_put(s : Synth) : Unit
  end

  doc """Start from a silent synth (Arcade.Synth.new)."""
  fn reset() : () do
    synth_cell_put(Arcade.Synth.new())
  end

  doc """The commands that arrived since the last block, then one quantum of samples."""
  fn serve(voices : SynthConsts -> cue -> List(SynthVoice), cmds : List(AudioCmd(cue))) : List(Float) do
    let (out, next) =
      Arcade.SynthFeed.block(voices, synth_cell_get(), cmds, Arcade.SynthFeed.quantum())
    synth_cell_put(next)
    out
  end

end
