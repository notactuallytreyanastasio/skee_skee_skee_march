mod Arcade.Suite.Vec do

  -- Arcade.Vec2 against copied rows, and Arcade.Vec3 against rows pinned with
  -- IEEE doubles in the same operand order.
  import Arcade.Test.Harness

  fn f(token : String) : Float do
    Arcade.Suite.Rows.f(token)
  end

  fn expect_vec(v : Arcade.Vec2.Vec2, x : String, y : String, what : String) : Outcome do
    all([Arcade.Test.GoldenIo.expect_float(v.x, x, what ++ ".x"), Arcade.Test.GoldenIo.expect_float(v.y, y, what ++ ".y")])
  end

  fn vec_row(row : List(String)) : Outcome do
    match row do
    Cons(ax, Cons(ay, Cons(cx, Cons(cy, Cons(k, Cons(sx, Cons(sy, Cons(dx, Cons(dy, Cons(mx, Cons(my, Cons(nx, Cons(ny, Cons(dot, Cons(len, Cons(ux, Cons(uy, Nil))))))))))))))))) -> do
      let a = Arcade.Vec2.vec2(f(ax), f(ay))
      let c = Arcade.Vec2.vec2(f(cx), f(cy))
      all([expect_vec(Arcade.Vec2.add(a, c), sx, sy, "add"), expect_vec(Arcade.Vec2.sub(a, c), dx, dy, "sub"), expect_vec(Arcade.Vec2.scale(a, f(k)), mx, my, "scale"), expect_vec(Arcade.Vec2.neg(a), nx, ny, "neg"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.dot(a, c), dot, "dot"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.length(a), len, "length"), expect_vec(Arcade.Vec2.normalized(a), ux, uy, "normalized")])
    end
    _ -> Mismatch("bad vec row")
    end
  end

  fn vec_zero() : Outcome do
    let z = Arcade.Vec2.zero()
    match Arcade.Suite.Rows.foundation("veczero") do
    Cons(Cons(nx, Cons(ny, Cons(len, Nil))), Nil) -> do
      all([expect_vec(Arcade.Vec2.normalized(z), nx, ny, "zero.normalized"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec2.length(z), len, "zero.length")])
    end
    _ -> Mismatch("expected one veczero row")
    end
  end

  fn vec2_examples() : Outcome do
    let v =
      Arcade.Vec2.add(Arcade.Vec2.vec2(1.0, 2.0), Arcade.Vec2.vec2(3.0, 0.0 -. 1.0))
    all([expect(Arcade.Vec2.equal(v, Arcade.Vec2.vec2(4.0, 1.0)), "sum"), expect(Arcade.Vec2.equal(Arcade.Vec2.scale(v, 2.0), Arcade.Vec2.vec2(8.0, 2.0)), "product"), expect(Arcade.Vec2.length(Arcade.Vec2.vec2(3.0, 4.0)) == 5.0, "length of 3,4"), expect(Arcade.Vec2.dot(Arcade.Vec2.vec2(1.0, 0.0), Arcade.Vec2.vec2(0.0, 1.0)) == 0.0, "perpendicular dot"), expect(Arcade.Vec2.equal(Arcade.Vec2.normalized(Arcade.Vec2.vec2(3.0, 4.0)), Arcade.Vec2.vec2(0.6, 0.8)), "normalized 3,4"), expect(!Arcade.Vec2.equal(v, Arcade.Vec2.vec2(4.0, 2.0)), "equal tells vectors apart")])
  end

  fn expect3(v : Arcade.Vec3.Vec3, toks : List(String), what : String) : Outcome do
    match toks do
    Cons(x, Cons(y, Cons(z, Nil))) -> do
      all([Arcade.Test.GoldenIo.expect_float(v.x, x, what ++ ".x"), Arcade.Test.GoldenIo.expect_float(v.y, y, what ++ ".y"), Arcade.Test.GoldenIo.expect_float(v.z, z, what ++ ".z")])
    end
    _ -> Mismatch("bad vec3 triple for " ++ what)
    end
  end

  fn at(toks : List(String), i : Int) : List(String) do
    List.take(List.drop(toks, i), 3)
  end

  fn vec3_of(toks : List(String), i : Int) : Arcade.Vec3.Vec3 do
    match at(toks, i) do
    Cons(x, Cons(y, Cons(z, Nil))) -> Arcade.Vec3.vec3(f(x), f(y), f(z))
    _ -> panic("bad vec3 row")
    end
  end

  fn one(toks : List(String), i : Int) : String do
    match List.nth_opt(toks, i) do
    Some(t) -> t
    None -> panic("short vec3 row")
    end
  end

  -- a(0..2) b(3..5) t(6) add(7) sub(10) scale(13) dot(16) cross(17)
  -- length(20) normalized(21) mix(24): 27 tokens.
  fn vec3_row(row : List(String)) : Outcome do
    if List.length(row) != 27 do
      Mismatch("vec3 row has " ++ int_to_string(List.length(row)) ++ " tokens")
    else
      do
        let a = vec3_of(row, 0)
        let b = vec3_of(row, 3)
        let t = f(one(row, 6))
        all([expect3(Arcade.Vec3.add(a, b), at(row, 7), "add"), expect3(Arcade.Vec3.sub(a, b), at(row, 10), "sub"), expect3(Arcade.Vec3.scale(a, t), at(row, 13), "scale"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec3.dot(a, b), one(row, 16), "dot"), expect3(Arcade.Vec3.cross(a, b), at(row, 17), "cross"), Arcade.Test.GoldenIo.expect_float(Arcade.Vec3.length(a), one(row, 20), "length"), expect3(Arcade.Vec3.normalized(a), at(row, 21), "normalized"), expect3(Arcade.Vec3.mix(a, b, t), at(row, 24), "mix")])
      end
    end
  end

  fn vec3_zero() : Outcome do
    let z = Arcade.Vec3.zero()
    all([expect3(z, ["0000000000000000", "0000000000000000", "0000000000000000"], "zero"), expect3(Arcade.Vec3.normalized(z), ["0000000000000000", "0000000000000000", "0000000000000000"], "zero.normalized")])
  end

  fn cases() : List(Case) do
    [
      case("Vec2 examples", fn () -> vec2_examples()),
      case("Vec2 ops", fn () -> all(List.map(Arcade.Suite.Rows.foundation("vec"), vec_row))),
      case("the zero Vec2 stays zero", fn () -> vec_zero()),
      case("Vec3 ops", fn () -> all(List.map(Arcade.Suite.Rows.words("vec3"), vec3_row))),
      case("the zero Vec3 stays zero", fn () -> vec3_zero())
    ]
  end

end
