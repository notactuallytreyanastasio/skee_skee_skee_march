mod Game do

  -- The imperative shell, and the entry point of the browser build. It holds
  -- one Skee.App.Model and does only this:
  --
  --   launch    read the five stored strings, boot, perform the effects
  --   events    canvas pointer events, visibility and resizes become Msgs
  --   per frame update(MsgTick(t)), paint scene_ops, render the HUD, whose
  --             queued taps come back as MsgTap
  --   fields    an edit of the host's text field becomes MsgHostDraft
  --   effects   FxSave to localStorage, FxHaptic to navigator.vibrate,
  --             FxHostPost to the same-origin relay (its answer comes back
  --             as MsgHostReply or MsgHostFailed), and every effect to
  --             Audio.apply (sound, rumble, drum)
  --
  -- Every rule is in Skee.App; nothing here looks at the game. Times are on
  -- one clock, performance.now() / 1000 (rAF's time and every event's
  -- timeStamp); positions are CSS pixels.
  needs IO.Foreign

  -- What the shell keeps between events: the model and the browser handles.
  type ShellState = {
    model : Skee.App.Model,
    k : Skee.Consts.Consts,
    canvas : Js.Dom.Node,
    ctx : Js.Canvas.Context,
    hud : Hud.HudHandle,
    audio : Audio.AudioHandle,
    width : Float,
    height : Float,
    dpr : Float
  }

  -- One cell holds the ShellState, so that event callbacks and the frame
  -- loop act on the same model (web/skee_glue.mjs).
  extern "./skee_glue.mjs" : Cap(IO.Foreign) do
    fn glue_cell_put(s : ShellState) : Unit
    fn glue_cell_get() : ShellState
  end

  -- ---- Storage ----
  -- The localStorage key of each save. Swift's names: wallet.json and
  -- run.json in Documents, tipsSeen, walkthroughDone and arrivalDone in
  -- UserDefaults.
  fn storage_key(key : Skee.App.SaveKey) : String do
    match key do
    KeyWallet -> "skee.wallet"
    KeyRun -> "skee.run"
    KeyTips -> "skee.tipsSeen"
    KeyWalkthroughDone -> "skee.walkthroughDone"
    KeyArrivalDone -> "skee.arrivalDone"
    KeyHostConsent -> "skee.hostConsent"
    end
  end

  fn stored(key : Skee.App.SaveKey) : Option(String) do
    Js.Dom.store_get(storage_key(key))
  end

  fn saved_strings() : Skee.App.SavedStrings do
    {
      saved_wallet: stored(KeyWallet),
      saved_run: stored(KeyRun),
      saved_tips: stored(KeyTips),
      saved_walk_done: stored(KeyWalkthroughDone),
      saved_arrival_done: stored(KeyArrivalDone),
      saved_host_consent: stored(KeyHostConsent)
    }
  end

  -- ---- Effects ----
  -- navigator.vibrate is the browser's only haptic: a pulse whose length
  -- follows the impact's intensity, and a short one for a notification. The
  -- rolling buzz has no browser equivalent and is not played.
  fn vibration_ms(h : Skee.App.Haptic) : Option(Int) do
    match h do
    HapticImpact(ImpactLight, i) -> Some(float_round(6.0 +. 10.0 *. i))
    HapticImpact(ImpactRigid, i) -> Some(float_round(8.0 +. 12.0 *. i))
    HapticImpact(ImpactHeavy, i) -> Some(float_round(12.0 +. 20.0 *. i))
    HapticNotify(_) -> Some(30)
    HapticBuzz(_) -> None
    HapticBuzzStop -> None
    end
  end

  fn effect(e : Skee.App.Effect) : () do
    match e do
    FxSave(key, text) -> Js.Dom.store_set(storage_key(key), text)
    FxHaptic(h) -> do
      match vibration_ms(h) do
      Some(ms) -> Glue.vibrate(ms)
      None -> ()
      end
    end
    FxSound(_) -> ()
    FxRumble(_) -> ()
    FxDrum(_) -> ()
    FxHostPost(key, body) -> host_post(key, body)
    end
  end

  -- FxHostPost: the one network call. What came back goes to the model
  -- under the call's key, as it came.
  fn host_post(key : Skee.App.CallKey, body : String) : () do
    Glue.host_post(body, Skee.App.host_timeout_ms(), fn answer -> host_replied(key, answer), fn reason -> dispatch(MsgHostFailed(key, reason)))
  end

  fn host_replied(key : Skee.App.CallKey, answer : (Int, String)) : () do
    let (status, body) = answer
    dispatch(MsgHostReply(key, status, body))
  end

  fn perform(s : ShellState, effects : List(Skee.App.Effect)) : () do
    List.each(effects, effect)
    Audio.apply(s.audio, effects)
  end

  -- One message: update, keep the new model, perform its effects.
  fn dispatch(msg : Skee.App.Msg) : () do
    let s = glue_cell_get()
    let (m, effects) = Skee.App.update(s.model, msg)
    let next = { s with model: m }
    glue_cell_put(next)
    perform(next, effects)
  end

  -- ---- The thumb ----
  fn sample(p : (Float, Float, Float)) : FlickSample do
    let (t, x, y) = p
    { sample_t: t, sample_x: x, sample_y: y }
  end

  fn samples(raw : List((Float, Float, Float))) : List(FlickSample) do
    List.map(raw, sample)
  end

  fn pointer_down(ss : List(FlickSample)) : () do
    match ss do
    Cons(first, _) -> dispatch(MsgPointerDown(first))
    Nil -> ()
    end
  end

  -- ---- The lever's knob (a drag on the HUD, not the alley) ----
  fn lever_touch(t : Skee.HudView.LeverTouch) : () do
    let s = glue_cell_get()
    List.each(Hud.lever_touch(s.hud, s.model, t), dispatch)
  end

  fn knob_down(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverDown(x, y)
  end

  fn knob_move(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverMove(x, y)
  end

  fn knob_up(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverUp(x, y)
  end

  -- ---- The frame ----
  -- A resize or a new devicePixelRatio (zoom, another screen) resizes the
  -- canvas's backing store and tells the model.
  fn follow_size() : () do
    let s = glue_cell_get()
    let (w, h) = Glue.view_size()
    let dpr = Glue.device_pixel_ratio()
    if w != s.width || h != s.height || dpr != s.dpr do
      resize(s, w, h, dpr)
    else
      ()
    end
  end

  fn resize(s : ShellState, w : Float, h : Float, dpr : Float) : () do
    Glue.size_canvas(s.canvas, w, h, dpr)
    glue_cell_put({ s with width: w, height: h, dpr: dpr })
    dispatch(MsgResize(w, h))
  end

  -- What the playtest reads off <html>: the top layer, whether a throw is
  -- possible, whether the presentation is busy, and the crease's height.
  fn mark(m : Skee.App.Model) : () do
    let g = Skee.App.geometry(m)
    Glue.mark("data-layer", show(Skee.App.top_layer(m)))
    Glue.mark("data-can-throw", if Skee.App.can_throw(m) do "1" else "0" end)
    Glue.mark("data-busy", if Skee.App.busy(m) do "1" else "0" end)
    Glue.mark("data-crease-y", int_to_string(float_round(g.crease_y)))
  end

  fn frame(t : Float) : () do
    follow_size()
    dispatch(MsgTick(t))
    let s = glue_cell_get()
    Paint.frame(s.ctx, s.k, s.dpr, s.width, s.height, Skee.App.scene_ops(s.model))
    List.each(Hud.render(s.hud, s.model), dispatch)
    let after = glue_cell_get()
    Hud.sync_fields(after.model)
    mark(after.model)
    Glue.request_frame(fn next -> frame(next))
  end

  -- ---- Launch ----
  fn element(id : String, tag : String) : Js.Dom.Node do
    match Js.Dom.find(id) do
    Some(node) -> node
    None -> do
      let node = Js.Dom.create(tag)
      Js.Dom.set_attr(node, "id", id)
      Js.Dom.append(Js.Dom.body(), node)
      node
    end
    end
  end

  fn context(canvas : Js.Dom.Node) : Js.Canvas.Context do
    match Js.Canvas.get_context(canvas) do
    Some(ctx) -> ctx
    None -> panic("this browser gives no 2D canvas context")
    end
  end

  fn launch() : () do
    let canvas = element("alley", "canvas")
    let ctx = context(canvas)
    let hud = Hud.mount(element("hud", "div"))
    let k = Skee.Consts.make()
    let (w, h) = Glue.view_size()
    let dpr = Glue.device_pixel_ratio()
    let (hi, lo) = Glue.seed_limbs()
    Glue.size_canvas(canvas, w, h, dpr)
    let (m, effects) = Skee.App.boot(k, saved_strings(), w, h, Skee.U64.make(hi, lo))
    let s =
      {
        model: m,
        k: k,
        canvas: canvas,
        ctx: ctx,
        hud: hud,
        audio: Audio.start(),
        width: w,
        height: h,
        dpr: dpr
      }
    glue_cell_put(s)
    perform(s, effects)
    Glue.on_pointer(canvas, fn raw -> pointer_down(samples(raw)), fn raw -> dispatch(MsgPointerMove(samples(raw))), fn raw -> dispatch(MsgPointerUp(samples(raw))), fn () -> dispatch(MsgPointerCancel))
    Glue.on_drag(hud.hud_root, fn p -> lever_touch(knob_down(p)), fn p -> lever_touch(knob_move(p)), fn p -> lever_touch(knob_up(p)), fn () -> lever_touch(LeverLost))
    Glue.on_fields(hud.hud_root, fn text -> dispatch(MsgHostDraft(text)))
    Glue.on_visibility(fn shown -> dispatch(MsgVisible(shown)))
    Glue.request_frame(fn t -> frame(t))
  end

  fn main(_f : Cap(IO.Foreign)) : () do
    launch()
  end

end
