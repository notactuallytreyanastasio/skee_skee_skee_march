mod Game do

  -- Skee's browser shell, and the entry point of the browser build: the hooks
  -- Arcade.Web.Runtime runs one Skee.App.Model with. The runtime owns the
  -- canvas, the frame loop and the events; this module says what they mean
  -- for skee:
  --
  --   boot      the six stored strings and the launch seed to Skee.App.boot,
  --             and the speakers (Audio.start)
  --   msgs      the thumb's samples, visibility, resizes and the tick
  --   listen    the lever's knob (a drag on the HUD) through Hud.lever_touch,
  --             and an edit of the host's text field as MsgHostDraft
  --   overlay   the HUD (Hud.render), whose queued taps come back as MsgTap;
  --             then Hud.sync_fields writes the draft back
  --   effects   FxSave to localStorage, FxHaptic to navigator.vibrate,
  --             FxHostPost to the same-origin relay (its answer comes back
  --             as MsgHostReply or MsgHostFailed), and every effect to
  --             Audio.apply (sound, rumble, drum)
  --   marks     what the playtest reads off <html>
  --
  -- Every rule is in Skee.App; nothing here looks at the game.
  needs IO.Foreign

  -- The model as the runtime holds it. The JS backend names each
  -- specialization of a generic fn after its type arguments, and a record
  -- type is spelled out field by field: with the bare Skee.App.Model every
  -- Arcade.Web.Runtime fn's name was tens of kilobytes and skee.mjs grew from
  -- 5.5 MB to 9.2 MB. A one-constructor type is spelled by its name.
  type Boxed = BoxedModel(Skee.App.Model)

  fn unbox(b : Boxed) : Skee.App.Model do
    match b do
    BoxedModel(m) -> m
    end
  end

  fn boxed(r : (Skee.App.Model, List(Skee.App.Effect))) : (Boxed, List(Skee.App.Effect)) do
    let (m, effects) = r
    (BoxedModel(m), effects)
  end

  -- ---- Storage ----
  -- The localStorage key of each save. Swift's names: wallet.json and
  -- run.json in Documents, tipsSeen, walkthroughDone and arrivalDone in
  -- UserDefaults.
  fn storage_key(key : Skee.App.SaveKey) : String do
    match key do
    KeyWallet -> "skee.wallet"
    KeyRun -> "skee.run"
    KeyTips -> "skee.tipsSeen"
    KeyWalkthroughDone -> "skee.walkthroughDone"
    KeyArrivalDone -> "skee.arrivalDone"
    KeyHostConsent -> "skee.hostConsent"
    end
  end

  fn stored(key : Skee.App.SaveKey) : Option(String) do
    Js.Dom.store_get(storage_key(key))
  end

  fn saved_strings() : Skee.App.SavedStrings do
    {
      saved_wallet: stored(KeyWallet),
      saved_run: stored(KeyRun),
      saved_tips: stored(KeyTips),
      saved_walk_done: stored(KeyWalkthroughDone),
      saved_arrival_done: stored(KeyArrivalDone),
      saved_host_consent: stored(KeyHostConsent)
    }
  end

  -- ---- Effects ----
  -- navigator.vibrate is the browser's only haptic: a pulse whose length
  -- follows the impact's intensity, and a short one for a notification. The
  -- rolling buzz has no browser equivalent and is not played.
  fn vibration_ms(h : Skee.App.Haptic) : Option(Int) do
    match h do
    HapticImpact(ImpactLight, i) -> Some(float_round(6.0 +. 10.0 *. i))
    HapticImpact(ImpactRigid, i) -> Some(float_round(8.0 +. 12.0 *. i))
    HapticImpact(ImpactHeavy, i) -> Some(float_round(12.0 +. 20.0 *. i))
    HapticNotify(_) -> Some(30)
    HapticBuzz(_) -> None
    HapticBuzzStop -> None
    end
  end

  fn effect(dispatch : Skee.App.Msg -> (), e : Skee.App.Effect) : () do
    match e do
    FxSave(key, text) -> Js.Dom.store_set(storage_key(key), text)
    FxHaptic(h) -> do
      match vibration_ms(h) do
      Some(ms) -> Arcade.Web.Glue.vibrate(ms)
      None -> ()
      end
    end
    FxSound(_) -> ()
    FxRumble(_) -> ()
    FxDrum(_) -> ()
    FxHostPost(key, body) -> host_post(dispatch, key, body)
    end
  end

  -- FxHostPost: the one network call. What came back goes to the model
  -- under the call's key, as it came.
  fn host_post(dispatch : Skee.App.Msg -> (), key : Skee.App.CallKey, body : String) : () do
    Arcade.Web.Glue.post_json("/skee-host/chat", body, Skee.App.host_timeout_ms(), fn answer -> host_replied(dispatch, key, answer), fn why -> host_failed(dispatch, key, why))
  end

  fn host_replied(dispatch : Skee.App.Msg -> (), key : Skee.App.CallKey, answer : (Int, String)) : () do
    let (status, body) = answer
    dispatch(MsgHostReply(key, status, body))
  end

  fn host_failed(dispatch : Skee.App.Msg -> (), key : Skee.App.CallKey, why : (Bool, String)) : () do
    let (timed_out, message) = why
    dispatch(MsgHostFailed(key, host_failure(timed_out, message)))
  end

  -- The player's words for no HTTP answer: the browser's own after "could
  -- not reach", or the timeout in whole seconds (Math.round).
  fn host_failure(timed_out : Bool, message : String) : String do
    if timed_out do
      "no answer from the host's relay in " ++ int_to_string((Skee.App.host_timeout_ms() + 500) / 1000) ++ " s"
    else
      if message == "" do
        "could not reach the host's relay"
      else
        "could not reach the host's relay: " ++ message
      end
    end
  end

  fn perform(dispatch : Skee.App.Msg -> (), effects : List(Skee.App.Effect)) : () do
    List.each(effects, fn e -> effect(dispatch, e))
    Audio.apply(effects)
  end

  -- ---- Boot ----
  -- The model first, then the speakers' gesture listeners.
  fn boot(k : Skee.Consts.Consts, w : Float, h : Float, seed : Arcade.U64.U64) : (Boxed, List(Skee.App.Effect)) do
    let booted = Skee.App.boot(k, saved_strings(), w, h, seed)
    Audio.start()
    boxed(booted)
  end

  -- ---- The thumb ----
  fn sample(p : (Float, Float, Float)) : FlickSample do
    let (t, x, y) = p
    { sample_t: t, sample_x: x, sample_y: y }
  end

  fn samples(raw : List((Float, Float, Float))) : List(FlickSample) do
    List.map(raw, sample)
  end

  fn pointer_down(raw : List((Float, Float, Float))) : Option(Skee.App.Msg) do
    match samples(raw) do
    Cons(first, _) -> Some(MsgPointerDown(first))
    Nil -> None
    end
  end

  -- ---- The lever's knob (a drag on the HUD, not the alley) ----
  fn knob_down(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverDown(x, y)
  end

  fn knob_move(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverMove(x, y)
  end

  fn knob_up(p : (Float, Float)) : Skee.HudView.LeverTouch do
    let (x, y) = p
    LeverUp(x, y)
  end

  -- The HUD's other event sources: the knob's pointer steps the lever's view
  -- state against the current model, and the host's field sends its draft.
  fn listen(hud : Hud.HudHandle, model : () -> Boxed, dispatch : Skee.App.Msg -> ()) : () do
    let touch = fn t -> List.each(Hud.lever_touch(hud, unbox(model()), t), dispatch)
    Arcade.Web.Input.on_drag(hud.hud_root, fn p -> touch(knob_down(p)), fn p -> touch(knob_move(p)), fn p -> touch(knob_up(p)), fn () -> touch(LeverLost))
    Arcade.Web.Input.on_fields(hud.hud_root, fn text -> dispatch(MsgHostDraft(text)))
  end

  -- ---- Marks ----
  -- What the playtest reads off <html>: the top layer, whether a throw is
  -- possible, whether the presentation is busy, and the crease's height.
  fn marks(m : Skee.App.Model) : List((String, String)) do
    let g = Skee.App.geometry(m)
    [
      ("data-layer", show(Skee.App.top_layer(m))),
      ("data-can-throw", if Skee.App.can_throw(m) do "1" else "0" end),
      ("data-busy", if Skee.App.busy(m) do "1" else "0" end),
      ("data-crease-y", int_to_string(float_round(g.crease_y)))
    ]
  end

  -- ---- Launch ----
  -- Called by the runtime once the canvas exists: the HUD's DOM, then the
  -- constants.
  fn hooks() : Arcade.Web.Runtime.WebHooks(Boxed, Skee.App.Msg, Skee.App.Effect) do
    let hud = Hud.mount(Arcade.Web.Runtime.element("hud", "div"))
    let k = Skee.Consts.make()
    {
      hook_num: k.num,
      hook_boot: fn (w, h, seed) -> boot(k, w, h, seed),
      hook_update: fn (b, msg) -> boxed(Skee.App.update(unbox(b), msg)),
      hook_perform: fn (dispatch, effects) -> perform(dispatch, effects),
      hook_tick: fn t -> MsgTick(t),
      hook_resize: fn (w, h) -> MsgResize(w, h),
      hook_down: fn raw -> pointer_down(raw),
      hook_move: fn raw -> Some(MsgPointerMove(samples(raw))),
      hook_up: fn raw -> Some(MsgPointerUp(samples(raw))),
      hook_cancel: Some(MsgPointerCancel),
      hook_listen: fn (model, dispatch) -> listen(hud, model, dispatch),
      hook_visible: fn shown -> MsgVisible(shown),
      hook_scene: fn b -> Skee.App.scene_ops(unbox(b)),
      hook_overlay: fn b -> Hud.render(hud, unbox(b)),
      hook_settle: fn b -> Hud.sync_fields(unbox(b)),
      hook_marks: fn b -> marks(unbox(b))
    }
  end

  fn main(_f : Cap(IO.Foreign)) : () do
    match Arcade.Web.Runtime.launch("alley", fn () -> hooks()) do
    Ok(_) -> ()
    Err(why) -> panic(why)
    end
  end

end
