mod Hud do

  -- The HUD over the canvas: Skee.HudView's panes written into the DOM. Every
  -- decision is the core's. This module only
  --
  --   mount    makes one element per pane (in Skee.HudView.pane_ids order,
  --            back to front) and the art's <symbol>s once, and listens for
  --            clicks on the root (event delegation)
  --   click    finds the nearest element with a data-act code and queues it
  --   drag     the lever's knob (data-drag): its pointer goes to
  --            Skee.HudView.lever_touch (`lever_touch`, wired by Game)
  --   render   decodes the queued codes, steps the Guide's page state with
  --            Skee.HudView.react, rewrites each pane only when its HTML
  --            changed, and returns the taps' Intents as MsgTap
  --
  -- A pane's last HTML is kept in its data-src attribute, the Guide's page
  -- state (Skee.HudView.save_local) in the root's data-local, so the handle
  -- holds nothing that changes. A pane left untouched keeps its elements, so
  -- a press on a button survives the frames around it.
  needs IO.Foreign

  type HudHandle = { hud_root : Js.Dom.Node }

  fn pane_element_id(id : String) : String do
    "hud-" ++ id
  end

  fn mount(root : Js.Dom.Node) : HudHandle do
    Js.Dom.clear(root)
    let art = Js.Dom.create("div")
    Js.Dom.set_attr(art, "id", "hud-art")
    Js.Dom.set_html(art, Skee.HudView.render(Skee.HudView.defs(Skee.Consts.make())))
    Js.Dom.append(root, art)
    List.each(Skee.HudView.pane_ids(), fn id -> add_pane(root, id))
    Js.Dom.set_attr(root, "data-local", Skee.HudView.save_local(Skee.HudView.initial()))
    Js.Dom.set_attr(root, "data-hud-root", "")
    Js.Dom.listen(root, "click", fn ev -> clicked(Js.Dom.event_target(ev)))
    { hud_root: root }
  end

  fn add_pane(root : Js.Dom.Node, id : String) : () do
    let pane = Js.Dom.create("div")
    Js.Dom.set_attr(pane, "id", pane_element_id(id))
    Js.Dom.add_class(pane, "hud-pane")
    Js.Dom.set_attr(pane, "data-src", "")
    Js.Dom.append(root, pane)
  end

  -- Delegation: the nearest element at or above the target that carries a
  -- tap code, up to the HUD's root.
  fn clicked(target : Js.Dom.Node) : () do
    match Js.Dom.get_attr(target, "data-act") do
    Some(code) -> do
      match string_to_int(code) do
      Some(n) -> Arcade.Web.Input.queue_tap(n)
      None -> ()
      end
    end
    None -> if Js.Dom.has_attr(target, "data-hud-root") do () else climb(target) end
    end
  end

  fn climb(target : Js.Dom.Node) : () do
    match Js.Dom.parent(target) do
    Some(up) -> clicked(up)
    None -> ()
    end
  end

  fn write_pane(s : Skee.HudView.Section) : () do
    match Js.Dom.find(pane_element_id(s.section_id)) do
    Some(pane) -> do
      let shown =
        match Js.Dom.get_attr(pane, "data-src") do
        Some(text) -> text
        None -> ""
        end
      if shown != s.section_html do
        replace_pane(pane, s.section_html)
      else
        ()
      end
    end
    None -> ()
    end
  end

  -- A text field in a rewritten pane keeps its text, focus and caret.
  fn replace_pane(pane : Js.Dom.Node, html : String) : () do
    Arcade.Web.Glue.set_html_keeping(pane, html)
    Js.Dom.set_attr(pane, "data-src", html)
  end

  doc """
  The host's text field holds the model's draft: after SAY clears it, or the
  core cuts it to length. Writes only when the two differ, so an idle frame
  and a keystroke (already in the model by MsgHostDraft) change nothing.
  """
  fn sync_fields(m : Skee.App.Model) : () do
    match Js.Dom.find(Skee.HudView.draft_field_id()) do
    Some(field) -> do
      let want = Skee.App.draft_of(m)
      if Js.Dom.get_value(field) != want do
        Js.Dom.set_value(field, want)
      else
        ()
      end
    end
    None -> ()
    end
  end

  fn step(acc : (Skee.HudView.HudLocal, List(Skee.App.Msg)), a : Skee.App.AppHud, code : Int) : (Skee.HudView.HudLocal, List(Skee.App.Msg)) do
    let (l, msgs) = acc
    match Skee.HudView.decode(code) do
    Some(act) -> do
      let (next, intent) = Skee.HudView.react(l, a, act)
      match intent do
      Some(i) -> (next, Cons(MsgTap(i), msgs))
      None -> (next, msgs)
      end
    end
    None -> (l, msgs)
    end
  end

  -- The lever's knob: its pointer steps the lever's view state with
  -- Skee.HudView.lever_touch, which says when a drag pulls.
  fn lever_touch(h : HudHandle, m : Skee.App.Model, t : Skee.HudView.LeverTouch) : List(Skee.App.Msg) do
    let saved = Js.Dom.get_attr(h.hud_root, "data-local")
    let (l, intent) =
      Skee.HudView.lever_touch(Skee.HudView.load_local(saved), Skee.App.hud(m), t)
    Js.Dom.set_attr(h.hud_root, "data-local", Skee.HudView.save_local(l))
    match intent do
    Some(i) -> [MsgTap(i)]
    None -> []
    end
  end

  fn render(h : HudHandle, m : Skee.App.Model) : List(Skee.App.Msg) do
    let a = Skee.App.hud(m)
    let saved = Js.Dom.get_attr(h.hud_root, "data-local")
    let start = Skee.HudView.load_local(saved)
    let (stepped, msgs_rev) =
      List.fold_left(Arcade.Web.Input.drain_taps(), (start, []), fn (acc, code) -> step(acc, a, code))
    let l = Skee.HudView.settle(stepped, a)
    let text = Skee.HudView.save_local(l)
    if saved != Some(text) do
      Js.Dom.set_attr(h.hud_root, "data-local", text)
    else
      ()
    end
    List.each(Skee.HudView.view(m.k, a, l, m.viewport.width, m.viewport.height), write_pane)
    List.reverse(msgs_rev)
  end

end
