mod Audio do

  -- Skee's speakers: Sound.swift's SoundEngine for the browser, on
  -- Arcade.Web.Audio. An update's audio effects become Arcade.SynthFeed
  -- commands (Skee.SoundOut), which the engine sends to the synth in order;
  -- the synth plays Skee.Cues through Arcade.Web.SynthHost, in the audio
  -- worklet (shell/synth_worklet.march) or on the main thread.
  --
  -- Entry points the shell uses:
  --   Audio.start() : ()
  --   Audio.apply(effects : List(Skee.App.Effect)) : ()
  needs IO.Foreign

  -- The synth's 44100 Hz, SoundEngine's mainMixerNode.outputVolume of 0.8,
  -- the worklet's build beside skee.mjs in dist/, and the names the
  -- playtests know (SynthNames).
  fn setup() : Arcade.Web.Audio.AudioSetup do
    {
      setup_rate: Arcade.Synth.rate(),
      setup_gain: 0.8,
      setup_worklet_url: "skee_synth_worklet.mjs",
      setup_processor: SynthNames.processor(),
      setup_global: SynthNames.debug_global()
    }
  end

  -- Install the gesture listeners; the speakers come up on the first gesture
  -- after that.
  fn start() : () do
    Arcade.Web.SynthHost.reset()
    Arcade.Web.Audio.install(setup(), fn cmds -> Arcade.Web.SynthHost.serve(Skee.Cues.voices_for, cmds))
  end

  fn apply(effects : List(Skee.App.Effect)) : () do
    Arcade.Web.Audio.route(Skee.SoundOut.commands(effects))
  end

end
