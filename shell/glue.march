mod Glue do

  -- The browser calls the shell needs that Js.Dom and Js.Canvas lack, backed
  -- by web/skee_glue.mjs (copied beside skee.mjs by `make web`). Each is one
  -- platform call; none decides anything about the game.
  needs IO.Foreign

  extern "./skee_glue.mjs" : Cap(IO.Foreign) do
    fn glue_now() : Float
    fn glue_request_frame(cb : Float -> ()) : Unit
    fn glue_view_size() : (Float, Float)
    fn glue_device_pixel_ratio() : Float
    fn glue_size_canvas(canvas : Js.Dom.Node, w : Float, h : Float, dpr : Float) : Unit
    fn glue_seed_limbs() : (Int, Int)
    fn glue_on_visibility(cb : Bool -> ()) : Unit
    fn glue_vibrate(ms : Int) : Unit
    fn glue_on_pointer(canvas : Js.Dom.Node, down : List((Float, Float, Float)) -> (), move : List((Float, Float, Float)) -> (), up : List((Float, Float, Float)) -> (), cancel : () -> ()) : Unit
    fn glue_queue_tap(i : Int) : Unit
    fn glue_drain_taps() : List(Int)
    fn glue_mark(name : String, value : String) : Unit
  end

  -- ---- Public names: extern declarations are private to this module ----
  fn now() : Float do
    glue_now()
  end

  fn request_frame(cb : Float -> ()) : () do
    glue_request_frame(cb)
  end

  fn view_size() : (Float, Float) do
    glue_view_size()
  end

  fn device_pixel_ratio() : Float do
    glue_device_pixel_ratio()
  end

  fn size_canvas(canvas : Js.Dom.Node, w : Float, h : Float, dpr : Float) : () do
    glue_size_canvas(canvas, w, h, dpr)
  end

  fn seed_limbs() : (Int, Int) do
    glue_seed_limbs()
  end

  fn on_visibility(cb : Bool -> ()) : () do
    glue_on_visibility(cb)
  end

  fn vibrate(ms : Int) : () do
    glue_vibrate(ms)
  end

  fn on_pointer(canvas : Js.Dom.Node, down : List((Float, Float, Float)) -> (), move : List((Float, Float, Float)) -> (), up : List((Float, Float, Float)) -> (), cancel : () -> ()) : () do
    glue_on_pointer(canvas, down, move, up, cancel)
  end

  fn queue_tap(i : Int) : () do
    glue_queue_tap(i)
  end

  fn drain_taps() : List(Int) do
    glue_drain_taps()
  end

  doc """Set a data-* attribute on <html>, for the playtest to read. Writes only on change."""
  fn mark(name : String, value : String) : () do
    glue_mark(name, value)
  end

end
