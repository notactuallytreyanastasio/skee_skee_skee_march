mod SynthWorklet do

  -- The entry point of the audio worklet's build (dist/skee_synth_worklet.mjs),
  -- loaded by AudioWorklet.addModule in its own realm. It registers the
  -- processor that starts from a silent synth (SynthEngine.reset, SoundEngine's
  -- `Synth()`) and runs SynthEngine.serve every render quantum
  -- (web/skee_worklet.mjs). It depends on Arcade.Synth, Skee.Cues and Skee.SynthFeed only.
  needs IO.Foreign

  extern "./skee_worklet.mjs" : Cap(IO.Foreign) do
    fn worklet_register(reset : () -> (), serve : List(AudioCmd) -> List(Float)) : Unit
  end

  fn main(_f : Cap(IO.Foreign)) : () do
    worklet_register(fn () -> SynthEngine.reset(), fn cmds -> SynthEngine.serve(cmds))
  end

end
