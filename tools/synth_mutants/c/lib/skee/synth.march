mod Skee.Synth do

  -- Every sound in the game, synthesised: no audio files. A small polyphonic
  -- synth as a pure value, ported from Sources/SkeeRender/Synth.swift: sounds
  -- in, samples out. The shell owns the clock and the speakers; it calls
  -- `play` when the presentation cues a sound, `set_rumble` and `set_drum`
  -- from the ball, and `render` for every block the audio device asks for.
  --
  -- Swift does this in 32-bit Float. March has only doubles, so every Float
  -- operation is done in double and rounded to the nearest Float by `f32`,
  -- which gives Swift's result bit for bit (a double holds any product of two
  -- Floats exactly, and one rounding of an exact value is correct). The libm
  -- calls (sinf, expf, powf) are rounded double libm: see docs/PORT.md,
  -- "Skee.Synth", for the measured difference.
  cap pure

  -- One per Swift Cue, one to one; the app maps Cue to Sound. Named Snd* so
  -- they cannot clash with Cue's constructors or Hole's Gutter.
  type Sound =
    SndLaunch
    | SndRail
    | SndHump
    | SndLip
    | SndBackwall
    | SndLanded
    | SndDrop(Hole)
    | SndGutter
    | SndHop
    | SndWhoosh
    | SndHotSpot
    | SndLever
    | SndPullWin(Int)
    | SndReelTick
    | SndReelStop
    | SndCombo(Int)
    | SndTallyChips(Int)
    | SndTallyMult(Int)
    | SndFrameDone
    | SndLineWon
    | SndJackpot
    | SndBanner(String)
    | SndFoul

  type SynthWave = WaveSine | WaveSquare | WaveTri | WaveNoise

  -- Every Float field holds a value a Swift Float can hold. `glide_floor` is
  -- Swift's max(glide, 0.0001) and `life` its decay * 6, both computed once.
  type SynthVoice = {
    wave : SynthWave,
    freq : Float,
    freq_end : Float,
    glide_floor : Float,
    amp : Float,
    decay : Float,
    life : Float,
    delay : Float,
    t : Float,
    phase : Float
  }

  -- The Float constants of the synth, rounded to Float once.
  type SynthConsts = {
    split : Float,
    tiny : Float,
    subnormal_shift : Float,
    overflow : Float,
    infinity : Float,
    dt : Float,
    pi : Float,
    rumble_follow : Float,
    lowpass_follow : Float,
    rumble_gain : Float,
    drum_step : Float,
    min_glide : Float,
    attack_time : Float,
    square_level : Float,
    default_glide : Float
  }

  type Synth = {
    voices : List(SynthVoice),
    lowpass : Float,
    rumble : Float,
    drum_clock : Float,
    seed : Int,
    rumble_target : Float,
    drum : Bool,
    c : SynthConsts
  }

  doc """Samples per second."""
  fn rate() : Float needs () do
    44100.0
  end

  doc """Enough for the game's cues. A cue past it drops the oldest voices."""
  fn max_voices() : Int needs () do
    48
  end

  pfn pow2(e : Int, acc : Float) : Float needs () do
    if e > 0 do
      pow2(e - 1, acc *. 2.0)
    else
      if e < 0 do pow2(e + 1, acc *. 0.5) else acc end
    end
  end

  -- Before rounding exists, so built from exact doubles and checked by the suite.
  pfn rounding() : SynthConsts needs () do
    {
      split: 536870913.0,
      tiny: pow2(-126, 1.0),
      subnormal_shift: pow2(-97, 1.5),
      overflow: pow2(128, 1.0) -. pow2(103, 1.0),
      infinity: pow2(1023, 1.0) *. 2.0,
      dt: 0.0,
      pi: 0.0,
      rumble_follow: 0.0,
      lowpass_follow: 0.0,
      rumble_gain: 0.0,
      drum_step: 0.0,
      min_glide: 0.0,
      attack_time: 0.0,
      square_level: 0.0,
      default_glide: 0.0
    }
  end

  -- Swift's Float.pi is pi rounded toward zero (0x40490FDA), one ulp below
  -- the nearest Float. Float ulps between 2 and 4 are 2^-22.
  pfn pi_toward_zero(r : SynthConsts, pi : Float) : Float needs () do
    let nearest = f32(r, pi)
    if nearest > pi do nearest -. pow2(-22, 1.0) else nearest end
  end

  doc """The synth's constants. Build once: `new` does."""
  fn consts() : SynthConsts needs () do
    let r = rounding()
    let k = Skee.Consts.make()
    { r with dt: f32(r, 1.0 /. rate()), pi: pi_toward_zero(r, k.pi), rumble_follow: f32(r, 0.0008), lowpass_follow: f32(r, 0.035), rumble_gain: f32(r, 0.9), drum_step: f32(r, 0.055), min_glide: f32(r, 0.0001), attack_time: f32(r, 0.003), square_level: f32(r, 0.6), default_glide: f32(r, 0.1) }
  end

  doc """
  Swift's Float(x): the nearest Float, ties to even, subnormals and overflow
  included. Veltkamp's split keeps the top 24 bits of a normal double; below
  Float's normal range, adding and removing 1.5 * 2^-97 rounds to a multiple
  of 2^-149; from 2^128 - 2^103 (halfway past Float's largest) up, the answer
  is infinity. NaN stays NaN.
  """
  fn f32(c : SynthConsts, x : Float) : Float needs () do
    let ax = if x < 0.0 do 0.0 -. x else x end
    if ax >= c.overflow do
      if x < 0.0 do 0.0 -. c.infinity else c.infinity end
    else
      if ax < c.tiny do
        do
          let r = x +. c.subnormal_shift -. c.subnormal_shift
          if r == 0.0 do x *. 0.0 else r end
        end
      else
        do
          let p = x *. c.split
          p -. (p -. x)
        end
      end
    end
  end

  doc """Swift's sin on a Float: double sin, rounded."""
  fn sinf(c : SynthConsts, x : Float) : Float needs () do
    f32(c, Math.sin(x))
  end

  doc """Swift's exp on a Float: double exp, rounded."""
  fn expf(c : SynthConsts, x : Float) : Float needs () do
    f32(c, Math.exp(x))
  end

  doc """Swift's pow on Floats: double pow, rounded."""
  fn powf(c : SynthConsts, base : Float, e : Float) : Float needs () do
    f32(c, Math.pow(base, e))
  end

  doc """A silent synth: no voices, no rumble, no drum roll."""
  fn new() : Synth needs () do
    {
      voices: [],
      lowpass: 0.0,
      rumble: 0.0,
      drum_clock: 0.0,
      seed: 22222,
      rumble_target: 0.0,
      drum: false,
      c: consts()
    }
  end

  doc """The rolling rumble's loudness, which follows the ball's speed. Swift's `rumbleTarget`."""
  fn set_rumble(s : Synth, target : Float) : Synth needs () do
    { s with rumble_target: f32(s.c, target) }
  end

  doc """The drum roll, while a jackpot-chance ball is in the air. Swift's `drum`."""
  fn set_drum(s : Synth, drum_on : Bool) : Synth needs () do
    { s with drum: drum_on }
  end

  fn voice_count(s : Synth) : Int needs () do
    List.length(s.voices)
  end

  -- ---- Voices ----
  -- Swift's v(wave, f, to:, glide:, amp:, decay:, delay:), every argument
  -- rounded to Float. The shorter forms are its defaults: to = f,
  -- glide = 0.1, delay = 0.
  pfn voice(c : SynthConsts, w : SynthWave, f : Float, to : Float, glide : Float, amp : Float, decay : Float, delay : Float) : SynthVoice needs () do
    let d = f32(c, decay)
    {
      wave: w,
      freq: f32(c, f),
      freq_end: f32(c, to),
      glide_floor: Skee.Maths.max_float(f32(c, glide), c.min_glide),
      amp: f32(c, amp),
      decay: d,
      life: f32(c, d *. 6.0),
      delay: f32(c, delay),
      t: 0.0,
      phase: 0.0
    }
  end

  pfn tone(c : SynthConsts, w : SynthWave, f : Float, amp : Float, decay : Float) : SynthVoice needs () do
    voice(c, w, f, f, c.default_glide, amp, decay, 0.0)
  end

  pfn tone_at(c : SynthConsts, w : SynthWave, f : Float, amp : Float, decay : Float, delay : Float) : SynthVoice needs () do
    voice(c, w, f, f, c.default_glide, amp, decay, delay)
  end

  pfn bend(c : SynthConsts, w : SynthWave, f : Float, to : Float, amp : Float, decay : Float) : SynthVoice needs () do
    voice(c, w, f, to, c.default_glide, amp, decay, 0.0)
  end

  pfn glide(c : SynthConsts, w : SynthWave, f : Float, to : Float, time : Float, amp : Float, decay : Float) : SynthVoice needs () do
    voice(c, w, f, to, time, amp, decay, 0.0)
  end

  -- Float(i) * x, in Float.
  pfn times(c : SynthConsts, i : Int, x : Float) : Float needs () do
    f32(c, int_to_float(i) *. f32(c, x))
  end

  -- start + Float(i) * step, in Float.
  pfn after(c : SynthConsts, start : Float, i : Int, step : Float) : Float needs () do
    f32(c, f32(c, start) +. times(c, i, step))
  end

  pfn arpeggio_from(c : SynthConsts, notes : List(Float), i : Int, step : Float, amp : Float, decay : Float, w : SynthWave, acc : List(SynthVoice)) : List(SynthVoice) needs () do
    match notes do
    Nil -> List.reverse(acc)
    Cons(f, rest) -> do
      arpeggio_from(c, rest, i + 1, step, amp, decay, w, Cons(tone_at(c, w, f, amp, decay, times(c, i, step)), acc))
    end
    end
  end

  pfn arpeggio(c : SynthConsts, notes : List(Float), step : Float, amp : Float, decay : Float, w : SynthWave) : List(SynthVoice) needs () do
    arpeggio_from(c, notes, 0, step, amp, decay, w, [])
  end

  -- Bell partials, like a struck chime.
  pfn bell(c : SynthConsts, pitch : Float, loudness : Float, delay : Float) : List(SynthVoice) needs () do
    let f = f32(c, pitch)
    let amp = f32(c, loudness)
    [
      tone_at(c, WaveSine, f, amp, 0.5, delay),
      tone_at(c, WaveSine, f *. f32(c, 2.76), amp *. f32(c, 0.35), 0.25, delay),
      tone_at(c, WaveSine, f *. f32(c, 5.4), amp *. f32(c, 0.15), 0.12, delay)
    ]
  end

  -- (0..<n).map(f): Swift's range of voices.
  pfn upto(n : Int, f : Int -> SynthVoice) : List(SynthVoice) needs () do
    upto_from(0, n, f, [])
  end

  pfn upto_from(i : Int, n : Int, f : Int -> SynthVoice, acc : List(SynthVoice)) : List(SynthVoice) needs () do
    if i < n do
      upto_from(i + 1, n, f, Cons(f(i), acc))
    else
      List.reverse(acc)
    end
  end

  -- A dropped ball's bell, and whether the hole pays 50 or more (Hole.faceValue >= 50).
  pfn drop_bell(h : Hole) : (Float, Bool) needs () do
    match h do
    Ring10 -> (523.0, false)
    Ring20 -> (587.0, false)
    Ring30 -> (659.0, false)
    Ring40 -> (784.0, false)
    Ring50 -> (1046.0, true)
    PocketLeft -> (1318.0, true)
    PocketRight -> (1318.0, true)
    Gutter -> (220.0, false)
    end
  end

  pfn drop_voices(c : SynthConsts, h : Hole) : List(SynthVoice) needs () do
    let (pitch, big) = drop_bell(h)
    let thud = glide(c, WaveSine, 120.0, 50.0, 0.25, 0.6, 0.2)
    let ring = Cons(thud, bell(c, pitch, 0.3, 0.04))
    if big do List.append(ring, bell(c, pitch *. 1.5, 0.2, 0.12)) else ring end
  end

  -- Swift's Int division truncates toward zero.
  pfn div_trunc(a : Int, b : Int) : Int needs () do
    if a < 0 do 0 - (0 - a) / b else a / b end
  end

  pfn combo_voices(c : SynthConsts, n : Int) : List(SynthVoice) needs () do
    let k = powf(c, f32(c, 1.0595), int_to_float(2 * Math.min_int(n, 6)))
    List.append([tone(c, WaveSquare, 659.0 *. k, 0.1, 0.08), tone_at(c, WaveSquare, 988.0 *. k, 0.1, 0.14, 0.07)], bell(c, 1318.0 *. k, 0.15, 0.14))
  end

  -- A rising two-note chime, higher each link of the chain.
  pfn tally_step(c : SynthConsts, i : Int) : Float needs () do
    powf(c, f32(c, 1.06), int_to_float(i))
  end

  pfn hot_spot_voices(c : SynthConsts) : List(SynthVoice) needs () do
    let sparkle =
      upto(14, fn i -> tone_at(c, WaveTri, int_to_float(2600 + i * 7 % 5 * 300), 0.06, 0.025, after(c, 0.25, i, 0.04)))
    List.concat([arpeggio(c, [1046.0, 1318.0, 1568.0, 2093.0], 0.05, 0.2, 0.3, WaveTri), bell(c, 2093.0, 0.22, 0.2), sparkle])
  end

  pfn jackpot_voices(c : SynthConsts) : List(SynthVoice) needs () do
    let sparkle =
      upto(20, fn i -> tone_at(c, WaveTri, int_to_float(3000 + i % 5 * 400), 0.05, 0.03, after(c, 0.4, i, 0.04)))
    List.concat([arpeggio(c, [523.0, 659.0, 784.0, 1046.0, 1318.0, 1568.0, 2093.0], 0.055, 0.25, 0.3, WaveTri), bell(c, 1046.0, 0.35, 0.4), bell(c, 1568.0, 0.25, 0.45), sparkle])
  end

  pfn lever_voices(c : SynthConsts) : List(SynthVoice) needs () do
    let ratchet =
      upto(6, fn i -> tone_at(c, WaveTri, int_to_float(1200 - i * 60), 0.1, 0.012, times(c, i, 0.025)))
    List.append(ratchet, [voice(c, WaveSine, 90.0, 60.0, 0.1, 0.45, 0.12, 0.16), tone_at(c, WaveNoise, 0.0, 0.08, 0.05, 0.16)])
  end

  -- Ratchet down, then the clunk of the reels letting go.
  pfn pull_win_voices(c : SynthConsts, chips : Int) : List(SynthVoice) needs () do
    let n = Math.min_int(30, 6 + div_trunc(chips, 15))
    let rattle =
      upto(n, fn i -> tone_at(c, WaveTri, int_to_float(2400 + i * 7 % 5 * 300), 0.06, 0.02, after(c, 0.2, i, 0.035)))
    List.append(arpeggio(c, [784.0, 988.0, 1175.0], 0.07, 0.2, 0.12, WaveSine), rattle)
  end

  -- A coin rattle that runs longer the more it paid.
  pfn banner_voices(c : SynthConsts, text : String) : List(SynthVoice) needs () do
    if text == "CLEARED" do
      do
        let ticks =
          upto(16, fn i -> tone_at(c, WaveTri, 1800.0, 0.08, 0.012, after(c, 0.5, i, 0.045)))
        List.append(arpeggio(c, [392.0, 523.0, 659.0, 784.0, 1046.0], 0.08, 0.22, 0.25, WaveSine), ticks)
      end
    else
      if text == "FREE GAMES" do
        arpeggio(c, [523.0, 659.0, 784.0, 1046.0, 784.0, 1046.0, 1318.0, 1568.0], 0.07, 0.22, 0.2, WaveSquare)
      else
        if String.ends_with(text, "JACKPOT") do
          do
            let shower =
              upto(40, fn i -> tone_at(c, WaveTri, int_to_float(2600 + i % 6 * 350), 0.05, 0.03, after(c, 0.5, i, 0.04)))
            List.append(arpeggio(c, [523.0, 659.0, 784.0, 1046.0, 1318.0, 1568.0, 2093.0, 2637.0], 0.06, 0.25, 0.35, WaveTri), shower)
          end
        else
          if text == "GAME OVER" do
            arpeggio(c, [392.0, 370.0, 349.0, 294.0], 0.3, 0.15, 0.4, WaveSquare)
          else
            if text == "FEVER" do
              Cons(glide(c, WaveSquare, 300.0, 1200.0, 0.5, 0.1, 0.4), bell(c, 1568.0, 0.2, 0.5))
            else
              bell(c, 784.0, 0.18, 0.0)
            end
          end
        end
      end
    end
  end

  doc """The voices a sound starts, in Swift's order."""
  fn voices_for(c : SynthConsts, snd : Sound) : List(SynthVoice) needs () do
    match snd do
    SndLaunch -> do
      [
        tone(c, WaveNoise, 0.0, 0.12, 0.08),
        glide(c, WaveSine, 180.0, 320.0, 0.12, 0.15, 0.08)
      ]
    end
    SndWhoosh -> do
      [
        tone(c, WaveNoise, 0.0, 0.16, 0.3),
        glide(c, WaveSine, 900.0, 180.0, 0.5, 0.2, 0.3)
      ]
    end
    SndHotSpot -> hot_spot_voices(c)
    SndHop -> do
      [
        glide(c, WaveSine, 220.0, 780.0, 0.09, 0.3, 0.12),
        glide(c, WaveTri, 440.0, 1100.0, 0.09, 0.1, 0.08)
      ]
    end
    SndRail -> [tone(c, WaveTri, 900.0, 0.15, 0.03)]
    SndHump -> do
      [
        glide(c, WaveSine, 170.0, 120.0, 0.08, 0.55, 0.07),
        tone(c, WaveTri, 950.0, 0.18, 0.015),
        tone(c, WaveNoise, 0.0, 0.08, 0.02)
      ]
    end
    SndLip -> do
      [
        tone(c, WaveTri, 1900.0, 0.2, 0.02),
        tone_at(c, WaveTri, 2300.0, 0.16, 0.02, 0.035)
      ]
    end
    SndBackwall -> do
      [
        bend(c, WaveSine, 110.0, 80.0, 0.4, 0.12),
        tone(c, WaveNoise, 0.0, 0.06, 0.04)
      ]
    end
    SndLanded -> [bend(c, WaveSine, 140.0, 100.0, 0.3, 0.06)]
    SndDrop(h) -> drop_voices(c, h)
    SndGutter -> do
      [
        glide(c, WaveSine, 220.0, 70.0, 0.45, 0.35, 0.35),
        tone(c, WaveNoise, 0.0, 0.05, 0.1)
      ]
    end
    SndReelTick -> [tone(c, WaveTri, 2600.0, 0.07, 0.012)]
    SndReelStop -> do
      [
        tone(c, WaveTri, 1500.0, 0.18, 0.05),
        tone(c, WaveSine, 750.0, 0.12, 0.08)
      ]
    end
    SndCombo(n) -> combo_voices(c, n)
    SndTallyChips(i) -> [tone(c, WaveSine, 440.0 *. tally_step(c, i), 0.22, 0.07)]
    SndTallyMult(i) -> do
      [
        tone(c, WaveSquare, 587.0 *. tally_step(c, i), 0.1, 0.09),
        tone(c, WaveSine, 1174.0 *. tally_step(c, i), 0.08, 0.06)
      ]
    end
    SndFrameDone -> [tone(c, WaveSine, 392.0, 0.2, 0.15)]
    SndLineWon -> arpeggio(c, [523.0, 659.0, 784.0, 1046.0], 0.06, 0.22, 0.18, WaveSine)
    SndJackpot -> jackpot_voices(c)
    SndBanner(text) -> banner_voices(c, text)
    SndLever -> lever_voices(c)
    SndPullWin(chips) -> pull_win_voices(c, chips)
    SndFoul -> do
      [
        tone(c, WaveSquare, 110.0, 0.25, 0.3),
        tone(c, WaveSquare, 104.0, 0.2, 0.3)
      ]
    end
    end
  end

  -- Boing: a pitch that jumps up and falls back.
  -- Wood knock over the ramp.
  doc """Queue voices; past max_voices the oldest go. Swift's `add`."""
  fn add(s : Synth, vs : List(SynthVoice)) : Synth needs () do
    let all_voices = List.append(s.voices, vs)
    let over = List.length(all_voices) - max_voices()
    { s with voices: if over > 0 do List.drop(all_voices, over) else all_voices end }
  end

  doc """Start a sound. Swift's `play(_ cue:)`."""
  fn play(s : Synth, snd : Sound) : Synth needs () do
    add(s, voices_for(s.c, snd))
  end

  -- ---- Rendering ----
  -- Swift's LCG, UInt32 wrapping. seed < 2^32, so seed * 1664525 + 1013904223
  -- stays below 2^53 and is exact on JS.
  pfn next_seed(seed : Int) : Int needs () do
    (seed * 1664525 + 1013904223) % 4294967296
  end

  -- Float(seed >> 9) / 2^23 * 2 - 1: exact in Float and in double.
  pfn noise_of(seed : Int) : Float needs () do
    int_to_float(seed / 512) /. 8388608.0 *. 2.0 -. 1.0
  end

  type Mix = { level : Float, mix_seed : Int, kept : List(SynthVoice) }

  pfn oscillate(c : SynthConsts, w : SynthWave, phase : Float, seed : Int) : (Float, Int) needs () do
    match w do
    WaveSine -> (sinf(c, f32(c, phase *. 2.0 *. c.pi)), seed)
    WaveSquare -> (if phase < 0.5 do c.square_level else 0.0 -. c.square_level end, seed)
    WaveTri -> do
      let centred = f32(c, phase -. 0.5)
      let folded = if centred < 0.0 do 0.0 -. centred else centred end
      (f32(c, f32(c, 4.0 *. folded) -. 1.0), seed)
    end
    WaveNoise -> do
      let next = next_seed(seed)
      (noise_of(next), next)
    end
    end
  end

  -- One voice for one sample, in Swift's order of operations.
  pfn sound_voice(c : SynthConsts, v : SynthVoice, m : Mix) : Mix needs () do
    let f =
      f32(c, v.freq +. f32(c, f32(c, v.freq_end -. v.freq) *. Skee.Maths.min_float(1.0, f32(c, v.t /. v.glide_floor))))
    let stepped = f32(c, v.phase +. f32(c, f *. c.dt))
    let phase = if stepped > 1.0 do f32(c, stepped -. 1.0) else stepped end
    let (osc, seed) = oscillate(c, v.wave, phase, m.mix_seed)
    let attack = Skee.Maths.min_float(1.0, f32(c, v.t /. c.attack_time))
    let envelope = expf(c, f32(c, (0.0 -. v.t) /. v.decay))
    let level =
      f32(c, m.level +. f32(c, f32(c, f32(c, osc *. v.amp) *. attack) *. envelope))
    let t = f32(c, v.t +. c.dt)
    let kept =
      if t > v.life do
        m.kept
      else
        Cons({ v with t: t, phase: phase }, m.kept)
      end
    { level: level, mix_seed: seed, kept: kept }
  end

  pfn mix_voices(c : SynthConsts, vs : List(SynthVoice), m : Mix) : Mix needs () do
    match vs do
    Nil -> m
    Cons(v, rest) -> do
      if v.delay > 0.0 do
        mix_voices(c, rest, { m with kept: Cons({ v with delay: f32(c, v.delay -. c.dt) }, m.kept) })
      else
        mix_voices(c, rest, sound_voice(c, v, m))
      end
    end
    end
  end

  -- One drum hit every 0.055 s while the roll is on. Appended past
  -- max_voices, as Swift's render appends without add.
  pfn drum_roll(s : Synth) : Synth needs () do
    if s.drum do
      do
        let c = s.c
        let clock = f32(c, s.drum_clock +. c.dt)
        if clock > c.drum_step do
          { s with drum_clock: 0.0, voices: List.append(s.voices, [voice(c, WaveNoise, 0.0, 0.0, 1.0, 0.13, 0.03, 0.0)]) }
        else
          { s with drum_clock: clock }
        end
      end
    else
      s
    end
  end

  -- Swift's `0 + x`: +0 when x is -0. March folds `0.0 +. x` to x on every
  -- target, losing that (tools/repros/synth/fold_probe.march).
  pfn plus_zero(x : Float) : Float needs () do
    x
  end

  pfn next_sample(s : Synth) : (Float, Synth) needs () do
    let c = s.c
    let rumble =
      f32(c, s.rumble +. f32(c, f32(c, s.rumble_target -. s.rumble) *. c.rumble_follow))
    let seed = next_seed(s.seed)
    let lowpass =
      f32(c, s.lowpass +. f32(c, f32(c, noise_of(seed) -. s.lowpass) *. c.lowpass_follow))
    let level = plus_zero(f32(c, f32(c, lowpass *. rumble) *. c.rumble_gain))
    let drummed = drum_roll({ s with rumble: rumble, lowpass: lowpass, seed: seed })
    let m = mix_voices(c, drummed.voices, { level: level, mix_seed: seed, kept: [] })
    let out = Skee.Maths.max_float(-1.0, Skee.Maths.min_float(1.0, m.level))
    (out, { drummed with seed: m.mix_seed, voices: List.reverse(m.kept) })
  end

  -- Rolling rumble: low-passed noise that follows the ball's speed.
  pfn render_into(s : Synth, n : Int, acc : List(Float)) : (List(Float), Synth) needs () do
    if n > 0 do
      do
        let (x, next) = next_sample(s)
        render_into(next, n - 1, Cons(x, acc))
      end
    else
      (List.reverse(acc), s)
    end
  end

  doc """The next n samples, each in [-1, 1], and the synth after them. Swift's `render`."""
  fn render(s : Synth, n : Int) : (List(Float), Synth) needs () do
    render_into(s, n, [])
  end

end
