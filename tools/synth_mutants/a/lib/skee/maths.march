mod Skee.Maths do

  -- Plain 2D vectors and the small numeric helpers (Math/Vec.swift, Math/Trig.swift).
  -- Named Maths so that `Math.sqrt` inside this file still means the stdlib.
  cap pure

  type Vec2 = { x : Float, y : Float }

  derive Show for Vec2

  doc """Swift's max(x, y): y on a tie, which decides the sign of a zero."""
  fn max_float(x : Float, y : Float) : Float needs () do
    if y >= x do y else x end
  end

  doc """Swift's min(x, y): x on a tie."""
  fn min_float(x : Float, y : Float) : Float needs () do
    if y < x do y else x end
  end

  doc """Swift's min(max(x, lo), hi). NaN stays NaN."""
  fn clamp(x : Float, lo : Float, hi : Float) : Float needs () do
    min_float(max_float(x, lo), hi)
  end

  doc """Swift's min(max(x, lo), hi) on Ints: hi wins when hi < lo, unlike Math.clamp_int."""
  fn clamp_int(x : Int, lo : Int, hi : Int) : Int needs () do
    Math.min_int(Math.max_int(x, lo), hi)
  end

  -- atan2 is the portable way to see a zero's sign: 1 /. x panics natively.
  pfn is_negative(x : Float) : Bool needs () do
    if x == 0.0 do Math.atan2(x, -1.0) < 0.0 else x < 0.0 end
  end

  doc """
  a / b with IEEE results for b == 0: `/.` panics on zero natively, while Swift
  and JS give an infinity or NaN. Use it for any divisor that can reach zero.
  """
  fn ieee_div(k : Skee.Consts.Consts, a : Float, b : Float) : Float needs () do
    if b != 0.0 do
      a /. b
    else
      if a == 0.0 || a != a do
        k.nan
      else
        if is_negative(a) == is_negative(b) do k.infinity else -k.infinity end
      end
    end
  end

  doc """Degrees to radians, in Swift's order: d * pi / 180."""
  fn degrees(k : Skee.Consts.Consts, d : Float) : Float needs () do
    d *. k.pi /. 180.0
  end

  doc """Equality. Vec2 is a record, and records do not derive Eq: see Skee.Types."""
  fn equal(a : Vec2, b : Vec2) : Bool needs () do
    a.x == b.x && a.y == b.y
  end

  fn vec2(x : Float, y : Float) : Vec2 needs () do
    { x: x, y: y }
  end

  fn zero() : Vec2 needs () do
    { x: 0.0, y: 0.0 }
  end

  fn add(a : Vec2, b : Vec2) : Vec2 needs () do
    { x: a.x +. b.x, y: a.y +. b.y }
  end

  fn sub(a : Vec2, b : Vec2) : Vec2 needs () do
    { x: a.x -. b.x, y: a.y -. b.y }
  end

  fn scale(a : Vec2, k : Float) : Vec2 needs () do
    { x: a.x *. k, y: a.y *. k }
  end

  fn neg(a : Vec2) : Vec2 needs () do
    { x: -a.x, y: -a.y }
  end

  fn dot(a : Vec2, b : Vec2) : Float needs () do
    a.x *. b.x +. a.y *. b.y
  end

  fn length(a : Vec2) : Float needs () do
    Math.sqrt(a.x *. a.x +. a.y *. a.y)
  end

  doc """Unit vector; the zero vector stays zero rather than becoming NaN."""
  fn normalized(a : Vec2) : Vec2 needs () do
    let l = length(a)
    if l == 0.0 do zero() else { x: a.x /. l, y: a.y /. l } end
  end

end
