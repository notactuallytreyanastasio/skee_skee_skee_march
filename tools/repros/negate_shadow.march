-- COMPILER BUG: prefix minus lowers to a call of the name `negate`, and a user
-- function called `negate` captures it. This program never terminates: the
-- literal -1.0 inside negate calls negate. Native and JS (both observed)
-- recurse until the stack runs out.
mod NegateShadow do
  needs IO.Console

  fn negate(x : Float) : Float do
    x *. -1.0
  end

  fn main(_c : Cap(IO.Console)) : () do
    println(float_to_string(negate(2.0)))
  end
end
