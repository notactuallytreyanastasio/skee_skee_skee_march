mod Skee.U64 do

  -- UInt64 arithmetic for targets that cannot hold 64 bits in an Int.
  --
  -- March's Int is 63-bit natively and a double on JS, so a UInt64 is two 32-bit
  -- limbs: value = hi * 2^32 + lo, both limbs in [0, 2^32). Every intermediate
  -- stays below 2^53, so results are identical on interpreter, native and JS.
  -- A seed above 2^53 is therefore representable: build it with `make(hi, lo)`
  -- or `of_hex`, never through a single Int.
  cap pure

  type U64 = { hi : Int, lo : Int }

  derive Eq, Show for U64

  -- 2^32 and 2^32-1, spelled as products as stdlib/random.march does.
  pfn two32() : Int needs () do
    65536 * 65536
  end

  pfn mask32(x : Int) : Int needs () do
    int_and(x, two32() - 1)
  end

  doc """A value from its two limbs. Each limb is reduced to 32 bits."""
  fn make(hi : Int, lo : Int) : U64 needs () do
    { hi: mask32(hi), lo: mask32(lo) }
  end

  doc """A non-negative Int as a U64."""
  fn of_int(n : { Int | _ >= 0 }) : U64 needs () do
    { hi: n / two32(), lo: n % two32() }
  end

  pfn hex_digit(c : Int) : Option(Int) needs () do
    if c >= 48 && c <= 57 do
      Some(c - 48)
    else
      if c >= 97 && c <= 102 do
        Some(c - 87)
      else
        if c >= 65 && c <= 70 do Some(c - 55) else None end
      end
    end
  end

  pfn add_digit(acc : Option(U64), c : Int) : Option(U64) needs () do
    match (acc, hex_digit(c)) do
    (Some(v), Some(d)) -> do
      Some({ hi: mask32(v.hi * 16 + v.lo / (two32() / 16)), lo: mask32(v.lo * 16 + d) })
    end
    (None, _) -> None
    (_, None) -> None
    end
  end

  doc """Parse up to 16 hex digits. None if empty, too long or not hex."""
  fn of_hex(s : String) : Option(U64) needs () do
    let digits = String.to_codepoints(s)
    let n = List.length(digits)
    if n == 0 || n > 16 do
      None
    else
      List.fold_left(digits, Some({ hi: 0, lo: 0 }), add_digit)
    end
  end

  doc """a + b, wrapping at 2^64 like Swift's &+."""
  fn add(a : U64, b : U64) : U64 needs () do
    let low = a.lo + b.lo
    { hi: mask32(a.hi + b.hi + low / two32()), lo: mask32(low) }
  end

  doc """Bitwise exclusive or."""
  fn xor(a : U64, b : U64) : U64 needs () do
    { hi: int_xor(a.hi, b.hi), lo: int_xor(a.lo, b.lo) }
  end

  doc """Logical shift right by 1 to 31 bits."""
  fn shr(a : U64, k : { Int | _ >= 1 && _ <= 31 }) : U64 needs () do
    let carried = int_and(a.hi, int_shl(1, k) - 1) * int_shl(1, 32 - k)
    { hi: int_shr(a.hi, k), lo: carried + int_shr(a.lo, k) }
  end

  pfn low16(x : Int) : Int needs () do
    int_and(x, 65535)
  end

  pfn high16(x : Int) : Int needs () do
    int_shr(x, 16)
  end

  -- The low 32 bits of x * y, for 32-bit x and y.
  pfn mul_low32(x : Int, y : Int) : Int needs () do
    let cross = low16(high16(x) * low16(y) + low16(x) * high16(y))
    mask32(low16(x) * low16(y) + cross * 65536)
  end

  doc """a * b, wrapping at 2^64 like Swift's &*, by 16-bit halves: no product exceeds 2^34."""
  fn mul(a : U64, b : U64) : U64 needs () do
    let a0 = low16(a.lo)
    let a1 = high16(a.lo)
    let b0 = low16(b.lo)
    let b1 = high16(b.lo)
    let p00 = a0 * b0
    let mid = a0 * b1 + a1 * b0 + high16(p00)
    let low = low16(p00) + low16(mid) * 65536
    let carry = a1 * b1 + int_shr(mid, 16)
    {
      hi: mask32(carry + mul_low32(a.hi, b.lo) + mul_low32(a.lo, b.hi)),
      lo: low
    }
  end

end
