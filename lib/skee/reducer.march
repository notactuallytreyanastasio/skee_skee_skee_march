mod Skee.Reducer do

  -- The run state machine (Run/Reducer.swift, Run/RunState.swift). Everything that
  -- changes a run goes through `apply`: a pure function from an action and a state
  -- to a new state and its ordered events, or a typed error. A run is fully
  -- described by its seed and actions.
  cap pure

  import Skee.Rng

  -- ---- A new run ----
  doc """
  Start a run. The first ante's boss is drawn immediately so it can be shown from
  the start. `extra_tickets` are a comped night's: part of how the run starts, so
  a save (seed and actions) must carry them to replay exactly.
  """
  fn new_run(_k : Skee.Consts.Consts, seed : Skee.U64.U64, config : RunConfig, room : Room, extra_tickets : Tickets) : RunState needs () do
    let (boss, rng) = pick(Skee.Rng.seed(seed), Skee.Items.all_bosses())
    let scaled = { config with target_scale: config.target_scale *. Skee.Rooms.target_scale(room) }
    let blank_round = bare_round(Warmup, Points(0), 0)
    let start =
      {
        config: scaled,
        ball: ClassicBall,
        room: room,
        rng: rng,
        seed: seed,
        ante: 1,
        boss: boss,
        round: blank_round,
        phase: Throwing,
        setup: Skee.Rooms.setup(room),
        reel_stops: Skee.HoleMap.fill_reels(0),
        top_slot: Skee.Scoring.empty_slot(),
        charms: [],
        power_ups: [],
        tickets: Skee.Units.add_tickets(config.start_tickets, extra_tickets),
        heat: 0,
        fever: false,
        stats: fresh_stats()
      }
    spin_reels({ start with round: fresh_round(Warmup, start) })
  end

  pfn fresh_stats() : RunStats needs () do
    {
      stat_balls: 0,
      stat_holes: Skee.HoleMap.fill(0),
      jackpots: 0,
      stat_rattles: 0,
      best_frame: Points(0),
      pulls: 0,
      free_games: 0,
      jackpot_tiers: { mini: 0, minor: 0, major: 0, grand: 0 },
      points: Points(0),
      rounds_cleared: 0
    }
  end

  pfn bare_round(kind : RoundKind, target : Points, frames_total : Int) : RoundState needs () do
    {
      kind: kind,
      target: target,
      frames_total: frames_total,
      frames: [],
      current_balls: [],
      streak: 0,
      combo: 0,
      armed: None,
      round_pull: None,
      free_left: 0,
      round_hot: None,
      last_bet: BetOne
    }
  end

  -- `target` is None only for an empty `ante_base`, a config Swift traps on here
  -- too, so this arm is that same trap.
  pfn fresh_round(kind : RoundKind, s : RunState) : RoundState needs () do
    let base = s.config.frames_per_round
    let with_charm = if List.member(s.charms, ExtraBall) do base + 1 else base end
    let frames =
      match kind do
      BossRound -> with_charm + Skee.Items.frame_delta(s.boss)
      Warmup -> with_charm
      Feature -> with_charm
      end
    match Skee.Items.target(s.config, s.ante, kind) do
    Some(target) -> bare_round(kind, target, frames)
    None -> unreachable()
    end
  end

  -- ---- The table ----
  doc """
  The table the next ball is thrown on: ante difficulty, then the boss (on boss
  rounds), then the armed power-up, then the ball.
  """
  fn table_for(k : Skee.Consts.Consts, s : RunState) : Table needs () do
    let tightened = Skee.Items.difficulty_table(s.ante, Skee.Rooms.table(k, s.room), s.config.antes)
    let bossed =
      match s.round.kind do
      BossRound -> Skee.Items.modify_for_boss(s.boss, tightened)
      Warmup -> tightened
      Feature -> tightened
      end
    let armed =
      match s.round.armed do
      Some(p) -> Skee.Items.modify_for_power_up(p, bossed)
      None -> bossed
      end
    Skee.Items.modify_for_ball(s.ball, armed)
  end

  -- ---- Actions ----
  doc """
  The single entry point for changing a run. Pure: an invalid action is rejected
  with a typed error, and there is no new state to be half-changed.
  """
  fn apply(k : Skee.Consts.Consts, a : Action, s : RunState) : Result(Step, ActionError) needs () do
    apply_with(k, fn (l, t, b, seed) -> Skee.Physics.simulate_shot(k, l, t, b, seed), a, s)
  end

  doc """
  `apply` with the physics passed in. The game uses `apply`; a replay of recorded
  shots passes them here, which keeps libm out of a test of the rules.
  """
  fn apply_with(k : Skee.Consts.Consts, simulate : Launch -> Table -> BallKind -> Skee.U64.U64 -> ShotResult, a : Action, s : RunState) : Result(Step, ActionError) needs () do
    match a do
    PullLever(bet) -> on_lane(s, fn -> pull(bet, s))
    ThrowBall(l) -> on_lane(s, fn -> after_pull(s, fn -> throw_ball(k, simulate, l, s)))
    CommitFoul -> on_lane(s, fn -> after_pull(s, fn -> foul(s)))
    Arm(i) -> on_lane(s, fn -> arm(i, s))
    ChooseBall(b) -> on_lane(s, fn -> Ok(choose_ball(b, s)))
    Buy(i, target) -> at_counter(s, fn c -> buy(i, target, c, s))
    Reroll -> at_counter(s, fn c -> reroll(c, s))
    Sell(i) -> at_counter(s, fn _ -> sell(i, s))
    LeaveCounter -> at_counter(s, fn _ -> Ok(leave_counter(s)))
    end
  end

  pfn at_counter(s : RunState, act : PrizeCounter -> Result(Step, ActionError)) : Result(Step, ActionError) needs () do
    match s.phase do
    AtCounter(c) -> act(c)
    Throwing -> Err(WrongPhase)
    Lost -> Err(WrongPhase)
    Won -> Err(WrongPhase)
    end
  end

  pfn on_lane(s : RunState, act : () -> Result(Step, ActionError)) : Result(Step, ActionError) needs () do
    match s.phase do
    Throwing -> act()
    AtCounter(_) -> Err(WrongPhase)
    Lost -> Err(WrongPhase)
    Won -> Err(WrongPhase)
    end
  end

  pfn after_pull(s : RunState, ball : () -> Step) : Result(Step, ActionError) needs () do
    match s.round.round_pull do
    None -> Err(NeedsPull)
    Some(_) -> Ok(ball())
    end
  end

  -- ---- The pull ----
  -- Pull the lever: pay the bet, spin, read the window. Its centre row becomes the
  -- frame's targets; line wins wait in the pull until the frame is scored.
  pfn pull(bet : Bet, s0 : RunState) : Result(Step, ActionError) needs () do
    let cost = Skee.Scoring.bet_cost(bet)
    match s0.round.round_pull do
    Some(_) -> Err(AlreadyPulled)
    None -> do
      if Skee.Units.tickets_at_least(s0.tickets, cost) do
        do
          let paid = { s0 with tickets: Skee.Units.sub_tickets(s0.tickets, cost), round: { s0.round with last_bet: bet } }
          let (p, rng) = Skee.Scoring.spin(paid.rng, bet, false, paid.room)
          Ok(spin({ paid with rng: rng }, p))
        end
      else
        Err(CantAfford)
      end
    end
    end
  end

  pfn add_tier(m : PerTier(Int), t : JackpotTier) : PerTier(Int) needs () do
    match t do
    Mini -> { m with mini: m.mini + 1 }
    Minor -> { m with minor: m.minor + 1 }
    Major -> { m with major: m.major + 1 }
    Grand -> { m with grand: m.grand + 1 }
    end
  end

  pfn award_free_games(s : RunState, p : Pull) : (RunState, List(GameEvent)) needs () do
    if Skee.Scoring.triggers_free_games(p) do
      do
        let n = Skee.Scoring.free_games_awarded()
        let r = s.round
        let t = s.stats
        ({ s with round: { r with free_left: r.free_left + n, frames_total: r.frames_total + n }, stats: { t with free_games: t.free_games + n } }, [FreeGamesWon(n)])
      end
    else
      (s, [])
    end
  end

  pfn award_jackpot(s : RunState, p : Pull) : (RunState, List(GameEvent)) needs () do
    match Skee.Scoring.jackpot(p) do
    Some(tier) -> do
      let t = s.stats
      ({ s with stats: { t with jackpot_tiers: add_tier(t.jackpot_tiers, tier) } }, [JackpotHit(tier)])
    end
    None -> (s, [])
    end
  end

  -- The pull lands: set the targets and the Hot Spot, and pay what it triggered.
  pfn spin(s0 : RunState, p : Pull) : Step needs () do
    let spots = Skee.Physics.hot_spots()
    let (spot, rng) = next_int_below(s0.rng, List.length(spots))
    let stats = s0.stats
    let s =
      { s0 with rng: rng, top_slot: { targets: Skee.Scoring.targets(p) }, round: { s0.round with round_pull: Some(p), round_hot: List.nth_opt(spots, spot) }, stats: { stats with pulls: stats.pulls + 1 } }
    let (freed, free_events) = award_free_games(s, p)
    let (paid, jackpot_events) = award_jackpot(freed, p)
    { run: paid, step_events: List.concat([[Pulled(p)], free_events, jackpot_events]) }
  end

  doc """
  Swift's Wallet.pulled: feed the meters for a pull and pay out a jackpot if it
  hit one, returning what it paid. It is here because Rooms, which holds the rest
  of the wallet, comes before the Scoring it needs. The shell calls it for every
  `Pulled` event: a pull changes the run and the wallet, but only the run is
  this reducer's to hold.
  """
  fn wallet_pulled(w : Wallet, p : Pull) : (Winnings, Wallet) needs () do
    let fed =
      if p.free do w else { w with progressive: Skee.Scoring.feed(w.progressive, p.bet) } end
    match Skee.Scoring.jackpot(p) do
    None -> (Winnings(0), fed)
    Some(tier) -> do
      let (won, reset) = Skee.Scoring.hit(fed.progressive, tier)
      (won, Skee.Rooms.credit({ fed with progressive: reset }, won))
    end
    end
  end

  -- ---- Throwing ----
  doc """The symbol a hole is showing right now; the next ball into it gets it."""
  fn showing(s : RunState, hole : Hole) : Symbol needs () do
    let reel = Skee.Scoring.reel(s.setup, hole)
    let stop =
      match Skee.HoleMap.reel_at(s.reel_stops, hole) do
      Some(n) -> n
      None -> 0
      end
    List.nth(reel, stop % List.length(reel))
  end

  doc """Points scored so far this round."""
  fn round_score(r : RoundState) : Points needs () do
    List.fold_left(r.frames, Points(0), fn (total, f) -> Skee.Units.add_points(total, Skee.Scoring.frame_total(f)))
  end

  doc """Balls still to throw this round."""
  fn balls_left(r : RoundState) : Int needs () do
    (r.frames_total - List.length(r.frames)) * 3 - List.length(r.current_balls)
  end

  doc """Everything a round pays."""
  fn payout_total(p : Payout) : Tickets needs () do
    Skee.Units.add_tickets(Skee.Units.add_tickets(p.base, p.overkill), p.interest)
  end

  pfn foul(s0 : RunState) : Step needs () do
    let ball = { Skee.Scoring.ball_record(Gutter, Blank, Chips(0)) with foul: true }
    let stats = s0.stats
    let s =
      { s0 with round: { s0.round with armed: None, current_balls: List.append(s0.round.current_balls, [ball]), combo: 0 }, stats: { stats with stat_balls: stats.stat_balls + 1 } }
    finish_ball(spin_reels(s), [Fouled])
  end

  -- What a hole pays this ball, before the ball's pay and the Hot Spot.
  pfn base_chips(s : RunState, hole : Hole, armed : Option(PowerUp)) : Chips needs () do
    let face = Skee.Scoring.hole_chips(s.setup, hole)
    let bossed =
      match s.round.kind do
      BossRound -> Skee.Items.boss_chips(s.boss, hole, face)
      Warmup -> face
      Feature -> face
      end
    if armed == Some(GoldenBall) do Chips(Skee.Units.chips_int(bossed) * 3) else bossed end
  end

  pfn throw_ball(k : Skee.Consts.Consts, simulate : Launch -> Table -> BallKind -> Skee.U64.U64 -> ShotResult, launch : Launch, s0 : RunState) : Step needs () do
    let (seed, drawn) =
      if Skee.Items.is_random(s0.ball) do
        draw_shot_seed(s0)
      else
        (Skee.U64.of_int(0), s0)
      end
    let shot = simulate(launch, table_for(k, drawn), drawn.ball, seed)
    let armed = drawn.round.armed
    let hole = shot.hole
    let rattles = Skee.Physics.rattles(shot)
    let hot = Some(hole) == drawn.round.round_hot
    let weight = if hot do 2.0 else 1.0 end
    let chips =
      Chips(float_round(int_to_float(Skee.Units.chips_int(base_chips(drawn, hole, armed))) *. Skee.Items.pay(drawn.ball) *. weight))
    let symbol =
      if armed == Some(WildBall) && hole != Gutter do Clover else showing(drawn, hole) end
    let hits = Skee.Scoring.hits(drawn.top_slot, symbol)
    let combo = if hits > 0 do drawn.round.combo + 1 else 0 end
    let record =
      {
        record_hole: hole,
        record_symbol: symbol,
        record_chips: chips,
        rattles: rattles,
        record_fold: launch.fold,
        foul: false,
        slot_hits: hits,
        record_combo: combo,
        record_ball: drawn.ball,
        hot: hot
      }
    let gutter_heat = if hole == Gutter do 1 else 0 end
    let stats = drawn.stats
    let s =
      { drawn with round: { drawn.round with combo: combo, armed: None, current_balls: List.append(drawn.round.current_balls, [record]) }, heat: drawn.heat + rattles + gutter_heat, stats: { stats with stat_balls: stats.stat_balls + 1, stat_rattles: stats.stat_rattles + rattles, stat_holes: Skee.HoleMap.put(stats.stat_holes, hole, Skee.HoleMap.at(stats.stat_holes, hole) + 1) } }
    let held = if armed == Some(Hold) do s else spin_reels(s) end
    finish_ball(held, [Shot(shot, record)])
  end

  pfn draw_shot_seed(s : RunState) : (Skee.U64.U64, RunState) needs () do
    let (seed, rng) = next(s.rng)
    (seed, { s with rng: rng })
  end

  -- After any ball: score the frame if it is full, end the round if it was the
  -- last frame.
  pfn finish_ball(s : RunState, events : List(GameEvent)) : Step needs () do
    if List.length(s.round.current_balls) == s.config.balls_per_frame do
      score_full_frame(s, events)
    else
      { run: s, step_events: events }
    end
  end

  pfn frame_context(s : RunState) : ScoringContext needs () do
    let pairs_pay =
      match s.round.kind do
      BossRound -> Skee.Items.pairs_pay(s.boss)
      Warmup -> true
      Feature -> true
      end
    {
      context_charms: s.charms,
      streak_before: s.round.streak,
      context_fever: s.fever,
      pairs_pay: pairs_pay,
      context_pull: s.round.round_pull
    }
  end

  pfn bank_frame(s : RunState, frame : FrameScore) : RunState needs () do
    let total = Skee.Scoring.frame_total(frame)
    let stats = s.stats
    let jackpots = if Skee.Scoring.is_jackpot(frame) do stats.jackpots + 1 else stats.jackpots end
    let best = Math.max_int(Skee.Units.points_int(stats.best_frame), Skee.Units.points_int(total))
    { s with round: { s.round with frames: List.append(s.round.frames, [frame]), current_balls: [], round_pull: None, streak: frame.streak_after }, tickets: Skee.Units.add_tickets(s.tickets, frame.frame_tickets), fever: false, stats: { stats with jackpots: jackpots, best_frame: Points(best), points: Skee.Units.add_points(stats.points, total) } }
  end

  pfn score_full_frame(s0 : RunState, events : List(GameEvent)) : Step needs () do
    let frame = Skee.Scoring.score_frame(s0.round.current_balls, frame_context(s0))
    let s = bank_frame(s0, frame)
    let scored = List.append(events, [FrameScored(frame)])
    let (lit, all_events) =
      if s.heat >= s.config.fever_heat do
        ({ s with heat: s.heat - s.config.fever_heat, fever: true }, List.append(scored, [FeverLit]))
      else
        (s, scored)
      end
    if List.length(lit.round.frames) == lit.round.frames_total do
      end_round(lit, all_events)
    else
      next_frame(lit, all_events)
    end
  end

  -- A free game: the machine pulls for you, at the bet that won it.
  pfn next_frame(s : RunState, events : List(GameEvent)) : Step needs () do
    if s.round.free_left > 0 do
      do
        let (p, rng) = Skee.Scoring.spin(s.rng, s.round.last_bet, true, s.room)
        let step = spin({ s with rng: rng, round: { s.round with free_left: s.round.free_left - 1 } }, p)
        { run: step.run, step_events: List.append(events, step.step_events) }
      end
    else
      { run: s, step_events: events }
    end
  end

  pfn round_payout(s : RunState, score : Points, target : Points) : Payout needs () do
    let c = s.config
    let over =
      int_to_float(Skee.Units.points_int(score)) /. int_to_float(Math.max_int(Skee.Units.points_int(target), 1)) -. 1.0
    {
      base: Skee.Items.per_round_at(c.round_tickets, s.round.kind),
      overkill: Tickets(Math.min_int(c.overkill_cap, float_floor(over /. c.overkill_step))),
      interest: Tickets(Math.min_int(c.interest_cap, Skee.Units.tickets_int(s.tickets) / c.interest_per))
    }
  end

  pfn end_round(s : RunState, events : List(GameEvent)) : Step needs () do
    let score = round_score(s.round)
    let target = s.round.target
    if Skee.Units.points_at_least(score, target) do
      clear_round(s, events, score, target)
    else
      { run: { s with phase: Skee.Types.Lost }, step_events: List.append(events, [RoundFailed(score, target)]) }
    end
  end

  pfn is_last_boss(s : RunState) : Bool needs () do
    match s.round.kind do
    BossRound -> s.ante >= s.config.antes
    Warmup -> false
    Feature -> false
    end
  end

  pfn clear_round(s0 : RunState, events : List(GameEvent), score : Points, target : Points) : Step needs () do
    let payout = round_payout(s0, score, target)
    let stats = s0.stats
    let s =
      { s0 with tickets: Skee.Units.add_tickets(s0.tickets, payout_total(payout)), stats: { stats with rounds_cleared: stats.rounds_cleared + 1 } }
    let cleared = List.append(events, [RoundCleared(score, target, payout)])
    if is_last_boss(s) do
      { run: { s with phase: Skee.Types.Won }, step_events: List.append(cleared, [RunWon]) }
    else
      do
        let (offers, rolled) = roll_offers(s)
        { run: { rolled with phase: AtCounter({ offers: offers, reroll_cost: Tickets(1) }) }, step_events: List.append(cleared, [CounterOpened]) }
      end
    end
  end

  -- ---- Prize counter ----
  pfn roll_edit(r : Skee.Rng.Rng) : (Offer, Skee.Rng.Rng) needs () do
    let (kind, after) = next_int_below(r, 4)
    if kind == 0 do
      (OfferGild, after)
    else
      if kind == 1 do
        (OfferPurge, after)
      else
        do
          let (symbol, picked) = pick(after, [Cherry, Bell, BarSym, Seven, Diamond, Clover])
          (OfferStamp(symbol), picked)
        end
      end
    end
  end

  pfn roll_offers(s : RunState) : (List(Option(Offer)), RunState) needs () do
    let unowned = List.filter(Skee.Items.all_charms(), fn c -> !List.member(s.charms, c))
    let (mixed, r1) = shuffled(s.rng, unowned)
    let charms = List.map(List.take(mixed, 2), fn c -> OfferCharm(c))
    let (edit, r2) = roll_edit(r1)
    let (power, r3) = pick(r2, Skee.Items.all_power_ups())
    let offers = List.append(charms, [edit, OfferPowerUp(power)])
    (List.map(List.take(offers, s.config.offer_count), fn o -> Some(o)), { s with rng: r3 })
  end

  pfn offer_at(c : PrizeCounter, i : Int) : Option(Offer) needs () do
    if i < 0 do
      None
    else
      match List.nth_opt(c.offers, i) do
      Some(slot) -> slot
      None -> None
      end
    end
  end

  -- Stamps, gilds and purges act on a hole with a reel.
  pfn on_reel(target : Option(Hole), act : Hole -> Result(RunState, ActionError)) : Result(RunState, ActionError) needs () do
    match target do
    None -> Err(NeedsTarget)
    Some(Gutter) -> Err(NeedsTarget)
    Some(hole) -> act(hole)
    end
  end

  pfn stamp(s : RunState, hole : Hole, symbol : Symbol) : RunState needs () do
    let setup = s.setup
    let reel = List.append(Skee.Scoring.reel(setup, hole), [symbol])
    { s with setup: { setup with reels: Skee.HoleMap.reel_put(setup.reels, hole, reel) } }
  end

  pfn purge(s : RunState, hole : Hole) : Result(RunState, ActionError) needs () do
    let setup = s.setup
    let reel = Skee.Scoring.reel(setup, hole)
    let count = List.length(reel)
    if count > 1 do
      do
        let stop =
          match Skee.HoleMap.reel_at(s.reel_stops, hole) do
          Some(n) -> n
          None -> 0
          end
        Ok({ s with setup: { setup with reels: Skee.HoleMap.reel_put(setup.reels, hole, remove_at(reel, stop % count)) }, reel_stops: Skee.HoleMap.reel_put(s.reel_stops, hole, 0) })
      end
    else
      Err(ReelTooShort)
    end
  end

  pfn gild(s : RunState, hole : Hole) : RunState needs () do
    let setup = s.setup
    let held =
      match Skee.HoleMap.reel_at(setup.gild, hole) do
      Some(c) -> c
      None -> Chips(0)
      end
    { s with setup: { setup with gild: Skee.HoleMap.reel_put(setup.gild, hole, Skee.Units.add_chips(held, Skee.Items.gild_amount())) } }
  end

  -- What the offer does to the run, before it is paid for.
  pfn deliver(item : Offer, target : Option(Hole), s : RunState) : Result(RunState, ActionError) needs () do
    match item do
    OfferCharm(charm) -> do
      if List.length(s.charms) < s.config.charm_slots do
        Ok({ s with charms: List.append(s.charms, [charm]) })
      else
        Err(SlotsFull)
      end
    end
    OfferPowerUp(p) -> do
      if List.length(s.power_ups) < s.config.power_up_slots do
        Ok({ s with power_ups: List.append(s.power_ups, [p]) })
      else
        Err(SlotsFull)
      end
    end
    OfferStamp(symbol) -> on_reel(target, fn hole -> Ok(stamp(s, hole, symbol)))
    OfferPurge -> on_reel(target, fn hole -> purge(s, hole))
    OfferGild -> on_reel(target, fn hole -> Ok(gild(s, hole)))
    end
  end

  pfn clear_slot(c : PrizeCounter, i : Int) : PrizeCounter needs () do
    { c with offers: List.concat([List.take(c.offers, i), [None], List.drop(c.offers, i + 1)]) }
  end

  pfn buy(i : Int, target : Option(Hole), c : PrizeCounter, s : RunState) : Result(Step, ActionError) needs () do
    match offer_at(c, i) do
    None -> Err(NoSuchOffer)
    Some(item) -> do
      let cost = Skee.Items.offer_cost(item)
      if Skee.Units.tickets_at_least(s.tickets, cost) do
        match deliver(item, target, s) do
        Err(e) -> Err(e)
        Ok(stocked) -> Ok({ run: { stocked with tickets: Skee.Units.sub_tickets(stocked.tickets, cost), phase: AtCounter(clear_slot(c, i)) }, step_events: [Bought(item)] })
        end
      else
        Err(CantAfford)
      end
    end
    end
  end

  pfn reroll(c : PrizeCounter, s : RunState) : Result(Step, ActionError) needs () do
    if Skee.Units.tickets_at_least(s.tickets, c.reroll_cost) do
      do
        let paid = { s with tickets: Skee.Units.sub_tickets(s.tickets, c.reroll_cost) }
        let (offers, rolled) = roll_offers(paid)
        let dearer = Skee.Units.add_tickets(c.reroll_cost, Tickets(1))
        Ok({ run: { rolled with phase: AtCounter({ offers: offers, reroll_cost: dearer }) }, step_events: [Rerolled] })
      end
    else
      Err(CantAfford)
    end
  end

  pfn sell(i : Int, s : RunState) : Result(Step, ActionError) needs () do
    let found = if i >= 0 do List.nth_opt(s.charms, i) else None end
    match found do
    None -> Err(NoSuchItem)
    Some(charm) -> do
      let refund = Tickets(Skee.Units.tickets_int(Skee.Items.charm_cost(charm)) / 2)
      Ok({ run: { s with charms: remove_at(s.charms, i), tickets: Skee.Units.add_tickets(s.tickets, refund) }, step_events: [Sold(charm)] })
    end
    end
  end

  pfn leave_counter(s : RunState) : Step needs () do
    match Skee.Items.round_next(s.round.kind) do
    Some(next_kind) -> do
      let round = fresh_round(next_kind, s)
      { run: { s with round: round, phase: Throwing }, step_events: [RoundStarted(round.kind, round.target)] }
    end
    None -> do
      let (boss, rng) = pick(s.rng, Skee.Items.all_bosses())
      let raised = { s with ante: s.ante + 1, boss: boss, rng: rng }
      let round = fresh_round(Warmup, raised)
      { run: { raised with round: round, phase: Throwing }, step_events: [AnteStarted(raised.ante, boss), RoundStarted(round.kind, round.target)] }
    end
    end
  end

  -- ---- Ball and power-up ----
  pfn choose_ball(b : BallKind, s : RunState) : Step needs () do
    { run: { s with ball: b }, step_events: [BallChosen(b)] }
  end

  pfn remove_at(xs : List(a), i : Int) : List(a) needs () do
    List.append(List.take(xs, i), List.drop(xs, i + 1))
  end

  pfn arm(i : Int, s : RunState) : Result(Step, ActionError) needs () do
    match (if i >= 0 do List.nth_opt(s.power_ups, i) else None end, s.round.armed) do
    (None, _) -> Err(NoSuchItem)
    (Some(_), Some(_)) -> Err(AlreadyArmed)
    (Some(p), None) -> Ok({ run: { s with power_ups: remove_at(s.power_ups, i), round: { s.round with armed: Some(p) } }, step_events: [Armed(p)] })
    end
  end

  -- ---- The reels ----
  pfn spin_reel(s : RunState, hole : Hole) : RunState needs () do
    let (stop, rng) = next_int_below(s.rng, List.length(Skee.Scoring.reel(s.setup, hole)))
    { s with rng: rng, reel_stops: Skee.HoleMap.reel_put(s.reel_stops, hole, stop) }
  end

  -- Every reel lands on a fresh seeded stop.
  pfn spin_reels(s : RunState) : RunState needs () do
    List.fold_left(Skee.HoleMap.reel_holes(), s, spin_reel)
  end

end
