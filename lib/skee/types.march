mod Skee.Types do

  -- Every data type more than one piece needs, ported from SkeeCore, plus the
  -- default spec values. Types and defaults only: behaviour lives in the piece
  -- modules (see docs/PORT.md).
  --
  -- ADDITIVE RULE. Other agents read this file while you edit it. You may append
  -- a type or a constructor. You may not rename, reorder or remove anything, and
  -- you must re-read the file immediately before every edit.
  --
  -- Where Swift used a dictionary with a closed key set, the port uses a record
  -- with one field per key (PerHole and friends), so a missing key cannot exist.
  -- Where Swift used an array of a fixed length, the port uses Three or a named
  -- record. Parallel arrays became one list of pairs (ShotResult.events).
  --
  -- No record derives Eq, and neither does anything holding one: native `==` on
  -- records silently gives wrong answers (tools/repros/record_eq), so the
  -- compiler must reject it. Compare records field by field in a named function.
  --
  -- Constructors are unique across this file, even where the Swift reuses a
  -- name, so a bare constructor always means one thing.
  cap pure

  import Skee.Maths

  -- ---- Containers ----
  -- Exactly three of something: the three reels.
  type Three(a) = Three(a, a, a)

  derive Eq, Show for Three

  -- One value per Hole, gutter included. Read with Skee.HoleMap.
  type PerHole(a) = {
    gutter : a,
    ring10 : a,
    ring20 : a,
    ring30 : a,
    ring40 : a,
    ring50 : a,
    pocket_left : a,
    pocket_right : a
  }

  derive Show for PerHole

  -- One value per hole that has a reel: every Hole but the gutter.
  type PerReel(a) = {
    reel10 : a,
    reel20 : a,
    reel30 : a,
    reel40 : a,
    reel50 : a,
    reel_left : a,
    reel_right : a
  }

  derive Show for PerReel

  -- One value per RoundKind.
  type PerRound(a) = { warmup : a, feature : a, boss_round : a }

  derive Show for PerRound

  -- One value per JackpotTier.
  type PerTier(a) = { mini : a, minor : a, major : a, grand : a }

  derive Show for PerTier

  -- One value per Room.
  type PerRoom(a) = {
    boardwalk : a,
    neon_lounge : a,
    high_roller : a,
    penthouse : a
  }

  derive Show for PerRoom

  -- ---- Units ----
  -- The four quantities a frame moves between. Swift holds all of them in Int,
  -- which lets a price be added to a score. Arithmetic and comparison are in
  -- Skee.Units. These types deliberately do not derive Ord: see docs/PORT.md.
  -- Chips on a ball or frame, before the multiplier.
  type Chips = Chips(Int)

  derive Eq, Show for Chips

  -- A frame's or round's score, chips times mult, and the targets it must beat.
  type Points = Points(Int)

  derive Eq, Show for Points

  -- The in-run currency.
  type Tickets = Tickets(Int)

  derive Eq, Show for Tickets

  -- The between-runs currency: prizes, comps and the progressive meters.
  type Winnings = Winnings(Int)

  derive Eq, Show for Winnings

  -- ---- Physics ----
  -- Where a ball ends up. Every shot resolves to exactly one hole. Compare with
  -- Skee.Units.hole_rank: `derive Ord` is broken, see docs/PORT.md.
  type Hole =
    Gutter
    | Ring10
    | Ring20
    | Ring30
    | Ring40
    | Ring50
    | PocketLeft
    | PocketRight

  derive Eq, Show, Hash for Hole

  -- Things that happened during a shot, in order.
  type ShotEvent =
    ShotDud
    | ShotRail
    | ShotLaunched
    | ShotLanded
    | ShotLip(Int)
    | ShotBackwall
    | ShotHop
    | ShotDropped(Hole)
    | ShotSettled(Hole)
    | ShotGutter

  derive Eq, Show for ShotEvent

  -- An event and when it happened, in seconds from release.
  type TimedEvent = { event : ShotEvent, at : Float }

  derive Show for TimedEvent

  type PathPhase = OnLane | InAir | OnBoard

  derive Eq, Show for PathPhase

  -- One recorded instant. `along` is distance from the release point: 0 to
  -- lane.length on the lane, lane.length + y on the board. `height` is z above
  -- the board, 0 on the lane.
  type PathSample = {
    t : Float,
    phase : PathPhase,
    px : Float,
    along : Float,
    height : Float
  }

  derive Show for PathSample

  -- Everything the player controls about one ball, already normalised. Build one
  -- only with the constructors in Skee.Physics: they do the clamping, and fields
  -- are read everywhere as if it had been done.
  type Launch = {
    power : Float,
    speed : Float,
    from : Float,
    aim : Float,
    start : Float,
    fold : Float,
    spin : Float,
    skid : Float
  }

  derive Show for Launch

  type ShotResult = {
    launch : Launch,
    hole : Hole,
    events : List(TimedEvent),
    path : List(PathSample),
    hinge_speed : Option(Float),
    first_landing : Option(Vec2),
    peak_height : Float,
    duration : Float
  }

  derive Show for ShotResult

  type LaneSpec = {
    length : Float,
    width : Float,
    incline : Float,
    rolling_friction : Float,
    rail_restitution : Float,
    min_speed : Float,
    scoring_speed : Float,
    max_speed : Float,
    knee : Float,
    max_aim_angle : Float,
    hook : Float,
    skid_loss : Float
  }

  derive Show for LaneSpec

  type HingeSpec = { base_angle : Float, fold_gain : Float, carry : Float }

  derive Show for HingeSpec

  type Pocket = { pocket_hole : Hole, center : Vec2, radius : Float }

  derive Show for Pocket

  -- Swift's two-element pockets array: left first, the order they are tested in.
  type Pockets = { left : Pocket, right : Pocket }

  derive Show for Pockets

  -- Swift's ringWalls array, smallest first: inside `wall40` is the 40 cup.
  type RingWalls = {
    wall40 : Float,
    wall30 : Float,
    wall20 : Float,
    wall10 : Float
  }

  derive Show for RingWalls

  type BoardSpec = {
    board_width : Float,
    board_height : Float,
    tilt : Float,
    ring_center : Vec2,
    center_hole_offset : Vec2,
    center_hole_radius : Float,
    capture_speed : Float,
    pockets_need_flight : Bool,
    lip_min_fall : Float,
    ring_walls : RingWalls,
    pockets : Pockets,
    lip_height : Float,
    ball_radius : Float,
    lip_band : Float,
    bounce : Float,
    lip_bounce : Float,
    lip_kick : Float,
    wall_restitution : Float,
    backwall_restitution : Float,
    board_rolling_friction : Float,
    landing_grip : Float,
    wind : Vec2,
    ring_hole_radius : Float
  }

  derive Show for BoardSpec

  type Table = {
    lane : LaneSpec,
    hinge : HingeSpec,
    board : BoardSpec,
    gravity : Float,
    dt : Float,
    max_duration : Float
  }

  derive Show for Table

  -- ---- Scoring ----
  -- Board symbols. Every hole carries one; a frame's three balls read as a payline.
  type Symbol = Blank | Cherry | Lemon | Bell | BarSym | Seven | Diamond | Clover

  derive Eq, Show, Hash for Symbol

  -- The result of reading three symbols as one line.
  type Payline = NoLine | Pair(Symbol) | Triple(Symbol)

  derive Eq, Show for Payline

  -- Symbols on the pull machine's reels.
  type ReelSymbol =
    ReelCherry
    | ReelLemon
    | ReelBell
    | ReelBar
    | ReelSeven
    | ReelDiamond
    | ReelWild
    | ReelX2
    | ReelX3
    | ReelBonus

  derive Eq, Show, Hash for ReelSymbol

  -- 1, 3 or 5 lines. Compare with Skee.Units.bet_rank.
  type Bet = BetOne | BetThree | BetFive

  derive Eq, Show for Bet

  type JackpotTier = Mini | Minor | Major | Grand

  derive Eq, Show for JackpotTier

  -- `line` is an index into the five pull lines; 0 is the centre row.
  type LineWin = {
    line : { Int | line >= 0 && line < 5 },
    symbol : ReelSymbol,
    line_chips : Chips,
    multiplier : Int
  }

  derive Show for LineWin

  -- Whose machine a pull is on. Compare with Skee.Units.room_rank.
  type Room = Boardwalk | NeonLounge | HighRoller | Penthouse

  derive Eq, Show, Hash for Room

  -- One pull of the lever. `stops` is each reel's top visible stop on its strip.
  type Pull = { stops : Three(Int), bet : Bet, free : Bool, pull_room : Room }

  derive Show for Pull

  -- The progressive meters over the machine, kept between runs.
  type Progressive = { meters : PerTier(Winnings) }

  derive Show for Progressive

  -- The player's reels and gilding. A hole's first symbol is its home symbol.
  type BoardSetup = { reels : PerReel(List(Symbol)), gild : PerReel(Chips) }

  derive Show for BoardSetup

  -- The frame's targets: the centre row of the last pull.
  type TopSlot = { targets : Three(Symbol) }

  derive Show for TopSlot

  type BallKind = Marshmallow | ClassicBall | JumpingBean | Wobbler | Comet

  derive Eq, Show, Hash for BallKind

  -- One thrown ball as the scorer sees it.
  type BallRecord = {
    record_hole : Hole,
    record_symbol : Symbol,
    record_chips : Chips,
    rattles : Int,
    record_fold : Float,
    foul : Bool,
    slot_hits : Int,
    record_combo : Int,
    record_ball : BallKind,
    hot : Bool
  }

  derive Show for BallRecord

  type Charm =
    LuckyPenny
    | HotStreak
    | HeavyHand
    | GutterRat
    | EvenSteven
    | Ladder
    | CornerOffice
    | NearMiss
    | MultBall
    | GlassCannon
    | TicketMuncher
    | HingeWhisperer
    | BellRinger
    | SevenSeas
    | ExtraBall

  derive Eq, Show, Hash for Charm

  type ScoringContext = {
    context_charms : List(Charm),
    streak_before : Int,
    context_fever : Bool,
    pairs_pay : Bool,
    context_pull : Option(Pull)
  }

  derive Show for ScoringContext

  -- What a score step came from. Ball and slot carry the ball's index in the frame.
  type ScoreSource =
    FromBase
    | FromPull
    | FromBall(Int)
    | FromSlot(Int)
    | FromPayline
    | FromCharm(Charm)
    | FromFever
    | FromFreeGame

  derive Eq, Show for ScoreSource

  -- One change to chips or mult. The total is just the fold of these.
  type ScoreEffect =
    SetBase(Chips, Float)
    | AddChips(Chips)
    | AddMult(Float)
    | TimesMult(Float)
    | AddTickets(Tickets)
    | Note(String)

  derive Eq, Show for ScoreEffect

  type ScoreStep = { source : ScoreSource, effect : ScoreEffect }

  derive Show for ScoreStep

  type FrameScore = {
    balls : List(BallRecord),
    payline : Payline,
    steps : List(ScoreStep),
    frame_chips : Chips,
    mult : Float,
    frame_tickets : Tickets,
    streak_after : Int
  }

  derive Show for FrameScore

  -- What a charm is allowed to look at.
  type FrameView = {
    view_balls : List(BallRecord),
    view_payline : Payline,
    view_streak_after : Int
  }

  derive Show for FrameView

  -- ---- Items and the counter ----
  type PowerUp = GoldenBall | Feather | Magnet | WildBall | Hold

  derive Eq, Show, Hash for PowerUp

  -- What the prize counter can sell.
  type Offer =
    OfferCharm(Charm)
    | OfferStamp(Symbol)
    | OfferGild
    | OfferPurge
    | OfferPowerUp(PowerUp)

  derive Eq, Show for Offer

  -- None marks a slot already bought this visit.
  type PrizeCounter = { offers : List(Option(Offer)), reroll_cost : Tickets }

  derive Show for PrizeCounter

  type Boss =
    TallLips
    | SlickLane
    | Crosswind
    | Miser
    | ShortHand
    | TightPockets
    | TheHouse

  derive Eq, Show, Hash for Boss

  -- ---- The run ----
  type RoundKind = Warmup | Feature | BossRound

  derive Eq, Show, Hash for RoundKind

  -- Every balance number for a run lives here.
  type RunConfig = {
    antes : Int,
    frames_per_round : Int,
    balls_per_frame : Int,
    start_tickets : Tickets,
    charm_slots : Int,
    power_up_slots : Int,
    fever_heat : Int,
    ante_base : List(Points),
    target_scale : Float,
    kind_scale : PerRound(Float),
    round_tickets : PerRound(Tickets),
    overkill_step : Float,
    overkill_cap : Int,
    interest_per : Int,
    interest_cap : Int,
    offer_count : Int
  }

  derive Show for RunConfig

  -- One round: a target, a number of three-ball frames, and the balls so far.
  type RoundState = {
    kind : RoundKind,
    target : Points,
    frames_total : Int,
    frames : List(FrameScore),
    current_balls : List(BallRecord),
    streak : Int,
    combo : Int,
    armed : Option(PowerUp),
    round_pull : Option(Pull),
    free_left : Int,
    round_hot : Option(Hole),
    last_bet : Bet
  }

  derive Show for RoundState

  type Phase = Throwing | AtCounter(PrizeCounter) | Lost | Won

  derive Show for Phase

  type RunStats = {
    stat_balls : Int,
    stat_holes : PerHole(Int),
    jackpots : Int,
    stat_rattles : Int,
    best_frame : Points,
    pulls : Int,
    free_games : Int,
    jackpot_tiers : PerTier(Int),
    points : Points,
    rounds_cleared : Int
  }

  derive Show for RunStats

  -- The whole run as a value. Its seed and actions reproduce it exactly.
  type RunState = {
    config : RunConfig,
    ball : BallKind,
    room : Room,
    rng : Skee.Rng.Rng,
    seed : Arcade.U64.U64,
    ante : { Int | ante >= 1 },
    boss : Boss,
    round : RoundState,
    phase : Phase,
    setup : BoardSetup,
    reel_stops : PerReel(Int),
    top_slot : TopSlot,
    charms : List(Charm),
    power_ups : List(PowerUp),
    tickets : Tickets,
    heat : { Int | heat >= 0 },
    fever : Bool,
    stats : RunStats
  }

  derive Show for RunState

  type Action =
    PullLever(Bet)
    | ThrowBall(Launch)
    | CommitFoul
    | ChooseBall(BallKind)
    | Arm(Int)
    | Buy(Int, Option(Hole))
    | Reroll
    | Sell(Int)
    | LeaveCounter

  derive Show for Action

  type ActionError =
    WrongPhase
    | NoSuchOffer
    | NoSuchItem
    | CantAfford
    | SlotsFull
    | NeedsTarget
    | AlreadyArmed
    | ReelTooShort
    | NeedsPull
    | AlreadyPulled

  derive Eq, Show for ActionError

  type Payout = { base : Tickets, overkill : Tickets, interest : Tickets }

  derive Show for Payout

  -- Things the shell should show or play, in the order they happened.
  type GameEvent =
    Pulled(Pull)
    | FreeGamesWon(Int)
    | JackpotHit(JackpotTier)
    | Shot(ShotResult, BallRecord)
    | Fouled
    | FrameScored(FrameScore)
    | FeverLit
    | RoundCleared(Points, Points, Payout)
    | RoundFailed(Points, Points)
    | CounterOpened
    | Bought(Offer)
    | Sold(Charm)
    | Rerolled
    | Armed(PowerUp)
    | BallChosen(BallKind)
    | RoundStarted(RoundKind, Points)
    | AnteStarted(Int, Boss)
    | RunWon

  derive Show for GameEvent

  -- Swift's Step: the field is `run` because `state` is a March keyword.
  type Step = { run : RunState, step_events : List(GameEvent) }

  derive Show for Step

  -- ---- Between runs ----
  type Prize =
    Sticker
    | RubberDuck
    | Kazoo
    | Yoyo
    | Slinky
    | PlushFrog
    | LavaLamp
    | Robot
    | GiantBear
    | Trophy
    | GlowSticks
    | RollerSkates
    | DiscoBall
    | NeonSign
    | Jukebox
    | ArcadeCabinet
    | Cufflinks
    | Champagne
    | PearlNecklace
    | GoldWatch
    | Chandelier
    | SportsCar
    | GoldenFlamingo
    | HotTub
    | GrandPiano
    | Yacht
    | PrivateJet
    | DiamondCrown

  derive Eq, Show, Hash for Prize

  type ShopError = ShopCantAfford | AlreadyOwned

  derive Eq, Show for ShopError

  -- What the host comps you with a room.
  type Comp = {
    comp_room : Room,
    nights : Int,
    comp_tickets : Tickets,
    credit : Winnings
  }

  derive Show for Comp

  -- Winnings carried between runs, and the shelf they bought. `rooms` is Swift's
  -- Set(Room), `comps` its optional dictionary by room.
  type Wallet = {
    balance : Winnings,
    lifetime : Winnings,
    owned : List(Prize),
    progressive : Progressive,
    rooms : PerRoom(Bool),
    wallet_room : Room,
    comps : PerRoom(Option(Comp)),
    games_since_host : Int,
    host_visits : Int
  }

  derive Show for Wallet

  -- ---- Input ----
  type FlickSample = { sample_t : Float, sample_x : Float, sample_y : Float }

  derive Show for FlickSample

  type FlickGeometry = {
    crease_y : Float,
    lane_center_x : Float,
    lane_half_width : Float,
    foul_give : Float
  }

  derive Show for FlickGeometry

  type StrokeOutcome = NoThrow | StrokeFoul | Release(Launch)

  derive Show for StrokeOutcome

  type FlickTuning = {
    slowest : Float,
    fastest : Float,
    release_weight : Float,
    snap_gain : Float,
    full_aim_angle : Float,
    smooth_jerk : Float,
    skid_per_jerk : Float,
    line_reach : Float
  }

  derive Show for FlickTuning

  -- ---- Bots ----
  -- How shaky a bot's hand is: Gaussian noise on power and aim.
  type Skill = { skill_name : String, power_sigma : Float, aim_sigma : Float }

  derive Show for Skill

  -- ---- Default spec values ----
  -- Functions, not module-level lets: a `let` in a library module is broken on
  -- the JS target (see docs/PORT.md). Angles take the Consts record because
  -- they are derived from pi.
  fn standard_lane(k : Skee.Consts.Consts) : LaneSpec needs () do
    {
      length: 2.4,
      width: 0.62,
      incline: degrees(k, 6.0),
      rolling_friction: 0.02,
      rail_restitution: 0.6,
      min_speed: 2.0,
      scoring_speed: 3.0,
      max_speed: 4.5,
      knee: 0.12,
      max_aim_angle: degrees(k, 8.0),
      hook: 0.35,
      skid_loss: 0.12
    }
  end

  fn standard_hinge(k : Skee.Consts.Consts) : HingeSpec needs () do
    { base_angle: degrees(k, 45.0), fold_gain: degrees(k, 20.0), carry: 1.0 }
  end

  fn standard_board(k : Skee.Consts.Consts) : BoardSpec needs () do
    {
      board_width: 0.62,
      board_height: 1.0,
      tilt: degrees(k, 20.0),
      ring_center: vec2(0.0, 0.58),
      center_hole_offset: vec2(0.0, 0.04),
      center_hole_radius: 0.03,
      capture_speed: 1.2,
      pockets_need_flight: true,
      lip_min_fall: 0.6,
      ring_walls: { wall40: 0.1, wall30: 0.16, wall20: 0.22, wall10: 0.29 },
      pockets: {
        left: { pocket_hole: PocketLeft, center: vec2(-0.2, 0.86), radius: 0.036 },
        right: { pocket_hole: PocketRight, center: vec2(0.2, 0.86), radius: 0.036 }
      },
      lip_height: 0.025,
      ball_radius: 0.03,
      lip_band: 0.6,
      bounce: 0.3,
      lip_bounce: 0.3,
      lip_kick: 0.2,
      wall_restitution: 0.4,
      backwall_restitution: 0.35,
      board_rolling_friction: 0.08,
      landing_grip: 0.35,
      wind: zero(),
      ring_hole_radius: 0.03
    }
  end

  fn standard_table(k : Skee.Consts.Consts) : Table needs () do
    {
      lane: standard_lane(k),
      hinge: standard_hinge(k),
      board: standard_board(k),
      gravity: 9.81,
      dt: k.dt,
      max_duration: 8.0
    }
  end

  fn standard_config() : RunConfig needs () do
    {
      antes: 8,
      frames_per_round: 3,
      balls_per_frame: 3,
      start_tickets: Tickets(4),
      charm_slots: 5,
      power_up_slots: 2,
      fever_heat: 10,
      ante_base: List.map([400, 820, 1320, 1870, 2530, 3300, 4070, 4950], fn n -> Points(n)),
      target_scale: 1.0,
      kind_scale: { warmup: 1.0, feature: 1.3, boss_round: 1.6 },
      round_tickets: { warmup: Tickets(3), feature: Tickets(4), boss_round: Tickets(5) },
      overkill_step: 0.5,
      overkill_cap: 5,
      interest_per: 5,
      interest_cap: 5,
      offer_count: 4
    }
  end

  fn standard_setup() : BoardSetup needs () do
    {
      reels: {
        reel10: [Cherry, Cherry, Lemon, Cherry, Bell],
        reel20: [Lemon, Lemon, Cherry, Bell, Lemon],
        reel30: [Bell, Bell, Lemon, BarSym, Bell],
        reel40: [BarSym, BarSym, Bell, Seven, BarSym],
        reel50: [Seven, BarSym, Seven, Bell, Cherry],
        reel_left: [Diamond, Seven, Diamond, Clover, BarSym],
        reel_right: [Diamond, BarSym, Diamond, Clover, Seven]
      },
      gild: {
        reel10: Chips(0),
        reel20: Chips(0),
        reel30: Chips(0),
        reel40: Chips(0),
        reel50: Chips(0),
        reel_left: Chips(0),
        reel_right: Chips(0)
      }
    }
  end

  fn standard_tuning() : FlickTuning needs () do
    {
      slowest: 300.0,
      fastest: 3100.0,
      release_weight: 0.5,
      snap_gain: 0.06,
      full_aim_angle: 1.0,
      smooth_jerk: 7.0,
      skid_per_jerk: 0.1,
      line_reach: 1.1
    }
  end

  -- ---- Meta: the first loadout, tips and the Guide (Meta/Walkthrough, Guide) ----
  -- The walkthrough's steps, in Swift's order (its raw values 0 to 11).
  type WalkthroughStep =
    WalkWelcome
    | WalkPull
    | WalkFlick
    | WalkSymbols
    | WalkLine
    | WalkScore
    | WalkPullAgain
    | WalkTopSlot
    | WalkLastPull
    | WalkFinish
    | WalkCounter
    | WalkPrizes

  derive Eq, Show for WalkthroughStep

  -- One coach card. `coach_needs_tap`: no task, it waits for GOT IT.
  -- `coach_high`: sit high, so the card does not cover what it is about.
  type CoachCard = {
    coach_title : String,
    coach_body : String,
    coach_needs_tap : Bool,
    coach_high : Bool
  }

  derive Show for CoachCard

  -- The coached practice game. `walk_pulled_ahead`: a free game has already
  -- pulled the next frame's lever.
  type Walkthrough = {
    walk_step : WalkthroughStep,
    walk_finished : Bool,
    walk_last_foul : Bool,
    walk_pulled_ahead : Bool
  }

  derive Show for Walkthrough

  -- A first-time card in a real game, in Swift's order.
  type Tip =
    TipCombo
    | TipHotSpot
    | TipCharm
    | TipSpecialty
    | TipBoardEdit
    | TipBoss
    | TipBets
    | TipBalls
    | TipFever
    | TipFreeGames
    | TipJackpot
    | TipGameOver

  derive Eq, Show for Tip

  -- Balls thrown since the last tip card. Swift's Int.max is NoTipYet.
  type SinceTip = NoTipYet | BallsSince(Int)

  derive Eq, Show for SinceTip

  -- GameModel's tip state: what has been seen (Swift's Set, kept in
  -- Tip order), the balls since the last card, and the card showing.
  type TipTracker = {
    tips_seen : List(Tip),
    since_tip : SinceTip,
    tip_showing : Option(Tip)
  }

  derive Show for TipTracker

  -- A Guide topic. Empty `topic_unlocks`: there from the start; otherwise
  -- any one of them unlocks it.
  type GuideTopic = {
    topic_title : String,
    topic_pages : List(String),
    topic_unlocks : List(Tip)
  }

  derive Show for GuideTopic

end
