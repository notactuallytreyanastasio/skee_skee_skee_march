mod Skee.Physics do

  -- One ball from release to rest, ported from Physics/*.swift. Pure: the same
  -- Launch on the same Table and seed always gives the same ShotResult.
  cap pure

  import Skee.Maths
  import Skee.Types

  doc """Ball speed for a power, up the curve with its knee at `lane.knee`."""
  fn release_speed(lane : LaneSpec, power : Float) : Float needs () do
    if power < lane.knee do
      lane.min_speed +. power /. lane.knee *. (lane.scoring_speed -. lane.min_speed)
    else
      lane.scoring_speed +. (power -. lane.knee) /. (1.0 -. lane.knee) *. (lane.max_speed -. lane.scoring_speed)
    end
  end

  doc """The inverse of `release_speed`, clamped to 0...1."""
  fn power_for_speed(lane : LaneSpec, v : Float) : Float needs () do
    let p =
      if v < lane.scoring_speed do
        (v -. lane.min_speed) /. (lane.scoring_speed -. lane.min_speed) *. lane.knee
      else
        lane.knee +. (v -. lane.scoring_speed) /. (lane.max_speed -. lane.scoring_speed) *. (1.0 -. lane.knee)
      end
    clamp(p, 0.0, 1.0)
  end

  doc """Launch angle above the board plane, flat open plus the fold's gain."""
  fn launch_angle(hinge : HingeSpec, fold : Float) : Float needs () do
    hinge.base_angle +. fold *. hinge.fold_gain
  end

  doc """A throw from the release line at a power. Clamps every input."""
  fn launch_of_power(
    k : Skee.Consts.Consts,
    power : Float,
    aim : Float,
    start : Float,
    fold : Float,
    spin : Float,
    skid : Float
  ) : Launch needs () do
    let clamped = clamp(power, 0.0, 1.0)
    {
      power: clamped,
      speed: release_speed(standard_lane(k), clamped),
      from: 0.0,
      aim: clamp(aim, -1.0, 1.0),
      start: clamp(start, -1.0, 1.0),
      fold: clamp(fold, 0.0, 1.0),
      spin: clamp(spin, -1.0, 1.0),
      skid: clamp(skid, 0.0, 1.0)
    }
  end

  doc """A throw let go mid-lane at a speed. Clamps every input."""
  fn launch_of_speed(
    k : Skee.Consts.Consts,
    speed : Float,
    from : Float,
    aim : Float,
    start : Float,
    fold : Float,
    spin : Float,
    skid : Float
  ) : Launch needs () do
    let lane = standard_lane(k)
    let clamped = clamp(speed, 0.0, lane.max_speed *. 1.3)
    {
      power: power_for_speed(lane, clamped),
      speed: clamped,
      from: clamp(from, 0.0, lane.length -. 0.05),
      aim: clamp(aim, -1.0, 1.0),
      start: clamp(start, -1.0, 1.0),
      fold: clamp(fold, 0.0, 1.0),
      spin: clamp(spin, -1.0, 1.0),
      skid: clamp(skid, 0.0, 1.0)
    }
  end

  doc """The left-right mirror image of a throw."""
  fn mirrored_launch(k : Skee.Consts.Consts, l : Launch) : Launch needs () do
    launch_of_speed(k, l.speed, l.from, -l.aim, -l.start, l.fold, -l.spin, l.skid)
  end

  doc """Printed face value, as on a real cabinet."""
  fn face_value(h : Hole) : Int needs () do
    match h do
    Gutter -> 0
    Ring10 -> 10
    Ring20 -> 20
    Ring30 -> 30
    Ring40 -> 40
    Ring50 -> 50
    PocketLeft -> 100
    PocketRight -> 100
    end
  end

  doc """The hole hit by the left-right mirror image of a shot."""
  fn mirrored(h : Hole) : Hole needs () do
    match h do
    PocketLeft -> PocketRight
    PocketRight -> PocketLeft
    Gutter -> Gutter
    Ring10 -> Ring10
    Ring20 -> Ring20
    Ring30 -> Ring30
    Ring40 -> Ring40
    Ring50 -> Ring50
    end
  end

  fn is_pocket(h : Hole) : Bool needs () do
    match h do
    PocketLeft -> true
    PocketRight -> true
    Gutter -> false
    Ring10 -> false
    Ring20 -> false
    Ring30 -> false
    Ring40 -> false
    Ring50 -> false
    end
  end

  doc """Where a Hot Spot can land. Never the 10: double nothing much is no treat."""
  fn hot_spots() : List(Hole) needs () do
    [Ring20, Ring30, Ring40, Ring50, PocketLeft, PocketRight]
  end

  doc """The 50 hole, near the top of the 40 cup."""
  fn center_hole(b : BoardSpec) : Vec2 needs () do
    add(b.ring_center, b.center_hole_offset)
  end

  -- A ring's own hole, one ball radius inside its outer wall.
  pfn ring_hole(b : BoardSpec, wall : Float) : Vec2 needs () do
    vec2(b.ring_center.x, b.ring_center.y -. (wall -. b.ball_radius))
  end

  doc """Where each hole sits on the board."""
  fn hole_center(b : BoardSpec, h : Hole) : Vec2 needs () do
    match h do
    Ring50 -> center_hole(b)
    Ring40 -> ring_hole(b, b.ring_walls.wall40)
    Ring30 -> ring_hole(b, b.ring_walls.wall30)
    Ring20 -> ring_hole(b, b.ring_walls.wall20)
    Ring10 -> ring_hole(b, b.ring_walls.wall10)
    PocketLeft -> b.pockets.left.center
    PocketRight -> b.pockets.right.center
    Gutter -> vec2(0.0, -0.1)
    end
  end

  doc """Which ring zone a resting point is in, ignoring holes and pockets."""
  fn zone(b : BoardSpec, p : Vec2) : Hole needs () do
    let d = length(sub(p, b.ring_center))
    let w = b.ring_walls
    if d < w.wall40 do
      Ring40
    else
      if d < w.wall30 do
        Ring30
      else
        if d < w.wall20 do
          Ring20
        else
          if d < w.wall10 do Ring10 else Gutter end
        end
      end
    end
  end

  -- ---- The shot ----
  -- Everything fixed for one shot.
  type Shot = {
    k : Skee.Consts.Consts,
    throw : Launch,
    table : Table,
    ball : BallKind,
    half_lane : Float,
    hook_pull : Float,
    slope_pull : Float,
    lane_friction : Float,
    in_plane : Vec2,
    normal_pull : Float,
    half_board : Float,
    back : Float,
    walls : List(Float)
  }

  -- What every phase carries forward. `events` and `path` are newest first.
  type Sim = {
    t : Float,
    step : Int,
    events : List(TimedEvent),
    path : List(PathSample),
    hinge_speed : Option(Float),
    first_landing : Option(Vec2),
    peak : Float,
    touched_wall : Bool,
    rng : Skee.Rng.Rng,
    next_hop : Float,
    hop_until : Float,
    hops : Int,
    sway_phase : Float
  }

  -- The ball on the lane. `dud` is Swift's events.contains(.dud).
  type LaneBall = { lx : Float, ls : Float, lvx : Float, lvs : Float, dud : Bool }

  type BoardMode = Airborne | Rolling

  -- The ball past the hinge. `z` is height above the board.
  type BoardBall = {
    p : Vec2,
    v : Vec2,
    z : Float,
    vz : Float,
    mode : BoardMode,
    resting : Float,
    nudges : Int
  }

  -- How a step on the board ended: go on, leave the loop as Swift's `break`
  -- does, or the shot is over.
  type Turn = Carry(Sim, BoardBall) | Stop(Sim, BoardBall) | Over(ShotResult)

  pfn is_bean(b : BallKind) : Bool needs () do
    match b do
    JumpingBean -> true
    Marshmallow -> false
    ClassicBall -> false
    Wobbler -> false
    Comet -> false
    end
  end

  pfn is_marshmallow(b : BallKind) : Bool needs () do
    match b do
    Marshmallow -> true
    ClassicBall -> false
    JumpingBean -> false
    Wobbler -> false
    Comet -> false
    end
  end

  pfn is_wobbler(b : BallKind) : Bool needs () do
    match b do
    Wobbler -> true
    Marshmallow -> false
    ClassicBall -> false
    JumpingBean -> false
    Comet -> false
    end
  end

  -- Sideways shove from a wobbler's sway, in m/s^2.
  pfn sway(c : Shot, sim : Sim, strength : Float) : Float needs () do
    if is_wobbler(c.ball) do
      strength *. Math.sin(c.k.tau *. 1.6 *. sim.t +. sim.sway_phase)
    else
      0.0
    end
  end

  -- How high a bean is on the lane right now: the path shows the hop.
  pfn lane_height(c : Shot, sim : Sim) : Float needs () do
    if sim.t < sim.hop_until do
      0.035 *. Math.sin(c.k.pi *. (sim.hop_until -. sim.t) /. 0.14)
    else
      0.0
    end
  end

  pfn sample(sim : Sim, phase : PathPhase, x : Float, along : Float, h : Float) : Sim needs () do
    { sim with path: Cons({ t: sim.t, phase: phase, px: x, along: along, height: h }, sim.path) }
  end

  -- Record at 120 Hz (every 2nd 240 Hz step), so a 120 Hz display never
  -- interpolates across a bounce.
  pfn record(sim : Sim, phase : PathPhase, x : Float, along : Float, h : Float) : Sim needs () do
    if sim.step % 2 == 0 do sample(sim, phase, x, along, h) else sim end
  end

  pfn emit(sim : Sim, e : ShotEvent) : Sim needs () do
    { sim with events: Cons({ event: e, at: sim.t }, sim.events) }
  end

  pfn tick(c : Shot, sim : Sim) : Sim needs () do
    { sim with t: sim.t +. c.table.dt, step: sim.step + 1 }
  end

  pfn finish(c : Shot, sim : Sim, hole : Hole) : ShotResult needs () do
    {
      launch: c.throw,
      hole: hole,
      events: List.reverse(sim.events),
      path: List.reverse(sim.path),
      hinge_speed: sim.hinge_speed,
      first_landing: sim.first_landing,
      peak_height: sim.peak,
      duration: sim.t
    }
  end

  -- A bean takes off on the lane: two draws, in this order.
  pfn lane_hop(c : Shot, sim : Sim, b : LaneBall) : (Sim, LaneBall) needs () do
    if is_bean(c.ball) && sim.t >= sim.next_hop && b.lvs > 0.0 do
      do
        let (shove, r1) = Skee.Rng.next_unit(c.k, sim.rng)
        let (wait, r2) = Skee.Rng.next_unit(c.k, r1)
        let hopped = emit({ sim with rng: r2, hop_until: sim.t +. 0.14, next_hop: sim.t +. 0.22 +. wait *. 0.2 }, ShotHop)
        (hopped, { b with lvx: b.lvx +. (shove -. 0.5) *. 0.7 })
      end
    else
      (sim, b)
    end
  end

  -- One step of rolling up the incline, before the rails.
  pfn lane_motion(c : Shot, sim : Sim, b : LaneBall) : LaneBall needs () do
    let dt = c.table.dt
    let speed = Math.sqrt(b.lvx *. b.lvx +. b.lvs *. b.lvs)
    let f = if speed > 0.0 do c.lane_friction /. speed else 0.0 end
    let vs = b.lvs +. (c.slope_pull -. f *. b.lvs) *. dt
    let vx = b.lvx +. (-f *. b.lvx +. c.hook_pull +. sway(c, sim, 10.0)) *. dt
    { b with lx: b.lx +. vx *. dt, ls: b.ls +. vs *. dt, lvx: vx, lvs: vs }
  end

  pfn lane_rails(c : Shot, sim : Sim, b : LaneBall) : (Sim, LaneBall) needs () do
    if Math.abs(b.lx) > c.half_lane do
      do
        let x = if b.lx > 0.0 do c.half_lane else -c.half_lane end
        let vx = -b.lvx *. c.table.lane.rail_restitution
        (emit(sim, ShotRail), { b with lx: x, lvx: vx })
      end
    else
      (sim, b)
    end
  end

  -- The first time forward speed runs out, the ball is a dud.
  pfn lane_stall(sim : Sim, b : LaneBall) : (Sim, LaneBall) needs () do
    if b.lvs <= 0.0 && !b.dud do
      (emit(sim, ShotDud), { b with dud: true })
    else
      (sim, b)
    end
  end

  pfn run_lane(c : Shot, sim0 : Sim, b0 : LaneBall) : ShotResult needs () do
    if b0.ls < c.table.lane.length do
      do
        let recorded = record(sim0, OnLane, b0.lx, b0.ls, lane_height(c, sim0))
        let (hopped, b1) = lane_hop(c, recorded, b0)
        let (railed, b2) = lane_rails(c, hopped, lane_motion(c, hopped, b1))
        let (stalled, b3) = lane_stall(tick(c, railed), b2)
        if b3.dud && (b3.ls <= 0.0 || stalled.t >= c.table.max_duration) do
          do
            let last = sample(stalled, OnLane, b3.lx, max_float(b3.ls, 0.0), 0.0)
            finish(c, emit(last, ShotGutter), Gutter)
          end
        else
          run_lane(c, stalled, b3)
        end
      end
    else
      leave_lane(c, sim0, b0)
    end
  end

  -- Over the hinge: the ball leaves at the launch angle, carrying `hinge.carry`.
  pfn leave_lane(c : Shot, sim : Sim, b : LaneBall) : ShotResult needs () do
    let hinge = c.table.hinge
    let beta = launch_angle(hinge, c.throw.fold)
    let carried = b.lvs *. hinge.carry
    let launched = emit({ sim with hinge_speed: Some(b.lvs) }, ShotLaunched)
    let ball = {
      p: vec2(b.lx, 0.0),
      v: vec2(b.lvx, carried *. Math.cos(beta)),
      z: 0.0,
      vz: carried *. Math.sin(beta),
      mode: Airborne,
      resting: 0.0,
      nudges: 0
    }
    run_board(c, launched, ball)
  end

  -- A marshmallow's drift toward the bullseye, in m/s^2.
  pfn drift(c : Shot, p : Vec2) : Vec2 needs () do
    if is_marshmallow(c.ball) do
      do
        let to = sub(c.table.board.ring_center, p)
        if length(to) > 0.01 do scale(normalized(to), 1.6) else vec2(0.0, 0.0) end
      end
    else
      vec2(0.0, 0.0)
    end
  end

  -- The pull on a ball in the plane of the board, before friction.
  pfn board_pull(c : Shot, sim : Sim, p : Vec2) : Vec2 needs () do
    add(add(c.in_plane, vec2(sway(c, sim, 4.0), 0.0)), drift(c, p))
  end

  pfn scan_lips(c : Shot, rel : Vec2, d : Float, walls : List(Float), i : Int) : Option((Int, Vec2)) needs () do
    let board = c.table.board
    match walls do
    Nil -> None
    Cons(wall, rest) -> do
      if Math.abs(d -. wall) < board.ball_radius *. board.lip_band do
        do
          let radial = if d == 0.0 do vec2(0.0, 1.0) else scale(rel, 1.0 /. d) end
          Some((i, if d >= wall do radial else neg(radial) end))
        end
      else
        scan_lips(c, rel, d, rest, i + 1)
      end
    end
    end
  end

  -- The ring wall whose top the ball is coming down on, with the unit vector
  -- pointing to the side of the wall the ball's centre is on.
  pfn lip_under(c : Shot, p : Vec2) : Option((Int, Vec2)) needs () do
    let rel = sub(p, c.table.board.ring_center)
    scan_lips(c, rel, length(rel), c.walls, 0)
  end

  -- Coming down through lip height near a ring wall is the rattle.
  pfn lip_hit(c : Shot, sim : Sim, b : BoardBall, prev_z : Float) : (Sim, BoardBall) needs () do
    let board = c.table.board
    if prev_z >= board.lip_height && b.z < board.lip_height && -b.vz >= board.lip_min_fall do
      match lip_under(c, b.p) do
      Some((ring, outward)) -> do
        let fall = -b.vz
        let kicked = add(b.v, scale(outward, board.lip_kick *. fall))
        (emit(sim, ShotLip(ring)), { b with z: board.lip_height, vz: fall *. board.lip_bounce, v: kicked })
      end
      None -> (sim, b)
      end
    else
      (sim, b)
    end
  end

  pfn first_contact(sim : Sim, p : Vec2) : Sim needs () do
    match sim.first_landing do
    Some(_) -> sim
    None -> emit({ sim with first_landing: Some(p) }, ShotLanded)
    end
  end

  pfn touch_down(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    let board = c.table.board
    if b.z <= 0.0 do
      do
        let vz = -b.vz *. board.bounce
        let v = scale(b.v, board.landing_grip)
        let landed = first_contact(sim, b.p)
        if vz < 0.15 do
          (landed, { b with z: 0.0, vz: 0.0, v: v, mode: Rolling })
        else
          (landed, { b with z: 0.0, vz: vz, v: v })
        end
      end
    else
      (sim, b)
    end
  end

  pfn fly(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    let dt = c.table.dt
    let v = add(b.v, scale(board_pull(c, sim, b.p), dt))
    let vz = b.vz -. c.normal_pull *. dt
    let p = add(b.p, scale(v, dt))
    let z = b.z +. vz *. dt
    let (bounced, after) = lip_hit(c, { sim with peak: max_float(sim.peak, z) }, { b with v: v, vz: vz, p: p, z: z }, b.z)
    touch_down(c, bounced, after)
  end

  -- Mostly under the lip: a bean dances in its ring, and only now and then jumps
  -- out of it. Four draws, in this order.
  pfn board_hop(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    if is_bean(c.ball) && sim.hops < 3 && sim.t >= sim.next_hop do
      do
        let (lift, r1) = Skee.Rng.next_unit(c.k, sim.rng)
        let (across, r2) = Skee.Rng.next_unit(c.k, r1)
        let (up, r3) = Skee.Rng.next_unit(c.k, r2)
        let (wait, r4) = Skee.Rng.next_unit(c.k, r3)
        let shove = vec2((across -. 0.5) *. 0.5, up *. 0.35)
        let hopped = emit({ sim with rng: r4, hops: sim.hops + 1, next_hop: sim.t +. 0.25 +. wait *. 0.25 }, ShotHop)
        (hopped, { b with vz: 0.3 +. lift *. 0.55, v: add(b.v, shove), mode: Airborne })
      end
    else
      (sim, b)
    end
  end

  pfn roll(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    let dt = c.table.dt
    let speed = length(b.v)
    let pull = board_pull(c, sim, b.p)
    let a =
      if speed > 0.0 do
        sub(pull, scale(b.v, c.table.board.board_rolling_friction *. c.normal_pull /. speed))
      else
        pull
      end
    let v = add(b.v, scale(a, dt))
    board_hop(c, sim, { b with v: v, p: add(b.p, scale(v, dt)) })
  end

  pfn bounce_off_wall(c : Shot, p0 : Vec2, v0 : Vec2, radial : Vec2, d : Float, wall : Float) : (Vec2, Vec2) needs () do
    let board = c.table.board
    let side = if d >= wall do 1.0 else -1.0 end
    let n = scale(radial, side)
    let p = add(board.ring_center, scale(radial, wall +. side *. board.ball_radius))
    let vn = dot(v0, n)
    if vn < 0.0 do
      (p, sub(v0, scale(n, (1.0 +. board.wall_restitution) *. vn)))
    else
      (p, v0)
    end
  end

  pfn scan_walls(c : Shot, p : Vec2, v : Vec2, radial : Vec2, d : Float, walls : List(Float)) : (Vec2, Vec2) needs () do
    match walls do
    Nil -> (p, v)
    Cons(wall, rest) -> do
      if Math.abs(d -. wall) < c.table.board.ball_radius do
        bounce_off_wall(c, p, v, radial, d, wall)
      else
        scan_walls(c, p, v, radial, d, rest)
      end
    end
    end
  end

  -- Push the ball out of any ring wall face it overlaps and reflect the
  -- velocity component into the wall.
  pfn collide_ring_walls(c : Shot, p : Vec2, v : Vec2) : (Vec2, Vec2) needs () do
    let rel = sub(p, c.table.board.ring_center)
    let d = length(rel)
    if d > 0.0 do scan_walls(c, p, v, scale(rel, 1.0 /. d), d, c.walls) else (p, v) end
  end

  pfn ring_walls(c : Shot, b : BoardBall) : BoardBall needs () do
    if b.z < c.table.board.lip_height do
      do
        let (p, v) = collide_ring_walls(c, b.p, b.v)
        { b with p: p, v: v }
      end
    else
      b
    end
  end

  pfn side_walls(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    if Math.abs(b.p.x) > c.half_board do
      do
        let x = if b.p.x > 0.0 do c.half_board else -c.half_board end
        let vx = -b.v.x *. c.table.board.wall_restitution
        ({ sim with touched_wall: true }, { b with p: vec2(x, b.p.y), v: vec2(vx, b.v.y) })
      end
    else
      (sim, b)
    end
  end

  pfn back_wall(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    if b.p.y > c.back do
      do
        let vy = -Math.abs(b.v.y) *. c.table.board.backwall_restitution
        (emit({ sim with touched_wall: true }, ShotBackwall), { b with p: vec2(b.p.x, c.back), v: vec2(b.v.x, vy) })
      end
    else
      (sim, b)
    end
  end

  pfn in_pocket(board : BoardSpec, p : Vec2, pocket : Pocket, clean_flight : Bool) : Bool needs () do
    length(sub(p, pocket.center)) < pocket.radius && (!board.pockets_need_flight || clean_flight)
  end

  pfn pocket_under(board : BoardSpec, p : Vec2, clean_flight : Bool) : Option(Hole) needs () do
    if in_pocket(board, p, board.pockets.left, clean_flight) do
      Some(board.pockets.left.pocket_hole)
    else
      if in_pocket(board, p, board.pockets.right, clean_flight) do
        Some(board.pockets.right.pocket_hole)
      else
        None
      end
    end
  end

  pfn hole_under(board : BoardSpec, p : Vec2, clean_flight : Bool) : Option(Hole) needs () do
    if length(sub(p, center_hole(board))) < board.center_hole_radius do
      Some(Ring50)
    else
      do
        let ring = zone(board, p)
        if ring != Gutter && length(sub(p, hole_center(board, ring))) < board.ring_hole_radius do
          Some(ring)
        else
          pocket_under(board, p, clean_flight)
        end
      end
    end
  end

  pfn along_board(c : Shot, b : BoardBall) : Float needs () do
    c.table.lane.length +. b.p.y
  end

  pfn capture(c : Shot, sim : Sim, b : BoardBall) : Option(Hole) needs () do
    let board = c.table.board
    if b.z < board.ball_radius *. 0.5 && length(b.v) <= board.capture_speed do
      hole_under(board, b.p, is_none(sim.first_landing) && !sim.touched_wall)
    else
      None
    end
  end

  pfn is_none(o : Option(a)) : Bool needs () do
    match o do
    None -> true
    Some(_) -> false
    end
  end

  pfn drop_in(c : Shot, sim : Sim, b : BoardBall, hole : Hole) : ShotResult needs () do
    let landed = if is_none(sim.first_landing) do { sim with first_landing: Some(b.p) } else sim end
    finish(c, emit(sample(landed, OnBoard, b.p.x, along_board(c, b), 0.0), ShotDropped(hole)), hole)
  end

  -- A ring is a cup: nothing rests on it except in its hole. A ball balanced on
  -- top of an inner wall is nudged around the wall toward the bottom, on the side
  -- it is already on.
  pfn nudge(board : BoardSpec, b : BoardBall) : BoardBall needs () do
    let rel = sub(b.p, board.ring_center)
    let side = if rel.x >= 0.0 do 1.0 else -1.0 end
    let turn = if rel.y > 0.0 do side else -side end
    let tangent = scale(normalized(vec2(-rel.y, rel.x)), turn)
    let v = scale(normalized(add(tangent, vec2(0.0, -0.3))), 0.35)
    { b with v: v, nudges: b.nudges + 1, resting: 0.0 }
  end

  -- Counts time at rest, and nudges or stops the ball when it has rested enough.
  pfn rest(c : Shot, sim : Sim, b : BoardBall) : Turn needs () do
    let board = c.table.board
    let moving = match b.mode do
      Airborne -> true
      Rolling -> length(b.v) >= 0.05
      end
    if moving do
      Carry(sim, { b with resting: 0.0 })
    else
      do
        let resting = b.resting +. c.table.dt
        if resting > 0.2 do
          if zone(board, b.p) != Gutter && b.nudges < 6 do
            Carry(sim, nudge(board, b))
          else
            Stop(sim, { b with resting: resting })
          end
        else
          Carry(sim, { b with resting: resting })
        end
      end
    end
  end

  -- What the step left: captured, gone past the bottom, or still in play.
  pfn after_step(c : Shot, sim : Sim, b : BoardBall) : Turn needs () do
    match capture(c, sim, b) do
    Some(hole) -> Over(drop_in(c, sim, b, hole))
    None -> do
      if b.p.y < -c.table.board.ball_radius do
        Over(finish(c, emit(sample(sim, OnBoard, b.p.x, along_board(c, b), b.z), ShotGutter), Gutter))
      else
        rest(c, sim, b)
      end
    end
    end
  end

  pfn phase_of(b : BoardBall) : PathPhase needs () do
    match b.mode do
    Airborne -> InAir
    Rolling -> OnBoard
    end
  end

  pfn move_on_board(c : Shot, sim : Sim, b : BoardBall) : (Sim, BoardBall) needs () do
    match b.mode do
    Airborne -> fly(c, sim, b)
    Rolling -> roll(c, sim, b)
    end
  end

  pfn board_step(c : Shot, sim0 : Sim, b0 : BoardBall) : Turn needs () do
    let recorded = record(sim0, phase_of(b0), b0.p.x, along_board(c, b0), b0.z)
    let (moved, b1) = move_on_board(c, recorded, b0)
    let (sided, b2) = side_walls(c, moved, ring_walls(c, b1))
    let (backed, b3) = back_wall(c, sided, b2)
    after_step(c, tick(c, backed), b3)
  end

  -- The clock ran out, or the ball came to rest with nothing left to try.
  pfn stop_shot(c : Shot, sim : Sim, b : BoardBall) : ShotResult needs () do
    let hole = zone(c.table.board, b.p)
    let last = sample(sim, OnBoard, b.p.x, along_board(c, b), b.z)
    finish(c, emit(last, if hole == Gutter do ShotGutter else ShotSettled(hole) end), hole)
  end

  pfn run_board(c : Shot, sim : Sim, b : BoardBall) : ShotResult needs () do
    if sim.t < c.table.max_duration do
      match board_step(c, sim, b) do
      Carry(s, n) -> run_board(c, s, n)
      Stop(s, n) -> stop_shot(c, s, n)
      Over(r) -> r
      end
    else
      stop_shot(c, sim, b)
    end
  end

  -- A bean's first hop and a wobbler's sway are drawn before anything moves.
  pfn start_sim(k : Skee.Consts.Consts, ball : BallKind, seed : Skee.U64.U64) : Sim needs () do
    let rng0 = Skee.Rng.seed(seed)
    -- The annotation is load-bearing natively: tools/repros/none_float_field.march.
    let blank : Sim = {
      t: 0.0,
      step: 0,
      events: [],
      path: [],
      hinge_speed: None,
      first_landing: None,
      peak: 0.0,
      touched_wall: false,
      rng: rng0,
      next_hop: 0.0,
      hop_until: 0.0,
      hops: 0,
      sway_phase: 0.0
    }
    if is_bean(ball) do
      do
        let (u, r) = Skee.Rng.next_unit(k, rng0)
        { blank with rng: r, next_hop: 0.08 +. u *. 0.12 }
      end
    else
      if is_wobbler(ball) do
        do
          let (u, r) = Skee.Rng.next_unit(k, rng0)
          { blank with rng: r, sway_phase: u *. 2.0 *. k.pi }
        end
      else
        blank
      end
    end
  end

  doc """
  One ball from release to rest. Random balls take their mischief from `seed`,
  so the same throw with the same seed is still the same shot.
  """
  fn simulate_shot(k : Skee.Consts.Consts, l : Launch, t : Table, ball : BallKind, seed : Skee.U64.U64) : ShotResult needs () do
    let lane = t.lane
    let board = t.board
    let w = board.ring_walls
    let g = t.gravity
    let half_lane = lane.width /. 2.0 -. board.ball_radius
    let v0 = l.speed *. Skee.Items.speed_scale(ball) *. (1.0 -. lane.skid_loss *. l.skid)
    let angle = l.aim *. lane.max_aim_angle
    let c = {
      k: k,
      throw: l,
      table: t,
      ball: ball,
      half_lane: half_lane,
      hook_pull: l.spin *. lane.hook,
      slope_pull: -g *. Math.sin(lane.incline),
      lane_friction: lane.rolling_friction *. g *. Math.cos(lane.incline),
      in_plane: add(vec2(0.0, -g *. Math.sin(board.tilt)), board.wind),
      normal_pull: g *. Math.cos(board.tilt),
      half_board: board.board_width /. 2.0 -. board.ball_radius,
      back: board.board_height -. board.ball_radius,
      walls: [w.wall40, w.wall30, w.wall20, w.wall10]
    }
    let b = {
      lx: l.start *. half_lane,
      ls: l.from,
      lvx: v0 *. Math.sin(angle),
      lvs: v0 *. Math.cos(angle),
      dud: false
    }
    run_lane(c, start_sim(k, ball, seed), b)
  end

  doc """How many lips the ball rattled on: the near-miss count."""
  fn rattles(r : ShotResult) : Int needs () do
    List.length(List.filter(r.events, fn e -> is_lip(e.event)))
  end

  pfn is_lip(e : ShotEvent) : Bool needs () do
    match e do
    ShotLip(_) -> true
    ShotDud -> false
    ShotRail -> false
    ShotLaunched -> false
    ShotLanded -> false
    ShotBackwall -> false
    ShotHop -> false
    ShotDropped(_) -> false
    ShotSettled(_) -> false
    ShotGutter -> false
    end
  end

end
