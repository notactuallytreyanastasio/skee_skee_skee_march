mod Skee.Maths do

  -- Forwarders to Arcade.Num and Arcade.Vec2, kept while call sites migrate.
  -- The Vec2 type itself lives in Arcade.Vec2.
  cap pure

  fn max_float(x : Float, y : Float) : Float needs () do
    Arcade.Num.max_float(x, y)
  end

  fn min_float(x : Float, y : Float) : Float needs () do
    Arcade.Num.min_float(x, y)
  end

  fn clamp(x : Float, lo : Float, hi : Float) : Float needs () do
    Arcade.Num.clamp(x, lo, hi)
  end

  fn clamp_int(x : Int, lo : Int, hi : Int) : Int needs () do
    Arcade.Num.clamp_int(x, lo, hi)
  end

  fn ieee_div(k : Skee.Consts.Consts, a : Float, b : Float) : Float needs () do
    Arcade.Num.ieee_div(k.num, a, b)
  end

  fn degrees(k : Skee.Consts.Consts, d : Float) : Float needs () do
    Arcade.Num.degrees(k.num, d)
  end

  fn equal(a : Arcade.Vec2.Vec2, b : Arcade.Vec2.Vec2) : Bool needs () do
    Arcade.Vec2.equal(a, b)
  end

  fn vec2(x : Float, y : Float) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.vec2(x, y)
  end

  fn zero() : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.zero()
  end

  fn add(a : Arcade.Vec2.Vec2, b : Arcade.Vec2.Vec2) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.add(a, b)
  end

  fn sub(a : Arcade.Vec2.Vec2, b : Arcade.Vec2.Vec2) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.sub(a, b)
  end

  fn scale(a : Arcade.Vec2.Vec2, k : Float) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.scale(a, k)
  end

  fn neg(a : Arcade.Vec2.Vec2) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.neg(a)
  end

  fn dot(a : Arcade.Vec2.Vec2, b : Arcade.Vec2.Vec2) : Float needs () do
    Arcade.Vec2.dot(a, b)
  end

  fn length(a : Arcade.Vec2.Vec2) : Float needs () do
    Arcade.Vec2.length(a)
  end

  fn normalized(a : Arcade.Vec2.Vec2) : Arcade.Vec2.Vec2 needs () do
    Arcade.Vec2.normalized(a)
  end

end
