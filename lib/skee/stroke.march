mod Skee.Stroke do

  -- The throw, as a pure function of a flick, ported from Input/Stroke.swift.
  -- Speed comes from the speed at lift-off and the peak, nudged by the snap
  -- through the release. Skid comes from jerk against a smooth reach. The line is
  -- where the thumb touched down, and aim is a small trim from the flick's chord.
  -- Swift keeps the last measurement in a global; here `measure_flick` returns it.
  cap pure

  import Skee.Maths

  -- What the analyser measured on a flick it accepted.
  type FlickMetrics = {
    peak_speed : Float,
    release_speed : Float,
    flick_duration : Float,
    jerk : Float,
    snap : Float,
    side : Float,
    flick_speed : Float
  }

  derive Show for FlickMetrics

  -- A time with an x and a y: positions, then velocities, then accelerations.
  type FlickTrack = { tt : Float, tx : Float, ty : Float }

  doc """A geometry with the standard give past the crease."""
  fn flick_geometry(crease_y : Float, lane_center_x : Float, lane_half_width : Float) : FlickGeometry needs () do
    {
      crease_y: crease_y,
      lane_center_x: lane_center_x,
      lane_half_width: lane_half_width,
      foul_give: 140.0
    }
  end

  fn foul_y(g : FlickGeometry) : Float needs () do
    g.crease_y -. g.foul_give
  end

  doc """The release line for a thumb landing at `touch_x`: the ball sits under it."""
  fn lane_start(k : Skee.Consts.Consts, touch_x : Float, g : FlickGeometry, tn : FlickTuning) : Float needs () do
    clamp(ieee_div(k, touch_x -. g.lane_center_x, g.lane_half_width) *. tn.line_reach, -1.0, 1.0)
  end

  fn crossed_foul_line(samples : List(FlickSample), g : FlickGeometry) : Bool needs () do
    let line = foul_y(g)
    List.any(samples, fn s -> s.sample_y < line)
  end

  pfn count(xs : List(a)) : Float needs () do
    int_to_float(List.length(xs))
  end

  -- Differences of neighbours. Pairs with no time between them drop out.
  pfn diff_go(a : FlickTrack, xs : List(FlickTrack), acc : List(FlickTrack)) : List(FlickTrack) needs () do
    match xs do
    Nil -> List.reverse(acc)
    Cons(b, rest) -> do
      let dt = b.tt -. a.tt
      if dt > 0.0 do
        diff_go(b, rest, Cons({ tt: (a.tt +. b.tt) /. 2.0, tx: (b.tx -. a.tx) /. dt, ty: (a.ty -. b.ty) /. dt }, acc))
      else
        diff_go(b, rest, acc)
      end
    end
    end
  end

  pfn diff(xs : List(FlickTrack)) : List(FlickTrack) needs () do
    match xs do
    Nil -> []
    Cons(a, rest) -> diff_go(a, rest, [])
    end
  end

  pfn sum_x(xs : List(FlickTrack)) : Float needs () do
    List.fold_left(xs, 0.0, fn (acc, e) -> acc +. e.tx)
  end

  pfn sum_y(xs : List(FlickTrack)) : Float needs () do
    List.fold_left(xs, 0.0, fn (acc, e) -> acc +. e.ty)
  end

  pfn sum_t(xs : List(FlickTrack)) : Float needs () do
    List.fold_left(xs, 0.0, fn (acc, e) -> acc +. e.tt)
  end

  pfn averaged(cur : FlickTrack, window : List(FlickTrack)) : FlickTrack needs () do
    let n = count(window)
    { tt: cur.tt, tx: sum_x(window) /. n, ty: sum_y(window) /. n }
  end

  pfn smooth_go(before : List(FlickTrack), xs : List(FlickTrack), acc : List(FlickTrack)) : List(FlickTrack) needs () do
    match xs do
    Nil -> List.reverse(acc)
    Cons(cur, rest) -> do
      let window = List.append(before, Cons(cur, List.take(rest, 1)))
      smooth_go([cur], rest, Cons(averaged(cur, window), acc))
    end
    end
  end

  -- Each entry becomes the mean of itself and its neighbours.
  pfn smooth(xs : List(FlickTrack)) : List(FlickTrack) needs () do
    smooth_go([], xs, [])
  end

  pfn flip(xs : List(FlickTrack)) : List(FlickTrack) needs () do
    List.map(xs, fn e -> { tt: e.tt, tx: e.tx, ty: -e.ty })
  end

  -- The first entry with the greatest upward speed, as Swift's max(by:) keeps.
  pfn fastest(v0 : FlickTrack, xs : List(FlickTrack)) : FlickTrack needs () do
    List.fold_left(xs, v0, fn (best, e) -> if best.ty < e.ty do e else best end)
  end

  pfn last_of(v0 : FlickTrack, xs : List(FlickTrack)) : FlickTrack needs () do
    List.fold_left(xs, v0, fn (_, e) -> e)
  end

  pfn start_time(v : List(FlickTrack), peak : Float, fallback : Float) : Float needs () do
    match List.find(v, fn e -> e.ty > peak *. 0.08) do
    Some(e) -> e.tt
    None -> fallback
    end
  end

  -- Lift-off speed: a line through the last few velocities, read at the end.
  pfn speed_at_end(tail : List(FlickTrack), last_v : FlickTrack, end_t : Float) : Float needs () do
    if List.length(tail) >= 2 do
      do
        let n = count(tail)
        let mt = sum_t(tail) /. n
        let mv = sum_y(tail) /. n
        let num =
          List.fold_left(tail, 0.0, fn (acc, e) -> acc +. (e.tt -. mt) *. (e.ty -. mv))
        let den =
          List.fold_left(tail, 0.0, fn (acc, e) -> acc +. (e.tt -. mt) *. (e.tt -. mt))
        let slope = if den > 0.0 do num /. den else 0.0 end
        mv +. slope *. (end_t -. mt)
      end
    else
      last_v.ty
    end
  end

  pfn mean_or_zero(sum : Float, xs : List(FlickTrack)) : Float needs () do
    if List.is_empty(xs) do 0.0 else sum /. count(xs) end
  end

  -- RMS jerk over the flick.
  pfn rms_jerk(jf : List(FlickTrack)) : Float needs () do
    if List.is_empty(jf) do
      0.0
    else
      Math.sqrt(List.fold_left(jf, 0.0, fn (acc, e) -> acc +. e.ty *. e.ty +. e.tx *. e.tx) /. count(jf))
    end
  end

  -- The last sample at or before the flick got going.
  pfn aim_from(first : FlickSample, samples : List(FlickSample), start_t : Float) : FlickSample needs () do
    List.fold_left(samples, first, fn (best, s) -> if s.sample_t <= start_t do s else best end)
  end

  -- The first sample nearest the moment of peak speed.
  pfn aim_to(first : FlickSample, samples : List(FlickSample), peak_t : Float) : FlickSample needs () do
    List.fold_left(samples, first, fn (best, s) -> if Math.abs(s.sample_t -. peak_t) < Math.abs(best.sample_t -. peak_t) do s else best end)
  end

  pfn some_metrics(peak : Float, release : Float, flick_time : Float, jerk : Float, snap : Float, side : Float, speed : Float) : Option(FlickMetrics) needs () do
    Some({ peak_speed: peak, release_speed: release, flick_duration: flick_time, jerk: jerk, snap: snap, side: side, flick_speed: speed })
  end

  pfn throw_of(k : Skee.Consts.Consts, samples : List(FlickSample), first : FlickSample, last : FlickSample, v0 : FlickTrack, v : List(FlickTrack), g : FlickGeometry, fold : Float, tn : FlickTuning) : (StrokeOutcome, Option(FlickMetrics)) needs () do
    let a = smooth(diff(flip(v)))
    let j = diff(flip(a))
    let top = fastest(v0, v)
    let peak = top.ty
    if peak > 150.0 do
      do
        let start_t = start_time(v, peak, first.sample_t)
        let end_t = last.sample_t
        let flick_time = max_float(0.03, end_t -. start_t)
        let tail = List.filter(v, fn e -> e.tt >= end_t -. 0.06)
        let release = max_float(0.0, speed_at_end(tail, last_of(v0, v), end_t))
        if release > 60.0 || peak > 600.0 do
          do
            let a_tail = List.filter(a, fn e -> e.tt >= end_t -. 0.05)
            let a_up = mean_or_zero(sum_y(a_tail), a_tail)
            let a_side = mean_or_zero(sum_x(a_tail), a_tail)
            let unit_accel = peak /. flick_time
            let snap = ieee_div(k, a_up, unit_accel)
            let base = tn.release_weight *. release +. (1.0 -. tn.release_weight) *. peak
            let speed = base *. (1.0 +. tn.snap_gain *. max_float(-1.5, min_float(1.5, snap)))
            let rms = rms_jerk(List.filter(j, fn e -> e.tt >= start_t))
            let jerk = rms *. flick_time *. flick_time /. peak
            let skid = (jerk -. tn.smooth_jerk) *. tn.skid_per_jerk
            let from = aim_from(first, samples, start_t)
            let to = aim_to(first, samples, top.tt)
            let chord =
              Math.atan2(to.sample_x -. from.sample_x, max_float(from.sample_y -. to.sample_y, 1.0))
            let aim = ieee_div(k, chord, tn.full_aim_angle)
            let power = ieee_div(k, speed -. tn.slowest, tn.fastest -. tn.slowest)
            let l =
              Skee.Physics.launch_of_power(k, power, aim, lane_start(k, first.sample_x, g, tn), fold, 0.0, skid)
            let metrics =
              some_metrics(peak, release, flick_time, jerk, snap, ieee_div(k, a_side, unit_accel), speed)
            (Release(l), metrics)
          end
        else
          (NoThrow, None)
        end
      end
    else
      (NoThrow, None)
    end
  end

  pfn track_of(samples : List(FlickSample)) : List(FlickTrack) needs () do
    List.map(samples, fn s -> { tt: s.sample_t, tx: s.sample_x, ty: s.sample_y })
  end

  pfn read_motion(k : Skee.Consts.Consts, samples : List(FlickSample), first : FlickSample, last : FlickSample, g : FlickGeometry, fold : Float, tn : FlickTuning) : (StrokeOutcome, Option(FlickMetrics)) needs () do
    let v = smooth(diff(track_of(samples)))
    match v do
    Cons(v0, _) -> do
      if List.length(v) >= 3 do
        throw_of(k, samples, first, last, v0, v, g, fold, tn)
      else
        (NoThrow, None)
      end
    end
    Nil -> (NoThrow, None)
    end
  end

  pfn last_sample(first : FlickSample, samples : List(FlickSample)) : FlickSample needs () do
    List.fold_left(samples, first, fn (_, s) -> s)
  end

  doc """What a flick came to, and what was measured if it was a throw."""
  fn measure_flick(k : Skee.Consts.Consts, samples : List(FlickSample), g : FlickGeometry, fold : Float, tn : FlickTuning) : (StrokeOutcome, Option(FlickMetrics)) needs () do
    match samples do
    Nil -> (NoThrow, None)
    Cons(first, _) -> do
      if first.sample_y > g.crease_y do
        if crossed_foul_line(samples, g) do
          (StrokeFoul, None)
        else
          do
            let last = last_sample(first, samples)
            if List.length(samples) >= 4 && first.sample_y -. last.sample_y > 25.0 do
              read_motion(k, samples, first, last, g, fold, tn)
            else
              (NoThrow, None)
            end
          end
        end
      else
        (NoThrow, None)
      end
    end
    end
  end

  doc """What a flick came to: nothing, a foul, or a throw."""
  fn analyze_flick(k : Skee.Consts.Consts, samples : List(FlickSample), g : FlickGeometry, fold : Float, tn : FlickTuning) : StrokeOutcome needs () do
    let (outcome, _) = measure_flick(k, samples, g, fold, tn)
    outcome
  end

end
