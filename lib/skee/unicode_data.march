  doc """lowercaseMapping for the 1 scalars that map to more than one scalar; [] for every other."""
  fn lower_many(cp : Int) : List(Int) needs () do
    if cp == 304 do [105, 775] else [] end
  end

  doc """The ASCII byte whose Character a scalar past ASCII equals (a canonical singleton), or -1. 3 scalars."""
  fn ascii_equal(cp : Int) : Int needs () do
    if cp == 894 do
      59
    else
      if cp == 8175 do 96 else if cp == 8490 do 75 else -1 end end
    end
  end

