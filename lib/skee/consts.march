-- Float constants that cannot be written as literals.
--
-- The JS emitter prints every Float literal with 12 significant digits, so a
-- constant needing more is built here from a string at run time. Parsing is
-- not free: call `make` once, keep the record, and pass it to whatever needs
-- it. Never call `make` in a loop.
mod Skee.Consts do
  cap pure

  type Consts = { pi : Float, tau : Float, dt : Float, unit53 : Float, floor_u1 : Float }

  -- Only ever called on the fixed strings below, and the rng suite pins each
  -- result to Swift's bits, so the None arm cannot be reached.
  pfn parse(text : String) : Float needs () do
    match string_to_float(text) do
      Some(x) -> x
      None -> unreachable()
    end
  end

  doc "All constants, each bit-identical to the Swift expression it replaces."
  fn make() : Consts needs () do
    {
      pi: parse("3.141592653589793"),
      tau: parse("6.283185307179586"),
      dt: parse("0.004166666666666667"),
      unit53: parse("1.1102230246251565e-16"),
      floor_u1: 0.000000000001
    }
  end
end
