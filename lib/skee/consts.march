mod Skee.Consts do

  -- Float constants that cannot be written as literals.
  --
  -- The JS emitter prints every Float literal with 12 significant digits, so a
  -- constant needing more is built here from a string at run time. Parsing is
  -- not free: call `make` once, keep the record, and pass it to whatever needs
  -- it. Never call `make` in a loop.
  --
  -- The engine-generic constants live in Arcade.Numerics; `num` carries that
  -- record for calls into the engine, and the flat fields below are copied
  -- from it, so both spellings hold the same bits.
  cap pure

  type Consts = {
    pi : Float,
    tau : Float,
    dt : Float,
    unit53 : Float,
    floor_u1 : Float,
    infinity : Float,
    nan : Float,
    marshmallow_drawn : Float,
    num : Arcade.Numerics.Numerics
  }

  doc """All constants, each bit-identical to the Swift expression it replaces."""
  fn make() : Consts needs () do
    let n = Arcade.Numerics.make()
    {
      pi: n.pi,
      tau: n.tau,
      dt: Arcade.Numerics.float_of_text("0.004166666666666667"),
      unit53: n.unit53,
      floor_u1: n.floor_u1,
      infinity: n.infinity,
      nan: n.nan,
      marshmallow_drawn: Arcade.Numerics.float_of_text("1.2999999523162842"),
      num: n
    }
  end

end
