mod Skee.Scene do

  -- The alley as a list of 2D drawing operations (SkeeScene: Cabinet.swift,
  -- Toon.swift, Shapes.swift, Textures.swift and the placement half of
  -- ScenePresenter.swift). SceneKit draws the Swift game with a depth buffer
  -- and shader modifiers; the browser has Canvas 2D. So this is a pure
  -- pipeline in three steps:
  --
  --   1. `model`: the cabinet as SceneKit builds it, part for part, in the
  --      same node order with the same transforms (checked against a dump of
  --      the real Cabinet's node tree).
  --   2. Lighting: Toon.swift's cel ramp, hemisphere fill and rim band, worked
  --      out once per flat face in linear light, as SceneKit renders.
  --   3. `draw`: every part projected through the camera and painted back to
  --      front as flat fills with dark ink outlines. The shell only paints.
  --
  -- What cannot be drawn this way is listed in docs/PORT.md under the scene
  -- piece (no per-pixel depth, no cast shadows, no particles yet).
  cap pure

  import Arcade.Draw
  import Arcade.Num
  import Arcade.Vec2
  import Skee.World

  -- ===================================================================
  -- The cabinet as parts (Cabinet.build)
  -- ===================================================================
  -- An affine transform as its three axis columns and translation.
  type Frame = { ax : Vec3, ay : Vec3, az : Vec3, at : Vec3 }

  -- SceneKit's stock geometries, in geometry units before the node's scale.
  type Solid =
    Slab(Float, Float, Float, Float)
    | Drum(Float, Float)
    | Orb(Float)
    | Hoop(Float, Float)
    | Card(Float, Float)
    | Band(Float, Float)
    | LipArc(Float, Float, Float, Float, Float)

  -- What is painted on a part besides its flat colour.
  type Skin =
    Painted
    | LaneWood
    | BallSkin(BallKind)
    | PitSkin
    | BadgeSkin(Int, Bool)
    | CoinSkin(Symbol)
    | BlobSkin
    | HaloSkin

  -- Which part of the cabinet: decides the painting order.
  type Role =
    FloorPart
    | LaneSlab
    | RailPart
    | RailCap
    | BodyPart
    | HumpPart
    | PanelPart
    | ZonePart
    | LipPart
    | PitPart
    | RimPart
    | BadgePart
    | CoinPart(Hole)
    | HaloPart(Hole)
    | SideWall
    | BackCap
    | BulbPart
    | TroughPart
    | WaitingBall
    | ShadowPart
    | BallPart

  derive Eq, Show for Role

  -- Added light (material.emission), sRGB channels 0...1.
  type Emit = { glow_r : Float, glow_g : Float, glow_b : Float }

  -- One SceneKit node with geometry. `colour` is its first material's flat
  -- colour (None when that material is a texture); `emission` is added light.
  type Part = {
    solid : Solid,
    frame : Frame,
    role : Role,
    colour : Option(Rgba),
    skin : Skin,
    outline : Float,
    hidden : Bool,
    opacity : Float,
    emission : Emit
  }

  -- ===================================================================
  -- What the screen shows this frame
  -- ===================================================================
  -- A rotation, for the rolling ball.
  type Quat = { qw : Float, qx : Float, qy : Float, qz : Float }

  -- Where the presenter put the ball (ScenePresenter.update's first half).
  type BallPlace = {
    centre : Vec3,
    scale : Float,
    normal : Vec3,
    airborne : Bool,
    visible : Bool,
    sink : Float,
    over_board : Bool
  }

  -- The soft shadow under the ball.
  type ShadowPlace = {
    spot : Vec3,
    facing : Vec3,
    size : Float,
    fade : Float,
    shown : Bool
  }

  -- What the presenter knows about the ball this frame. `beat_is_roll` is
  -- true while the current beat is a roll; `resting` is the last landing and
  -- the clock time it stays until.
  type BallCue = {
    sample : Option(PathSample),
    busy : Bool,
    beat_is_roll : Bool,
    resting : Option((PathSample, Float)),
    clock : Float,
    throwing : Bool,
    held : Option(Vec3)
  }

  -- What rolling remembers between frames: orientation, last centre, the
  -- spin carried through flight, and the bounce swell (1 down to 0).
  type Motion = {
    orientation : Quat,
    last : Option(Vec3),
    spin : Vec3,
    pop : Float
  }

  -- Moments that make the ball swell or send out a ring of light. The
  -- presentation maps its cues onto these.
  type Spark =
    SparkHump
    | SparkLip
    | SparkHop
    | SparkLanded
    | SparkBackwall
    | SparkRail
    | SparkDrop(Hole)

  derive Eq for Spark

  -- A ring of light racing outward (ScenePresenter.shock).
  type Wave = { spot : Vec3, facing : Vec3, age : Float, size : Float }

  -- A hole's reel on the board (Cabinet.setReel's arguments).
  type ReelLook = {
    symbol : Symbol,
    turn : Float,
    glow : Float,
    slot_match : Bool,
    pulse : Float
  }

  -- What the presenter knows about the reels this frame: the board's reels,
  -- where each is on screen (fractional while spinning), the symbols this
  -- frame's balls have shown so far (empty while busy or tallying), and the
  -- top slot unless busy.
  type ReelCue = {
    setup : BoardSetup,
    positions : PerReel(Float),
    have : List(Symbol),
    slot : Option(TopSlot)
  }

  -- Everything ScenePresenter.update reads from the Presentation in a frame.
  -- `excited` is flash > 0.05, fever, a banner, anticipation or celebration.
  type FrameCue = {
    ball_cue : BallCue,
    sparks : List(Spark),
    kind : BallKind,
    anticipation : Float,
    shake : Float,
    balls_left : Int,
    excited : Bool,
    reel_cue : ReelCue
  }

  -- What ScenePresenter keeps between frames.
  type Keep = {
    motion : Motion,
    lean : Float,
    waves : List(Wave),
    flash_age : PerReel(Option(Float))
  }

  -- Marquee bulbs: which step of the chase, and how bright, 0...1.
  type BulbLight = { chase : Int, level : Float }

  type BallView = {
    place : BallPlace,
    motion : Motion,
    kind : BallKind,
    shadow : ShadowPlace
  }

  -- Everything one frame of the alley needs.
  type Scenery = {
    world : World,
    palette : Skee.Rooms.CabinetPalette,
    viewport : Arcade.Camera.Viewport,
    camera : Arcade.Camera.Rig,
    ball : BallView,
    waiting : Int,
    reels : PerReel(ReelLook),
    bulbs : BulbLight,
    waves : List(Wave)
  }

  -- ===================================================================
  -- Colours
  -- ===================================================================
  fn of_rgb(c : Skee.Rooms.Rgb) : Rgba needs () do
    hex(c.packed)
  end

  doc """Toon.ink: the colour of every outline."""
  fn ink() : Rgba needs () do
    hex(3810118)
  end

  -- ===================================================================
  -- Light (Toon.swift's shader modifiers, per flat face)
  -- ===================================================================
  -- Linear multipliers per channel, the rim band's strength, and added light.
  type Light = {
    lr : Float,
    lg : Float,
    lb : Float,
    rim : Float,
    er : Float,
    eg : Float,
    eb : Float
  }

  pfn to_linear(x : Float) : Float needs () do
    if x <= 0.04045 do x /. 12.92 else Math.pow((x +. 0.055) /. 1.055, 2.4) end
  end

  pfn to_srgb(x : Float) : Float needs () do
    let c = clamp(x, 0.0, 1.0)
    if c <= 0.0031308 do
      c *. 12.92
    else
      1.055 *. Math.pow(c, 1.0 /. 2.4) -. 0.055
    end
  end

  doc """The direction toward makeSun's light: normalize(-0.45, 1, 0.25)."""
  fn sun() : Vec3 needs () do
    unit(v3(-0.45, 1.0, 0.25))
  end

  pfn smoothstep(e0 : Float, e1 : Float, x : Float) : Float needs () do
    let t = clamp((x -. e0) /. (e1 -. e0), 0.0, 1.0)
    t *. t *. (3.0 -. 2.0 *. t)
  end

  doc """
  The cel ramp for a surface normal seen from `to_eye`: three bands of sun
  (150, 205, 255 of 255), hemisphere fill from ground (d9c8ff) to sky (fff4fb)
  and the hard rim band. three.js folds 1/pi into its lights; so does this.
  """
  fn light(normal : Vec3, to_eye : Vec3) : Light needs () do
    let n = unit(normal)
    let u = dot3(n, sun()) *. 0.5 +. 0.5
    let band =
      if u < 1.0 /. 3.0 do
        150.0 /. 255.0
      else
        if u < 2.0 /. 3.0 do 205.0 /. 255.0 else 1.0 end
      end
    let s = band *. 2.2 *. 0.31831
    let t = n.y *. 0.5 +. 0.5
    let h = 1.6 *. 0.31831
    let ground = v3(217.0 /. 255.0, 200.0 /. 255.0, 1.0)
    let sky = v3(1.0, 244.0 /. 255.0, 251.0 /. 255.0)
    let hemi = mix3(ground, sky, t)
    let facing = Math.max_float(dot3(unit(to_eye), n), 0.0)
    {
      lr: s +. hemi.x *. h,
      lg: s +. hemi.y *. h,
      lb: s +. hemi.z *. h,
      rim: smoothstep(0.62, 0.68, 1.0 -. facing) *. 0.28,
      er: 0.0,
      eg: 0.0,
      eb: 0.0
    }
  end

  doc """Unlit: SceneKit's constant lighting model, for glows and shadows."""
  fn unlit() : Light needs () do
    { lr: 1.0, lg: 1.0, lb: 1.0, rim: 0.0, er: 0.0, eg: 0.0, eb: 0.0 }
  end

  fn dark() : Emit needs () do
    { glow_r: 0.0, glow_g: 0.0, glow_b: 0.0 }
  end

  doc """Add an emission colour (sRGB, as SceneKit's material.emission)."""
  fn glowing(l : Light, e : Emit) : Light needs () do
    { l with er: to_linear(e.glow_r), eg: to_linear(e.glow_g), eb: to_linear(e.glow_b) }
  end

  pfn lit_channel(x : Int, m : Float, rim : Float, e : Float) : Int needs () do
    channel(to_srgb(to_linear(int_to_float(x) /. 255.0) *. m +. rim +. e) *. 255.0)
  end

  doc """A material colour under a light, as the shader writes it out."""
  fn shade(c : Rgba, l : Light) : Rgba needs () do
    {
      red: lit_channel(c.red, l.lr, l.rim, l.er),
      green: lit_channel(c.green, l.lg, l.rim *. 0.96, l.eg),
      blue: lit_channel(c.blue, l.lb, l.rim, l.eb),
      alpha: c.alpha
    }
  end

  -- ===================================================================
  -- Frames
  -- ===================================================================
  fn identity() : Frame needs () do
    {
      ax: v3(1.0, 0.0, 0.0),
      ay: v3(0.0, 1.0, 0.0),
      az: v3(0.0, 0.0, 1.0),
      at: origin()
    }
  end

  fn apply(f : Frame, p : Vec3) : Vec3 needs () do
    plus(plus(plus(times(f.ax, p.x), times(f.ay, p.y)), times(f.az, p.z)), f.at)
  end

  fn turn(f : Frame, d : Vec3) : Vec3 needs () do
    plus(plus(times(f.ax, d.x), times(f.ay, d.y)), times(f.az, d.z))
  end

  doc """Parent then child: a child node's world transform."""
  fn compose(parent : Frame, child : Frame) : Frame needs () do
    {
      ax: turn(parent, child.ax),
      ay: turn(parent, child.ay),
      az: turn(parent, child.az),
      at: apply(parent, child.at)
    }
  end

  pfn rot_x(a : Float, v : Vec3) : Vec3 needs () do
    let c = Math.cos(a)
    let s = Math.sin(a)
    v3(v.x, v.y *. c -. v.z *. s, v.y *. s +. v.z *. c)
  end

  pfn rot_y(a : Float, v : Vec3) : Vec3 needs () do
    let c = Math.cos(a)
    let s = Math.sin(a)
    v3(v.x *. c +. v.z *. s, v.y, v.z *. c -. v.x *. s)
  end

  pfn rot_z(a : Float, v : Vec3) : Vec3 needs () do
    let c = Math.cos(a)
    let s = Math.sin(a)
    v3(v.x *. c -. v.y *. s, v.x *. s +. v.y *. c, v.z)
  end

  pfn euler(e : Vec3, v : Vec3) : Vec3 needs () do
    rot_y(e.y, rot_x(e.x, rot_z(e.z, v)))
  end

  doc """
  An SCNNode's local transform: position, eulerAngles (SceneKit applies roll,
  then pitch, then yaw: R = Ry Rx Rz) and scale.
  """
  fn node(pos : Vec3, angles : Vec3, scale : Vec3) : Frame needs () do
    {
      ax: times(euler(angles, v3(1.0, 0.0, 0.0)), scale.x),
      ay: times(euler(angles, v3(0.0, 1.0, 0.0)), scale.y),
      az: times(euler(angles, v3(0.0, 0.0, 1.0)), scale.z),
      at: pos
    }
  end

  fn at_point(pos : Vec3) : Frame needs () do
    { identity() with at: pos }
  end

  pfn ones() : Vec3 needs () do
    v3(1.0, 1.0, 1.0)
  end

  pfn no_turn() : Vec3 needs () do
    origin()
  end

  -- ===================================================================
  -- Quaternions (the ball's roll)
  -- ===================================================================
  fn quat_identity() : Quat needs () do
    { qw: 1.0, qx: 0.0, qy: 0.0, qz: 0.0 }
  end

  doc """simd_quatf(angle:axis:)."""
  fn quat_axis(angle : Float, axis : Vec3) : Quat needs () do
    let a = unit(axis)
    let s = Math.sin(angle /. 2.0)
    { qw: Math.cos(angle /. 2.0), qx: a.x *. s, qy: a.y *. s, qz: a.z *. s }
  end

  doc """p * q: rotate by q, then by p."""
  fn quat_mul(p : Quat, q : Quat) : Quat needs () do
    {
      qw: p.qw *. q.qw -. p.qx *. q.qx -. p.qy *. q.qy -. p.qz *. q.qz,
      qx: p.qw *. q.qx +. p.qx *. q.qw +. p.qy *. q.qz -. p.qz *. q.qy,
      qy: p.qw *. q.qy -. p.qx *. q.qz +. p.qy *. q.qw +. p.qz *. q.qx,
      qz: p.qw *. q.qz +. p.qx *. q.qy -. p.qy *. q.qx +. p.qz *. q.qw
    }
  end

  fn quat_rotate(q : Quat, v : Vec3) : Vec3 needs () do
    let u = v3(q.qx, q.qy, q.qz)
    let t = times(cross(u, v), 2.0)
    plus(plus(v, times(t, q.qw)), cross(u, t))
  end

  doc """simd_quatf(from:to:) for unit vectors."""
  fn quat_between(a : Vec3, b : Vec3) : Quat needs () do
    let c = cross(a, b)
    let d = dot3(a, b)
    if d < -0.999999 do
      do
        let perp =
          unit(if Math.abs(a.x) < 0.9 do cross(a, v3(1.0, 0.0, 0.0)) else cross(a, v3(0.0, 1.0, 0.0)) end)
        { qw: 0.0, qx: perp.x, qy: perp.y, qz: perp.z }
      end
    else
      do
        let q = { qw: 1.0 +. d, qx: c.x, qy: c.y, qz: c.z }
        let l =
          Math.sqrt(q.qw *. q.qw +. q.qx *. q.qx +. q.qy *. q.qy +. q.qz *. q.qz)
        { qw: q.qw /. l, qx: q.qx /. l, qy: q.qy /. l, qz: q.qz /. l }
      end
    end
  end

  fn quat_frame(q : Quat, pos : Vec3, scale : Float) : Frame needs () do
    {
      ax: times(quat_rotate(q, v3(1.0, 0.0, 0.0)), scale),
      ay: times(quat_rotate(q, v3(0.0, 1.0, 0.0)), scale),
      az: times(quat_rotate(q, v3(0.0, 0.0, 1.0)), scale),
      at: pos
    }
  end

  -- ===================================================================
  -- Building the cabinet
  -- ===================================================================
  pfn part(solid : Solid, frame : Frame, role : Role, colour : Option(Rgba), skin : Skin, outline : Float) : Part needs () do
    {
      solid: solid,
      frame: frame,
      role: role,
      colour: colour,
      skin: skin,
      outline: outline,
      hidden: false,
      opacity: 1.0,
      emission: dark()
    }
  end

  -- ToonKit.part over the shared rounded unit box.
  pfn box_part(parent : Frame, colour : Skee.Rooms.Rgb, scale : Vec3, pos : Vec3, role : Role) : Part needs () do
    part(Slab(1.0, 1.0, 1.0, 0.12), compose(parent, node(pos, no_turn(), scale)), role, Some(of_rgb(colour)), Painted, 0.03)
  end

  fn lane_frame(w : World) : Frame needs () do
    let pos =
      minus(lane(w, 0.0, w.table.lane.length /. 2.0), times(lane_normal(w), 0.025))
    node(pos, v3(w.table.lane.incline, 0.0, 0.0), ones())
  end

  fn board_frame(k : Skee.Consts.Consts, w : World) : Frame needs () do
    let s = w.board_scale
    node(board_origin(w), v3(w.board_tilt -. k.pi /. 2.0, 0.0, 0.0), v3(s, s, s))
  end

  pfn lane_parts(w : World, p : Skee.Rooms.CabinetPalette) : List(Part) needs () do
    let lw = w.table.lane.width
    let ll = lane_length(w)
    let lf = lane_frame(w)
    let slab =
      part(Slab(lw, 0.05, ll, 0.012), lf, LaneSlab, Some(hex(15185274)), LaneWood, 0.02)
    let rails =
      List.flat_map([-1.0, 1.0], fn sx -> [box_part(lf, p.rail, v3(0.07, 0.11, ll +. 0.1), v3(sx *. (lw /. 2.0 +. 0.035), 0.04, 0.0), RailPart), box_part(lf, p.rail_dark, v3(0.08, 0.025, ll +. 0.12), v3(sx *. (lw /. 2.0 +. 0.035), 0.1, 0.0), RailCap)])
    let body =
      box_part(lf, p.cabinet_body, v3(lw +. 0.2, 0.42, ll +. 0.1), v3(0.0, -0.24, 0.0), BodyPart)
    List.concat([[slab], rails, [body]])
  end

  pfn hump_part(k : Skee.Consts.Consts, w : World) : Part needs () do
    let pos =
      plus(lane(w, 0.0, w.table.lane.length), times(lane_normal(w), w.hump_height -. 0.045))
    let f = node(pos, v3(0.0, 0.0, k.pi /. 2.0), v3(0.09, w.table.lane.width, 0.09))
    part(Drum(0.5, 1.0), f, HumpPart, Some(hex(16765562)), Painted, 0.03)
  end

  -- Ring walls, smallest first, with their zone colours.
  pfn walls(b : BoardSpec) : List(Float) needs () do
    [
      b.ring_walls.wall40,
      b.ring_walls.wall30,
      b.ring_walls.wall20,
      b.ring_walls.wall10
    ]
  end

  pfn zone_colours(p : Skee.Rooms.CabinetPalette) : List(Skee.Rooms.Rgb) needs () do
    [p.zones.zone40, p.zones.zone30, p.zones.zone20, p.zones.zone10]
  end

  pfn flat_disc(k : Skee.Consts.Consts, bf : Frame, pos : Vec3) : Frame needs () do
    compose(bf, node(pos, v3(k.pi /. 2.0, 0.0, 0.0), ones()))
  end

  pfn zone_parts(k : Skee.Consts.Consts, w : World, p : Skee.Rooms.CabinetPalette, bf : Frame) : List(Part) needs () do
    let b = w.table.board
    let c = b.ring_center
    let zs =
      List.reverse(List.zip(List.range(0, 4), List.zip(walls(b), zone_colours(p))))
    List.map(zs, fn z -> zone_part(k, bf, c, z))
  end

  pfn zone_part(k : Skee.Consts.Consts, bf : Frame, c : Vec2, z : (Int, (Float, Skee.Rooms.Rgb))) : Part needs () do
    match z do
    (i, (wall, colour)) -> do
      let f = flat_disc(k, bf, v3(c.x, c.y, 0.001 +. int_to_float(3 - i) *. 0.0004))
      part(Drum(wall, 0.002), f, ZonePart, Some(of_rgb(colour)), Painted, 0.0)
    end
    end
  end

  pfn lip_parts(k : Skee.Consts.Consts, w : World, p : Skee.Rooms.CabinetPalette, bf : Frame) : List(Part) needs () do
    let b = w.table.board
    let c = b.ring_center
    List.map(walls(b), fn wall -> part(LipArc(wall, 0.0085, b.lip_height, -k.pi /. 2.0, Math.asin(min_float(0.95, (ring_hole_visual() +. 0.006) /. wall))), compose(bf, at_point(v3(c.x, c.y, 0.0))), LipPart, Some(of_rgb(p.lip)), Painted, 0.022))
  end

  doc """Hole.isPocket || hole == .ring50: gold rims and badges."""
  fn is_special(h : Hole) : Bool needs () do
    match h do
    Ring50 -> true
    PocketLeft -> true
    PocketRight -> true
    Gutter -> false
    Ring10 -> false
    Ring20 -> false
    Ring30 -> false
    Ring40 -> false
    end
  end

  doc """Drawn pit radius of a hole."""
  fn pit_radius(b : BoardSpec, h : Hole) : Float needs () do
    if Skee.Physics.is_pocket(h) do
      b.pockets.left.radius +. 0.004
    else
      if h == Ring50 do
        b.center_hole_radius +. 0.004
      else
        ring_hole_visual()
      end
    end
  end

  pfn trim_colour(special : Bool) : Rgba needs () do
    if special do hex(16763213) else hex(16775404) end
  end

  pfn hole_parts(k : Skee.Consts.Consts, w : World, p : Skee.Rooms.CabinetPalette, bf : Frame, h : Hole) : List(Part) needs () do
    let b = w.table.board
    let c = Skee.Physics.hole_center(b, h)
    let special = is_special(h)
    let radius = pit_radius(b, h)
    let side = if h == PocketRight do 1.0 else -1.0 end
    let pit =
      part(Drum(radius, 0.002), flat_disc(k, bf, v3(c.x, c.y, 0.004)), PitPart, Some(of_rgb(p.hole_colour)), PitSkin, 0.0)
    let rim =
      part(Hoop(radius +. 0.003, 0.0055), flat_disc(k, bf, v3(c.x, c.y, 0.006)), RimPart, Some(trim_colour(special)), Painted, 0.02)
    let badge =
      part(Slab(0.062, 0.034, 0.01, 0.012), compose(bf, at_point(v3(c.x +. side *. (radius +. 0.042), c.y, 0.008))), BadgePart, None, BadgeSkin(Skee.Physics.face_value(h), special), 0.016)
    [pit, rim, badge]
  end

  -- Cabinet.buildRingReels' layout for one hole: centre on the board, orbit
  -- radius, coin count, coin size, first coin's angle, and the halo band.
  type ReelLayout = {
    reel_hole : Hole,
    centre : Vec2,
    radius : Float,
    count : Int,
    size : Float,
    phase : Float,
    band_in : Float,
    band_out : Float
  }

  fn reel_layout(k : Skee.Consts.Consts, b : BoardSpec, h : Hole) : ReelLayout needs () do
    let c = b.ring_center
    let w = b.ring_walls
    match h do
    Ring10 -> ring_layout(k, h, c, 7, 0.074, w.wall20, w.wall10)
    Ring20 -> ring_layout(k, h, c, 6, 0.07, w.wall30, w.wall20)
    Ring30 -> ring_layout(k, h, c, 4, 0.066, w.wall40, w.wall30)
    Ring40 -> do
      {
        reel_hole: h,
        centre: c,
        radius: w.wall40 *. 0.62,
        count: 2,
        size: 0.056,
        phase: 0.0,
        band_in: 0.0,
        band_out: w.wall40 -. 0.008
      }
    end
    Ring50 -> do
      {
        reel_hole: h,
        centre: Skee.Physics.hole_center(b, Ring50),
        radius: 0.0,
        count: 1,
        size: 0.066,
        phase: k.pi /. 2.0,
        band_in: b.center_hole_radius +. 0.008,
        band_out: b.center_hole_radius +. 0.02
      }
    end
    PocketLeft -> pocket_layout(k, b, h)
    PocketRight -> pocket_layout(k, b, h)
    Gutter -> do
      {
        reel_hole: h,
        centre: c,
        radius: 0.0,
        count: 0,
        size: 0.0,
        phase: 0.0,
        band_in: 0.0,
        band_out: 0.0
      }
    end
    end
  end

  -- Named functions, not let-bound lambdas: see tools/repros/lambda_tagged_int.
  pfn ring_layout(k : Skee.Consts.Consts, h : Hole, c : Vec2, count : Int, size : Float, inner : Float, outer : Float) : ReelLayout needs () do
    {
      reel_hole: h,
      centre: c,
      radius: (inner +. outer) /. 2.0,
      count: count,
      size: size,
      phase: k.pi /. 2.0,
      band_in: inner +. 0.008,
      band_out: outer -. 0.008
    }
  end

  pfn pocket_layout(k : Skee.Consts.Consts, b : BoardSpec, h : Hole) : ReelLayout needs () do
    let pc = Skee.Physics.hole_center(b, h)
    {
      reel_hole: h,
      centre: vec2(pc.x, pc.y +. 0.07),
      radius: 0.0,
      count: 1,
      size: 0.08,
      phase: k.pi /. 2.0,
      band_in: b.pockets.left.radius +. 0.008,
      band_out: b.pockets.left.radius +. 0.022
    }
  end

  -- One coin of a reel as Cabinet.setReel leaves it: pivot-local position,
  -- hidden in the hole channel, and its glow swell.
  type Coin = { local : Vec3, coin_hidden : Bool, swell : Float }

  doc """Cabinet.setReel's placement of coin `i` of a reel."""
  fn coin(k : Skee.Consts.Consts, r : ReelLayout, look : ReelLook, i : Int) : Coin needs () do
    let n = int_to_float(r.count)
    let spin = look.turn *. 2.0 *. k.pi /. int_to_float(Math.max_int(r.count, 3))
    let a = int_to_float(i) /. n *. 2.0 *. k.pi +. r.phase +. spin
    let bottom =
      Math.abs(Math.atan2(Math.sin(a +. k.pi /. 2.0), Math.cos(a +. k.pi /. 2.0))) < 0.75
    if r.radius == 0.0 do
      {
        local: v3(r.radius *. Math.cos(a), 0.0, 0.0),
        coin_hidden: false,
        swell: 1.0 +. 0.25 *. look.glow *. look.pulse
      }
    else
      {
        local: v3(r.radius *. Math.cos(a), r.radius *. Math.sin(a), 0.0),
        coin_hidden: bottom,
        swell: 1.0 +. 0.18 *. look.glow *. look.pulse
      }
    end
  end

  doc """The coins' glow: Cabinet.setReel's emission colour."""
  fn coin_emission(look : ReelLook) : Emit needs () do
    if look.glow > 0.0 do
      do
        let p = look.pulse
        let g = if look.glow > 1.0 do 0.45 else 0.3 end
        let b = if look.glow > 1.0 do 0.0 else 0.25 *. p end
        { glow_r: 0.55 *. p, glow_g: g *. p, glow_b: b }
      end
    else
      dark()
    end
  end

  doc """The halo under a reel: opacity and colour."""
  fn halo(look : ReelLook) : (Float, Rgba) needs () do
    let strength = if look.glow > 1.0 do 0.75 else 0.45 end
    let opacity =
      if look.glow > 0.0 do
        strength *. look.pulse
      else
        if look.slot_match do 0.4 *. look.pulse else 0.0 end
      end
    let colour =
      if look.glow > 1.0 do
        hex(16767053)
      else
        if look.glow > 0.0 do hex(16774832) else hex(7336191) end
      end
    (opacity, colour)
  end

  pfn reel_parts(k : Skee.Consts.Consts, w : World, bf : Frame, look : ReelLook, h : Hole) : List(Part) needs () do
    let r = reel_layout(k, w.table.board, h)
    let pivot = compose(bf, at_point(v3(r.centre.x, r.centre.y, 0.02)))
    let halo_y = if Skee.Physics.is_pocket(h) do r.centre.y -. 0.07 else r.centre.y end
    let (opacity, halo_colour) = halo(look)
    let glow_part =
      { part(Band(r.band_in, r.band_out), flat_disc(k, bf, v3(r.centre.x, halo_y, 0.0035)), HaloPart(h), Some(halo_colour), HaloSkin, 0.0) with opacity: opacity }
    let coins =
      List.map(List.range(0, r.count), fn i -> coin_part(k, r, look, pivot, h, i))
    List.append(coins, [glow_part])
  end

  pfn coin_part(k : Skee.Consts.Consts, r : ReelLayout, look : ReelLook, pivot : Frame, h : Hole, i : Int) : Part needs () do
    let c = coin(k, r, look, i)
    let f = compose(pivot, node(c.local, no_turn(), v3(c.swell, c.swell, c.swell)))
    { part(Card(r.size, r.size), f, CoinPart(h), None, CoinSkin(look.symbol), 0.0) with hidden: c.coin_hidden, emission: coin_emission(look) }
  end

  pfn wall_parts(w : World, p : Skee.Rooms.CabinetPalette, bf : Frame) : List(Part) needs () do
    let bw = w.table.board.board_width
    let bh = w.table.board.board_height
    [
      side_wall(bf, p, bw, bh, -1.0),
      side_wall(bf, p, bw, bh, 1.0),
      box_part(bf, p.rail_dark, v3(bw +. 0.08, 0.05, 0.18), v3(0.0, bh +. 0.02, 0.07), BackCap)
    ]
  end

  pfn side_wall(bf : Frame, p : Skee.Rooms.CabinetPalette, bw : Float, bh : Float, sx : Float) : Part needs () do
    box_part(bf, p.rail, v3(0.04, bh +. 0.04, 0.16), v3(sx *. (bw /. 2.0 +. 0.02), bh /. 2.0, 0.06), SideWall)
  end

  doc """Cabinet.buildBulbs: the bulb spots on the board, in order."""
  fn bulb_spots(w : World) : List(Vec3) needs () do
    let bw = w.table.board.board_width
    let bh = w.table.board.board_height
    let top =
      List.map(List.range(0, 9), fn i -> v3(-bw /. 2.0 +. bw *. int_to_float(i) /. 8.0, bh +. 0.05, 0.14))
    let sides =
      List.flat_map(List.range(0, 7), fn i -> [v3(-bw /. 2.0 -. 0.02, bh *. int_to_float(i) /. 6.0, 0.15), v3(bw /. 2.0 +. 0.02, bh *. int_to_float(i) /. 6.0, 0.15)])
    List.append(top, sides)
  end

  doc """Cabinet.lightBulbs: bulb `i` is lit on every third step of the chase."""
  fn bulb_lit(light_ : BulbLight, i : Int) : Bool needs () do
    (i + light_.chase) % 3 == 0 && light_.level > 0.0
  end

  pfn bulb_parts(w : World, bf : Frame, bulbs : BulbLight) : List(Part) needs () do
    List.map(List.enumerate(bulb_spots(w)), fn e -> bulb_part(bf, bulbs, e))
  end

  pfn bulb_part(bf : Frame, bulbs : BulbLight, e : (Int, Vec3)) : Part needs () do
    match e do
    (i, spot) -> do
      let colour = if i % 2 == 0 do hex(16773544) else hex(16752324) end
      let level = if bulb_lit(bulbs, i) do bulbs.level else 0.0 end
      { part(Orb(0.012), compose(bf, at_point(spot)), BulbPart, Some(colour), Painted, 0.02) with emission: { glow_r: level, glow_g: level, glow_b: level } }
    end
    end
  end

  fn trough_spot(w : World) : Vec3 needs () do
    plus(lane(w, 0.0, -0.2), v3(0.0, -0.06, 0.02))
  end

  pfn trough_parts(w : World, p : Skee.Rooms.CabinetPalette, kind : BallKind, waiting : Int) : List(Part) needs () do
    let lw = w.table.lane.width
    let t = trough_spot(w)
    let trough =
      box_part(identity(), p.rail_dark, v3(lw +. 0.12, 0.035, 0.09), t, TroughPart)
    Cons(trough, List.map(List.range(0, 12), fn i -> waiting_ball(w, kind, waiting, i)))
  end

  doc """Ball `i` in the return trough, nearest first; hidden past `waiting`."""
  fn waiting_ball(w : World, kind : BallKind, waiting : Int, i : Int) : Part needs () do
    let lw = w.table.lane.width
    let n = int_to_float(i)
    let f =
      node(plus(trough_spot(w), v3(lw /. 2.0 +. 0.02 -. n *. 0.062, 0.045, 0.0)), v3(n *. 0.7, n *. 1.3, 0.0), ones())
    { part(Orb(ball_radius(w)), f, WaitingBall, None, BallSkin(kind), 0.03) with hidden: i >= waiting }
  end

  doc """The ball and its shadow, as ScenePresenter places them."""
  fn ball_parts(k : Skee.Consts.Consts, w : World, v : BallView) : List(Part) needs () do
    let r = ball_radius(w)
    let s = v.shadow
    let blob_frame = quat_frame(quat_between(v3(0.0, 0.0, 1.0), s.facing), s.spot, s.size)
    let blob =
      { part(Card(r *. 2.6, r *. 2.6), blob_frame, ShadowPart, None, BlobSkin, 0.0) with hidden: !s.shown, opacity: s.fade }
    let size =
      v.place.scale *. Skee.Items.drawn_size(k, v.kind) *. (1.0 +. 0.35 *. v.motion.pop)
    let ball =
      { part(Orb(r), quat_frame(v.motion.orientation, v.place.centre, size), BallPart, None, BallSkin(v.kind), 0.03) with hidden: !v.place.visible }
    [blob, ball]
  end

  pfn floor_part(k : Skee.Consts.Consts, p : Skee.Rooms.CabinetPalette) : Part needs () do
    part(Card(30.0, 30.0), node(v3(0.0, -0.45, 0.0), v3(-k.pi /. 2.0, 0.0, 0.0), ones()), FloorPart, Some(of_rgb(p.floor)), Painted, 0.0)
  end

  doc """
  The whole cabinet as SceneKit's node tree holds it, depth first: floor,
  lane, hump, board (panel, zones, lips, holes, reels, walls, bulbs),
  trough, waiting balls, shadow, ball.
  """
  fn model(k : Skee.Consts.Consts, s : Scenery) : List(Part) needs () do
    let w = s.world
    let p = s.palette
    let bf = board_frame(k, w)
    let holes = List.filter(Skee.HoleMap.all_holes(), fn h -> h != Gutter)
    let board_parts =
      List.concat([[box_part(bf, p.felt, v3(w.table.board.board_width +. 0.02, w.table.board.board_height +. 0.02, 0.05), v3(0.0, w.table.board.board_height /. 2.0, -0.026), PanelPart)], zone_parts(k, w, p, bf), lip_parts(k, w, p, bf), List.flat_map(holes, fn h -> hole_parts(k, w, p, bf, h)), List.flat_map(Skee.HoleMap.reel_holes(), fn h -> reel_parts(k, w, bf, reel_look_at(s.reels, h), h)), wall_parts(w, p, bf), bulb_parts(w, bf, s.bulbs)])
    List.concat([[floor_part(k, p)], lane_parts(w, p), [hump_part(k, w)], board_parts, trough_parts(w, p, s.ball.kind, s.waiting), ball_parts(k, w, s.ball)])
  end

  doc """A reel's look, by hole (the gutter has none: a blank at rest)."""
  fn reel_look_at(m : PerReel(ReelLook), h : Hole) : ReelLook needs () do
    match Skee.HoleMap.reel_at(m, h) do
    Some(l) -> l
    None -> { symbol: Blank, turn: 0.0, glow: 0.0, slot_match: false, pulse: 1.0 }
    end
  end

  -- ===================================================================
  -- Screen geometry for the HUD and the stroke (delegates to Skee.Camera)
  -- ===================================================================
  doc """
  Where each hole is on screen, in pixels, for HUDState's popups and board
  taps: GameModel's holeOnScreen, through the fitted rig.
  """
  fn hole_on_screen(k : Skee.Consts.Consts, w : World, rig : Arcade.Camera.Rig, v : Arcade.Camera.Viewport) : PerHole(Vec2) needs () do
    Skee.Camera.hole_on_screen(k, w, rig, v)
  end

  doc """ScenePresenter.flickGeometry: crease y, lane centre x and half width in pixels."""
  fn flick_geometry(k : Skee.Consts.Consts, w : World, rig : Arcade.Camera.Rig, v : Arcade.Camera.Viewport) : FlickGeometry needs () do
    Skee.Camera.flick_geometry(k, w, rig, v)
  end

  -- ===================================================================
  -- ScenePresenter.update: placing things from the presentation
  -- ===================================================================
  doc """
  Where the ball is drawn: on its recorded path, sinking through the hole it
  landed in, waiting under the thumb, or hidden.
  """
  fn place_ball(w : World, c : BallCue) : BallPlace needs () do
    let r = ball_radius(w)
    let rest_spot = plus(lane(w, 0.0, 0.12), times(lane_normal(w), r))
    match c.sample do
    Some(s) -> do
      let centre = ball_center(w, s)
      let scale = ball_scale(w, s)
      let base =
        {
          centre: centre,
          scale: scale,
          normal: surface_normal(w, s),
          airborne: s.phase == InAir && s.height > 0.005,
          visible: true,
          sink: 0.0,
          over_board: s.along > w.table.lane.length
        }
      if !c.busy || !c.beat_is_roll do
        match c.resting do
        Some((_, until)) -> sunk(w, base, s, 0.6 -. (until -. c.clock))
        None -> base
        end
      else
        base
      end
    end
    None -> do
      if c.throwing && !c.busy do
        {
          centre: held_or(c.held, rest_spot),
          scale: 1.0,
          normal: lane_normal(w),
          airborne: false,
          visible: true,
          sink: 0.0,
          over_board: false
        }
      else
        {
          centre: rest_spot,
          scale: 1.0,
          normal: lane_normal(w),
          airborne: false,
          visible: false,
          sink: 0.0,
          over_board: false
        }
      end
    end
    end
  end

  pfn held_or(h : Option(Vec3), fallback : Vec3) : Vec3 needs () do
    match h do
    Some(p) -> p
    None -> fallback
    end
  end

  -- Just landed: drop through the hole; in the gutter, vanish half way.
  pfn sunk(w : World, b : BallPlace, s : PathSample, age : Float) : BallPlace needs () do
    let sink = min_float(1.0, max_float(0.0, age /. 0.35))
    let centre =
      minus(b.centre, times(board_normal(w), sink *. 2.2 *. ball_radius(w) *. b.scale))
    let visible = if s.along <= w.table.lane.length do sink < 0.5 else true end
    { b with centre: centre, scale: b.scale *. (1.0 -. 0.4 *. sink), visible: visible, sink: sink }
  end

  doc """
  Roll the ball by the distance it moved over its radius, about the axis in
  the surface across the motion. In the air it keeps the spin it had. The
  swell from the last bounce fades at 4 per second.
  """
  fn roll_on(w : World, m : Motion, b : BallPlace, dt : Float) : Motion needs () do
    let turned =
      match m.last do
      Some(last) -> if b.visible do rolled(w, m, b, minus(b.centre, last), dt) else m end
      None -> m
      end
    let last = if b.visible do Some(b.centre) else None end
    { turned with last: last, pop: max_float(0.0, m.pop -. dt *. 4.0) }
  end

  doc """
  Whether a step `d` of the ball runs along its surface normal, as when it
  sinks straight into a hole: Swift's roll axis is then the normalised cross
  product of rounding noise, so the ball would spin at random. The port does
  not roll it.
  """
  fn rolls_straight_down(b : BallPlace, d : Vec3) : Bool needs () do
    let dist = length3(d)
    !b.airborne && dist > 0.00001 && dist < 0.5 && length3(cross(b.normal, d)) <= dist *. 0.000001
  end

  pfn rolled(w : World, m : Motion, b : BallPlace, d : Vec3, dt : Float) : Motion needs () do
    let dist = length3(d)
    let across = cross(b.normal, d)
    if rolls_straight_down(b, d) do
      m
    else
      if !b.airborne && dist > 0.00001 && dist < 0.5 do
        do
          let axis = unit(across)
          let angle = dist /. (ball_radius(w) *. b.scale)
          let o = quat_mul(quat_axis(angle, axis), m.orientation)
          let spin =
            if dt > 1.0 /. 400.0 do
              plus(times(m.spin, 0.6), times(axis, angle /. dt *. 0.4))
            else
              m.spin
            end
          { m with orientation: o, spin: spin }
        end
      else
        do
          let rate = length3(m.spin)
          if b.airborne && rate > 0.0 do
            { m with orientation: quat_mul(quat_axis(rate *. dt, times(m.spin, 1.0 /. rate)), m.orientation) }
          else
            m
          end
        end
      end
    end
  end

  -- Sinking straight into a hole moves along the normal: Swift normalises a
  -- cross product of rounding noise there and spins the ball at random. A
  -- move with no part across the surface does not roll it here.
  doc """The shadow on the surface under the ball: smaller and fainter the higher it flies."""
  fn shadow_place(w : World, c : BallCue, b : BallPlace) : ShadowPlace needs () do
    let r = ball_radius(w)
    let l = w.table.lane.length
    let (ground, height) =
      match c.sample do
      Some(s) -> do
        if s.along > l do
          (board(w, vec2(s.px, s.along -. l), 0.0), s.height)
        else
          (minus(b.centre, times(b.normal, r *. b.scale)), 0.0)
        end
      end
      None -> (minus(b.centre, times(b.normal, r *. b.scale)), 0.0)
      end
    let fade = max_float(0.25, 1.0 -. height *. 3.0)
    {
      spot: plus(ground, times(b.normal, 0.004)),
      facing: b.normal,
      size: b.scale *. (0.7 +. 0.3 *. fade),
      fade: fade,
      shown: b.visible
    }
  end

  doc """The bounce swell a spark gives the ball."""
  fn popped(pop : Float, s : Spark) : Float needs () do
    match s do
    SparkHump -> 1.0
    SparkLip -> max_float(pop, 0.6)
    SparkHop -> 1.0
    SparkLanded -> max_float(pop, 0.8)
    SparkBackwall -> pop
    SparkRail -> pop
    SparkDrop(_) -> pop
    end
  end

  doc """The rings of light a spark sends out (ScenePresenter.shock)."""
  fn shocks(w : World, s : Spark, centre : Vec3, kind : BallKind) : List(Wave) needs () do
    let comet = kind == Comet
    match s do
    SparkHump -> do
      [
        {
          spot: centre,
          facing: lane_normal(w),
          age: 0.0,
          size: if comet do 0.9 else 0.5 end
        }
      ]
    end
    SparkHop -> [{ spot: centre, facing: board_normal(w), age: 0.0, size: 0.25 }]
    SparkBackwall -> do
      if comet do
        [{ spot: centre, facing: board_normal(w), age: 0.0, size: 0.4 }]
      else
        []
      end
    end
    SparkRail -> do
      if comet do
        [{ spot: centre, facing: board_normal(w), age: 0.0, size: 0.4 }]
      else
        []
      end
    end
    SparkDrop(h) -> do
      [
        {
          spot: board(w, Skee.Physics.hole_center(w.table.board, h), 0.02),
          facing: board_normal(w),
          age: 0.0,
          size: if Skee.Physics.face_value(h) >= 50 do 1.1 else 0.55 end
        }
      ]
    end
    SparkLip -> []
    SparkLanded -> []
    end
  end

  doc """Rings of light grow and fade over 0.55 s."""
  fn age_waves(waves : List(Wave), dt : Float) : List(Wave) needs () do
    List.filter(List.map(waves, fn x -> { x with age: x.age +. dt }), fn x -> x.age /. wave_life() < 1.0)
  end

  doc """Cabinet.lightBulbs' arguments: an idle twinkle, a fast chase when excited."""
  fn bulb_light(excited : Bool, clock : Float) : BulbLight needs () do
    let rate = if excited do 14.0 else 2.0 end
    {
      chase: float_truncate(clock *. rate),
      level: if excited do 0.9 else 0.35 end
    }
  end

  doc """Balls waiting in the tray: all that are left but the one in hand."""
  fn waiting_count(balls_left : Int, held : Bool, in_flight : Bool, busy : Bool, throwing : Bool) : Int needs () do
    let in_hand = if held || in_flight || !busy && throwing do 1 else 0 end
    Math.max_int(0, balls_left - in_hand)
  end

  doc """
  Each reel shows the symbol it is on, orbiting while it spins. Rings that
  would pair (glow 1) or finish the line (glow 2) glow; a hole that just took
  a ball flashes; a symbol the top slot shows is ringed in cyan.
  """
  fn reel_looks(c : ReelCue, throwing : Bool, clock : Float, flash_age : PerReel(Option(Float))) : PerReel(ReelLook) needs () do
    let pulse = 0.6 +. 0.4 *. Math.sin(clock *. 7.0)
    let line_now = Skee.Scoring.added_mult(Skee.Scoring.evaluate(c.have))
    {
      reel10: reel_look(c, throwing, pulse, line_now, flash_age, Ring10),
      reel20: reel_look(c, throwing, pulse, line_now, flash_age, Ring20),
      reel30: reel_look(c, throwing, pulse, line_now, flash_age, Ring30),
      reel40: reel_look(c, throwing, pulse, line_now, flash_age, Ring40),
      reel50: reel_look(c, throwing, pulse, line_now, flash_age, Ring50),
      reel_left: reel_look(c, throwing, pulse, line_now, flash_age, PocketLeft),
      reel_right: reel_look(c, throwing, pulse, line_now, flash_age, PocketRight)
    }
  end

  pfn reel_look(c : ReelCue, throwing : Bool, pulse : Float, line_now : Float, flash_age : PerReel(Option(Float)), h : Hole) : ReelLook needs () do
    let reel = Skee.Scoring.reel(c.setup, h)
    let n = List.length(reel)
    let pos =
      match Skee.HoleMap.reel_at(c.positions, h) do
      Some(x) -> x
      None -> 0.0
      end
    let idx = (float_round(pos) % n + n) % n
    let sym =
      match List.nth_opt(reel, idx) do
      Some(x) -> x
      None -> Blank
      end
    let held = List.length(c.have)
    let line_glow =
      if held > 0 && held < 3 && throwing do
        if Skee.Scoring.added_mult(Skee.Scoring.evaluate(List.append(c.have, [sym]))) -. line_now > 0.0 do
          if held == 2 do 2.0 else 1.0 end
        else
          0.0
        end
      else
        0.0
      end
    let age =
      match Skee.HoleMap.reel_at(flash_age, h) do
      Some(a) -> a
      None -> None
      end
    let glow =
      match age do
      Some(a) -> if a < 0.6 do max_float(line_glow, 2.0) else line_glow end
      None -> line_glow
      end
    let hits =
      match c.slot do
      Some(t) -> Skee.Scoring.hits(t, sym)
      None -> 0
      end
    let shown_pulse =
      match age do
      Some(a) -> if a < 0.6 do 1.0 -. a /. 0.6 +. 0.3 else pulse end
      None -> pulse
      end
    {
      symbol: sym,
      turn: pos,
      glow: glow,
      slot_match: throwing && hits > 0,
      pulse: shown_pulse
    }
  end

  pfn flash_drop(ages : PerReel(Option(Float)), s : Spark) : PerReel(Option(Float)) needs () do
    match s do
    SparkDrop(h) -> put_reel(ages, h, Some(0.0))
    SparkHump -> ages
    SparkLip -> ages
    SparkHop -> ages
    SparkLanded -> ages
    SparkBackwall -> ages
    SparkRail -> ages
    end
  end

  pfn put_reel(m : PerReel(a), h : Hole, x : a) : PerReel(a) needs () do
    match h do
    Ring10 -> { m with reel10: x }
    Ring20 -> { m with reel20: x }
    Ring30 -> { m with reel30: x }
    Ring40 -> { m with reel40: x }
    Ring50 -> { m with reel50: x }
    PocketLeft -> { m with reel_left: x }
    PocketRight -> { m with reel_right: x }
    Gutter -> m
    end
  end

  pfn age_flashes(m : PerReel(Option(Float)), dt : Float) : PerReel(Option(Float)) needs () do
    {
      reel10: age_flash(m.reel10, dt),
      reel20: age_flash(m.reel20, dt),
      reel30: age_flash(m.reel30, dt),
      reel40: age_flash(m.reel40, dt),
      reel50: age_flash(m.reel50, dt),
      reel_left: age_flash(m.reel_left, dt),
      reel_right: age_flash(m.reel_right, dt)
    }
  end

  pfn age_flash(a : Option(Float), dt : Float) : Option(Float) needs () do
    match a do
    Some(x) -> Some(x +. dt)
    None -> None
    end
  end

  doc """Nothing remembered yet: a fresh ScenePresenter."""
  fn keep_fresh() : Keep needs () do
    {
      motion: { orientation: quat_identity(), last: None, spin: origin(), pop: 0.0 },
      lean: 0.0,
      waves: [],
      flash_age: Skee.HoleMap.fill_reels(None)
    }
  end

  doc """
  ScenePresenter.update: one frame. Returns the scene to draw and what to
  keep for the next frame. `rig` is the fitted camera (Skee.Camera.fit_world).
  """
  fn present(w : World, palette : Skee.Rooms.CabinetPalette, rig : Arcade.Camera.Rig, v : Arcade.Camera.Viewport, keep : Keep, c : FrameCue, dt : Float) : (Scenery, Keep) needs () do
    let bc = c.ball_cue
    let place = place_ball(w, bc)
    let moved = roll_on(w, keep.motion, place, dt)
    let shadow = shadow_place(w, bc, place)
    let drawn = { place: place, motion: moved, kind: c.kind, shadow: shadow }
    let popped_motion = { moved with pop: List.fold_left(c.sparks, moved.pop, popped) }
    let fresh = List.flat_map(c.sparks, fn s -> shocks(w, s, place.centre, c.kind))
    let waves = age_waves(List.append(keep.waves, fresh), dt)
    let dropped = List.fold_left(c.sparks, keep.flash_age, flash_drop)
    let ages = age_flashes(dropped, dt)
    let throwing = bc.throwing
    let in_flight = bc.busy && bc.beat_is_roll
    let held =
      match bc.held do
      Some(_) -> true
      None -> false
      end
    let lean = Skee.Camera.lean_step(keep.lean, c.anticipation, dt)
    let scene =
      {
        world: w,
        palette: palette,
        viewport: v,
        camera: Skee.Camera.framed(w, rig, lean, c.shake, bc.clock),
        ball: drawn,
        waiting: waiting_count(c.balls_left, held, in_flight, bc.busy, throwing),
        reels: reel_looks(c.reel_cue, throwing, bc.clock, ages),
        bulbs: bulb_light(c.excited, bc.clock),
        waves: waves
      }
    let kept = { motion: popped_motion, lean: lean, waves: waves, flash_age: ages }
    pair(scene, kept)
  end

  -- A tuple after a record literal would parse as a call of the record.
  pfn pair(a : Scenery, b : Keep) : (Scenery, Keep) needs () do
    (a, b)
  end

  -- ===================================================================
  -- Painting: parts to draw operations
  -- ===================================================================
  -- What every painter needs: the camera for this viewport, where the eye is,
  -- and how many pixels one unit of Toon outline thickness is. The inverted
  -- hull grows with distance, so an outline keeps one screen width:
  -- thick * height / (40 * tan(fov / 2)).
  type Brush = {
    k : Skee.Consts.Consts,
    lens : Arcade.Camera.Projection,
    eye : Vec3,
    ink_px : Float
  }

  fn brush(k : Skee.Consts.Consts, s : Scenery) : Brush needs () do
    let l = Arcade.Camera.projection(k.num, s.camera, s.viewport)
    {
      k: k,
      lens: l,
      eye: s.camera.pose.eye,
      ink_px: l.height /. (40.0 *. l.half)
    }
  end

  pfn px(b : Brush, p : Vec3) : Vec2 needs () do
    Arcade.Camera.pixel(b.k.num, b.lens, p)
  end

  pfn depth(b : Brush, p : Vec3) : Float needs () do
    let s = Arcade.Camera.seen(b.lens, p)
    s.depth
  end

  doc """Pixels per metre at a scene point."""
  fn scale_at(b : Brush, p : Vec3) : Float needs () do
    Arcade.Camera.pixels_per_metre(b.lens, depth(b, p))
  end

  pfn to_eye(b : Brush, p : Vec3) : Vec3 needs () do
    minus(b.eye, p)
  end

  -- Nothing nearer than SceneKit's zNear is drawn.
  pfn z_near() : Float needs () do
    0.05
  end

  -- Sutherland-Hodgman against the near plane, in camera space.
  pfn clip_edge(a : Arcade.Camera.Seen, c : Arcade.Camera.Seen) : List(Arcade.Camera.Seen) needs () do
    let n = z_near()
    let a_in = a.depth >= n
    let c_in = c.depth >= n
    if a_in && c_in do
      [c]
    else
      if a_in do
        [near_cut(a, c)]
      else
        if c_in do [near_cut(a, c), c] else [] end
      end
    end
  end

  -- Where an edge crosses the near plane. Only called when it does, so the
  -- depths differ.
  pfn near_cut(a : Arcade.Camera.Seen, c : Arcade.Camera.Seen) : Arcade.Camera.Seen needs () do
    let n = z_near()
    let t = (n -. a.depth) /. (c.depth -. a.depth)
    {
      across: a.across +. (c.across -. a.across) *. t,
      rise: a.rise +. (c.rise -. a.rise) *. t,
      depth: n
    }
  end

  pfn ring_pairs(xs : List(a)) : List((a, a)) needs () do
    match xs do
    Nil -> []
    Cons(first, _) -> List.zip(xs, List.append(List.drop(xs, 1), [first]))
    end
  end

  doc """A scene polygon in pixels, clipped to what is in front of the camera."""
  fn polygon(b : Brush, pts : List(Vec3)) : List(Vec2) needs () do
    let seen = List.map(pts, fn p -> Arcade.Camera.seen(b.lens, p))
    let clipped =
      if List.all(seen, fn s -> s.depth >= z_near()) do
        seen
      else
        List.flat_map(ring_pairs(seen), fn e -> clip_pair(e))
      end
    List.map(clipped, fn s -> Arcade.Camera.pixel_of_seen(b.k.num, b.lens, s))
  end

  pfn clip_pair(e : (Arcade.Camera.Seen, Arcade.Camera.Seen)) : List(Arcade.Camera.Seen) needs () do
    match e do
    (a, c) -> clip_edge(a, c)
    end
  end

  -- Andrew's monotone chain: the outline of a solid seen from the camera.
  pfn turn_sign(o : Vec2, a : Vec2, c : Vec2) : Float needs () do
    (a.x -. o.x) *. (c.y -. o.y) -. (a.y -. o.y) *. (c.x -. o.x)
  end

  pfn half_hull(pts : List(Vec2), acc : List(Vec2)) : List(Vec2) needs () do
    match pts do
    Nil -> acc
    Cons(p, rest) -> half_hull(rest, Cons(p, pop_right_turns(acc, p)))
    end
  end

  pfn pop_right_turns(acc : List(Vec2), p : Vec2) : List(Vec2) needs () do
    match acc do
    Cons(a, Cons(o, more)) -> do
      if turn_sign(o, a, p) <= 0.0 do
        pop_right_turns(Cons(o, more), p)
      else
        acc
      end
    end
    _ -> acc
    end
  end

  doc """The convex hull of points, counter-clockwise in y-up terms."""
  fn hull(pts : List(Vec2)) : List(Vec2) needs () do
    let sorted = List.sort_by(pts, fn (a, c) -> a.x < c.x || a.x == c.x && a.y <= c.y)
    let lower = half_hull(sorted, [])
    let upper = half_hull(List.reverse(sorted), [])
    List.append(List.reverse(List.drop(lower, 1)), List.reverse(List.drop(upper, 1)))
  end

  pfn pen(c : Rgba, width : Float) : Pen needs () do
    { ink: c, width: width, ends: RoundEnd, corners: RoundCorner }
  end

  pfn butt_pen(c : Rgba, width : Float) : Pen needs () do
    { ink: c, width: width, ends: ButtEnd, corners: RoundCorner }
  end

  pfn fill(sh : Shape, c : Rgba) : DrawOp needs () do
    FillShape(sh, Flat(c), Over)
  end

  -- The ink silhouette: an outward stroke under the fill.
  pfn ink_outline(b : Brush, sh : Shape, thick : Float) : List(DrawOp) needs () do
    if thick > 0.0 do
      [StrokeShape(sh, pen(ink(), 2.0 *. thick *. b.ink_px), Over)]
    else
      []
    end
  end

  pfn circle_points(f : Frame, radius : Float, y : Float, n : Int) : List(Vec3) needs () do
    List.map(List.range(0, n), fn i -> apply(f, circle_at(radius, y, i, n)))
  end

  -- A point on a circle in the local xz-plane (the axis of SceneKit's
  -- cylinders, tori and tubes is local y).
  pfn circle_at(radius : Float, y : Float, i : Int, n : Int) : Vec3 needs () do
    let a = 6.283185307 *. int_to_float(i) /. int_to_float(n)
    v3(radius *. Math.cos(a), y, radius *. Math.sin(a))
  end

  pfn axis_normal(f : Frame) : Vec3 needs () do
    unit(f.ay)
  end

  pfn colour_or(c : Option(Rgba), fallback : Rgba) : Rgba needs () do
    match c do
    Some(x) -> x
    None -> fallback
    end
  end

  -- An affine map taking texture (0,0), (w,0) and (0,h) to three pixels.
  pfn texture_map(o : Vec2, along_u : Vec2, along_v : Vec2, w : Float, h : Float) : Affine needs () do
    {
      a: (along_u.x -. o.x) /. w,
      b: (along_u.y -. o.y) /. w,
      c: (along_v.x -. o.x) /. h,
      d: (along_v.y -. o.y) /. h,
      e: o.x,
      f: o.y
    }
  end

  pfn identity_affine() : Affine needs () do
    { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
  end

  doc """The CSS font for Textures.text's AvenirNext-Heavy at a size."""
  fn heavy_font(size : Float) : String needs () do
    "900 " ++ css_number(size) ++ "px 'Avenir Next', Avenir, Nunito, 'Arial Rounded MT Bold', sans-serif"
  end

  -- ---- Boxes ----
  -- A box face: its four local corners (as signs) and outward normal.
  type BoxFace = { corners : List(Vec3), outward : Vec3 }

  pfn box_faces() : List(BoxFace) needs () do
    [
      {
        corners: [
          v3(1.0, -1.0, 1.0),
          v3(1.0, -1.0, -1.0),
          v3(1.0, 1.0, -1.0),
          v3(1.0, 1.0, 1.0)
        ],
        outward: v3(1.0, 0.0, 0.0)
      },
      {
        corners: [
          v3(-1.0, -1.0, -1.0),
          v3(-1.0, -1.0, 1.0),
          v3(-1.0, 1.0, 1.0),
          v3(-1.0, 1.0, -1.0)
        ],
        outward: v3(-1.0, 0.0, 0.0)
      },
      {
        corners: [
          v3(-1.0, 1.0, 1.0),
          v3(1.0, 1.0, 1.0),
          v3(1.0, 1.0, -1.0),
          v3(-1.0, 1.0, -1.0)
        ],
        outward: v3(0.0, 1.0, 0.0)
      },
      {
        corners: [
          v3(-1.0, -1.0, -1.0),
          v3(1.0, -1.0, -1.0),
          v3(1.0, -1.0, 1.0),
          v3(-1.0, -1.0, 1.0)
        ],
        outward: v3(0.0, -1.0, 0.0)
      },
      {
        corners: [
          v3(-1.0, -1.0, 1.0),
          v3(1.0, -1.0, 1.0),
          v3(1.0, 1.0, 1.0),
          v3(-1.0, 1.0, 1.0)
        ],
        outward: v3(0.0, 0.0, 1.0)
      },
      {
        corners: [
          v3(1.0, -1.0, -1.0),
          v3(-1.0, -1.0, -1.0),
          v3(-1.0, 1.0, -1.0),
          v3(1.0, 1.0, -1.0)
        ],
        outward: v3(0.0, 0.0, -1.0)
      }
    ]
  end

  pfn half(v : Vec3, w : Float, h : Float, l : Float) : Vec3 needs () do
    v3(v.x *. w /. 2.0, v.y *. h /. 2.0, v.z *. l /. 2.0)
  end

  -- The normal of a transformed face: the inverse-transpose direction,
  -- which for a node scaled along its own axes is the axis over its scale.
  pfn face_normal(f : Frame, outward : Vec3) : Vec3 needs () do
    let sx = length3(f.ax)
    let sy = length3(f.ay)
    let sz = length3(f.az)
    unit(plus(plus(times(f.ax, outward.x /. (sx *. sx)), times(f.ay, outward.y /. (sy *. sy))), times(f.az, outward.z /. (sz *. sz))))
  end

  pfn paint_box(b : Brush, p : Part, w : Float, h : Float, l : Float) : List(DrawOp) needs () do
    let corners =
      List.map([v3(-1.0, -1.0, -1.0), v3(1.0, -1.0, -1.0), v3(1.0, 1.0, -1.0), v3(-1.0, 1.0, -1.0), v3(-1.0, -1.0, 1.0), v3(1.0, -1.0, 1.0), v3(1.0, 1.0, 1.0), v3(-1.0, 1.0, 1.0)], fn c -> apply(p.frame, half(c, w, h, l)))
    let silhouette = Poly(hull(List.map(corners, fn c -> px(b, c))))
    let faces = List.flat_map(box_faces(), fn face -> paint_face(b, p, w, h, l, face))
    List.append(ink_outline(b, silhouette, p.outline), faces)
  end

  pfn paint_face(b : Brush, p : Part, w : Float, h : Float, l : Float, face : BoxFace) : List(DrawOp) needs () do
    let pts = List.map(face.corners, fn c -> apply(p.frame, half(c, w, h, l)))
    let centre = apply(p.frame, half(face.outward, w, h, l))
    let n = face_normal(p.frame, face.outward)
    if dot3(n, to_eye(b, centre)) > 0.0 do
      do
        let lit = light(n, to_eye(b, centre))
        let outline = polygon(b, pts)
        match p.skin do
        LaneWood -> do
          if face.outward.y > 0.5 do
            paint_lane_wood(b, p, w, h, l, lit, outline)
          else
            [
              fill(Poly(outline), shade(colour_or(p.colour, hex(15185274)), lit))
            ]
          end
        end
        BadgeSkin(value, special) -> do
          if face.outward.z > 0.5 do
            paint_badge(b, p, w, h, l, lit, outline, value, special)
          else
            [fill(Poly(outline), shade(trim_colour(special), lit))]
          end
        end
        Painted -> [fill(Poly(outline), shade(colour_or(p.colour, ink()), lit))]
        BallSkin(_) -> [fill(Poly(outline), shade(colour_or(p.colour, ink()), lit))]
        PitSkin -> [fill(Poly(outline), shade(colour_or(p.colour, ink()), lit))]
        CoinSkin(_) -> [fill(Poly(outline), shade(colour_or(p.colour, ink()), lit))]
        BlobSkin -> []
        HaloSkin -> []
        end
      end
    else
      []
    end
  end

  -- A point on the top face of a slab from lane-texture pixels: u across
  -- (0...512), v from the release end (0) to the hinge (2048). The lane's
  -- contentsTransform flips v, which puts the arrows a third of the way up.
  pfn lane_uv(p : Part, w : Float, h : Float, l : Float, u : Float, v : Float) : Vec3 needs () do
    apply(p.frame, v3(-w /. 2.0 +. u /. 512.0 *. w, h /. 2.0, l /. 2.0 -. v /. 2048.0 *. l))
  end

  -- One maple board's tone and its three grain streaks, drawn from the
  -- texture's SplitMix64(seed: 11) in Swift's order.
  type Plank = { tone : Float, streaks : List((Float, Float, Float)) }

  pfn plank(k : Skee.Consts.Consts, r : Arcade.Rng.Rng) : (Plank, Arcade.Rng.Rng) needs () do
    let (tone, r1) = Arcade.Rng.next_unit(k.num, r)
    let (a, r2) = streak(k, r1)
    let (c, r3) = streak(k, r2)
    let (d, r4) = streak(k, r3)
    ({ tone: tone, streaks: [a, c, d] }, r4)
  end

  pfn streak(k : Skee.Consts.Consts, r : Arcade.Rng.Rng) : ((Float, Float, Float), Arcade.Rng.Rng) needs () do
    let (x, r1) = Arcade.Rng.next_unit(k.num, r)
    let (y0, r2) = Arcade.Rng.next_unit(k.num, r1)
    let (len_, r3) = Arcade.Rng.next_unit(k.num, r2)
    ((x, y0, len_), r3)
  end

  pfn planks(k : Skee.Consts.Consts, r : Arcade.Rng.Rng, n : Int) : List(Plank) needs () do
    if n <= 0 do
      []
    else
      do
        let (one, next) = plank(k, r)
        Cons(one, planks(k, next, n - 1))
      end
    end
  end

  doc """Textures.lane's nine boards: tone and grain, deterministic."""
  fn lane_planks(k : Skee.Consts.Consts) : List(Plank) needs () do
    planks(k, Arcade.Rng.seed(Arcade.U64.make(0, 11)), 9)
  end

  doc """Textures.lane's maple: the base fill, and where every board's tone starts."""
  fn lane_wood() : Rgba needs () do
    hex(15906930)
  end

  doc """Each of Textures.lane's nine boards: the maple mixed toward 0xE5A35E."""
  fn lane_plank_tones(k : Skee.Consts.Consts) : List(Rgba) needs () do
    List.map(lane_planks(k), plank_tone)
  end

  pfn plank_tone(pl : Plank) : Rgba needs () do
    mix(lane_wood(), hex(15049566), pl.tone *. 0.6)
  end

  -- ---- Texture marks ----
  -- A Textures.swift image as the marks its CGContext draws, in the image's
  -- pixels (y down), in drawing order. The draw paints a texture from its
  -- marks, and `texel` reads a pixel back from the same marks, so the scene
  -- suite can hold both against the real images.
  type Mark =
    MarkFill(List(Vec2), Rgba)
    | MarkLines(List((Vec2, Vec2)), Float, Rgba)
    | MarkEdge(List(Vec2), Float, Rgba)
    | MarkRing(Vec2, Float, Float, Rgba)
    | Undrawn(Vec2, Vec2, Float)

  -- MarkFill: a convex polygon, filled. MarkLines: butt-capped segments of
  -- that width stroked as one path, so where they cross they paint once. MarkEdge: a closed outline stroked with round joins.
  -- MarkRing: a circle (centre, radius) stroked at that width. Undrawn: a
  -- butt-capped stroke Swift paints and the port leaves out (docs/PORT.md,
  -- deviations), so `texel` reads its pixels as unknown.
  -- A pixel read back from marks: premultiplied 0...255 channels, alpha
  -- 0...1, whether every mark edge near it is at least `texel_margin` away
  -- (or buried under an opaque mark), so antialiasing cannot touch it, and
  -- the index of the last mark that covered it (-1: the base).
  type Texel = {
    tr : Float,
    tg : Float,
    tb : Float,
    ta : Float,
    clean : Bool,
    top : Int
  }

  doc """
  How far from a stroke's edge a pixel centre must be to be compared: half
  a pixel's diagonal, so the whole pixel is on one side.
  """
  fn texel_margin() : Float needs () do
    0.7072
  end

  -- A mark with the box outside which it cannot reach a pixel, edge
  -- margin included, worked out once so a texel skips the far marks.
  type Placed = { mark : Mark, index : Int, lo : Vec2, hi : Vec2 }

  doc """Marks ready for `texel`: each with its index and reach."""
  fn place_marks(marks : List(Mark)) : List(Placed) needs () do
    List.map(List.enumerate(marks), placed)
  end

  pfn placed(e : (Int, Mark)) : Placed needs () do
    match e do
    (i, m) -> do
      let (pts, reach) = mark_extent(m)
      let r = reach +. texel_margin()
      let lo =
        List.fold_left(pts, vec2(1000000000.0, 1000000000.0), fn (a, q) -> vec2(min_float(a.x, q.x -. r), min_float(a.y, q.y -. r)))
      let hi =
        List.fold_left(pts, vec2(-1000000000.0, -1000000000.0), fn (a, q) -> vec2(max_float(a.x, q.x +. r), max_float(a.y, q.y +. r)))
      { mark: m, index: i, lo: lo, hi: hi }
    end
    end
  end

  -- The points a mark is built on, and how far past them it paints.
  pfn mark_extent(m : Mark) : (List(Vec2), Float) needs () do
    match m do
    MarkFill(pts, _) -> (pts, 0.0)
    MarkLines(segs, width, _) -> do
      (List.flat_map(segs, fn sg -> [Tuple.first(sg), Tuple.second(sg)]), width /. 2.0)
    end
    MarkEdge(pts, width, _) -> (pts, width /. 2.0)
    MarkRing(centre, radius, width, _) -> ([centre], radius +. width /. 2.0)
    Undrawn(a, z, width) -> ([a, z], width /. 2.0)
    end
  end

  doc """The pixel at `q` after painting `marks` over `base`."""
  fn texel(base : Rgba, marks : List(Mark), q : Vec2) : Texel needs () do
    texel_placed(base, place_marks(marks), q)
  end

  doc """`texel` over marks already placed with `place_marks`."""
  fn texel_placed(base : Rgba, marks : List(Placed), q : Vec2) : Texel needs () do
    let a = base.alpha
    let start =
      {
        tr: int_to_float(base.red) *. a,
        tg: int_to_float(base.green) *. a,
        tb: int_to_float(base.blue) *. a,
        ta: a,
        clean: true,
        top: -1
      }
    List.fold_left(marks, start, fn (t, pm) -> placed_over(t, pm, q))
  end

  pfn placed_over(t : Texel, pm : Placed, q : Vec2) : Texel needs () do
    if q.x < pm.lo.x || q.x > pm.hi.x || q.y < pm.lo.y || q.y > pm.hi.y do
      t
    else
      mark_over(t, pm.index, pm.mark, q)
    end
  end

  -- Where a point is against a mark: deep inside, deep outside, or near
  -- enough an edge that antialiasing may reach it.
  type Cover = DeepIn | DeepOut | NearEdge

  derive Eq for Cover

  pfn cover_of(inside : Bool, edge : Float) : Cover needs () do
    if edge < texel_margin() do
      NearEdge
    else
      if inside do DeepIn else DeepOut end
    end
  end

  pfn mark_over(t : Texel, i : Int, m : Mark, q : Vec2) : Texel needs () do
    match m do
    MarkFill(pts, c) -> paint_texel(t, i, polygon_cover(pts, q), c)
    MarkLines(segs, width, c) -> do
      paint_texel(t, i, union_cover(List.map(segs, fn sg -> polygon_cover(segment_box(Tuple.first(sg), Tuple.second(sg), width), q))), c)
    end
    MarkEdge(pts, width, c) -> do
      let d = outline_distance(pts, q)
      paint_texel(t, i, cover_of(d < width /. 2.0, Math.abs(d -. width /. 2.0)), c)
    end
    MarkRing(centre, radius, width, c) -> do
      let d = Math.abs(Arcade.Vec2.length(Arcade.Vec2.sub(q, centre)) -. radius)
      paint_texel(t, i, cover_of(d < width /. 2.0, Math.abs(d -. width /. 2.0)), c)
    end
    Undrawn(a, z, width) -> do
      match polygon_cover(segment_box(a, z, width), q) do
      DeepOut -> t
      DeepIn -> { t with clean: false }
      NearEdge -> { t with clean: false }
      end
    end
    end
  end

  pfn paint_texel(t : Texel, i : Int, cov : Cover, c : Rgba) : Texel needs () do
    match cov do
    DeepOut -> t
    NearEdge -> { t with clean: false }
    DeepIn -> do
      let a = c.alpha
      let keep = 1.0 -. a
      {
        tr: int_to_float(c.red) *. a +. t.tr *. keep,
        tg: int_to_float(c.green) *. a +. t.tg *. keep,
        tb: int_to_float(c.blue) *. a +. t.tb *. keep,
        ta: a +. t.ta *. keep,
        clean: t.clean || a >= 1.0,
        top: i
      }
    end
    end
  end

  -- One path's strokes together: inside if any covers the pixel, outside
  -- if all miss it.
  pfn union_cover(covers : List(Cover)) : Cover needs () do
    if List.any(covers, fn c -> c == DeepIn) do
      DeepIn
    else
      if List.all(covers, fn c -> c == DeepOut) do DeepOut else NearEdge end
    end
  end

  -- A butt-capped stroke's area: the segment widened to a rectangle.
  pfn segment_box(a : Vec2, z : Vec2, width : Float) : List(Vec2) needs () do
    let d = Arcade.Vec2.normalized(Arcade.Vec2.sub(z, a))
    let n = Arcade.Vec2.scale(vec2(0.0 -. d.y, d.x), width /. 2.0)
    [
      Arcade.Vec2.add(a, n),
      Arcade.Vec2.add(z, n),
      Arcade.Vec2.sub(z, n),
      Arcade.Vec2.sub(a, n)
    ]
  end

  -- A convex area covers the pixel centred on `q` when all four of its
  -- corners are inside, and misses it when the centre is a margin outside.
  pfn polygon_cover(pts : List(Vec2), q : Vec2) : Cover needs () do
    let corners =
      [
        vec2(q.x -. 0.5, q.y -. 0.5),
        vec2(q.x +. 0.5, q.y -. 0.5),
        vec2(q.x +. 0.5, q.y +. 0.5),
        vec2(q.x -. 0.5, q.y +. 0.5)
      ]
    if List.all(corners, fn c -> inside_convex(pts, c)) do
      DeepIn
    else
      if !inside_convex(pts, q) && outline_distance(pts, q) >= texel_margin() do
        DeepOut
      else
        NearEdge
      end
    end
  end

  -- Each edge of a closed outline, as (from, to).
  pfn edges_of(pts : List(Vec2)) : List((Vec2, Vec2)) needs () do
    match pts do
    Cons(first, _) -> List.zip(pts, List.append(List.drop(pts, 1), [first]))
    Nil -> []
    end
  end

  pfn edge_cross(e : (Vec2, Vec2), q : Vec2) : Float needs () do
    match e do
    (a, z) -> do
      let d = Arcade.Vec2.sub(z, a)
      let r = Arcade.Vec2.sub(q, a)
      d.x *. r.y -. d.y *. r.x
    end
    end
  end

  pfn inside_convex(pts : List(Vec2), q : Vec2) : Bool needs () do
    let crosses = List.map(edges_of(pts), fn e -> edge_cross(e, q))
    List.all(crosses, fn c -> c > 0.0) || List.all(crosses, fn c -> c < 0.0)
  end

  pfn segment_distance(e : (Vec2, Vec2), q : Vec2) : Float needs () do
    match e do
    (a, z) -> do
      let d = Arcade.Vec2.sub(z, a)
      let len2 = Arcade.Vec2.dot(d, d)
      let t =
        if len2 == 0.0 do
          0.0
        else
          Arcade.Num.clamp(Arcade.Vec2.dot(Arcade.Vec2.sub(q, a), d) /. len2, 0.0, 1.0)
        end
      Arcade.Vec2.length(Arcade.Vec2.sub(q, Arcade.Vec2.add(a, Arcade.Vec2.scale(d, t))))
    end
    end
  end

  pfn outline_distance(pts : List(Vec2), q : Vec2) : Float needs () do
    List.fold_left(edges_of(pts), 1000000000.0, fn (m, e) -> min_float(m, segment_distance(e, q)))
  end

  -- ---- Textures.lane ----
  doc """Textures.lane's size in pixels: u across, v from the hinge end down."""
  fn lane_texture_size() : Vec2 needs () do
    vec2(512.0, 2048.0)
  end

  doc """
  Textures.lane's marks over its maple: each board's tone and three grain
  streaks, the eight seams, then the five arrows (fill, then ink edge).
  """
  fn lane_marks(k : Skee.Consts.Consts) : List(Mark) needs () do
    let size = lane_texture_size()
    let bw = size.x /. 9.0
    let boards =
      List.flat_map(List.enumerate(lane_planks(k)), fn e -> plank_marks(bw, size.y, e))
    let seams =
      MarkLines(List.map(List.range(1, 9), fn i -> (vec2(int_to_float(i) *. bw, 0.0), vec2(int_to_float(i) *. bw, size.y))), 3.0, hex(13208398))
    let arrows =
      List.flat_map(List.enumerate([-2.0, -1.0, 0.0, 1.0, 2.0]), fn e -> arrow_marks(size, bw, e))
    List.concat([boards, [seams], arrows])
  end

  pfn plank_marks(bw : Float, height : Float, e : (Int, Plank)) : List(Mark) needs () do
    match e do
    (i, pl) -> do
      let x0 = int_to_float(i) *. bw
      let board_fill =
        MarkFill([vec2(x0, 0.0), vec2(x0 +. bw, 0.0), vec2(x0 +. bw, height), vec2(x0, height)], plank_tone(pl))
      [
        board_fill,
        MarkLines(List.map(pl.streaks, fn st -> grain_segment(x0, bw, height, st)), 2.0, with_alpha(hex(14723174), 0.55))
      ]
    end
    end
  end

  pfn grain_segment(x0 : Float, bw : Float, height : Float, st : (Float, Float, Float)) : (Vec2, Vec2) needs () do
    match st do
    (ux, vy, len_) -> do
      let x = x0 +. ux *. bw
      let y0 = vy *. height
      (vec2(x, y0), vec2(x +. 3.0, y0 +. 300.0 +. len_ *. 400.0))
    end
    end
  end

  pfn arrow_marks(size : Vec2, bw : Float, e : (Int, Float)) : List(Mark) needs () do
    match e do
    (k_, x) -> do
      let cx = size.x /. 2.0 +. x *. bw *. 1.5
      let drop = if k_ == 2 do -0.04 else Math.abs(x) *. 0.015 end
      let tip = size.y *. (0.34 -. drop)
      let pts = [vec2(cx, tip +. 70.0), vec2(cx +. 22.0, tip), vec2(cx -. 22.0, tip)]
      [MarkFill(pts, hex(16744360)), MarkEdge(pts, 5.0, ink())]
    end
    end
  end

  doc """A Textures.lane pixel at `q`, read back from `lane_marks`."""
  fn lane_texel(k : Skee.Consts.Consts, q : Vec2) : Texel needs () do
    texel(lane_wood(), lane_marks(k), q)
  end

  -- Marks to drawing operations, through `at` (texture pixels to screen
  -- pixels) with `metre` screen pixels per texture pixel; `tint` turns a
  -- mark's colour into the painted one (lit, or faded).
  pfn paint_marks(k : Skee.Consts.Consts, at : Vec2 -> Vec2, metre : Float, tint : Rgba -> Rgba, marks : List(Mark)) : List(DrawOp) needs () do
    List.flat_map(marks, fn m -> paint_mark(k, at, metre, tint, m))
  end

  pfn paint_mark(k : Skee.Consts.Consts, at : Vec2 -> Vec2, metre : Float, tint : Rgba -> Rgba, m : Mark) : List(DrawOp) needs () do
    match m do
    MarkFill(pts, c) -> [fill(Poly(List.map(pts, at)), tint(c))]
    MarkLines(segs, width, c) -> do
      [
        StrokeShape(Outline(List.flat_map(segs, fn sg -> [MoveTo(at(Tuple.first(sg))), LineTo(at(Tuple.second(sg)))])), butt_pen(tint(c), width *. metre), Over)
      ]
    end
    MarkEdge(pts, width, c) -> [StrokeShape(Poly(List.map(pts, at)), pen(tint(c), width *. metre), Over)]
    MarkRing(centre, radius, width, c) -> do
      [
        StrokeShape(Poly(List.map(List.range(0, 40), fn i -> at(ring_point(k, centre, radius, i)))), pen(tint(c), width *. metre), Over)
      ]
    end
    Undrawn(_, _, _) -> []
    end
  end

  pfn ring_point(k : Skee.Consts.Consts, centre : Vec2, radius : Float, i : Int) : Vec2 needs () do
    let a = k.tau *. int_to_float(i) /. 40.0
    vec2(centre.x +. radius *. Math.cos(a), centre.y +. radius *. Math.sin(a))
  end

  pfn paint_lane_wood(b : Brush, p : Part, w : Float, h : Float, l : Float, lit : Light, outline : List(Vec2)) : List(DrawOp) needs () do
    let metre = scale_at(b, lane_uv(p, w, h, l, 256.0, 1024.0)) *. w /. 512.0
    let base = fill(Poly(outline), shade(lane_wood(), lit))
    Cons(base, paint_marks(b.k, fn q -> px(b, lane_uv(p, w, h, l, q.x, q.y)), metre, fn c -> shade(c, lit), lane_marks(b.k)))
  end

  -- Textures.badge on the front face: cream (gold when special) with the
  -- number in pink and ink, or ink alone on gold.
  pfn paint_badge(b : Brush, p : Part, w : Float, h : Float, l : Float, lit : Light, outline : List(Vec2), value : Int, special : Bool) : List(DrawOp) needs () do
    let frame =
      texture_map(badge_px(b, p, w, h, l, 0.0, 0.0), badge_px(b, p, w, h, l, 256.0, 0.0), badge_px(b, p, w, h, l, 0.0, 140.0), 256.0, 140.0)
    let bg = if special do hex(16763213) else hex(16775404) end
    let text_colour = if special do ink() else hex(16731501) end
    let edge = if special do None else Some(pen(shade(ink(), lit), 10.0)) end
    [
      fill(Poly(outline), shade(bg, lit)),
      DrawText({ words: int_to_string(value), font: heavy_font(112.0), middle: vec2(128.0, 70.0), fill: shade(text_colour, lit), edge: edge, frame: frame })
    ]
  end

  -- Named helpers, never let-bound lambdas: see tools/repros/lambda_tagged_int.
  pfn badge_px(b : Brush, p : Part, w : Float, h : Float, l : Float, x : Float, y : Float) : Vec2 needs () do
    px(b, apply(p.frame, v3(-w /. 2.0 +. x /. 256.0 *. w, h /. 2.0 -. y /. 140.0 *. h, l /. 2.0)))
  end

  pfn pit_px(b : Brush, p : Part, radius : Float, height : Float, u : Float, v : Float) : Vec2 needs () do
    px(b, apply(p.frame, v3((u /. 256.0 -. 0.5) *. 2.0 *. radius, height /. 2.0, (v /. 256.0 -. 0.5) *. 2.0 *. radius)))
  end

  pfn blob_px(b : Brush, p : Part, w : Float, h : Float, u : Float, v : Float) : Vec2 needs () do
    px(b, apply(p.frame, v3((u /. 128.0 -. 0.5) *. w, (0.5 -. v /. 128.0) *. h, 0.0)))
  end

  pfn ball_point(p : Part, world_r : Float, lon : Float, lat : Float) : Vec3 needs () do
    apply(p.frame, times(sphere_point(lon, lat), world_r /. length3(p.frame.ax)))
  end

  -- ---- Cylinders, tori, tubes, lips ----
  pfn paint_drum(b : Brush, p : Part, radius : Float, height : Float) : List(DrawOp) needs () do
    let thin = height *. length3(p.frame.ay) < 0.01
    if thin do
      paint_disc(b, p, radius, height)
    else
      paint_bar(b, p, radius, height)
    end
  end

  pfn paint_disc(b : Brush, p : Part, radius : Float, height : Float) : List(DrawOp) needs () do
    let top = circle_points(p.frame, radius, height /. 2.0, 48)
    let n = axis_normal(p.frame)
    let lit = light(n, to_eye(b, p.frame.at))
    let outline = polygon(b, top)
    match p.skin do
    PitSkin -> do
      let frame =
        texture_map(pit_px(b, p, radius, height, 0.0, 0.0), pit_px(b, p, radius, height, 256.0, 0.0), pit_px(b, p, radius, height, 0.0, 256.0), 256.0, 256.0)
      let stops =
        [
          { offset: 0.0, colour: shade(hex(459788), lit) },
          { offset: 0.62, colour: shade(hex(1444898), lit) },
          { offset: 1.0, colour: shade(ink(), lit) }
        ]
      [
        FillShape(Poly(outline), RadialPaint({ inner: vec2(128.0, 146.0), inner_radius: 0.0, outer: vec2(128.0, 128.0), outer_radius: 128.0, stops: stops, frame: frame }), Over)
      ]
    end
    Painted -> do
      List.append(ink_outline(b, Poly(outline), p.outline), [fill(Poly(outline), shade(colour_or(p.colour, ink()), lit))])
    end
    LaneWood -> []
    BallSkin(_) -> []
    BadgeSkin(_, _) -> []
    CoinSkin(_) -> []
    BlobSkin -> []
    HaloSkin -> []
    end
  end

  -- A long cylinder (the hump): both end circles' hull, lit from above.
  pfn paint_bar(b : Brush, p : Part, radius : Float, height : Float) : List(DrawOp) needs () do
    let ends =
      List.append(circle_points(p.frame, radius, height /. 2.0, 16), circle_points(p.frame, radius, 0.0 -. height /. 2.0, 16))
    let outline = Poly(hull(List.map(ends, fn q -> px(b, q))))
    let up = unit(to_eye(b, p.frame.at))
    let lit = light(unit(plus(up, v3(0.0, 1.0, 0.0))), up)
    List.append(ink_outline(b, outline, p.outline), [fill(outline, shade(colour_or(p.colour, ink()), lit))])
  end

  pfn paint_hoop(b : Brush, p : Part, ring : Float, pipe : Float) : List(DrawOp) needs () do
    let pts = polygon(b, circle_points(p.frame, ring, 0.0, 40))
    let width = 2.0 *. pipe *. length3(p.frame.ax) *. scale_at(b, p.frame.at)
    let lit = light(axis_normal(p.frame), to_eye(b, p.frame.at))
    let colour = shade(colour_or(p.colour, ink()), lit)
    [
      StrokeShape(Poly(pts), pen(ink(), width +. 2.0 *. p.outline *. b.ink_px), Over),
      StrokeShape(Poly(pts), pen(colour, width), Over)
    ]
  end

  pfn paint_band(b : Brush, p : Part, inner : Float, outer : Float) : List(DrawOp) needs () do
    if p.opacity <= 0.0 do
      []
    else
      do
        let colour = with_alpha(colour_or(p.colour, hex(16774832)), p.opacity)
        let outside = polygon(b, circle_points(p.frame, outer, 0.0, 40))
        if inner <= 0.0 do
          [FillShape(Poly(outside), Flat(colour), Lighter)]
        else
          [
            FillShape(Holed(outside, polygon(b, circle_points(p.frame, inner, 0.0, 40))), Flat(colour), Lighter)
          ]
        end
      end
    end
  end

  pfn paint_lip(b : Brush, p : Part, ring : Float, tube : Float, height : Float, gap_at : Float, gap_half : Float) : List(DrawOp) needs () do
    let a0 = gap_at +. gap_half
    let a1 = gap_at +. b.k.tau -. gap_half
    let n = 40
    let pts =
      List.map(List.range(0, n + 1), fn i -> px(b, apply(p.frame, lip_point(ring, height -. tube, a0 +. (a1 -. a0) *. int_to_float(i) /. int_to_float(n)))))
    let width = 2.0 *. tube *. length3(p.frame.ax) *. scale_at(b, p.frame.at)
    let lit = light(unit(p.frame.az), to_eye(b, p.frame.at))
    let colour = shade(colour_or(p.colour, ink()), lit)
    let path =
      Outline(Cons(MoveTo(first_or(pts)), List.map(List.drop(pts, 1), fn q -> LineTo(q))))
    [
      StrokeShape(path, pen(ink(), width +. 2.0 *. p.outline *. b.ink_px), Over),
      StrokeShape(path, pen(colour, width), Over)
    ]
  end

  pfn lip_point(ring : Float, z : Float, u : Float) : Vec3 needs () do
    v3(ring *. Math.cos(u), ring *. Math.sin(u), z)
  end

  pfn first_or(pts : List(Vec2)) : Vec2 needs () do
    match pts do
    Cons(p, _) -> p
    Nil -> vec2(0.0, 0.0)
    end
  end

  -- ---- Cards ----
  pfn card_corners(f : Frame, w : Float, h : Float) : List(Vec3) needs () do
    List.map([v3(-1.0, -1.0, 0.0), v3(1.0, -1.0, 0.0), v3(1.0, 1.0, 0.0), v3(-1.0, 1.0, 0.0)], fn c -> apply(f, v3(c.x *. w /. 2.0, c.y *. h /. 2.0, 0.0)))
  end

  pfn paint_card(b : Brush, p : Part, w : Float, h : Float) : List(DrawOp) needs () do
    match p.skin do
    Painted -> paint_floor(b, p, w, h)
    BlobSkin -> paint_blob(b, p, w, h)
    CoinSkin(sym) -> paint_coin(b, p, w, sym)
    LaneWood -> []
    BallSkin(_) -> []
    PitSkin -> []
    BadgeSkin(_, _) -> []
    HaloSkin -> []
    end
  end

  -- The floor, the only big flat face whose rim band shows: Toon's rim term
  -- lights the floor where it is seen at a grazing angle, far from the
  -- camera, so the near floor is a darker pool around the player's feet.
  -- Drawn as the lit far floor with rings stepping down to the unlit pool.
  pfn paint_floor(b : Brush, p : Part, w : Float, h : Float) : List(DrawOp) needs () do
    let colour = colour_or(p.colour, ink())
    let up = v3(0.0, 1.0, 0.0)
    let base = light(up, up)
    let height = b.eye.y -. p.frame.at.y
    let foot = v3(b.eye.x, p.frame.at.y, b.eye.z)
    let far =
      fill(Poly(polygon(b, card_corners(p.frame, w, h))), shade(colour, { base with rim: 0.28 }))
    let rings =
      List.map([0.75, 0.5, 0.25, 0.0], fn q -> floor_ring(b, colour, base, foot, height, q))
    Cons(far, rings)
  end

  -- The pool where the rim term has fallen to `q` of its band: rimF is
  -- 1 - height / distance on a floor seen from `height` above it.
  pfn floor_ring(b : Brush, colour : Rgba, base : Light, foot : Vec3, height : Float, q : Float) : DrawOp needs () do
    let x = 0.62 +. 0.06 *. (q +. 0.25)
    let dist = height /. (1.0 -. x)
    let r = Math.sqrt(max_float(0.0, dist *. dist -. height *. height))
    let pts = List.map(List.range(0, 48), fn i -> plus(foot, circle_at(r, 0.0, i, 48)))
    fill(Poly(polygon(b, pts)), shade(colour, { base with rim: smoothstep(0.62, 0.68, 0.62 +. 0.06 *. q) *. 0.28 }))
  end

  -- Textures.blob: ink at 55% fading out, under the ball.
  pfn paint_blob(b : Brush, p : Part, w : Float, h : Float) : List(DrawOp) needs () do
    let frame =
      texture_map(blob_px(b, p, w, h, 0.0, 0.0), blob_px(b, p, w, h, 128.0, 0.0), blob_px(b, p, w, h, 0.0, 128.0), 128.0, 128.0)
    let stops =
      [
        { offset: 0.0, colour: with_alpha(ink(), 0.55 *. p.opacity) },
        { offset: 1.0, colour: with_alpha(ink(), 0.0) }
      ]
    [
      FillShape(Poly(polygon(b, card_corners(p.frame, w, h))), RadialPaint({ inner: vec2(64.0, 64.0), inner_radius: 0.0, outer: vec2(64.0, 64.0), outer_radius: 64.0, stops: stops, frame: frame }), Over)
    ]
  end

  -- A reel coin: a billboard facing the camera, Textures.coin on it.
  pfn paint_coin(b : Brush, p : Part, w : Float, sym : Symbol) : List(DrawOp) needs () do
    let centre = p.frame.at
    let size = w *. length3(p.frame.ax) *. scale_at(b, centre)
    let mid = px(b, centre)
    let facing = unit(to_eye(b, centre))
    let lit = glowing(light(facing, facing), p.emission)
    coin_ops(lit, vec2(mid.x -. size /. 2.0, mid.y -. size /. 2.0), size, sym)
  end

  doc """
  Textures.coin in a square of `size` pixels at `corner`: a cream coin with a
  thick ink rim (an empty grey coin for a blank) and the symbol on it.
  """
  fn coin_ops(lit : Light, corner : Vec2, size : Float, sym : Symbol) : List(DrawOp) needs () do
    let u = size /. 256.0
    let mid = vec2(corner.x +. size /. 2.0, corner.y +. size /. 2.0)
    let face = if sym == Blank do hex(12168898) else hex(16776178) end
    let disk = fill(Disc(mid, 118.0 *. u), shade(face, lit))
    let rim =
      StrokeShape(Disc(mid, 114.0 *. u), pen(shade(ink(), lit), 16.0 *. u), Over)
    List.append([disk, rim], symbol_ops(lit, vec2(corner.x +. 44.0 *. u, corner.y +. 44.0 *. u), 168.0 *. u, sym))
  end

  -- ---- Symbols (Textures.drawSymbol) ----
  -- A symbol's square on screen: corner and side, in pixels.
  type Square = { x0 : Float, y0 : Float, side : Float, lit : Light }

  pfn sq_pt(q : Square, x : Float, y : Float) : Vec2 needs () do
    vec2(q.x0 +. x *. q.side, q.y0 +. y *. q.side)
  end

  -- An ellipse as four cubic arcs.
  pfn oval_path(cx : Float, cy : Float, rx : Float, ry : Float) : List(PathStep) needs () do
    let kx = rx *. 0.5522847
    let ky = ry *. 0.5522847
    [
      MoveTo(vec2(cx +. rx, cy)),
      CubicTo(vec2(cx +. rx, cy +. ky), vec2(cx +. kx, cy +. ry), vec2(cx, cy +. ry)),
      CubicTo(vec2(cx -. kx, cy +. ry), vec2(cx -. rx, cy +. ky), vec2(cx -. rx, cy)),
      CubicTo(vec2(cx -. rx, cy -. ky), vec2(cx -. kx, cy -. ry), vec2(cx, cy -. ry)),
      CubicTo(vec2(cx +. kx, cy -. ry), vec2(cx +. rx, cy -. ky), vec2(cx +. rx, cy)),
      ClosePath
    ]
  end

  pfn sq_circle(q : Square, x : Float, y : Float, r : Float) : List(PathStep) needs () do
    let c = sq_pt(q, x, y)
    oval_path(c.x, c.y, r *. q.side, r *. q.side)
  end

  pfn step_points(s : PathStep) : List(Vec2) needs () do
    match s do
    MoveTo(a) -> [a]
    LineTo(a) -> [a]
    QuadTo(a, c) -> [a, c]
    CubicTo(a, c, d) -> [a, c, d]
    ClosePath -> []
    end
  end

  -- CGPath.boundingBox: every point, control points included.
  pfn bounds(path : List(PathStep)) : (Vec2, Vec2) needs () do
    let pts = List.flat_map(path, step_points)
    let lo =
      List.fold_left(pts, vec2(1000000000.0, 1000000000.0), fn (a, p) -> vec2(min_float(a.x, p.x), min_float(a.y, p.y)))
    let hi =
      List.fold_left(pts, vec2(-1000000000.0, -1000000000.0), fn (a, p) -> vec2(max_float(a.x, p.x), max_float(a.y, p.y)))
    (lo, hi)
  end

  -- drawSymbol's shape(): fill, a hard highlight clipped to the shape, ink.
  pfn sym_shape(q : Square, path : List(PathStep), colour : Rgba, highlight : Bool) : List(DrawOp) needs () do
    let line = q.side *. 0.045
    let body = fill(Outline(path), shade(colour, q.lit))
    let shine = if highlight do sym_highlight(q, path, colour) else [] end
    let edge =
      StrokeShape(Outline(path), { ink: shade(ink(), q.lit), width: line, ends: ButtEnd, corners: RoundCorner }, Over)
    List.concat([[body], shine, [edge]])
  end

  pfn sym_highlight(q : Square, path : List(PathStep), colour : Rgba) : List(DrawOp) needs () do
    let (lo, hi) = bounds(path)
    let w = hi.x -. lo.x
    let h = hi.y -. lo.y
    let rx = w *. 0.38 /. 2.0
    let ry = h *. 0.28 /. 2.0
    let spot = oval_path(lo.x +. w *. 0.12 +. rx, lo.y +. h *. 0.1 +. ry, rx, ry)
    [
      PushClip(Outline(path)),
      fill(Outline(spot), shade(lighter(colour, 0.45), q.lit)),
      PopClip
    ]
  end

  -- drawSymbol's stroke(): an ink line under a coloured one, round caps.
  pfn sym_stroke(q : Square, path : List(PathStep), colour : Rgba, width : Float) : List(DrawOp) needs () do
    let line = q.side *. 0.045
    [
      StrokeShape(Outline(path), pen(shade(ink(), q.lit), width +. line *. 2.0), Over),
      StrokeShape(Outline(path), pen(shade(colour, q.lit), width), Over)
    ]
  end

  pfn sym_text(q : Square, words : String, cx : Float, cy : Float, size : Float, colour : Rgba, outline : Float) : DrawOp needs () do
    let edge = if outline > 0.0 do Some(pen(shade(ink(), q.lit), outline)) else None end
    DrawText({ words: words, font: heavy_font(size), middle: vec2(cx, cy), fill: shade(colour, q.lit), edge: edge, frame: identity_affine() })
  end

  pfn rounded_rect(x : Float, y : Float, w : Float, h : Float, r : Float) : List(PathStep) needs () do
    let k = r *. 0.5522847
    [
      MoveTo(vec2(x +. r, y)),
      LineTo(vec2(x +. w -. r, y)),
      CubicTo(vec2(x +. w -. r +. k, y), vec2(x +. w, y +. r -. k), vec2(x +. w, y +. r)),
      LineTo(vec2(x +. w, y +. h -. r)),
      CubicTo(vec2(x +. w, y +. h -. r +. k), vec2(x +. w -. r +. k, y +. h), vec2(x +. w -. r, y +. h)),
      LineTo(vec2(x +. r, y +. h)),
      CubicTo(vec2(x +. r -. k, y +. h), vec2(x, y +. h -. r +. k), vec2(x, y +. h -. r)),
      LineTo(vec2(x, y +. r)),
      CubicTo(vec2(x, y +. r -. k), vec2(x +. r -. k, y), vec2(x +. r, y)),
      ClosePath
    ]
  end

  doc """Textures.drawSymbol in a square: flat fills, one hard highlight, ink."""
  fn symbol_ops(lit : Light, corner : Vec2, side : Float, s : Symbol) : List(DrawOp) needs () do
    let q = { x0: corner.x, y0: corner.y, side: side, lit: lit }
    let line = side *. 0.045
    match s do
    Blank -> []
    Cherry -> do
      let stems =
        [
          MoveTo(sq_pt(q, 0.3, 0.6)),
          QuadTo(sq_pt(q, 0.34, 0.28), sq_pt(q, 0.6, 0.12)),
          MoveTo(sq_pt(q, 0.7, 0.64)),
          QuadTo(sq_pt(q, 0.72, 0.34), sq_pt(q, 0.6, 0.12))
        ]
      let leaf =
        [
          MoveTo(sq_pt(q, 0.6, 0.14)),
          QuadTo(sq_pt(q, 0.8, 0.0), sq_pt(q, 0.92, 0.18)),
          QuadTo(sq_pt(q, 0.78, 0.3), sq_pt(q, 0.6, 0.14)),
          ClosePath
        ]
      List.concat([sym_stroke(q, stems, hex(6012507), side *. 0.05), sym_shape(q, leaf, hex(7328623), false), sym_shape(q, sq_circle(q, 0.3, 0.7, 0.19), hex(16731501), true), sym_shape(q, sq_circle(q, 0.7, 0.72, 0.19), hex(16731501), true)])
    end
    Lemon -> do
      let p =
        [
          MoveTo(sq_pt(q, 0.06, 0.52)),
          QuadTo(sq_pt(q, 0.16, 0.18), sq_pt(q, 0.5, 0.18)),
          QuadTo(sq_pt(q, 0.84, 0.18), sq_pt(q, 0.94, 0.48)),
          QuadTo(sq_pt(q, 0.84, 0.82), sq_pt(q, 0.5, 0.82)),
          QuadTo(sq_pt(q, 0.16, 0.82), sq_pt(q, 0.06, 0.52)),
          ClosePath
        ]
      sym_shape(q, p, hex(16769357), true)
    end
    Bell -> do
      let p =
        [
          MoveTo(sq_pt(q, 0.5, 0.1)),
          CubicTo(sq_pt(q, 0.78, 0.1), sq_pt(q, 0.72, 0.5), sq_pt(q, 0.8, 0.64)),
          QuadTo(sq_pt(q, 0.92, 0.72), sq_pt(q, 0.92, 0.78)),
          LineTo(sq_pt(q, 0.08, 0.78)),
          QuadTo(sq_pt(q, 0.08, 0.72), sq_pt(q, 0.2, 0.64)),
          CubicTo(sq_pt(q, 0.28, 0.5), sq_pt(q, 0.22, 0.1), sq_pt(q, 0.5, 0.1)),
          ClosePath
        ]
      List.append(sym_shape(q, sq_circle(q, 0.5, 0.84, 0.09), hex(14719546), false), sym_shape(q, p, hex(16761405), true))
    end
    BarSym -> do
      let plate =
        rounded_rect(q.x0, q.y0 +. side *. 0.26, side, side *. 0.48, side *. 0.08)
      List.append(sym_shape(q, plate, ink(), false), [sym_text(q, "BAR", q.x0 +. side /. 2.0, q.y0 +. side /. 2.0, side *. 0.34, hex(16775404), 0.0)])
    end
    Seven -> do
      [
        sym_text(q, "7", q.x0 +. side /. 2.0, q.y0 +. side /. 2.0, side, hex(16726876), line *. 1.6)
      ]
    end
    Diamond -> do
      let outer =
        [
          MoveTo(sq_pt(q, 0.5, 0.06)),
          LineTo(sq_pt(q, 0.94, 0.4)),
          LineTo(sq_pt(q, 0.5, 0.94)),
          LineTo(sq_pt(q, 0.06, 0.4)),
          ClosePath
        ]
      let facets =
        [
          MoveTo(sq_pt(q, 0.06, 0.4)),
          LineTo(sq_pt(q, 0.94, 0.4)),
          MoveTo(sq_pt(q, 0.3, 0.4)),
          LineTo(sq_pt(q, 0.5, 0.94)),
          MoveTo(sq_pt(q, 0.7, 0.4)),
          LineTo(sq_pt(q, 0.5, 0.94)),
          MoveTo(sq_pt(q, 0.3, 0.4)),
          LineTo(sq_pt(q, 0.5, 0.06)),
          MoveTo(sq_pt(q, 0.7, 0.4)),
          LineTo(sq_pt(q, 0.5, 0.06))
        ]
      let shine =
        [
          MoveTo(sq_pt(q, 0.5, 0.1)),
          LineTo(sq_pt(q, 0.62, 0.38)),
          LineTo(sq_pt(q, 0.38, 0.38)),
          ClosePath
        ]
      List.concat([sym_shape(q, outer, hex(5103871), false), [StrokeShape(Outline(facets), butt_pen(with_alpha(shade(ink(), lit), 0.7), line *. 0.6), Over), fill(Outline(shine), with_alpha(shade(hex(16777215), lit), 0.8))]])
    end
    Clover -> do
      let stem =
        [
          MoveTo(sq_pt(q, 0.5, 0.52)),
          QuadTo(sq_pt(q, 0.5, 0.82), sq_pt(q, 0.68, 0.94))
        ]
      let leaves =
        List.flat_map([(0.5, 0.27), (0.27, 0.48), (0.73, 0.48), (0.5, 0.68)], fn c -> clover_leaf(q, c))
      List.append(sym_stroke(q, stem, hex(4173658), side *. 0.06), leaves)
    end
    end
  end

  pfn clover_leaf(q : Square, c : (Float, Float)) : List(DrawOp) needs () do
    match c do
    (x, y) -> sym_shape(q, sq_circle(q, x, y, 0.18), hex(6018682), true)
    end
  end

  -- ---- Spheres ----
  pfn paint_orb(b : Brush, p : Part, radius : Float) : List(DrawOp) needs () do
    let centre = p.frame.at
    let world_r = radius *. length3(p.frame.ax)
    let mid = px(b, centre)
    let r_px = world_r *. scale_at(b, centre)
    let facing = unit(to_eye(b, centre))
    let outline = ink_outline(b, Disc(mid, r_px), p.outline)
    match p.skin do
    BallSkin(kind) -> List.append(outline, ball_ops(b, p, kind, world_r, mid, r_px))
    Painted -> do
      let lit = glowing(light(unit(plus(facing, sun())), facing), p.emission)
      List.append(outline, [fill(Disc(mid, r_px), shade(colour_or(p.colour, ink()), lit))])
    end
    LaneWood -> []
    PitSkin -> []
    BadgeSkin(_, _) -> []
    CoinSkin(_) -> []
    BlobSkin -> []
    HaloSkin -> []
    end
  end

  doc """Textures.ball: six gores alternating, white caps at the poles."""
  fn stripes(kind : BallKind) : List(Rgba) needs () do
    match kind do
    Marshmallow -> do
      List.map([16777215, 16767464, 16777215, 16767464, 16777215, 16767464], hex)
    end
    ClassicBall -> do
      List.map([16740207, 16769986, 16740207, 16769986, 16740207, 16769986], hex)
    end
    JumpingBean -> List.map([8313978, 4173402, 8313978, 4173402, 8313978, 4173402], hex)
    Wobbler -> List.map([16731501, 16767053, 8313978, 6277375, 10191858, 16740261], hex)
    Comet -> do
      List.map([16767053, 16742938, 16727342, 16767053, 16742938, 16727342], hex)
    end
    end
  end

  doc """Textures.ball's size in pixels: longitude across, latitude down."""
  fn ball_texture_size() : Vec2 needs () do
    vec2(512.0, 256.0)
  end

  doc """Rows of Textures.ball each white polar cap takes."""
  fn ball_cap_rows() : Float needs () do
    18.0
  end

  doc """The polar caps' colour."""
  fn ball_cap_colour() : Rgba needs () do
    hex(16777215)
  end

  doc """
  Textures.ball(kind): six gores, the ink seams between them (which the
  port does not draw, docs/PORT.md), then the two white caps.
  """
  fn ball_marks(kind : BallKind) : List(Mark) needs () do
    let size = ball_texture_size()
    let gw = size.x /. 6.0
    let gores = List.map(List.enumerate(stripes(kind)), fn e -> gore_mark(gw, size.y, e))
    let seams =
      List.map(List.range(0, 6), fn i -> Undrawn(vec2(int_to_float(i) *. gw, 0.0), vec2(int_to_float(i) *. gw, size.y), 4.0))
    let cap = ball_cap_rows()
    let caps =
      [
        MarkFill([vec2(0.0, 0.0), vec2(size.x, 0.0), vec2(size.x, cap), vec2(0.0, cap)], ball_cap_colour()),
        MarkFill([vec2(0.0, size.y -. cap), vec2(size.x, size.y -. cap), vec2(size.x, size.y), vec2(0.0, size.y)], ball_cap_colour())
      ]
    List.concat([gores, seams, caps])
  end

  pfn gore_mark(gw : Float, height : Float, e : (Int, Rgba)) : Mark needs () do
    match e do
    (i, c) -> do
      let x0 = int_to_float(i) *. gw
      MarkFill([vec2(x0, 0.0), vec2(x0 +. gw +. 1.0, 0.0), vec2(x0 +. gw +. 1.0, height), vec2(x0, height)], c)
    end
    end
  end

  doc """A Textures.ball(kind) pixel at `q`, read back from `ball_marks`."""
  fn ball_texel(kind : BallKind, q : Vec2) : Texel needs () do
    texel(with_alpha(hex(0), 0.0), ball_marks(kind), q)
  end

  -- Latitude bands of the equirectangular skin: the white polar caps take
  -- `ball_cap_rows` of the texture's rows at each end (77.3 degrees and up).
  pfn bands(k : Skee.Consts.Consts) : List((Float, Float, Bool)) needs () do
    let pole = k.pi /. 2.0
    let size = ball_texture_size()
    let cap = pole -. ball_cap_rows() /. size.y *. k.pi
    [
      (0.0 -. pole, 0.0 -. cap, true),
      (0.0 -. cap, -0.45, false),
      (-0.45, 0.45, false),
      (0.45, cap, false),
      (cap, pole, true)
    ]
  end

  pfn sphere_point(lon : Float, lat : Float) : Vec3 needs () do
    v3(Math.cos(lat) *. Math.sin(lon), Math.sin(lat), Math.cos(lat) *. Math.cos(lon))
  end

  pfn ball_ops(b : Brush, p : Part, kind : BallKind, world_r : Float, mid : Vec2, r_px : Float) : List(DrawOp) needs () do
    let colours = stripes(kind)
    let facing = unit(to_eye(b, p.frame.at))
    let base = fill(Disc(mid, r_px), shade(first_colour(colours), light(facing, facing)))
    let patches = List.flat_map(List.enumerate(colours), fn e -> gore_ops(b, p, world_r, e))
    Cons(base, patches)
  end

  pfn first_colour(cs : List(Rgba)) : Rgba needs () do
    match cs do
    Cons(c, _) -> c
    Nil -> ink()
    end
  end

  pfn gore_ops(b : Brush, p : Part, world_r : Float, e : (Int, Rgba)) : List(DrawOp) needs () do
    match e do
    (i, colour) -> do
      List.flat_map(bands(b.k), fn band -> patch_op(b, p, world_r, i, colour, band))
    end
    end
  end

  pfn patch_op(b : Brush, p : Part, world_r : Float, i : Int, colour : Rgba, band : (Float, Float, Bool)) : List(DrawOp) needs () do
    match band do
    (lat0, lat1, white) -> do
      let lon0 = int_to_float(i) *. b.k.pi /. 3.0
      let lon1 = lon0 +. b.k.pi /. 3.0
      let mid_dir =
        unit(turn(p.frame, sphere_point((lon0 +. lon1) /. 2.0, (lat0 +. lat1) /. 2.0)))
      let centre = plus(p.frame.at, times(mid_dir, world_r))
      if dot3(mid_dir, to_eye(b, centre)) > 0.0 do
        do
          let edge0 =
            List.map([0.0, 0.5, 1.0], fn t -> ball_point(p, world_r, lon0, lat0 +. (lat1 -. lat0) *. t))
          let edge1 =
            List.map([1.0, 0.5, 0.0], fn t -> ball_point(p, world_r, lon1, lat0 +. (lat1 -. lat0) *. t))
          let pts = List.map(List.append(edge0, edge1), fn q -> px(b, q))
          let c = if white do ball_cap_colour() else colour end
          [fill(Poly(pts), shade(c, light(mid_dir, to_eye(b, centre))))]
        end
      else
        []
      end
    end
    end
  end

  -- ---- Waves ----
  doc """A ring of light's scale and opacity at its age (ScenePresenter.spectacle)."""
  fn wave_look(wv : Wave) : (Float, Float) needs () do
    let u = wv.age /. wave_life()
    (wv.size *. (0.15 +. u), 1.0 -. u *. u)
  end

  doc """Seconds a ring of light lives."""
  fn wave_life() : Float needs () do
    0.55
  end

  doc """Textures.wave's size in pixels (square)."""
  fn wave_texture_size() : Float needs () do
    256.0
  end

  doc """Textures.wave: a white ring, then a gold one on it, over clear."""
  fn wave_marks() : List(Mark) needs () do
    let n = wave_texture_size()
    let centre = vec2(n /. 2.0, n /. 2.0)
    let radius = (n -. 36.0) /. 2.0
    [
      MarkRing(centre, radius, 22.0, hex(16777215)),
      MarkRing(centre, radius, 10.0, hex(16767053))
    ]
  end

  doc """A Textures.wave pixel at `q`, read back from `wave_marks`."""
  fn wave_texel(q : Vec2) : Texel needs () do
    texel(with_alpha(hex(0), 0.0), wave_marks(), q)
  end

  doc """A ring of light: Textures.wave on a plane facing `facing`."""
  fn wave_ops(b : Brush, wv : Wave) : List(DrawOp) needs () do
    let (scale, opacity) = wave_look(wv)
    let f =
      quat_frame(quat_between(v3(0.0, 0.0, 1.0), wv.facing), plus(wv.spot, times(wv.facing, 0.01)), scale)
    let n = wave_texture_size()
    let ppm = scale *. scale_at(b, f.at)
    paint_marks(b.k, fn q -> px(b, apply(f, v3((q.x -. n /. 2.0) /. n, (q.y -. n /. 2.0) /. n, 0.0))), ppm /. n, fn c -> with_alpha(c, c.alpha *. opacity), wave_marks())
  end

  -- ---- Order ----
  doc """
  Painting order, back to front. SceneKit sorts by depth per pixel; this
  draws the board's layers bottom up (the top cap's underside sits behind
  the pockets' coins from the player's eye), then the side walls and bulbs,
  then the lane, the trough, and the ball last.
  """
  fn layer(r : Role) : Int needs () do
    match r do
    FloorPart -> 0
    PanelPart -> 1
    BackCap -> 2
    ZonePart -> 3
    HaloPart(_) -> 4
    PitPart -> 5
    RimPart -> 6
    LipPart -> 7
    BadgePart -> 8
    CoinPart(_) -> 9
    SideWall -> 10
    BulbPart -> 10
    BodyPart -> 11
    LaneSlab -> 12
    RailPart -> 13
    RailCap -> 14
    HumpPart -> 15
    TroughPart -> 16
    WaitingBall -> 17
    ShadowPart -> 18
    BallPart -> 19
    end
  end

  pfn paint_part(b : Brush, p : Part) : List(DrawOp) needs () do
    if p.hidden do
      []
    else
      match p.solid do
      Slab(w, h, l, _) -> paint_box(b, p, w, h, l)
      Drum(r, h) -> paint_drum(b, p, r, h)
      Orb(r) -> paint_orb(b, p, r)
      Hoop(r, pipe) -> paint_hoop(b, p, r, pipe)
      Card(w, h) -> paint_card(b, p, w, h)
      Band(i, o) -> paint_band(b, p, i, o)
      LipArc(ring, tube, height, gap_at, gap_half) -> paint_lip(b, p, ring, tube, height, gap_at, gap_half)
      end
    end
  end

  -- While the ball sinks into a hole, only what is above the board or inside
  -- the pit shows: clip to the pit and everything above its middle.
  pfn sink_clip(k : Skee.Consts.Consts, b : Brush, s : Scenery) : Option(Shape) needs () do
    let place = s.ball.place
    if place.sink > 0.0 && place.over_board do
      do
        let w = s.world
        let bf = board_frame(k, w)
        let local = turn_back(bf, place.centre)
        let h = nearest_hole(w.table.board, vec2(local.x, local.y))
        let c = Skee.Physics.hole_center(w.table.board, h)
        let pit =
          polygon(b, circle_points(flat_disc(k, bf, v3(c.x, c.y, 0.004)), pit_radius(w.table.board, h), 0.0, 32))
        let mid = px(b, apply(bf, v3(c.x, c.y, 0.0)))
        let above =
          [
            vec2(-10000.0, -10000.0),
            vec2(20000.0, -10000.0),
            vec2(20000.0, mid.y),
            vec2(-10000.0, mid.y)
          ]
        Some(Polys([wound(pit), wound(above)]))
      end
    else
      None
    end
  end

  -- Board coordinates of a scene point (the board frame has no shear).
  pfn turn_back(f : Frame, p : Vec3) : Vec3 needs () do
    let d = minus(p, f.at)
    let sx = length3(f.ax)
    v3(dot3(d, f.ax) /. (sx *. sx), dot3(d, f.ay) /. (sx *. sx), dot3(d, f.az) /. (sx *. sx))
  end

  pfn nearest_hole(board_ : BoardSpec, p : Vec2) : Hole needs () do
    let holes = Skee.HoleMap.reel_holes()
    List.fold_left(holes, Ring10, fn (best, h) -> if length(sub(Skee.Physics.hole_center(board_, h), p)) < length(sub(Skee.Physics.hole_center(board_, best), p)) do h else best end)
  end

  -- Same winding for every ring of a Polys union (non-zero fill).
  pfn wound(pts : List(Vec2)) : List(Vec2) needs () do
    let area = List.fold_left(ring_pairs(pts), 0.0, fn (a, e) -> a +. edge_area(e))
    if area < 0.0 do List.reverse(pts) else pts end
  end

  pfn edge_area(e : (Vec2, Vec2)) : Float needs () do
    match e do
    (a, c) -> a.x *. c.y -. c.x *. a.y
    end
  end

  -- Indexed part, for a stable sort.
  type Ranked = { rank : Int, index : Int, ranked : Part }

  doc """
  One frame of the alley as draw operations, back to front: the backdrop,
  then every visible part, then the rings of light.
  """
  fn draw(k : Skee.Consts.Consts, s : Scenery) : List(DrawOp) needs () do
    let b = brush(k, s)
    let parts = model(k, s)
    let ranked = List.map(List.enumerate(parts), fn e -> rank_part(e))
    let sorted =
      List.sort_by(ranked, fn (x, y) -> x.rank < y.rank || x.rank == y.rank && x.index <= y.index)
    let clip = sink_clip(k, b, s)
    let body = List.flat_map(sorted, fn r -> paint_ranked(b, clip, r))
    let waves = List.flat_map(s.waves, fn wv -> wave_ops(b, wv))
    List.concat([[ClearTo(of_rgb(s.palette.backdrop))], body, waves])
  end

  pfn rank_part(e : (Int, Part)) : Ranked needs () do
    match e do
    (i, p) -> { rank: layer(p.role), index: i, ranked: p }
    end
  end

  pfn paint_ranked(b : Brush, clip : Option(Shape), r : Ranked) : List(DrawOp) needs () do
    let ops = paint_part(b, r.ranked)
    match clip do
    Some(c) -> do
      if clipped_to_pit(r.ranked.role) do
        List.concat([[PushClip(c)], ops, [PopClip]])
      else
        ops
      end
    end
    None -> ops
    end
  end

  doc """Whether a part sinks with the ball, so a sinking ball's pit clip applies to it."""
  fn clipped_to_pit(role : Role) : Bool needs () do
    match role do
    BallPart -> true
    FloorPart -> false
    LaneSlab -> false
    RailPart -> false
    RailCap -> false
    BodyPart -> false
    HumpPart -> false
    PanelPart -> false
    ZonePart -> false
    LipPart -> false
    PitPart -> false
    RimPart -> false
    BadgePart -> false
    CoinPart(_) -> false
    HaloPart(_) -> false
    SideWall -> false
    BackCap -> false
    BulbPart -> false
    TroughPart -> false
    WaitingBall -> false
    ShadowPart -> false
    end
  end

end
