mod Skee.Guide do

  -- Meta/Guide.swift: how each part of the game works, in plain words, for when
  -- a card has gone by and you would like to read it again. It lists only what
  -- you have met, so it starts small and grows. Numbers and lists come from the
  -- rules themselves, so a change to a charm or a price cannot leave a page
  -- telling a different story.
  cap pure

  import Skee.Units

  pfn n(x : Int) : String needs () do
    int_to_string(x)
  end

  pfn tickets(t : Tickets) : String needs () do
    int_to_string(tickets_int(t))
  end

  pfn chips(c : Chips) : String needs () do
    int_to_string(chips_int(c))
  end

  pfn face(h : Hole) : String needs () do
    n(Skee.Physics.face_value(h))
  end

  doc """Guide.num: a whole multiplier prints without its decimal point."""
  fn num(x : Float) : String needs () do
    let whole = float_round(x)
    if int_to_float(whole) == x do int_to_string(whole) else float_to_string(x) end
  end

  doc """Guide.label: the symbol's raw name, capitalised."""
  fn label(s : Symbol) : String needs () do
    match s do
    Blank -> "Blank"
    Cherry -> "Cherry"
    Lemon -> "Lemon"
    Bell -> "Bell"
    BarSym -> "Bar"
    Seven -> "Seven"
    Diamond -> "Diamond"
    Clover -> "Clover"
    end
  end

  pfn topic(title : String, pages : List(String), unlocks : List(Tip)) : GuideTopic needs () do
    { topic_title: title, topic_pages: pages, topic_unlocks: unlocks }
  end

  pfn chunk(items : List(String), per : { Int | _ >= 1 }, acc : List(String)) : List(String) needs () do
    match items do
    Nil -> List.reverse(acc)
    Cons(_, _) -> chunk(List.drop(items, per), per, Cons(String.join(List.take(items, per), "\n\n"), acc))
    end
  end

  doc """Guide.list: items `per` to a page, a blank line between them."""
  fn list(title : String, items : List(String), per : { Int | _ >= 1 }, unlocks : List(Tip)) : GuideTopic needs () do
    topic(title, chunk(items, per, []), unlocks)
  end

  pfn match_line(s : Symbol) : String needs () do
    label(s) ++ ": pair +" ++ num(Skee.Scoring.pair_mult(s)) ++ ", three +" ++ num(Skee.Scoring.triple_mult(s))
  end

  pfn big_idea(c : RunConfig) : GuideTopic needs () do
    topic("The Big Idea", ["You roll balls into holes to reach a target score. Beat the target and you move on to the next round.", "A game has " ++ n(c.antes) ++ " antes, which are like levels. Each ante has 3 rounds: a warm-up, a feature game and a boss machine.", "Each round gives you " ++ n(c.frames_per_round) ++ " frames, and a frame is one turn of " ++ n(c.balls_per_frame) ++ " balls. Miss a target and that game is over, but your winnings are saved."], [])
  end

  pfn rolling() : GuideTopic needs () do
    topic("Rolling the Ball", ["Put your thumb on the dotted line, flick up and let go. Where you put your thumb is where the ball goes, and a faster flick rolls farther.", "If your thumb crosses the line on the lane, that's a foul: the ball is used up and scores nothing. Flick and let go early.", "The ball rolls up the lane, over the hump and onto the board. On a folding phone, folding it lofts the ball higher off the hump."], [])
  end

  pfn lever() : GuideTopic needs () do
    topic("The Lever", ["Every frame starts with a pull. The middle row becomes the frame's targets, the pictures you want to hit."], [])
  end

  pfn scoring() : GuideTopic needs () do
    let matches =
      String.join(Cons("What matches add to your multiplier:", List.map([Cherry, Lemon, Bell, BarSym, Clover, Seven, Diamond], match_line)), "\n")
    topic("Scoring", ["The rings pay " ++ face(Ring10) ++ ", " ++ face(Ring20) ++ ", " ++ face(Ring30) ++ ", " ++ face(Ring40) ++ " and " ++ face(Ring50) ++ " chips, and the two corner pockets pay " ++ face(PocketLeft) ++ ". The gutter pays nothing.", "Every hole also shows a picture, and your ball takes that picture. The pictures change after every ball, so look before you throw.", "A frame's three balls read as a slot line. A pair or three alike raises your multiplier. Cherries also add " ++ chips(Skee.Scoring.flat_chips(Cherry)) ++ " chips each, matched or not.", matches, "The clover is wild and matches anything except a blank.", "A frame scores chips times multiplier. Chips come from holes, cherries and line wins. The multiplier starts at 1 and everything else raises it.", "That's why a small hole with a good match can beat a big hole with none. Three frames add up to your round score."], [])
  end

  pfn counter(c : RunConfig) : GuideTopic needs () do
    let paid = c.round_tickets
    topic("Tickets and the Counter", ["Tickets are for this game only. You start with " ++ tickets(c.start_tickets) ++ ". Clearing a round pays " ++ tickets(paid.warmup) ++ ", " ++ tickets(paid.feature) ++ " or " ++ tickets(paid.boss_round) ++ ", and a boss pays the most.", "Beat the target by half again and you get a bonus ticket, up to " ++ n(c.overkill_cap) ++ ". You also get 1 for every " ++ n(c.interest_per) ++ " you're holding, up to " ++ n(c.interest_cap) ++ ", so saving pays.", "After each round you can spend tickets. You can hold " ++ n(c.charm_slots) ++ " charms and " ++ n(c.power_up_slots) ++ " specialty balls. Charms sell back for half. Rerolling shows new offers, and costs more each time.", "Stamp puts a picture on a hole you pick. Gild adds " ++ chips(Skee.Items.gild_amount()) ++ " chips to a hole for good. Purge removes the picture a hole is showing. Tap the item, then tap the hole."], [])
  end

  pfn combos() : GuideTopic needs () do
    topic("Targets and Combos", ["A ball showing one of the frame's targets adds to your multiplier and starts a combo. The next match in a row adds more, up to level " ++ n(Skee.Scoring.max_level()) ++ ".", "A throw that misses the targets ends the combo. A ball that matches all three targets also pays " ++ tickets(Skee.Scoring.jackpot_tickets()) ++ " tickets."], [TipCombo])
  end

  pfn hot_spot(c : RunConfig) : GuideTopic needs () do
    topic("Hot Spot and Fever", ["After each pull one hole sparkles with a gold ring. A ball in it pays double chips until the next pull. It's never the 10.", "Every rattle on a rim and every gutter ball adds heat to the meter. At " ++ n(c.fever_heat) ++ " heat, the next frame's multiplier is doubled."], [TipHotSpot, TipFever])
  end

  pfn bets() : GuideTopic needs () do
    let cost = fn b -> tickets(Skee.Scoring.bet_cost(b))
    topic("Bets and Free Games", ["Bet 1, 3 or 5 lines for " ++ cost(BetOne) ++ ", " ++ cost(BetThree) ++ " or " ++ cost(BetFive) ++ " tickets. Three alike on a line you bet on adds chips to the frame, from " ++ chips(Skee.Scoring.line_pay(ReelCherry)) ++ " for cherries up to " ++ chips(Skee.Scoring.line_pay(ReelWild)) ++ " for wilds.", "Wilds stand in for any picture, and 2X and 3X wilds multiply the line. Three or more BONUS pictures anywhere win " ++ n(Skee.Scoring.free_games_awarded()) ++ " free games: extra frames that score double."], [TipBets, TipFreeGames])
  end

  pfn charms() : GuideTopic needs () do
    list("Charms", List.map(Skee.Items.all_charms(), fn c -> Skee.Items.charm_name(c) ++ ": " ++ Skee.Items.charm_blurb(c) ++ "."), 4, [TipCharm])
  end

  pfn specialty() : GuideTopic needs () do
    let first =
      "Buy these at the counter for " ++ tickets(Skee.Items.power_up_cost(GoldenBall)) ++ " tickets, then tap one to use it on your next throw."
    list("Specialty Balls", Cons(first, List.map(Skee.Items.all_power_ups(), fn p -> Skee.Items.power_up_name(p) ++ ": " ++ Skee.Items.power_up_blurb(p) ++ ".")), 3, [TipSpecialty])
  end

  pfn balls() : GuideTopic needs () do
    let first = "Swap for free before any throw. The number is what the ball's chips are multiplied by."
    list("Choosing a Ball", Cons(first, List.map(Skee.Items.all_balls(), fn b -> Skee.Items.ball_name(b) ++ " (" ++ Skee.Items.pay_label(b) ++ "): " ++ Skee.Items.ball_blurb(b))), 3, [TipBalls])
  end

  pfn bosses() : GuideTopic needs () do
    let first = "The third round of each ante bends one rule, and it's written on screen."
    list("Boss Machines", Cons(first, List.map(Skee.Items.all_bosses(), fn b -> Skee.Items.boss_name(b) ++ ": " ++ Skee.Items.boss_blurb(b))), 4, [TipBoss])
  end

  pfn winnings() : GuideTopic needs () do
    let rooms = String.join(List.map(List.drop(Skee.Rooms.all_rooms(), 1), Skee.Rooms.name), ", ")
    topic("Winnings and Hosts", ["Winnings are kept between games. Each finished game pays 1 for every 20 points you scored, 20 for each round cleared, and 500 for beating the arcade.", "Spend winnings in the prize shop. Prizes are just for show and never change the game. They're there to be collected.", "Jackpots only pay at the 5-line bet. Three bars pay the MINI, three sevens the MINOR, three diamonds the MAJOR, and three wilds on the middle row the GRAND.", "The meters over the machine grow with every pull and carry over between games. A jackpot goes straight to your winnings.", "Every 3 or 4 games a host sits down to offer you free nights. A night is one game that starts with bonus tickets. Talk to them: charm pays, and rudeness costs patience.", "Win enough and the host offers a new room, yours for good, with its own board and machine: " ++ rooms ++ ". Pick your room on the title screen."], [TipGameOver, TipJackpot])
  end

  doc """Guide.all: every topic, in the order the Guide lists them."""
  fn all() : List(GuideTopic) needs () do
    let c = Skee.Types.standard_config()
    [
      big_idea(c),
      rolling(),
      lever(),
      scoring(),
      counter(c),
      combos(),
      hot_spot(c),
      bets(),
      charms(),
      specialty(),
      balls(),
      bosses(),
      winnings()
    ]
  end

  doc """Is this topic open to a player who has seen these tips?"""
  fn unlocked(t : GuideTopic, seen : List(Tip)) : Bool needs () do
    List.is_empty(t.topic_unlocks) || List.any(t.topic_unlocks, fn u -> Skee.Walkthrough.has_tip(seen, u))
  end

  doc """Guide.topics(seen:): what this player has met so far."""
  fn topics(seen : List(Tip)) : List(GuideTopic) needs () do
    List.filter(all(), fn t -> unlocked(t, seen))
  end

end
