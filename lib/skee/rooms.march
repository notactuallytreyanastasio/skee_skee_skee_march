  doc """The host's first offer: the room, one night, nothing else."""
  fn comp_opening(r : Room) : Comp needs () do
    { comp_room: r, nights: 1, comp_tickets: Tickets(0), credit: Winnings(0) }
  end

  doc """
  What the deal is worth in winnings, by the casino's arithmetic: a ticket on a
  night is worth 40, each night itself 60.
  """
  fn comp_value(c : Comp) : Winnings needs () do
    let tickets = Skee.Units.tickets_int(c.comp_tickets)
    Winnings(c.nights * 60 + c.nights * tickets * 40 + Skee.Units.winnings_int(c.credit))
  end

  doc """The most any host will put on the table for a room."""
  fn comp_ceiling(r : Room) : Comp needs () do
    let k = Skee.Units.room_rank(r)
    {
      comp_room: r,
      nights: 3 + k,
      comp_tickets: Tickets(2 + k),
      credit: Winnings(300 * (k + 1))
    }
  end

  doc """Every field held inside 0...ceiling, nights at least 1."""
  fn comp_clamped(c : Comp) : Comp needs () do
    let top = comp_ceiling(c.comp_room)
    let tickets =
      clamp_int(Skee.Units.tickets_int(c.comp_tickets), 0, Skee.Units.tickets_int(top.comp_tickets))
    let credit =
      clamp_int(Skee.Units.winnings_int(c.credit), 0, Skee.Units.winnings_int(top.credit))
    {
      comp_room: c.comp_room,
      nights: clamp_int(c.nights, 1, top.nights),
      comp_tickets: Tickets(tickets),
      credit: Winnings(credit)
    }
  end

  doc """Read a PerRoom record."""
  fn room_at(m : PerRoom(a), r : Room) : a needs () do
    match r do
    Boardwalk -> m.boardwalk
    NeonLounge -> m.neon_lounge
    HighRoller -> m.high_roller
    Penthouse -> m.penthouse
    end
  end

  doc """Write a PerRoom record."""
  fn room_put(m : PerRoom(a), r : Room, v : a) : PerRoom(a) needs () do
    match r do
    Boardwalk -> { m with boardwalk: v }
    NeonLounge -> { m with neon_lounge: v }
    HighRoller -> { m with high_roller: v }
    Penthouse -> { m with penthouse: v }
    end
  end

  -- Progressive(): every meter at its seed. Rooms comes before Scoring in the
  -- module order, and a new wallet needs the meters.
  fn seeded_progressive() : Progressive needs () do
    {
      meters: {
        mini: Winnings(50),
        minor: Winnings(150),
        major: Winnings(600),
        grand: Winnings(2500)
      }
    }
  end

  doc """Wallet(balance:lifetime:owned:). The Boardwalk is yours from the start."""
  fn new_wallet(balance : Winnings, lifetime : Winnings, owned : List(Prize)) : Wallet needs () do
    {
      balance: balance,
      lifetime: lifetime,
      owned: owned,
      progressive: seeded_progressive(),
      rooms: {
        boardwalk: true,
        neon_lounge: false,
        high_roller: false,
        penthouse: false
      },
      wallet_room: Boardwalk,
      comps: {
        boardwalk: None,
        neon_lounge: None,
        high_roller: None,
        penthouse: None
      },
      games_since_host: 0,
      host_visits: 0
    }
  end

  doc """Wallet()."""
  fn empty_wallet() : Wallet needs () do
    new_wallet(Winnings(0), Winnings(0), [])
  end

  fn credit(w : Wallet, amount : Winnings) : Wallet needs () do
    { w with balance: Skee.Units.add_winnings(w.balance, amount), lifetime: Skee.Units.add_winnings(w.lifetime, amount) }
  end

  doc """
  The next room the host is ready to comp, if your winnings have earned it: the
  first one you don't have yet, once you're past its threshold.
  """
  fn comp_due(w : Wallet) : Option(Room) needs () do
    match List.find(all_rooms(), fn r -> !room_at(w.rooms, r)) do
    None -> None
    Some(r) -> do
      if Skee.Units.winnings_at_least(w.lifetime, comp_threshold(r)) do
        Some(r)
      else
        None
      end
    end
    end
  end

  doc """Games between the host's visits: three, then four, then three."""
  fn host_interval(w : Wallet) : { Int | _ >= 3 && _ <= 4 } needs () do
    if w.host_visits % 2 == 0 do 3 else 4 end
  end

  doc """A game ended, won, lost or walked away from."""
  fn game_played(w : Wallet) : Wallet needs () do
    { w with games_since_host: w.games_since_host + 1 }
  end

  doc """
  The room the host wants to talk about, once enough games have gone by: the
  next room if winnings have earned it, otherwise a comped stay where you are.
  """
  fn host_due(w : Wallet) : Option(Room) needs () do
    if w.games_since_host >= host_interval(w) do
      match comp_due(w) do
      Some(r) -> Some(r)
      None -> Some(w.wallet_room)
      end
    else
      None
    end
  end

  -- The deal to bank: nights left from an earlier deal stay, and the better
  -- ticket perk applies to all of them.
  pfn stay_after(deal : Comp, old : Option(Comp)) : Comp needs () do
    match old do
    None -> deal
    Some(banked) -> do
      let tickets =
        Math.max_int(Skee.Units.tickets_int(deal.comp_tickets), Skee.Units.tickets_int(banked.comp_tickets))
      { deal with nights: deal.nights + banked.nights, comp_tickets: Tickets(tickets) }
    end
    end
  end

  -- The first haggle at the door neither moves you nor counts as a host visit.
  pfn after_visit(w : Wallet, deal : Comp, visit : HostVisit) : Wallet needs () do
    match visit do
    VisitArrival -> w
    VisitNewRoom -> do
      { w with wallet_room: deal.comp_room, games_since_host: 0, host_visits: w.host_visits + 1 }
    end
    VisitReturning -> do
      { w with wallet_room: deal.comp_room, games_since_host: 0, host_visits: w.host_visits + 1 }
    end
    end
  end

  doc """
  Wallet.close for a haggle that has finished: `deal` is Haggle.final. An open
  haggle changes nothing, so it has no call here. The room is yours either way;
  the deal's nights are banked and its credit paid.
  """
  fn close_deal(w : Wallet, deal : Comp, visit : HostVisit) : Wallet needs () do
    let r = deal.comp_room
    let stay = stay_after(deal, room_at(w.comps, r))
    let banked =
      { w with rooms: room_put(w.rooms, r, true), comps: room_put(w.comps, r, Some(stay)) }
    after_visit(credit(banked, deal.credit), deal, visit)
  end

  -- Use one of the comp's nights; the last one spends the comp.
  pfn spend_night(w : Wallet, c : Comp) : (Tickets, Wallet) needs () do
    let left = c.nights - 1
    let kept = if left > 0 do Some({ c with nights: left }) else None end
    (c.comp_tickets, { w with comps: room_put(w.comps, w.wallet_room, kept) })
  end

  doc """
  Start a run in the current room: use a comped night if one is left. Returns
  the extra starting tickets and the wallet after.
  """
  fn check_in(w : Wallet) : (Tickets, Wallet) needs () do
    match room_at(w.comps, w.wallet_room) do
    None -> (Tickets(0), w)
    Some(c) -> if c.nights > 0 do spend_night(w, c) else (Tickets(0), w) end
    end
  end

  doc """Buy a prize. Owning it is checked before the price, as in Swift."""
  fn buy(w : Wallet, p : Prize) : Result(Wallet, ShopError) needs () do
    let price = prize_price(p)
    if List.any(w.owned, fn x -> x == p) do
      Err(AlreadyOwned)
    else
      if Skee.Units.winnings_at_least(w.balance, price) do
        Ok({ w with balance: Skee.Units.sub_winnings(w.balance, price), owned: List.append(w.owned, [p]) })
      else
        Err(ShopCantAfford)
      end
    end
  end

  doc """
  What a finished run pays to the shelf: a twentieth of every point scored, 20
  per round cleared, 500 for beating the arcade.
  """
  fn winnings(stats : RunStats, won : Bool) : Winnings needs () do
    let bonus = if won do 500 else 0 end
    Winnings(Skee.Units.points_int(stats.points) / 20 + stats.rounds_cleared * 20 + bonus)
  end

  fn rgb(r : { Int | _ >= 0 && _ <= 255 }, g : { Int | _ >= 0 && _ <= 255 }, b : { Int | _ >= 0 && _ <= 255 }) : Rgb needs () do
    { packed: r * 65536 + g * 256 + b }
  end

