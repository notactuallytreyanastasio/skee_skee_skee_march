mod Skee.Rooms do

  -- Where you play (Meta/Room.swift), and the prize shelf and wallet that carry
  -- between runs (Meta/PrizeShelf.swift). Every room has its own board, cabinet
  -- reels, pull machine, prize counter and colours. The physics is the same
  -- everywhere.
  cap pure

  import Arcade.Num
  import Arcade.Vec2

  -- Why the host sat down: Haggle.Visit. The rest of Haggle is not ported yet.
  type HostVisit = VisitArrival | VisitNewRoom | VisitReturning

  derive Eq, Show for HostVisit

  -- A colour as 0xRRGGBB. Build one with `rgb`.
  type Rgb = { packed : { Int | packed >= 0 && packed <= 16777215 } }

  derive Show for Rgb

  -- Ring zones, the 40 cup outward to the 10.
  type ZoneColours = { zone40 : Rgb, zone30 : Rgb, zone20 : Rgb, zone10 : Rgb }

  derive Show for ZoneColours

  -- A room's colours. Same cel look everywhere; each room repaints the wood,
  -- the rails and the rings. Swift keeps this in SkeeScene, but it is plain data.
  type CabinetPalette = {
    backdrop : Rgb,
    rail : Rgb,
    rail_dark : Rgb,
    cabinet_body : Rgb,
    zones : ZoneColours,
    lip : Rgb,
    hole_colour : Rgb,
    felt : Rgb,
    floor : Rgb
  }

  derive Show for CabinetPalette

  doc """Room.allCases."""
  fn all_rooms() : List(Room) needs () do
    [Boardwalk, NeonLounge, HighRoller, Penthouse]
  end

  fn name(r : Room) : String needs () do
    match r do
    Boardwalk -> "The Boardwalk Arcade"
    NeonLounge -> "The Neon Lounge"
    HighRoller -> "The High Roller Suite"
    Penthouse -> "The Penthouse"
    end
  end

  fn blurb(r : Room) : String needs () do
    match r do
    Boardwalk -> "Where everyone starts. Sticky floors, honest machines."
    NeonLounge -> do
      "Rings set high and tight, pockets pulled in. The machine runs hot on wilds."
    end
    HighRoller -> do
      "Small rings, pockets that pay 150, a machine heavy with sevens and diamonds."
    end
    Penthouse -> "A steep board and wide rings. The machine is full of 3X wilds."
    end
  end

  fn next(r : Room) : Option(Room) needs () do
    match r do
    Boardwalk -> Some(NeonLounge)
    NeonLounge -> Some(HighRoller)
    HighRoller -> Some(Penthouse)
    Penthouse -> None
    end
  end

  doc """Lifetime winnings at which the host first offers to comp this room."""
  fn comp_threshold(r : Room) : Winnings needs () do
    match r do
    Boardwalk -> Winnings(0)
    NeonLounge -> Winnings(1500)
    HighRoller -> Winnings(5000)
    Penthouse -> Winnings(12000)
    end
  end

  doc """How much more each room asks than the Boardwalk."""
  fn target_scale(r : Room) : Float needs () do
    match r do
    Boardwalk -> 1.0
    NeonLounge -> 1.3
    HighRoller -> 1.0
    Penthouse -> 1.4
    end
  end

  fn pockets(x : Float, y : Float, radius : Float) : Pockets needs () do
    {
      left: { pocket_hole: PocketLeft, center: vec2(-x, y), radius: radius },
      right: { pocket_hole: PocketRight, center: vec2(x, y), radius: radius }
    }
  end

  fn walls(w40 : Float, w30 : Float, w20 : Float, w10 : Float) : RingWalls needs () do
    { wall40: w40, wall30: w30, wall20: w20, wall10: w10 }
  end

  fn board(k : Skee.Consts.Consts, r : Room) : BoardSpec needs () do
    let b = Skee.Types.standard_board(k)
    match r do
    Boardwalk -> b
    NeonLounge -> do
      { b with ring_center: vec2(0.0, 0.6), ring_walls: walls(0.095, 0.15, 0.21, 0.28), pockets: pockets(0.17, 0.88, 0.036) }
    end
    HighRoller -> do
      { b with ring_walls: walls(0.085, 0.14, 0.2, 0.27), center_hole_offset: vec2(0.0, 0.035), pockets: pockets(0.22, 0.87, 0.033) }
    end
    Penthouse -> do
      { b with tilt: degrees(k.num, 24.0), ring_center: vec2(0.0, 0.6), ring_walls: walls(0.11, 0.17, 0.23, 0.3), pockets: pockets(0.19, 0.88, 0.038) }
    end
    end
  end

  doc """The alley. Only the board moves; the lane and hinge are the same everywhere."""
  fn table(k : Skee.Consts.Consts, r : Room) : Table needs () do
    { Skee.Types.standard_table(k) with board: board(k, r) }
  end

  doc """The cabinet's reels: what each hole can show."""
  fn setup(r : Room) : BoardSetup needs () do
    let s = Skee.Types.standard_setup()
    let reels = s.reels
    match r do
    Boardwalk -> s
    NeonLounge -> do
      { s with reels: { reels with reel10: [Lemon, Lemon, Cherry, Clover, Lemon], reel20: [Bell, Lemon, Bell, Cherry, Bell], reel50: [Seven, Clover, Seven, BarSym, Seven] } }
    end
    HighRoller -> do
      let gild = s.gild
      {
        reels: { reels with reel30: [BarSym, Bell, BarSym, Seven, BarSym], reel40: [Seven, BarSym, Seven, Diamond, Seven], reel50: [Diamond, Seven, Diamond, BarSym, Diamond] },
        gild: { gild with reel_left: Chips(50), reel_right: Chips(50) }
      }
    end
    Penthouse -> do
      { s with reels: { reels with reel10: [Bell, Bell, BarSym, Bell, Cherry], reel20: [BarSym, BarSym, Bell, Seven, BarSym], reel50: [Diamond, Clover, Diamond, Seven, Diamond], reel_left: [Clover, Diamond, Clover, Seven, Clover], reel_right: [Clover, Seven, Clover, Diamond, Clover] } }
    end
    end
  end

  doc """Pull.strips: the Boardwalk's three reels, and where every room starts."""
  fn base_strips() : Three(List(ReelSymbol)) needs () do
    Three([ReelCherry, ReelLemon, ReelBell, ReelBonus, ReelCherry, ReelBar, ReelLemon, ReelSeven, ReelCherry, ReelBell, ReelLemon, ReelWild, ReelBar, ReelCherry, ReelDiamond, ReelLemon, ReelBell, ReelBonus, ReelX2, ReelCherry], [ReelLemon, ReelCherry, ReelBar, ReelBell, ReelLemon, ReelSeven, ReelCherry, ReelWild, ReelBell, ReelLemon, ReelCherry, ReelBonus, ReelBar, ReelLemon, ReelX3, ReelCherry, ReelBell, ReelDiamond, ReelLemon, ReelCherry], [ReelBell, ReelCherry, ReelLemon, ReelBonus, ReelBar, ReelCherry, ReelBell, ReelLemon, ReelSeven, ReelCherry, ReelX2, ReelLemon, ReelBell, ReelCherry, ReelBonus, ReelDiamond, ReelLemon, ReelBar, ReelWild, ReelCherry])
  end

  -- The reel with its first `from` swapped, and whether there was one. `before`
  -- holds the stops already passed, nearest first.
  pfn swap_first(reel : List(ReelSymbol), from : ReelSymbol, to : ReelSymbol, before : List(ReelSymbol)) : (List(ReelSymbol), Bool) needs () do
    match reel do
    Nil -> (List.reverse(before), false)
    Cons(x, rest) -> do
      if x == from do
        (List.append(List.reverse(before), Cons(to, rest)), true)
      else
        swap_first(rest, from, to, Cons(x, before))
      end
    end
    end
  end

  -- One reel of Swift's swap: at most one stop, and only while any are left.
  pfn swap_reel(reel : List(ReelSymbol), from : ReelSymbol, to : ReelSymbol, left : Int) : (List(ReelSymbol), Int) needs () do
    if left > 0 do
      do
        let (swapped, found) = swap_first(reel, from, to, [])
        (swapped, if found do left - 1 else left end)
      end
    else
      (reel, left)
    end
  end

  -- Swap up to `count` stops, the first on each reel in turn.
  pfn swap(s : Three(List(ReelSymbol)), from : ReelSymbol, to : ReelSymbol, count : Int) : Three(List(ReelSymbol)) needs () do
    match s do
    Three(a, b, c) -> do
      let (a2, left_a) = swap_reel(a, from, to, count)
      let (b2, left_b) = swap_reel(b, from, to, left_a)
      let (c2, _) = swap_reel(c, from, to, left_b)
      Three(a2, b2, c2)
    end
    end
  end

  doc """The pull machine's strips: the same machine, with a different temper."""
  fn strips(r : Room) : Three(List(ReelSymbol)) needs () do
    let s = base_strips()
    match r do
    Boardwalk -> s
    NeonLounge -> swap(swap(s, ReelCherry, ReelWild, 3), ReelLemon, ReelX2, 3)
    HighRoller -> swap(swap(s, ReelCherry, ReelSeven, 3), ReelLemon, ReelDiamond, 3)
    Penthouse -> swap(swap(s, ReelCherry, ReelX3, 3), ReelLemon, ReelBar, 3)
    end
  end

